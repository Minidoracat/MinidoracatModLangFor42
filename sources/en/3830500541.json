{
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore": "Theodore",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_Chattiness": "How chatty he is",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_Chattiness_option1": "Quiet",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_Chattiness_option2": "Normal",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_Chattiness_option3": "Chatty",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_Chattiness_tooltip": "How often he talks on his own: questions for you, comments about places, and lines about the people and animals around. Talking to him from his T menu always works.",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_FarmAnimalsCalm": "Farm animals stay calm around him",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_FarmAnimalsCalm_tooltip": "To the game he's a zombie, so farm animals would run from him. On, farm animals don't run from zombies at all (the game can't tell him apart). Wild animals are never changed. Restart the game after changing this.",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_FirstMeeting": "First meeting",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_FirstMeeting_tooltip": "In a new game, he's panicking when you first meet him, and asks what happens now.",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_HomeChores": "Chores at home",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_HomeChores_tooltip": "While he stays home, he makes you sandwiches (and cleans up blood when you ask). Off, he only eats and drinks (asked, he still cleans).",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_HumanityLoss": "How hard things hit him",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_HumanityLoss_option1": "Gentle",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_HumanityLoss_option2": "Normal",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_HumanityLoss_option3": "Harsh",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_HumanityLoss_tooltip": "How much his humanity drops from bad things: seeing you kill, being left alone, missed talks, nightmares. Good things work the same on every setting.",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_Nightmares": "Nightmares",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_Nightmares_option1": "Never",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_Nightmares_option2": "Rare",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_Nightmares_option3": "Normal",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_Nightmares_option4": "Often",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_Nightmares_tooltip": "How often he has bad dreams at night (more when he's sad, fewer with a bedtime story or something soft to hug).",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_PlaceComments": "Comments about places",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_PlaceComments_tooltip": "He says things about places you go (a burnt house, a toy store, an upstairs...) and you can answer him with Talk.",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_ProudParent": "Proud Parent moodle",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_ProudParent_tooltip": "When Theodore counts your supplies over the walkie-talkie or hands you the sandwich he made you, you get the Proud Parent moodle for a day: you run a little faster.",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_SeasonalClothes": "Clothes for every season",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_SeasonalClothes_tooltip": "Long sleeves in the fall, his school jacket in November and March, and a hat and gloves in winter and in the snow. Off, he always wears his T-shirt.",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_Sickness": "Getting sick",
  "translate_en|mods/Theodore/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Theodore_Sickness_tooltip": "He can catch a cold, faster when he gets soaked in the rain. While he's sick he rests in his bed until he's better. Soup, medicine and tissues help."
}
