  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions": "US Military Grenades",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions_DebugSpawnKeyEnabled": "Enable Debug Spawn Key",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions_DebugSpawnKeyEnabled_tooltip": "Off by default. When enabled, Shift + Numpad \"+\" (rebindable in Mod Options) spawns a single flashbang directly into your inventory for quick trajectory testing.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions_DelayedFuseEnabled": "Delayed Fuse on Landing",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions_DelayedFuseEnabled_tooltip": "Off by default. When enabled, this mod's own grenades (Mk2, M26, M67, M84 Flashbang, M14 TH3) land and sit armed for a few seconds before exploding, instead of detonating immediately on impact. Does not affect mines/Claymores (which already land as placed traps) or vanilla throwables.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions_DelayedFuseSeconds": "Fuse Delay (seconds)",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions_DelayedFuseSeconds_tooltip": "How many seconds a landed grenade sits armed before exploding, when Delayed Fuse on Landing is enabled.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions_FireDamageEnabled": "Enhanced Fire Damage",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions_FireDamageEnabled_tooltip": "When enabled, zombies take additional damage while on fire, regardless of the fire source. Disable to use vanilla fire behavior.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions_FireDamageMultiplier": "Fire Damage Multiplier",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions_FireDamageMultiplier_tooltip": "Multiplies the additional fire damage dealt to burning zombies. 0.5 = about 30% faster than vanilla, 1.0 = about twice as fast, 5.0 = about five times faster than vanilla.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions_LootMultiplier": "Loot Multiplier",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions_LootMultiplier_tooltip": "Multiplies the spawn chance of all grenades and mines in loot containers. 0.5 = half as frequent, 1.0 = default, 2.0 = twice as frequent.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions_VanillaBallisticsEnabled": "Apply Ballistic Arc to Vanilla Throwables",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExplosivesOptions_VanillaBallisticsEnabled_tooltip": "Off by default. When enabled, the mod's custom throw arc and ground-target marker also apply to vanilla Pipe Bombs, Aerosol Bombs, Smoke Bombs, Flame Traps, Noise Traps, Firecrackers, and Molotov Cocktails (including their sensor, remote, and timer variants where they exist), instead of only this mod's own grenades.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_ClaymoreRemote": "An M18A1 Claymore mine fitted with a remote trigger instead of a motion sensor. Detonate it from a distance using a remote control.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Explosives_DEBUG_SPAWN_KEY": "Hold Shift and press this key to spawn a single flashbang directly into your inventory, for testing grenade trajectories/collisions without needing full debug mode.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_FlareBurning": "A lit signal flare, burning brightly and giving off sparks and smoke. Throw it to mark a location or light up the area.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_FlareSpent": "A burnt-out signal flare. No longer useful.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_GrenadeBandolier": "Provides 4 grenade attachment slots. Drag grenades onto the attachment icons to holster them there for quick access - it is not a storage container.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_M26FuzeAssembly": "A hand-built fuze assembly for an M26 grenade shell - primer, delay element, and wiring, ready to be screwed into the shell.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_M26Shell": "An unfinished, hollow shell for an M26 fragmentation grenade. Needs a fuze assembly, striker lever and gunpowder to become a working grenade.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_M67FuzeAssembly": "A hand-built fuze assembly for an M67 grenade shell - primer, delay element, and wiring, ready to be screwed into the shell.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_M67Shell": "An unfinished, hollow shell for an M67 fragmentation grenade. Needs a fuze assembly, striker lever and gunpowder to become a working grenade.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Mk2FuzeAssembly": "A hand-built fuze assembly for an Mk2 grenade shell - primer, delay element, and wiring, ready to be screwed into the shell.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Mk2Shell": "An unfinished, hollow shell for an Mk2 fragmentation grenade. Needs a fuze assembly, striker lever and gunpowder to become a working grenade.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_StrikerLever": "A spring-loaded striker lever, forged from scrap metal. Needed to assemble any hand grenade - it's what triggers the fuse when released.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/UI.json|UI_Explosives_DebugSpawnGiven": "Spawned a test flashbang.",
  "translate_en|mods/Explosives/42/media/lua/shared/Translate/EN/UI.json|UI_Options_Explosives_DEBUG_SPAWN_KEY": "Debug Spawn Flashbang Key (hold Shift)"
}
