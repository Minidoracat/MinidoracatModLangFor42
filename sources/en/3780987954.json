  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_CalorieBonusPreset_tooltip": "Extra calories applied after the weight-based rebalance. 0%% uses the balanced values; 100%% doubles them and 400%% makes them x5.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableBaitQuality": "Bait type and freshness",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableBaitQuality_tooltip": "Insects favour small fish, fresh fish bait attracts predators, meat favours catfish, and stale or rotten bait shifts catches toward scavengers and trash.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableCastMiniGame": "Casting-distance minigame",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableCastMiniGame_tooltip": "Shows a blue-and-yellow 1-to-16-tile meter while aiming. Yellow marks the aimed distance and the blue cursor selects the cast.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableCatchEvents": "Catch events",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableCatchEvents_tooltip": "Enables escapes, exceptional catches and the event system used by line breaks, rod breaks and double catches.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableEnhancedXP": "Staged Fishing XP",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableEnhancedXP_tooltip": "Awards +1 XP on a bite, +2 when control starts, +5 on capture and +10 extra for an exceptional catch.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableEquipmentEffects": "Meaningful equipment",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableEquipmentEffects_tooltip": "Hooks alter attraction, line quality alters break risk, and professional rods wear more slowly.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableExpandedTrash": "Expanded fishing trash",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableExpandedTrash_tooltip": "Adds boots, branches, cans, cordage, hooks and other vanilla junk to fishing catches.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableFatigue": "Fishing fatigue",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableFatigue_tooltip": "Long uninterrupted fishing sessions drain endurance and progressively slow reeling. Resting starts a fresh session.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableFishAI": "Species behaviour",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableFishAI_tooltip": "Makes carp, trout, catfish, pike and compatible mod fish fight with different speed, force and escape risks.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableFishQuality": "Fish quality",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableFishQuality_tooltip": "Caught fish receive an invisible Normal, Good, Excellent or Legendary quality that affects weight, nutrition, mood and value metadata.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableFishSchools": "Hidden fish schools",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableFishSchools_tooltip": "Some thirty-tile water areas are richer. Catches still deplete vanilla abundance and double catches deplete it twice.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableLineBreaks": "Line breaks",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableLineBreaks_tooltip": "Allows high tension and heavy fish to break the fishing line. Line type and condition affect risk.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableModCompatibility": "Automatic mod-fish compatibility",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableModCompatibility_tooltip": "Automatically balances all species registered in the Build 42 Fishing.fishes table and enables dedicated support for Yumi's Fishing Expansion.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableNutritionBalance": "Nutritional rebalance",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableNutritionBalance_tooltip": "Recalculates fish nutrition from real caught weight and preserves the total nutrition when filleting.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableRareFish": "Rare fish variants",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableRareFish_tooltip": "Allows albino, mutated, gigantic, scarred and diseased catches.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableRealisticWear": "Weight-based rod wear",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableRealisticWear_tooltip": "Small fish barely wear rods; large and exceptional fish may remove substantially more condition.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableRodBreaks": "Rare rod breaks",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableRodBreaks_tooltip": "Allows a very rare rod failure. Heavy fish and damaged rods are more dangerous.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableSeatedFishing": "Fishing while seated",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableSeatedFishing_tooltip": "Allows fishing from the ground and from recognized chairs or furniture. Furniture must face the water.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableStatistics": "Fishing statistics",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableStatistics_tooltip": "Tracks fish, total weight, species, records, escapes, breaks, junk, treasure and special catches per character.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableTimeEffects": "Strong time-of-day effects",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableTimeEffects_tooltip": "Makes dawn and dusk best, morning good, midday poor and night less productive.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableTreasure": "Fishing treasure",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableTreasure_tooltip": "Allows very rare catches such as watches, rings, old coins, tools and premium line.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableWeatherEffects": "Strong weather effects",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EnableWeatherEffects_tooltip": "Light rain helps, while storms, strong wind, heavy rain and fog reduce fishing success.",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EventFrequency": "Event frequency",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EventFrequency_option1": "Low (x0.5)",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EventFrequency_option2": "Normal (x1)",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EventFrequency_option3": "High (x2)",
  "translate_en|mods/VanillaFishingFix/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_VanillaFishingFix_EventFrequency_tooltip": "Scales the probability of catch events, treasure and rare fish."
