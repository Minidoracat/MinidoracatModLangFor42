  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Tooltip.json|ItemTooltip_HFM_Manual": "A gunsmithing periodical. Learn how to repair damaged firearms and assemble Firearm Maintenance Kits and Gunsmithing Tools.",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Tooltip.json|ItemTooltip_item_HFMManual": "A gunsmithing periodical. Learn how to repair damaged firearms and assemble Firearm Maintenance Kits and Gunsmithing Tools.",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_HFM_CLPBottle": "Cleaner, Lubricant, Protectant. Used for cleaning a firearm and lubrication during reassembly.",
