  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_MinimumCleanThreshold": "Minimum Condition To Clean",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_MinimumCleanThreshold_tooltip": "Gun parts below this condition must be repaired before they can be cleaned.",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_MinimumFirearmSkill": "Firearm Skill Required To Repair",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_MinimumFirearmSkill_tooltip": "Aiming or Reloading level needed to repair gun parts. Cleaning has no skill requirement, so any survivor can maintain a firearm in the field.",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_MinimumRepairThreshold": "Minimum Condition To Repair",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_MinimumRepairThreshold_tooltip": "Gun parts below this condition are beyond repair. Set to 0 to allow repairing broken firearms.",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_PartsBulk": "Disassembled Parts Bulk (%)",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_PartsBulk_tooltip": "Weight of disassembled gun parts as a percentage of the assembled firearm's weight. 100 means no extra bulk.",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_RepairConditionCap": "Repair Limit (% Of Max Condition)",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_RepairConditionCap_tooltip": "Repairing stops at this percentage of a firearm's maximum condition; cleaning restores the rest. 70% is 7 out of 10 on a typical firearm. A percentage is used because maximum condition varies between firearms, especially modded ones. Set to 100 to let repairs fully restore a firearm.",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_RepairEfficacy": "Condition Restored Per Scrap Metal",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_RepairEfficacy_tooltip": "How much condition each piece of Scrap Metal restores while repairing.",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_RepairRequiresSurface": "Repairs Require A Workbench",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_RepairRequiresSurface_tooltip": "Repairing gun parts requires standing next to a table, counter or workbench. Cleaning is never restricted, so firearms can still be maintained in the field.",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_StripAttachments": "Remove Attachments Before Disassembly",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_StripAttachments_tooltip": "Mimics the behaviour of Universal Gun Repair, intended for those who wish to adhere as closely as possible to that mod. Removes weapon attachments from the firearm before disassembly, placing them in your inventory. There is no benefit or drawback other than what it says; recommend keeping it off.",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_XPGain": "XP Gain (%)",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HFM_XPGain_tooltip": "Multiplies all experience awarded by this mod. Set to 0 to disable XP gain entirely, or above 100 to increase it.",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HagsFirearmMaintenance": "Hags' Firearm Maintenance",
  "translate_en|mods/HagsFirearmMaintenance/42/media/lua/shared/Translate/EN/Tooltip.json|ItemTooltip_HFM_CLPBottle": "Cleaner, Lubricant, Protectant. Used for cleaning a firearm and lubrication during reassembly.",
