  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation": "Peachey's Distillation",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_AgeTimeMultiplier": "Ageing Time",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_AgeTimeMultiplier_tooltip": "How long casked spirits and wine take to mature.<br>100 is the mod's designed balance: five days for whiskey, ten for scotch, seven for country wine to become aged wine.<br>Higher is slower.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_CultureTimePercent": "Yeast and Culture Speed",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_CultureTimePercent_tooltip": "How long a batch made with yeast, or a crock pitched with a mother of vinegar, takes compared to the same batch made with plain sugar.<br>33 means a third of the time. Set to 100 to remove the advantage entirely.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_FermentRadius": "Fermentation Range",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_FermentRadius_tooltip": "How far from a player, in tiles, containers are checked each hour for batches that are ready.<br>Anything you are carrying always counts. Raise this if you want a cellar to keep working while you stand at the far end of the building; large values cost performance.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_FermentTimeMultiplier": "Fermentation Time",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_FermentTimeMultiplier_tooltip": "How long mash, wort, must and honey must take to ferment.<br>100 is the mod's designed balance: one day for mash, a day and a half for ale, two days for wine, three for mead.<br>Higher is slower.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_IntoxicationMultiplier": "Alcohol Strength",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_IntoxicationMultiplier_tooltip": "How drunk these drinks get you. Affects only the intoxication they cause, not their mood, pain or healing effects.<br>Set to 0 for no intoxication at all.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_LootEquipment": "Distilling Gear in Loot",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_LootEquipment_tooltip": "Whether the Still Kit and the Mother of Vinegar turn up in the world: drug shacks, barns, garages, camping lockers and survivor food stores.<br>Off by default, since the still is the gate on the whole spirits line.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_LootFineSpirits": "Aged Spirits in Loot",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_LootFineSpirits_tooltip": "Whether vodka, brandy, vermouth, absinthe, aged wine, whiskey and scotch turn up in the world.<br>Off by default: these cost days of waiting to make, and finding them hands you the back half of the mod. Malort never spawns at any setting.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_LootHomebrew": "Homebrew in Loot",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_LootHomebrew_tooltip": "Whether ale, country wine, mead and moonshine turn up in the world: survivor safehouses, squats, trailer parks, farm and garage fridges, drug shacks and hidden stashes.<br>Someone else was brewing before you got here. A found bottle of country wine still ages into aged wine on its own.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_LootTier_option1": "None",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_LootTier_option2": "Very Rare",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_LootTier_option3": "Rare",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_LootTier_option4": "Normal",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_LootTier_option5": "Common",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_RequireHeatSource": "Still Kit Needs a Fire",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_RequireHeatSource_tooltip": "The portable Still Kit only works next to live heat: a lit campfire, barbecue or fireplace, or a powered oven or antique stove.<br>Turn off to distil anywhere. The Moonshine Still workstation has its own firebox and is unaffected either way.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_SourTimeMultiplier": "Souring Time",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Distillation_SourTimeMultiplier_tooltip": "How long a souring crock takes to become vinegar.<br>100 is the mod's designed balance: three days on a wild ferment, one day with a mother of vinegar pitched in.<br>Higher is slower.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_Absinthe": "Enormous lift, then a comedown 20 minutes later.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_AgedWine": "Best mood repair here. Only patience makes it.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_Anise": "Licorice-sweet herb. High summer only.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_BarleyMash": "For scotch. Sours on its own. Right-click to check.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_BerryBrandy": "Low proof. Dulls pain and mends you for an hour.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_CaskStation": "Staved oak. Bulk beer, wine and mead. No fire.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_CornMash": "Sours into wash on its own. Right-click to check.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_CountryWine": "Drinkable now, or leave it a week to age.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_FermentedBarleyMash": "Soured barley wash. The start of scotch.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_FermentedCornMash": "Soured corn wash. Ready for the still.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_FermentedFruitMash": "Soured fruit wash. Ready for the still.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_FermentedPotatoMash": "Soured potato wash. Ready for the still.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_FruitMash": "Sours into wash on its own. Right-click to check.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_HomebrewAle": "Filling, and the only drink that quenches thirst.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_HoneyMust": "Bottled and waiting. Becomes mead in three days.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_Malort": "Foul. Heals every wound. One go. No help for bites.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_Mead": "Honey wine. Warming, and good for a cold.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_Moonshine": "Huge boredom relief. Crashes hard 20 minutes later.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_MoonshineStillStation": "Welded drum with its own firebox. No campfire.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_MotherOfVinegar": "Optional culture. Sours a crock 3x faster.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_Must": "Bottled and waiting. Becomes wine on its own.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_NewMakeScotch": "Raw spirit, undrinkable. Ten days in the cask.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_NewMakeWhiskey": "Raw spirit, undrinkable. Five days in the cask.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_PotatoMash": "Starchy. Sours on its own. Right-click to check.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_PotatoVodka": "Clean spirit. Best here for stress and misery.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_RecipeBarleyMash": "Threshed barley - the same crop the beer wants.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_RecipeBrewMead": "Honey, water and 3 jars. Mead in 72h.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_RecipeBrewMust": "Fruit and 3 jars. Wine in 48h, then it ages.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_RecipeBrewWort": "Grain, hops and 4 beer bottles. Ale in 36h.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_RecipeCaskMead": "Full cask: 6 mead. Best return on honey.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_RecipeCaskMust": "Full cask: 6 wine. Bring 6 jars.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_RecipeCaskSour": "Full cask: 6 vinegar. Sugar or a mother. 6 jars.",
  "translate_en|mods/ZomboidDistillation/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Distillation_RecipeCaskWort": "Full cask: 8 ale. Bring 8 beer bottles.",
