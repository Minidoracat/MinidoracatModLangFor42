  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PSA_P90_Mag": "Transparent 50-round mag. Easy to check, hard to jam.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_SCP_Injector": "Injector marked 'Hemovita'. No manufacturer, no batch number.<br>Sealed unit. Single-use.<br>No idea what's in it, but judging by the gear those guys carried,it wasn't meant to be safe, just effective.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_SCP_Injector_AdrenalSurge": "Injector marked 'Adrenal Surge'. No manufacturer, no batch number.<br>Sealed unit. Single-use.<br>Whoever carried this wasn’t planning to last — just to keep moving a little longer.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_bag_scpbackpack": "Large Foundation backpack. Carries essentials for field duty.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_balaclava_operatorbalaclava": "Thermal balaclava worn by operators. Masks identity, keeps warm.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_boilersuit_dclass": "Orange jumpsuit issued to D-Class inmates. Easy to spot, hard to hide.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_boilersuit_scpguard": "Worn by SCP facility guards. Durable and practical.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_boilersuit_scpmtf": "Assigned to MTF personnel. Reinforced for hostile environments.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_elbowpads_left": "Left elbow pad. Helps absorb melee blows.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_elbowpads_right": "Right elbow pad. Helps absorb melee blows.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_gloves_tactical": "Tactical gloves reinforced for CQC. Protects hands without limiting grip.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_goggles_tactical": "Impact-resistant goggles. Enhances visibility in dusty zones.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_hazmat_scp": "Sealed hazmat suit for biohazard containment. Limits vision and mobility.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_helmet_protec_full": "Lightweight tactical helmet favored by rapid-response units.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_helmet_scpguard": "Standard-issue ballistic helmet for Foundation guards.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_helmet_scpguard_down": "PASGT helmet with visor down. Reduced vision, full face cover.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_helmet_scpguard_up": "PASGT helmet with visor raised. Better view, less protection.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_kneepads_left": "Left-side tactical kneepad. Offers decent leg protection.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_kneepads_right": "Right-side tactical kneepad. Offers decent leg protection.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_mask_m40": "Military-grade M40 gas mask. Blocks most airborne hazards.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_mask_m40_nofilter": "M40 gas mask without filter. Reduced protection.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_tshirt_dclass": "Basic cotton shirt for D-Class. Nothing fancy.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_tshirt_staff": "Issued to low-level Foundation staff. Standard branding.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_vest_mtf": "Reinforced vest worn by MTF units. Excellent ballistic resistance.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_vest_scpguard": "Heavy-duty vest for frontline security. Protects against small arms fire.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_vest_scpguardlight": "Lightweight vest for guards. Balanced protection and mobility.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_vest_tacvest": "Tactical webbing for fast reloads. Keeps gear close and accessible.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_vest_tacvest_loose": "Loosened tac-vest. Better comfort, less stability.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_1": "…Fuck. That’s not right.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_10": "They didn’t make this for survival. Just results.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_11": "…That shouldn’t have worked.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_12": "Feels like it’s fixing things it shouldn’t.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_13": "I don’t think this leaves you the same.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_14": "Something’s wrong. I can feel it lingering.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_15": "…Yeah. That’s not natural.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_16": "It’s in my blood now. I can tell.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_17": "Too quiet… should hurt more.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_18": "Feels like I skipped something important.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_19": "…Hope this doesn’t come back to bite me.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_2": "Burns… Jesus, it burns.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_20": "They used this on people and didn’t ask twice.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_3": "Something’s moving. I can feel it.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_4": "Too fast… way too fast.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_5": "This isn’t how the body’s supposed to work.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_6": "…I’m still alive. Somehow.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_7": "God, what did they put in this…",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_8": "Feels like it’s forcing me back together.",
  "translate_en|mods/SCP Pack/common/media/lua/shared/Translate/EN/UI.json|UI_Saying_9": "Need water… feels like I’m drying out."
}
