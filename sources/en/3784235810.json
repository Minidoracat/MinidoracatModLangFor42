  "translate_en|mods/PeixesBRExpansion/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Base.PeixesBR_Arapaima_Description": "The Amazonian giant, a living legend. Rare, enormous and a brutal fighter. The best bait is a fish fillet.",
  "translate_en|mods/PeixesBRExpansion/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Base.PeixesBR_Arqueiro_Description": "A sharpshooter: it knocks insects down with precise water jets. Prefers surface baits.",
  "translate_en|mods/PeixesBRExpansion/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Base.PeixesBR_Arraia_Description": "A river-bottom stingray with a venomous tail barb. Takes bottom bait — and demands respect when landed.",
  "translate_en|mods/PeixesBRExpansion/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Base.PeixesBR_Aruana_Description": "The 'water monkey': it leaps out of the river to snatch insects off branches. Elegant and a fighter.",
  "translate_en|mods/PeixesBRExpansion/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Base.PeixesBR_Dourado_Description": "The king of the river, a fierce fighter found only in running water. The best bait is a baitfish.",
  "translate_en|mods/PeixesBRExpansion/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Base.PeixesBR_Pintado_Description": "A giant leather catfish and the heaviest trophy around. The best bait is small animal meat.",
  "translate_en|mods/PeixesBRExpansion/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Base.PeixesBR_PiranhaPreta_Description": "The largest piranha, solitary and territorial. Pound for pound the strongest bite in the Amazon.",
  "translate_en|mods/PeixesBRExpansion/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Base.PeixesBR_PiranhaVioleta_Description": "A smaller piranha with a violet line. Swims in big schools — where you catch one, you catch many.",
  "translate_en|mods/PeixesBRExpansion/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Base.PeixesBR_Piranha_Description": "The famous red-bellied piranha. Razor teeth and a taste for flesh — mind your fingers when unhooking it.",
  "translate_en|mods/PeixesBRExpansion/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Base.PeixesBR_Tambaqui_Description": "The fruit-eating river giant. It feeds on fruit falling from trees — river folk catch it using fruit pits as bait.",
  "translate_en|mods/PeixesBRExpansion/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Base.PeixesBR_Tilapia_Description": "A calm omnivore, easy to catch with dough or bread. The best bait is bread.",
  "translate_en|mods/PeixesBRExpansion/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Base.PeixesBR_Traira_Description": "A voracious ambush predator of still waters. The best bait is frog meat.",
  "translate_en|mods/PeixesBRExpansion/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Base.PeixesBR_Tucunare_Description": "An aggressive predator that strikes anything resembling a small fish. The best bait is a minnow lure.",
