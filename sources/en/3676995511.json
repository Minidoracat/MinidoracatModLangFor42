  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_AutoShareSymbols": "Auto-Share Map Symbols",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_AutoShareSymbols_option1": "Everyone",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_AutoShareSymbols_option2": "Faction",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_AutoShareSymbols_option3": "Safehouse",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_AutoShareSymbols_option4": "Disabled",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_AutoShareSymbols_tooltip": "Controls who sees your map symbols and freehand drawings. Everyone = all players on the server. Faction = only your faction members. Safehouse = only your safehouse members. Disabled = vanilla manual sharing for symbols, drawings are private only.",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_MaxStrokesPerPlayer": "Max Drawings Per Player",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_MaxStrokesPerPlayer_tooltip": "Maximum freehand drawings each player can have on the shared map (5-100). Default: 30. Oldest drawings must be erased to make room for new ones. Ignored when Remove Drawing Limits is enabled.",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_MaxStrokesTotal": "Max Total Drawings",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_MaxStrokesTotal_tooltip": "Maximum total freehand drawings across all players on the server (50-1000). Default: 200. Prevents excessive storage growth on busy servers. Ignored when Remove Drawing Limits is enabled.",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_RemoveDrawingLimits": "Remove Drawing Limits (Not Recommended)",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_RemoveDrawingLimits_tooltip": "Not recommended. Ignores Max Drawings Per Player and Max Total Drawings, so players can draw without limit. Every drawing is redrawn on every player's map, so large numbers of drawings cause map lag for everyone and add server load. Default: off.",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_RequireEraserToErase": "Require Eraser to Erase",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_RequireEraserToErase_tooltip": "When enabled, players need an eraser in their inventory to use the erase tool. When disabled, anyone can erase.",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_RequirePenToDraw": "Require Pen to Draw",
  "translate_en|mods/PZShareMapNotes/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PZShareMapNotes_RequirePenToDraw_tooltip": "When enabled, players need a pen or pencil in their inventory to use freehand drawing. The drawing color matches the pen type. When disabled, anyone can draw in orange."
