  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PUR_TooWindedToDig": "You are too winded to keep digging.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PUR_TrapdoorBuilt": "Trapdoor built",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PUR_TrapdoorRemoved": "Trapdoor removed.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PUR_Worksite": "Worksite",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Moveables.json|Bunker_Worksite_Bench": "Bunker Worksite Bench",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Recipes.json|BunkerWorksiteBench": "Bunker Worksite Bench",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR": "Plysken Underground Revolution",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_AutoContinue": "Keep digging automatically",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_AutoContinue_tooltip": "One click starts a work session: your character keeps digging until the sacks are full, endurance runs out, the square is done, or you move.<br>Turning this off means one click per pass.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_BenchRange": "Worksite radius around the bench (tiles)",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_BenchRange_tooltip": "Everything this mod lets you do - digging, sinking the shaft, building the ladder, laying the hatch - has to happen within this many tiles of a worksite bench.<br>The bench sits on the surface and covers the whole column beneath it, so you never need a second one further down.<br>Raise it if you want a sprawling bunker, lower it if you want a tight one.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_ClimbEndurancePerBag": "Endurance cost per sack carried up (%%)",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_ClimbEndurancePerBag_tooltip": "Hauling soil up a ladder is the hardest part of the job.<br>Set to 0 if you would rather not think about it.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_ClimbMaxBags": "Sacks you can carry up a ladder, bare-handed",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_ClimbMaxBagsWithPack": "Sacks you can carry up a ladder, wearing a backpack",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_ClimbMaxBagsWithPack_tooltip": "With the sacks on your back your hands are free, so you can climb - and you will feel every kilo.<br>This is the number that really shapes the dig: it decides how many trips a gallery costs you.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_ClimbMaxBags_tooltip": "You climb with your hands. A sack of soil in your arms leaves you one hand, and that is already one too few.<br>1 is realistic. Set it high to ignore the whole thing.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_ClimbNoPackFactor": "Extra effort when climbing with sacks in your arms",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_ClimbNoPackFactor_tooltip": "Multiplies the endurance cost when the sacks are not on your back.<br>At 4, hauling one sack bare-handed costs as much as four in a backpack - which is about right.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_DigEndurancePerPass": "Endurance cost per digging pass (%%)",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_DigEndurancePerPass_tooltip": "The base game does not tire you when you dig. This mod does.<br>Breaking asphalt with a pickaxe costs half again as much.<br>Your character stops when endurance falls below the threshold above. Set to 0 to dig tirelessly.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_DigPassTime": "Duration of one pass",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_DigPassTime_tooltip": "Length of a single digging pass.<br>180 is about the same as filling a grave in the base game.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_DigPassesPerLevel": "Digging passes per square",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_DigPassesPerLevel_tooltip": "How many shovel passes it takes to open one square, one level down.<br>24 is realistic: a square is about 2.5 cubic metres of soil, roughly an afternoon of hand digging.<br>Lower it if you would rather build than dig.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_DigSpeedMultiplier": "Digging speed (%%)",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_DigSpeedMultiplier_tooltip": "Global speed multiplier for every digging pass.<br>Higher is faster. Set it to 500 if you only care about what you build down there.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_DirtPerPass": "Dirt per pass (%% of a sack)",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_DirtPerPass_tooltip": "How much of a sack each pass fills.<br>25 means four passes fill one sack, matching the base game's dirt sack.<br>Set to 0 and the soil simply vanishes.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_LadderSkillLevel": "Carpentry needed for the ladder",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_LadderSkillLevel_tooltip": "Carpentry level required to build the shaft ladder.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_MinEndurance": "Stop digging below this endurance (%%)",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_MinEndurance_tooltip": "Digging is heavy work. Below this endurance your character stops and catches their breath.<br>Set to 0 to dig until you drop.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_OuvrageMaterialPercent": "Building material cost (%%)",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_OuvrageMaterialPercent_tooltip": "Scales what the ladder and the trapdoor cost to build.<br>Lower it on a low-loot game where twenty nails are hard to come by.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_OuvrageTimePercent": "Building time (%%)",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_OuvrageTimePercent_tooltip": "Scales how long it takes to build - and to take apart - the ladder and the trapdoor.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_RequireBags": "Digging requires empty sacks",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_RequireBags_tooltip": "The soil you dig out has to go somewhere.<br>When every sack you carry is full, you must empty one before you can keep digging.<br>Turn this off for a lighter experience.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_RoadPasses": "Passes to break through asphalt",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_RoadPasses_tooltip": "How many pickaxe passes it takes to break a road or pavement surface before you can dig the soil underneath.<br>A shovel will not do.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_TrapdoorSkillLevel": "Carpentry needed for the trapdoor",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_TrapdoorSkillLevel_tooltip": "Carpentry level required to build the trapdoor that closes the shaft.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_UndergroundTempEnabled": "Underground stays temperate",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PUR_UndergroundTempEnabled_tooltip": "A dug gallery is thermally stable: cool in summer, mild in winter.<br>Turn this off and your bunker follows the weather outside.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PUR_CarryingSacks": "Carrying %1/%2 sacks of soil.<br>Hauling them up will cost you.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PUR_ClearGroundFirst": "Clear the ground before you can start digging.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PUR_CloseTrapdoor": "Shut it. Nothing falls in once it is closed - not you, not them.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PUR_DigPassInfo": "About %1s per pass.<br>Each pass fills %2 of a sack.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PUR_HandsFree": "Your hands are free.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PUR_LockTrapdoor": "Slide the latch across. It keeps people out, not the dead.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PUR_OpenTrapdoor": "Swing it open to reach the ladder. Anything can fall in while it is open.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PUR_RemoveTrapdoor": "Take it apart. You get the hinges, the knob and half the planks back - the nails are bent. The shaft opens up again.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PUR_TrapdoorIsLocked": "It is locked. Unlock it first.",
  "translate_en|mods/Plysken Underground Revolution/42.1/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PUR_UnlockTrapdoor": "Slide the latch back."
}
