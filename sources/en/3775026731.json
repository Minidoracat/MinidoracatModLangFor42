  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Wounds_TOCDirtyness": "Wound dirtiness",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Wounds_Tab": "Condition",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Wounds_TooMuch": "Too much - another dose will poison you.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Wounds_TrimBlade": "Requires a scalpel or scissors",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Wounds_TrimSkill": "Requires First Aid 2",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Wounds_Unexamined": "Something is wrong here.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Wounds_VBurn": "Burn",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/ItemName.json|Wounds.BloodBag": "Blood collection bag",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/ItemName.json|Wounds.BloodBagUsed": "Used blood bag",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/ItemName.json|Wounds.BloodBag_ABN": "Blood collection bag (AB-)",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/ItemName.json|Wounds.BloodBag_ABP": "Blood collection bag (AB+)",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/ItemName.json|Wounds.BloodBag_AN": "Blood collection bag (A-)",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/ItemName.json|Wounds.BloodBag_AP": "Blood collection bag (A+)",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/ItemName.json|Wounds.BloodBag_BN": "Blood collection bag (B-)",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/ItemName.json|Wounds.BloodBag_BP": "Blood collection bag (B+)",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/ItemName.json|Wounds.BloodBag_ON": "Blood collection bag (O-)",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/ItemName.json|Wounds.BloodBag_OP": "Blood collection bag (O+)",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/ItemName.json|Wounds.BloodBag_X": "Blood collection bag (untested)",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/ItemName.json|Wounds.BloodTypingKit": "Blood typing kit",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/ItemName.json|Wounds.TransfusionKit": "Transfusion set",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul": "Wounds Overhaul",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_AntibioticCourse": "Antibiotic course length:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_AntibioticCourse_tooltip": "How much cover it takes to beat an infection. 1.0 is 48 hours - three antibiotics back to back, the balance the mod was built around.<br>Lower it on a world where medicine is scarce: 0.66 makes it a two-pill course, 0.33 a single one. Higher makes a cure a project.<br>It does not change how fast the illness climbs - that is the sepsis speed setting.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_AxialFractureEnabled": "Chest and head fractures need rest",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_AxialFractureEnabled_tooltip": "Ribs, a skull, a pelvis - the fractures a splint cannot reach. On: sitting down mends them measurably faster, running on them hurts, sets the bone back and drains you; painkillers dull it. Off: they heal on vanilla's flat timer, untouched by anything you do.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_BloodLossEnabled": "Blood loss:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_BloodLossEnabled_tooltip": "Heavy bleeding leaves the survivor weak for days after the cut is dressed.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_BloodWarmHours": "Blood keeps outside a fridge (hours):",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_BloodWarmHours_tooltip": "How many in-game hours drawn blood stays usable while warm. Real blood banks allow 4; the default is 8 so a trip home is possible.<br>A powered fridge stops the clock, a cooler slows it six times, winter air at 6 C or below keeps blood that is not being carried on a body.<br>A freezer ruins whole blood.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_CoveredWoundsHidden": "Bandages hide the wound:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_CoveredWoundsHidden_tooltip": "A bandaged limb shows only the bandage, a broken bone, and whether it hurts. The kind of wound, stitches and infection stay hidden until the dressing comes off.<br>What was examined before is remembered: removing the bandage shows it without a new examination.<br>Off: wounds read through the bandage as before.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_ExamineScalesWithFindings": "Examination time follows severity",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_ExamineScalesWithFindings_tooltip": "On: what the finding IS decides the time - a scratch is read at a glance, a laceration or a bite is real work. Two deep wounds' worth is a full examination.<br>Off (the default): every examination takes the flat time set by skill and the speed slider, however much or little there is to find.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_ExamineSpeed": "Examination speed:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_ExamineSpeed_tooltip": "How quickly an examination is carried out. Higher is faster.<br>First Aid still shortens it on top of this.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_FractureEnabled": "Open fractures:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_FractureEnabled_tooltip": "A broken bone under an open wound worsens while unsplinted and feeds the infection.<br>Arms and legs only.<br>Also needs the Bone Fracture option enabled, or nothing can break in the first place.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_GateMiniHealthPanel": "Quick health panels wait for the examination",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_GateMiniHealthPanel_tooltip": "Only matters with Mini Health Panel or Mini Health Plus installed. Their floating window offers treatment without an examination, which walks around this mod's central rule.<br>On: their menu is held on an unexamined limb, same as this mod's own panel.<br>Off: their panel stays a fast lane - on some servers a neck wound is a matter of seconds, and one screen too many before a bandage can be a death.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_MedicalItemsEnabled": "Blood transfusion and medical items:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_MedicalItemsEnabled_tooltip": "Turns on the blood part of the mod: drawing blood, transfusion, blood groups, typing and crossmatching - and puts the supplies for it in hospital and clinic loot: blood collection bags (single-use, the only vessel blood goes into), a transfusion set and a blood typing kit.<br>OFF by default. While off, none of it is offered and none of the items ever spawn - the mod stays pure Lua and can be removed at any time.<br>Turning it on lets mod items into your save.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_MedicalItemsRate": "Medical item frequency:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_MedicalItemsRate_tooltip": "Multiplies how often blood bags, transfusion sets and typing kits turn up in clinic and medical storage loot. 1.0 is the mod's own rate, 0.5 half as often, 2.0 twice - 0 removes them from loot entirely.<br>Only matters while the switch above is on.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_NeckSkipsExamination": "The neck needs no examination:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_NeckSkipsExamination_tooltip": "A cut throat empties a survivor in well under a minute, and an untrained character spends twelve seconds looking before they are allowed to touch it.<br>On: the neck can be treated on sight, like vanilla.<br>Off: it waits for an examination like every other limb.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_PixelArt": "Pixel-art wounds:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_PixelArt_tooltip": "Draws the wound close-ups - the examination panel and the stitching minigame - in a pixelated style that sits with the game's own look, instead of the drawn originals.<br>The wounds, the aim marks and everything they do stay exactly the same; only the rendering changes.<br>Off by default.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_PoisoningEnabled": "Poisoning and organ damage:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_PoisoningEnabled_tooltip": "Taking more medicine than the body can clear makes you ill for far longer than the overdose itself lasts, and leaves a mark on the liver and kidneys.<br>Alcohol on top of a course of medicine is much harder on the liver than alcohol alone.<br>Water helps: a hydrated survivor clears an overdose about twice as fast, and healthy kidneys are what makes that work.<br>Turned off, medicine behaves as it did before this was added - an overdose still makes you sick while it lasts, but nothing accumulates.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_RequireExamination": "Examination covers:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_RequireExamination_option1": "Everything",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_RequireExamination_option2": "Only what you cannot feel",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_RequireExamination_option3": "Nothing",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_RequireExamination_tooltip": "The body always shows where it hurts and how badly. This decides how much of the naming an examination has to do first - and First Aid decides how fast and how detailed that examination is.<br>Everything: nothing is named until you look, treatment included.<br>Only what you cannot feel: an injury you watched happen is named at once, and looking is for infection, dirt and how far it has got.<br>Nothing: everything is named straight away, the way vanilla does it.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_SepsisEnabled": "Sepsis:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_SepsisEnabled_tooltip": "An untreated wound infection reaches the bloodstream and kills.<br>Antibiotics work as a course over days, not as a single pill.<br>Turned off, wound infection behaves as it does in vanilla.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_SepsisSpeed": "Sepsis speed:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_SepsisSpeed_tooltip": "How fast an infection takes hold and climbs. 1.0 is the balance the mod was built around: untreated, the first symptoms arrive after about twelve hours and it kills in roughly three days.<br>Lower is milder. It never makes the body recover faster, only the illness slower.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_SutureGameEnabled": "Stitch wounds by hand:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_SutureGameEnabled_tooltip": "On: stitching opens a close-up of the wound and you place each stitch yourself - the needle goes in one side and out the other, and how well it is done is up to you. First Aid decides how steady your hand is; a surgical needle forgives more than a sewing one. A poor closure can tear open when you run.<br>Off: stitching works exactly as it does in vanilla, decided by a dice roll behind the scenes.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_TreatmentNeedsExam": "Treatment waits for the examination",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_TreatmentNeedsExam_tooltip": "On the strictest examination setting, a limb cannot be treated until it has been examined - you cannot bandage what you have not looked at.<br>Turn this off to keep the naming behind an examination while letting first aid go ahead: you can dress a wound in a hurry and find out what it is later, somewhere safer.<br>Has no effect on the other two examination settings, where nothing was held back to begin with.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_WalkingExamSkill": "First Aid needed to examine while walking:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_WalkingExamSkill_tooltip": "Below this First Aid level an examination roots the character in place. 0 allows walking from the start, 10 never.<br>Legs, feet and groin always require standing still - that is anatomy, not skill.",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_XpRate": "First Aid experience from this mod:",
  "translate_en|mods/WoundsOverhaul/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundsOverhaul_XpRate_tooltip": "Multiplies the experience the mod's OWN work pays: examining a limb, trimming a laceration, drawing blood, crossmatching, running a transfusion. 1.0 is the mod's own rate, 0 pays nothing for them.<br>Stitching and bandaging are the game's own awards and are left alone - move those with the world's XP multiplier."
}
