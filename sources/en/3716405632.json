{
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Cataclysm_1": "Fuck, fuck, fuck... I really don't like the sound of that.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Cataclysm_2": "Shit... sounds like the whole city is coming for my ass.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Cataclysm_3": "God damn it, why right now? Fight them or run?",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Cataclysm_4": "No. That's not a horde. That's a fucking wall of dead.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Cataclysm_5": "This sounds like grave trouble. Should've written a will earlier.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Cataclysm_6": "Fuuuuuuck! I'll need a good bottle of whiskey after this... if I survive.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Normal_1": "Fuck... I hear a horde nearby. I think they're coming here.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Normal_2": "Shit. That's not just wandering. They're heading this way!",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Normal_3": "Great. A whole damn crowd, and of course they found me.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Normal_4": "I hear them. Too many footsteps... way too close.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Normal_5": "I heard something over there. I should stay careful.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Normal_6": "Goddamn wanderers. Why can't you just die? Oh, right. They're already dead.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Normal_7": "Yeah, fuckers! Come and get me!",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Normal_8": "I like company, but not that sort of company.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Normal_9": "Hey... I know that one. Gotta give them a proper burial.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Wandering_1": "Hold on... that's a moving horde. Maybe I can stay quiet.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Wandering_2": "Shit. They're passing through. Don't make a sound.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Wandering_3": "That's a lot of dead on the move. Better let them pass.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Wandering_4": "Keep it quiet... maybe they won't notice me.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Wandering_5": "That's my neighborhood. Hope they don't stay long. Better not provoke them.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_DHE_Speech_Wandering_6": "Is there a parade or what? I don't feel like joining. Better stay quiet.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents": "Dynamic Horde Events",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_AttractionRadius": "Zombie attraction radius",
