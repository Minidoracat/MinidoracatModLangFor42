  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_CataclysmIndicatorSeconds": "Cataclysm indicator duration, seconds",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_CataclysmMaxDays": "Maximum days before cataclysm horde",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_CataclysmMaxDays_tooltip": "Used only in Random interval mode. The rolled deadline is persistent across restarts.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_CataclysmMaxSpawnRadius": "Cataclysm maximum spawn radius, tiles",
