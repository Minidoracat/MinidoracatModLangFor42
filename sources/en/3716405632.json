  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_CataclysmPursuitHours": "Cataclysm pursuit duration, game hours",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_CataclysmPursuitHours_tooltip": "How many in-game hours cataclysm zombies should keep directly pursuing the selected player. After this, the mod stops reinforcing the direct target.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_CataclysmScheduleMode": "Cataclysm schedule mode",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_CataclysmScheduleMode_tooltip": "Random interval uses the minimum and maximum day settings. Fixed mode uses the fixed interval in days and fixed hour. The selected deadline survives save and server restarts.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_CataclysmScreenEffectSeconds": "Cataclysm screen effect duration, seconds",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_CataclysmWeatherDurationHours": "Cataclysm weather duration, hours",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_CataclysmWeatherDurationHours_tooltip": "How long the cataclysm weather event should last. The mod first tries a tropical storm, then falls back to storm, rain, lightning, and custom weather calls if needed.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_CataclysmWindIntensity": "Cataclysm wind intensity",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_CataclysmWindIntensity_tooltip": "Wind intensity forced during cataclysm weather. 0 disables extra wind, 1 is maximum wind.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_CooldownHours": "Cooldown after horde event, hours",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_Debug": "Enable debug logging",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_DebugPage": "Dynamic Horde Events - Debug",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_DisableAtNight": "Disable normal horde events at night",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_DisableAtNight_tooltip": "Applies only to the normal horde. If its persistent deadline occurs during the configured night window, that occurrence is skipped and the next one is scheduled.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableCataclysmFogWind": "Force fog and wind during cataclysm weather",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableCataclysmFogWind_tooltip": "Adds climate overrides on top of the tropical storm: fog, strong wind, heavy clouds and desaturation. Overrides are reset after the cataclysm weather duration.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableCataclysmHorde": "Enable cataclysm horde event",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableCataclysmHordeSpeech": "Enable cataclysm horde survivor lines",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableCataclysmHordeSpeech_tooltip": "When a cataclysm horde event starts, the player character says a more intense random warning line above their head.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableCataclysmHorde_tooltip": "Enables a rare ultra-hardcore horde event with its own timer and warning indicator.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableCataclysmPursuit": "Enable cataclysm direct pursuit",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableCataclysmPursuit_tooltip": "When enabled, zombies spawned by a cataclysm horde are forced to pursue the selected player directly. The cataclysm attraction sound is still emitted.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableCataclysmScreenEffect": "Enable cataclysm red screen effect",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableCataclysmWeather": "Enable cataclysm storm weather",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableCataclysmWeather_tooltip": "Attempts to force severe weather when a cataclysm horde starts.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableDebugContextMenu": "Enable right-click debug menu",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableDebugHotkey": "Enable debug hotkeys",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableDirectionIndicator": "Show direction indicators for all hordes",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableDirectionIndicator_tooltip": "Controls the direction indicator for normal, wandering and cataclysm hordes. The all-notifications master switch can disable every player-facing warning at once.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableEventNotifications": "Enable all horde event notifications",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableEventNotifications_tooltip": "Master switch for player-facing warnings from real events: direction indicators, warning audio, survivor lines and the cataclysm screen effect. Gameplay attraction sounds used by zombie AI are not disabled.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableMPActiveSpawnClamp": "Keep MP sound-driven spawns active",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableMPActiveSpawnClamp_tooltip": "In multiplayer, clamps normal and wandering horde spawn distance so freshly spawned zombies stay in the active simulation area and can hear the single attraction sound.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableNormalHorde": "Enable normal horde event",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableNormalHordePathAssist": "Assist normal horde pathfinding",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableNormalHordePathAssist_tooltip": "Requires normal horde target tracking. Periodically asks spawned normal horde zombies to rebuild a path to the selected player, which can help with high fences and different floors. This uses no extra sound pulses, but can make normal hordes more direct and slightly increase server AI work.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableNormalHordePursuit": "Keep normal horde targeting player",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableNormalHordePursuit_tooltip": "When enabled, zombies spawned by a normal horde keep periodically refreshing their target, aggro, and last-heard position to the selected player while they are alive. The normal attraction sound is still emitted, but this does not create extra sound pulses or cataclysm catch-up respawns.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableNormalHordeSpeech": "Enable normal horde survivor lines",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableNormalHordeSpeech_tooltip": "When a normal horde event starts, the player character says a short random warning line above their head.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableNormalHorde_tooltip": "Enables the scheduled regular horde event. Cataclysm and wandering hordes have their own toggles and are not affected by this setting.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableWanderingHorde": "Enable wandering horde event",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableWanderingHordeSpeech": "Enable wandering horde survivor lines",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableWanderingHordeSpeech_tooltip": "When a wandering horde event starts, the player character says a short random line about staying quiet or letting the horde pass.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableWanderingHorde_tooltip": "Enables a separate passing horde event. The horde spawns on one side of the player and is attracted toward a point beyond the player area, so it may pass by if you stay quiet.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableWarningSound": "Play warning sounds for all hordes",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_EnableWarningSound_tooltip": "Controls audible player warnings for normal, wandering and cataclysm hordes. This does not disable the inaudible world-sound event used to attract zombie AI.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_Enabled": "Enable Dynamic Horde Events (global)",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_Enabled_tooltip": "Master switch for Dynamic Horde Events. While disabled, persistent event timers are paused instead of being rerolled. Use the per-event toggles below to disable only one horde type.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_General": "Dynamic Horde Events - General",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_IndicatorSeconds": "Indicator duration, seconds",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_MP": "Dynamic Horde Events - Multiplayer & Spawning",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_MPActiveSpawnMaxRadius": "MP active spawn max radius, tiles",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_MPActiveSpawnMaxRadius_tooltip": "Maximum spawn distance for normal and wandering hordes in multiplayer when active spawn clamp is enabled. Higher values can spawn zombies outside active AI range, causing them to ignore the attraction sound.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_MPAttractionDelaySeconds": "MP attraction delay, seconds",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_MPAttractionDelaySeconds_tooltip": "Delay before the single attraction sound is emitted after spawning zombies in multiplayer. Values below 6 seconds may fail to attract spawned MP zombies. Increase this if the server has high load",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_MaxSpawnHours": "Maximum hours before horde event",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_MaxSpawnHours_tooltip": "Used only in Random interval mode. The rolled deadline is persistent and is not rerolled when the save or server is restarted.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_MaxSpawnRadius": "Maximum spawn radius, tiles",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_MaxZombies": "Maximum zombies per horde",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_MinSpawnHours": "Minimum hours before horde event",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_MinSpawnHours_tooltip": "Used only in Random interval mode. The rolled deadline is persistent and is not rerolled when the save or server is restarted.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_MinSpawnRadius": "Minimum spawn radius, tiles",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_MinZombies": "Minimum zombies per horde",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_NightEndHour": "Night end hour",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_NightStartHour": "Night start hour",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_Normal": "Dynamic Horde Events - Normal Horde",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_NormalFixedHour": "Normal fixed event hour",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_NormalFixedHour_tooltip": "Used only in Fixed days and hour mode. Uses the 24-hour clock: 22 means 10:00 PM. The event runs on the first scheduler check at or after this hour.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_NormalFixedIntervalDays": "Normal fixed interval, days",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_NormalFixedIntervalDays_tooltip": "Used only in Fixed days and hour mode. For example, 7 triggers a normal horde every seven in-game days.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_NormalScheduleMode": "Normal horde schedule mode",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_NormalScheduleMode_tooltip": "Random interval uses the minimum and maximum hour settings. Fixed mode uses the fixed interval in days and fixed hour. The selected deadline is stored in the save and survives restarts.",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_ScalingInterval": "Scaling interval",
  "translate_en|mods/DynamicHordeEvents/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_DynamicHordeEvents_ScalingInterval_tooltip": "How many days or months must pass before the horde size multiplier increases.",
