  "translate_en|mods/SauceTooltips/42/media/lua/shared/Translate/EN/UI.json|UI_ST_OptRangeTooltip": "Base distance in tiles for object tooltip visibility",
  "translate_en|mods/SauceTooltips/42/media/lua/shared/Translate/EN/UI.json|UI_ST_OptRequireLOS": "Require line of sight",
  "translate_en|mods/SauceTooltips/42/media/lua/shared/Translate/EN/UI.json|UI_ST_OptRequireLOSTooltip": "Hide world object tooltips when a wall blocks the view, so you can no longer read the contents of a fridge through the side of a house. Uses the visibility the game already computes for lighting, so it costs nothing. Turn off for x-ray tooltips. (Applies live.)",
