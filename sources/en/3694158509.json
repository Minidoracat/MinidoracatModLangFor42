  "translate_en|mods/SauceTooltips/42/media/lua/shared/Translate/EN/UI.json|UI_ST_OptDress": "Dressed tooltips (kraft card)",
  "translate_en|mods/SauceTooltips/42/media/lua/shared/Translate/EN/UI.json|UI_ST_OptDressTooltip": "Dress every tooltip in the kraft label card: accent rail, dot leaders, section rules, chrome gauges. Turn off for the plain vanilla box. When Sauce Inventory Rendering is installed its card takes over automatically. (Applies live.)",
  "translate_en|mods/SauceTooltips/42/media/lua/shared/Translate/EN/UI.json|UI_ST_OptModName": "Sauce Tooltips",
  "translate_en|mods/SauceTooltips/42/media/lua/shared/Translate/EN/UI.json|UI_ST_OptRangeDesc": "How far away you can see detailed tooltip info for world objects. Close objects (shelves, fridges) use 60%% of this range. Fire/smoke sources use 150%%.",
