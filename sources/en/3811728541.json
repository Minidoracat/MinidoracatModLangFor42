  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens": "Real Vehicle Interiors",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_FurnitureInWorld": "RV furniture as loot",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_FurnitureInWorld_tooltip": "Now and then RV furniture turns up in camping stores, carpentry and tool crates and garages.",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_FurnitureLoot": "Loot in RV furniture",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_FurnitureLoot_tooltip": "Fridges, kitchenettes, cabinets, wardrobes, washrooms, dinettes and beds in new vehicles hold loot like their counterparts in houses.",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_GeneratorFuelUse": "Camper generator fuel use",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_GeneratorFuelUse_tooltip": "Multiplies the petrol the camper's generator burns (1 = 0.8 litres an hour).",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_GeneratorWear": "Camper generator wear",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_GeneratorWear_tooltip": "Multiplies how fast the camper's generator wears out while running (0 = never).",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_LooseWhileDriving": "Loose items while driving",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_LooseWhileDriving_option1": "They stay put",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_LooseWhileDriving_option2": "They fall in crashes",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_LooseWhileDriving_option3": "They fall in crashes and hard braking",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_LooseWhileDriving_tooltip": "What stands on the counters, tables, beds and wheel wells of a vehicle can fall to the floor when it is thrown about. Nothing breaks and nothing leaves the vehicle.",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_PropaneAppliances": "Stove and heater burn propane",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_PropaneAppliances_tooltip": "The kitchenette's stove and the heater burn the game's propane tanks (put them in at the dashboard or the piece), and the generator is for the fridge and the battery. Off: they run on the generator, as in earlier versions. A vehicle starts with a little propane.",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_RainFillsTank": "Rain fills the water tank",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_RainFillsTank_tooltip": "A vehicle standing outside collects rain in its water tank, as tainted water like a rain barrel's (boil it before drinking).",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_ShorePower": "Shore power from a generator beside it",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_ShorePower_tooltip": "A generator running within a few tiles of a vehicle powers its fridge, and its stove and heater when they do not burn propane.",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_StartFurnished": "Vehicles start furnished",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MELens_StartFurnished_tooltip": "New campers come with RV furniture, buses with bus seats. Off: they start empty and you build or find the furniture. Box trucks always start with their boxes.",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_MELensRV_Box": "A cargo box. Inside a box truck, use Place furniture to set it down where it fits; boxes stack two high.",
  "translate_en|mods/RealVehicleInteriors/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_MELensRV_Furniture": "RV furniture. Inside a walk-in camper or bus, right-click an empty place along a wall to place it, or use Place furniture."
}
