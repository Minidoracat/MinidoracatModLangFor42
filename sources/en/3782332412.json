  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Icon_VHS": "V H S",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Icon_Waves": "Waves",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Icon_Wrench": "Wrench",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Icon_X": "X",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_MarkComplete": "Mark buildings with nothing left behind",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_MarkComplete_tt": "A building where no closed container is left in any room gets a checkmark instead of an X.<br>So the X means \"been here\" and the checkmark means \"nothing left behind\".<br>Rooms with no containers at all count as done. The swap happens the next time you open the map.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_MarkScale": "Mark size (%)",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_MarkScale_tt": "How big a mark is drawn, as a percentage of a symbol you place by hand.<br>The default is smaller than yours on purpose: in a dense neighbourhood -- a residential block, a row of townhouses -- full-size marks touch each other and the map stops being readable.<br>A building's mark sits on the building; the valuable-find mark is drawn SMALLER, hanging off its top-right corner, so the two never cover each other.<br>Changing this redraws every mark of the mod the next time you open the map.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_MarkVehicles": "Mark vehicles with fuel",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_MarkVehicles_tt": "Marks a car you inspected -- sat in, or opened the hood -- that still had fuel when you walked away.<br>A car merely seen from outside is never marked: you had no way to know.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_MaxMarks": "Maximum marks",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_MaxMarks_tt": "A ceiling on how many buildings this mod will ever draw.<br>The map recalculates the position of every symbol each time you zoom or drag, so thousands of them make the map sluggish.<br>Progress keeps being tracked past the ceiling; only the drawing stops.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_MinRooms": "Rooms needed for an X",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_MinRooms_tt": "How many rooms must count before the building gets an X.<br>One is too few: you can walk through a single room without searching anything.<br>Buildings with fewer rooms than this only need all of theirs, so sheds still get marked.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_N3WODesc": "These two options only do anything with the N3WO Map Overhaul mod installed. That mod knows the NAME of 949 buildings across Knox County; this one knows what you did inside them. Together the mark stops being an anonymous X.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_N3WONotify": "Say on screen what was marked",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_N3WONotify_tt": "A note across the top of the screen when a building is marked, or a valuable is left behind -- with the building's name when N3WO knows it.<br>This mod is otherwise invisible until you open the map: writing on the map needs the map screen open, and there is no way around that.<br>A name you have not discovered yet is never revealed: the mod does not tell you what you do not know.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_N3WOOnlyPOI": "Only mark named buildings",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_N3WOOnlyPOI_tt": "Turns the mod inside out: instead of marking every house you searched, it marks only the places N3WO has a name for -- shops, stations, clinics.<br>In a long Louisville save this is the difference between a readable map and an X over every house.<br>Does nothing without N3WO installed: with no list of names, no building would ever be marked.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_N3WOTitle": "N3WO Map Overhaul",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_N3WOUsePins": "Marks as N3WO points, not map symbols",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_N3WOUsePins_tt": "Puts every mark on N3WO's own point layer instead of drawing a map symbol.<br>You gain: the building's NAME on hover, a colour per kind of mark, the map's search box finding them, and one button to hide them all.<br>You lose: marks on the MINIMAP, marks when zoomed out past N3WO's threshold, and moving or erasing them with the map's own tools.<br>Turn it off and every mark goes back to being a symbol -- the swap happens the next time you open the map, in both directions, and nothing is left behind.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_N3WO_Building": "this building",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_N3WO_Complete": "Nothing left behind: %1",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_N3WO_Find": "%1 left behind at %2",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_N3WO_Searched": "Searched: %1",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Pin_Complete": "Nothing left behind",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Pin_Loot": "Something valuable",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Pin_Searched": "Searched",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Pin_Vehicle": "Fuel in the tank",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_RareDesc": "Marks a building where you SAW something valuable and left it. Only what you actually opened counts -- a generator in a cupboard you never opened is not marked, because you do not know it is there.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_RareTitle": "Rare finds",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Axe": "Axe",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Axe_tt": "Wood, doors, and a decent weapon in one item.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Blade": "Machete or katana",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Blade_tt": "The two melee weapons worth a trip back.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_BlowTorch": "Blowtorch",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_BlowTorch_tt": "The whole metalworking tree depends on it.<br>A spent one is never marked.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_CarBattery": "Car battery",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_CarBattery_tt": "Turns an abandoned car into a working one.<br>A dead battery is never marked.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Crowbar": "Crowbar",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Crowbar_tt": "The best durability-to-damage melee weapon in the game.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Firearm": "Firearm",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Firearm_tt": "Shotgun, pistol, rifle -- any of them.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_FishingRod": "Fishing rod",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_FishingRod_tt": "Food that does not fight back.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Generator": "Generator",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Generator_tt": "The single most valuable find in the game.<br>Also marks generators already placed in the world.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_HamRadio": "Ham radio",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_HamRadio_tt": "Long range information, and the only way to hear another survivor.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Medicine": "Antibiotics and sutures",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Medicine_tt": "The things that save a character you were about to lose.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_PropaneTank": "Propane tank",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_PropaneTank_tt": "Feeds the blowtorch, and makes bombs.<br>An empty tank is never marked.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Recipe": "Recipe magazine",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Recipe_tt": "Schematics and engineer magazines: they teach what XP does not.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Saw": "Saw",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Saw_tt": "A prerequisite for most of carpentry.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Seeds": "Seeds",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Seeds_tt": "Only matters if you farm -- turn it off if you do not.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_SewingKit": "Sewing kit",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_SewingKit_tt": "Clothing repair, and the padding that stops bites.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Sledgehammer": "Sledgehammer",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Sledgehammer_tt": "Demolition. Without one, half the map's walls are permanent.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Tarp": "Tarp",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Tarp_tt": "Tents, rain collectors, and covered storage.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Trap": "Cage trap",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Trap_tt": "Quiet, renewable meat.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Welding": "Welding gear",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Rare_Welding_tt": "Mask and rods -- the pair the blowtorch needs.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_RequireWritingTool": "Require a pen or pencil",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_RequireWritingTool_tt": "You can only draw on a map with something to write with, so neither can this mod.<br>Progress is still tracked without one: find a pencil and the missing marks appear the next time you open the map.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_RoomSeconds": "Seconds per room",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_RoomSeconds_tt": "How long you must spend in a room for it to count as searched -- unless you open a container there, which counts it instantly.<br>Together these stop a building from being marked because you ran through it fleeing a horde: nobody opens cupboards while running away.<br>Real seconds, not in-game ones. Time spent sprinting never counts.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_ShareDesc": "Put a mark on the map for your group, and tell at a glance who can see it. On the map screen, bottom left, the \"Share\" button picks who; then take an icon from the normal palette and click. The mark comes out already coloured and synced -- PINK for your party, TEAL for your safehouse, ORANGE for the whole server. The game's own five pen colours stay private, yours only. Server only: in single player the button is not there.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_ShareTitle": "Multiplayer: sharing marks",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Share_Button": "Automark - Share: %1",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Share_NoFaction": "you are not in a party",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Share_NoSafehouse": "you have no safehouse",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Share_NoServer": "single player",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Share_Tooltip": "Who sees the next mark you place. Click to change.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Share_everyone": "The whole server",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Share_faction": "Party",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Share_safehouse": "Safehouse",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Share_self": "Just me",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_SkipSafehouse": "Never mark a safehouse",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_SkipSafehouse_tt": "Your own base is not loot, and an X over it is noise.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_VehicleFuelMin": "Minimum fuel to mark (%)",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_VehicleFuelMin_tt": "Below this, the tank is not worth a trip back with a gas can.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_VehicleTitle": "Vehicles",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAutoMark": "AutoMark — Looted Places",
