{
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Debug": "Write a diagnostic log",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Debug_tt": "Logs to console.txt what the mod decides about each room and building.<br>For bug reports: turn it on, reproduce the problem, and send the file.<br>Costs one line per event, nothing per frame.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Enable": "Enable automatic marks",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_Enable_tt": "Draws on your world map by itself as you search buildings.<br>Turn off and nothing new is ever drawn; marks already on the map stay.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_HideServerWide": "Hide marks shared with the whole server",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_HideServerWide_tt": "On a busy public server, the orange marks -- the ones somebody shared with EVERYONE -- become noise.<br>This hides only those. What your party and your safehouse shared stays visible.<br>Nothing is deleted. Turn it back off and they all return the next time you open the map.<br>The game has a blunter version of this in the map's own options, \"Remote Symbols\", which hides every mark from every other player at once.",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_IconComplete": "Icon: nothing left behind",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_IconOf": "    icon",
  "translate_en|mods/MNAutoMark/42/media/lua/shared/Translate/EN/UI.json|UI_MNAM_IconPick_tt": "Which of the game's own map symbols this mark uses.<br>Change it any time: the next map you open redraws every mark of this kind with the new icon.",
