  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_DisorganizedGridPenalty": "Disorganized Trait: Grid Size Penalty",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_DisorganizedGridPenalty_tooltip": "Removed from the width AND height of everything a Disorganized character is carrying. No grid ever shrinks below 1x1. Set to 0 to make the trait not affect inventory space.",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_EnableGravity": "Gravity Mode",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_EnableSearch": "Enable Search Mode",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_EncumbranceSlow": "Slow Down When Overencumbered",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_EncumbranceSlow_tooltip": "Carrying more than 50 weight slows you down, scaling up to half speed. Turn off if you want grid space to be the only limit.",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_EnforceCarryWeight": "Enforce Vanilla Container Capacity",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_ItemTransferSpeedMultiplier": "Transfer Speed Multiplier",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_ItemWeightMultiplier": "Item Weight Multiplier",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_ItemWeightMultiplier_tooltip": "The only weight setting. Every item is multiplied by it - every item, from a nail to a fridge, including items from other mods. At 0.10 things weigh a tenth of normal, so your grid fills up long before you get encumbered while heavy things stay heavier than light ones. 0.01 is near-weightless. 1.0 turns it off and gives you vanilla weights. This never changes how many slots anything takes: footprints always come from the item's original weight.",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_OrganizedGridBonus": "Organized Trait: Bonus Grid Size",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_OrganizedGridBonus_tooltip": "In this mod the Organized trait grants grid space instead of carry weight. Added to the width AND height of everything the character is carrying. Set to 0 to make the trait not affect inventory space.",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_PocketGridBonus": "Clothing Pocket Size Bonus",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_PocketGridBonus_tooltip": "Added to the width AND height of every pocket on worn clothing, and to your character's own body slots. Pockets are tiny 1x1 grids, so each +1 multiplies what they hold: 0 = 1 slot per pocket (base mod), 1 = 4, 2 = 9. LOWER THIS if trousers holding 16+ items feels unrealistic. Set to 0 for vanilla Inventory Tetris.",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_PreventTardisStacking": "Prevent Infinite Container Stacking",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_SearchBodies": "Corpse Search",
