  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_UseItemTransferTime": "Item Transfer Time",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_WorldGridBonus": "World Container Size Bonus",
