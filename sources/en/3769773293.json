  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_BagGridBonus_tooltip": "Added to the width AND height of every carried container: backpacks, bags, purses, cases. A 6x4 bag holds 24 at 0, 35 at 1, 48 at 2. Set to 0 for vanilla Inventory Tetris.",
  "translate_en|mods/INVENTORY_TETRISP_MP/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_InventoryTetris_BonusGridSize": "Bonus Grid Size (all containers)",
