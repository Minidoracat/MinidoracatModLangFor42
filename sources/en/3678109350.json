  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop": "Chopper Drop",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_AlertEnabled": "Enable Screen Alerts",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_AlertEnabled_tooltip": "Show supply drop events as large centered text on screen (like admin server messages).",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_AlertMessageEnd": "Alert Message — Drop Ended",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_AlertMessageEnd_tooltip": "Message shown on screen when a supply drop expires or is removed.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_AlertMessageStart": "Alert Message — Drop Started",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_AlertMessageStart_tooltip": "Message shown on screen when a supply drop is announced. Use {x} and {y} for drop coordinates.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_CallAirdropCooldown": "Request Airdrop Cooldown (minutes)",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_CallAirdropCooldown_tooltip": "Minimum minutes after any supply drop ends before a player can call a new airdrop. Uses the same time mode as Event Frequency. Set to 0 for no cooldown.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_CallAirdropEnabled": "Enable Request Airdrop",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_CallAirdropEnabled_tooltip": "Allow players to use a fully charged radio to call in an immediate supply drop. The radio is destroyed after use.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_ChopperLeaveRadius": "Chopper Leave Radius (tiles)",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_ChopperLeaveRadius_tooltip": "How close a player must get to the crate for the helicopter to leave (5–50 tiles). Only used when 'Chopper Leaves on Arrival' is enabled. Smaller = chopper stays longer (player must be right on top of the crate). Larger = chopper leaves earlier (as soon as anyone is in visual range).",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_ChopperLeavesOnArrival": "Chopper Leaves on Arrival",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_ChopperLeavesOnArrival_tooltip": "When enabled, the helicopter flies off the moment a player reaches the drop zone — rotor sound stops and zombies are no longer attracted to the area. The crate remains until despawn. Lets players push through the horde and reclaim the area instead of fighting an endless siren.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_ChopperPattern": "Chopper Pattern",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_ChopperPattern_option1": "Static",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_ChopperPattern_option2": "Orbit",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_ChopperPattern_tooltip": "How the helicopter sound moves at the drop site. Static keeps it fixed on the crate. Orbit makes it circle around the drop site, spreading zombies out instead of stacking them on one spot.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_DespawnTimer": "Despawn Timer (minutes)",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_DespawnTimer_tooltip": "Minutes before an uncollected supply crate disappears. Uses the same time mode as Event Frequency.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_Enabled": "Enable Supply Drops",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_Enabled_tooltip": "Master kill switch. When disabled, NO drops occur — random, radio, or admin.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_EventFrequency": "Event Frequency (minutes)",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_EventFrequency_tooltip": "Minutes between supply drop events. In Real Time mode this is wall-clock minutes. In Game Time mode this is in-game minutes.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_HelicopterVolume": "Helicopter Volume (%)",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_HelicopterVolume_tooltip": "Volume of the helicopter sound as a percentage. 100 = full volume, 0 = silent. The game's SFX slider scales on top of this. Lower if the helicopter is drowning out other game audio.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_LootQuantity": "Loot Quantity",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_LootQuantity_tooltip": "Number of random items placed in each supply crate. Items are picked randomly from a large pool of weapons, armor, supplies, and consumables.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_MaxDistance": "Max Distance from Players (tiles)",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_MaxDistance_tooltip": "Maximum distance from a player where a supply drop can appear. Too far and players may not reach it in time.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_MinDistance": "Min Distance from Players (tiles)",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_MinDistance_tooltip": "Minimum distance from a player where a supply drop can appear. Prevents drops on top of players.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_MinPlayers": "Minimum Players Online",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_MinPlayers_tooltip": "Supply drops only occur when at least this many players are online. Useful for skipping events during solo play.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_RadioCharges": "Radio Charges",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_RadioCharges_tooltip": "Number of times a radio can be used to Tune In before its battery is depleted and the radio is destroyed.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_RadioDropChance": "Radio Drop Chance (%)",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_RadioDropChance_tooltip": "Percentage chance for a Chopper Drop Radio to appear on military zombie corpses. Higher values mean more radios in the world.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_RadioEnabled": "Enable Chopper Drop Radio",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_RadioEnabled_tooltip": "Enable or disable the Chopper Drop Radio item. When disabled, radios will not spawn and all radio features are inactive.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_RadioHeadStart": "Early Intel Head Start (seconds)",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_RadioHeadStart_tooltip": "Seconds of advance notice radio holders get before the drop location is announced to everyone. Set to 0 to disable early intel.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_RandomEventsEnabled": "Enable Random Drops",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_RandomEventsEnabled_tooltip": "When disabled, the timer-based random drops stop. Radio (Tune In / Request Airdrop) and admin commands still work — drops only happen on demand. Useful for radio-only / pure on-demand setups.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_SoundRadius": "Helicopter Sound Radius (tiles)",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_SoundRadius_tooltip": "How far away players can hear the helicopter sound. Larger values let players hear it from further away.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_SpawnFailAlert": "Enable Spawn Fail Alert",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_SpawnFailAlertMessage": "Spawn Fail Alert Message",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_SpawnFailAlertMessage_tooltip": "Message shown on screen when a supply drop is cancelled due to a bad landing zone.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_SpawnFailAlert_tooltip": "Show a screen alert to all players when a supply drop is cancelled due to a bad landing zone (water, no walkable tile).",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_SpawnRetryDelay": "Spawn Retry Delay (minutes)",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_SpawnRetryDelay_tooltip": "If the drop location lands on water or has no valid tile, the event is cancelled and retried after this many minutes.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_TimerMode": "Timer Mode",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_TimerMode_option1": "Real Time",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_TimerMode_option2": "Game Time",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_TimerMode_tooltip": "How event timers are measured. Real Time uses wall-clock minutes. Game Time uses in-game minutes (affected by day length and game speed).",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_UseCustomLoot": "Use Custom Loot Config",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_UseCustomLoot_tooltip": "Load the loot pool from ChopperDrop_Loot.cfg instead of the built-in item list. The config file is auto-generated in Zomboid/Lua/ on first server start. Edit it to add, remove, or comment out items. Requires server restart after changes.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_ZombieAttractionRadius": "Zombie Attraction Radius (tiles)",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_ZombieAttractionRadius_tooltip": "How far the helicopter noise attracts zombies. Larger values pull zombies from a wider area.",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_ZombieHordeSize": "Zombie Horde Size",
  "translate_en|mods/ChopperDrop/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ChopperDrop_ZombieHordeSize_tooltip": "Number of zombies spawned at the drop site when a player arrives. Set to 0 to disable horde spawning."
}
