  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Anomaliesb42_SpawnShadow_tooltip": "Chance out of 1000 (checked every 10 in-game minutes at night, scales up with days survived) that a Shadow spawns near a player. 0 = disabled. Default: 15.",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Anomaliesb42_ToxicWalkersRequireZones": "Toxic Walkers Only Near Toxic Zones",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Anomaliesb42_ToxicWalkersRequireZones_tooltip": "The toxic cloud effect only applies to zombies inside or within 20 tiles of an active Toxic Zone. Disable to restore the base mod's behavior where matching zombies are toxic anywhere in the world.",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Anomaliesb42_ZoneDamageMultiplier": "Zone Damage Multiplier",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Anomaliesb42_ZoneDamageMultiplier_option1": "0.5x",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Anomaliesb42_ZoneDamageMultiplier_option2": "0.75x",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Anomaliesb42_ZoneDamageMultiplier_option3": "1x (Normal)",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Anomaliesb42_ZoneDamageMultiplier_option4": "1.5x",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Anomaliesb42_ZoneDamageMultiplier_option5": "2x",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Tooltip_EN.json|Tooltip_Anchor": "Gain immunity from being knocked down by gravity anomalies, but lose some carry weight. Gives off faint radiation.",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Tooltip_EN.json|Tooltip_Bubble": "Purges radiation and illness from your body, but it makes you quite thirsty and gives off faint radiation.",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Tooltip_EN.json|Tooltip_DeadStar": "Gravity anomalies ignore you, completely. Theres no con to this, but you better use it quick, the radiation melts your skin.",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Tooltip_EN.json|Tooltip_Ember": "Frost Zone damage is halved, and it warms you up. Makes you thirsty and a bit tired. Gives off moderate radiation.",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Tooltip_EN.json|Tooltip_Featherweight": "Get 6 more carry weight, but you gain fatigue over time. Gives off moderate radiation.",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Tooltip_EN.json|Tooltip_Hoarfrost": "Damage taken in Thermal Zones is halved, and it cools you down, but sometimes a bit too much. Gives off faint radiation.",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Tooltip_EN.json|Tooltip_LeadCase": "The Lead Case provides protection from most artifacts radiation and allows you to still use it.",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Tooltip_EN.json|Tooltip_Salamander": "Gain passive health regen, but gain stress over time. Gives off alot of radiation.",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Tooltip_EN.json|Tooltip_SlimeHeart": "Gas mask filters drain slower, but you feel permenantly queasy and it gives off moderate radiation.",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Tooltip_EN.json|Tooltip_SnowFlakeCore": "Your bleeding wounds freeze over, but you start to feel a big sluggish. Gives off moderate radiation.",
  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Tooltip_EN.json|Tooltip_Stormglass": "Emission damage is halved, but you also panic during emissions. Gives off alot of radiation."
}
