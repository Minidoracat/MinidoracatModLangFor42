  "translate_en|mods/AnomaliesMP/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Anomaliesb42_SpawnMutant_tooltip": "Chance out of 1000 (checked every 10 in-game minutes, scales up with days survived) that a Squealer spawns near a player. 0 = disabled. Default: 3.",
