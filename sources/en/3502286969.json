{
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/Fluids.json|Fluid_Container_BottleLighterFluid": "Lighter Fluid Tin",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/Fluids.json|Fluid_Name_Naphtha": "Naphtha",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_1": "The horde's gonna think i’m a walking bottle of dinner…",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_10": "The world burns, and i’m feeding it vanity…",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_11": "Perhaps i should throw in a love letter while at it",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_12": "This’ll burn about as well as my optimism.",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_13": "You call this lighter fluid???",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_14": "Why does it smell like my ex-wife?",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_15": "Can’t wait to smell amazing while dying horribly",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_16": "The scent's strong enough to reanimate a graveyard",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_17": "This better not make me smell like 'Brain No. 5'",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_18": "Did i just prank myself?",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_19": "What am i even doing with this junk?",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_2": "Pouring lies into my lighter, nice!",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_20": "Might as well be pouring water in…",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_21": "Is this some kind of sabotage?",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_22": "Even the fire would laugh at this",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_23": "This is going to be more useless than i am…",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_24": "Tomorrow i’ll be brushing my teeth with ketchup, won’t i?",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_25": "Who knew 'Eau de Toilette' meant 'Come Eat Me'?",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_3": "Might as well slick my hair back with barbecue sauce at this point…",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_4": "At least my lighter smells better than me…",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_5": "Even the zombies would roll their eyes at this",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_6": "This is probably the most stupid idea i ever had",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_7": "Should i try fill it with soup?",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_8": "How the hell did i even come up with this!?",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LighterZ_Perfume_9": "Damn! Even my future looks brighter than this!",
  "translate_en|mods/PR_LighterZ/42/media/lua/shared/Translate/EN/ItemName.json|Base.GoldLighter": "Gold Lighter"
}
