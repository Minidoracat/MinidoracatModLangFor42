  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_ChainsawDestruction": "Chainsaw destruction",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_ChainsawDestruction_tooltip": "On: the Sawrunner and the Sawcrazy cut through barricades, walls, fences and windows. Off: they only break doors, like the other monsters, and climb low fences.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Damage": "Monster damage",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Damage_option1": "50%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Damage_option2": "75%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Damage_option3": "100%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Damage_tooltip": "How hard every monster hits you. 100%% is the mod as made; lower it for an easier early game. The Human Flower and the Drowned stay deadly.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Health": "Monster health",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Health_option1": "75%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Health_option2": "100%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Health_option3": "125%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Health_option4": "150%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Health_tooltip": "How much health every monster has. 100%% is the mod as made; 75%% makes them die about a quarter sooner, 125%% makes them take about a quarter more hits, 150%% half as many again. The Human Flower cannot be hurt either way. Monsters already in the world keep the health they have.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Loudness": "Monster loudness",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Loudness_option1": "50%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Loudness_option2": "75%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Loudness_option3": "100%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Loudness_option4": "125%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Loudness_option5": "150%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Loudness_option6": "200%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Loudness_tooltip": "How loud the monsters are. 100%% is the mod as made. Footsteps and some hit and death sounds stay at 100%%. The Sawrunner's chase music is not changed by this.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_MovementSpeed": "Monster movement speed",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_MovementSpeed_option1": "65%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_MovementSpeed_option2": "75%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_MovementSpeed_option3": "85%%",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_MovementSpeed_option4": "100%% (Original)",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_MovementSpeed_tooltip": "Scales travel and movement animation together. 100%% is original speed. Taller and Flygare are unchanged. Attack, climbing and death timing stay unchanged.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Ragdolls": "Monster ragdolls (cars)",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Monsters_Ragdolls_tooltip": "On: a monster hit hard by a car is thrown as a ragdoll and gets up again. Single-player only (the game has no ragdolls in multiplayer) and only with the game's own ragdoll option on. Not the Taller, the Human Flower or the Flygare.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_RegularCreatures": "Cry of Fear: Regular Creatures",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Sawrunner": "Cry of Fear: Sawrunner Event",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Sawrunner_NaturalSpawns": "Allow ordinary Sawrunner spawning",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Sawrunner_NaturalSpawns_tooltip": "Allow Sawrunner in the ordinary population as well as night events. Requires Sawrunner enabled under Special Creatures.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Sawrunner_NightEvent": "Sawrunner night encounters",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Sawrunner_NightEvent_tooltip": "Scheduled night encounters with Sawrunner. Requires Sawrunner enabled under Special Creatures.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns": "Cry of Fear: Population",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_DayNightSpawns": "Fewer monsters by day, more at night",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_DayNightSpawns_tooltip": "Natural spawn amounts: day 0.5x; night 1.5x (8 PM-6 AM). Combines with population growth. Existing monsters stay. Night-only still applies. Sawrunner events unaffected.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_DrownedAmount": "Drowned (number)",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_DrownedAmount_tooltip": "How many Drowned live in each map area. Type any number, decimals too: 0.25 = one in every 4 areas. 0 = none. The old settings: Rare 0.25, Uncommon 0.5, Normal 1, High 2.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_HumanFlowers": "Human Flower",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_HumanFlowers_tooltip": "Off: stops new Human Flowers. Existing flowers remain. This stationary creature cannot be killed and is deadly within 3 tiles.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_NightOnly": "Monsters only at night",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_NightOnly_tooltip": "On: monsters only appear from 8 PM to 4 AM, and they are back every night. In daylight the ones far from you disappear; the ones still near you stay.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_PeakDay": "Peak population day",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_PeakDay_tooltip": "Day 1 starts at your chosen population. It increases gradually until this day, then stays at the peak. Measured from world creation; joining or respawning does not reset it.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_PeakMultiplier": "Population at peak (multiplier)",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_PeakMultiplier_tooltip": "Starting natural population multiplied at the peak day. 2 means twice as many. Includes regular and special monsters, including enabled Human Flowers.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_PopulationGrowth": "Increase population over time",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_PopulationGrowth_tooltip": "Increase enabled natural monster populations as the world ages. Off by default. None stays disabled. Does not change Sawrunner night events.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_RegularAmount": "Regular monsters (number)",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_RegularAmount_tooltip": "How many regular monsters (Slowers, Fasters, Children and others) live around you in a town; fewer in the suburbs and the countryside. Type any number, decimals too. 0 = none. The old settings: Rare 4, Uncommon 8, Normal 12, High 20.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_RespawnHours": "Killed monsters come back after (hours)",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_RespawnHours_tooltip": "How many in-game hours the place of a killed monster stays empty. It only comes back while you are away from that place. 0: killed monsters never come back.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_SafehouseBuffer": "Safehouse spawn buffer (tiles)",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_SafehouseBuffer_tooltip": "Blocks natural monster spawns inside claimed safehouses and this far outside their borders, even when empty. 0: inside only. Existing monsters can still approach.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_SawcrazyAmount": "Sawcrazies (number)",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_SawcrazyAmount_tooltip": "How many Sawcrazies live in each map area. Type any number, decimals too: 0.25 = one in every 4 areas, 1 = one in each. 0 = none. The old settings: Rare 0.1, Uncommon 0.25, Normal 0.5, High 1.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_SawrunnerAmount": "Sawrunners (number)",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_SawrunnerAmount_tooltip": "How many Sawrunners live in each map area (needs ordinary Sawrunner spawning on). Type any number, decimals too: 0.25 = one in every 4 areas. 0 = none. The old settings: Rare 0.25, Uncommon 0.5, Normal 1, High 2.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_StrangerAmount": "Strangers (number)",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Spawns_StrangerAmount_tooltip": "How many Strangers live in each map area. Type any number, decimals too: 0.25 = one in every 4 areas. 0 = none. The old settings: Rare 0.25, Uncommon 0.5, Normal 1, High 2.",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_SpecialCreatures": "Cry of Fear: Special Creatures",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Stranger_Range": "Stranger range (tiles)",
  "translate_en|mods/CryOfFearMonsters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_COF_Stranger_Range_tooltip": "How far away the Stranger can hurt you when you look at him."
}
