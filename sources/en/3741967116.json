  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiAmurLeopard": "A stealthy night predator with padded feet, sharp claws, and silent movement.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiClydesdaleHorse": "A powerful running survivor with heavy stamina, thick resilience, and serious sprinting talent.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiCottontailRabbit": "A nervous but quick-footed survivor made for sprinting, dodging, and escaping danger.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiDomesticLonghair": "A graceful night-eyed feline with soft paws, quiet movement, and elegant survival instincts.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiDomesticShorthair": "A quick, balanced housecat survivor with nimble movement, padded feet, and fast reactions.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiDragon": "A fire-scaled apex survivor with bite power, combat instincts, strength, and heat-resistant scales.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiEastAfricanCheetah": "A fast-moving sprinter built for speed, reflexes, nimble movement, and hit-and-run survival.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiGoldenRetriever": "A loyal companion type with brave instincts, helpful survival skills, and pack-bonded warmth.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiGreenIguana": "A sun-loving reptile survivor with scales, balance, outdoor skill, and cold-blooded drawbacks.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiKomodoDragon": "A dangerous scavenger-predator with reptile stomach, bite force, and ruthless hunting instincts.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiLabradorRetriever": "A loyal tracker with a strong nose, outdoor skill, courage, and natural foraging ability.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiMixedBreed": "A charming mix of instincts, loyalty, balance, senses, and adaptable survival talent.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiNileCrocodile": "A heavy reptile predator with scaled skin, bite power, strength, and survival patience.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiRedFox": "A clever fox built for quiet steps, scavenging, trapping, and slipping away before trouble catches up.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiSaintBernard": "A sturdy rescue-hearted survivor with thick fur, resilience, strength, and first-aid talent.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiSiberianTiger": "A powerful predator with claws, jaws, courage, and brutal close-combat instincts.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiTexasLonghornBull": "A muscular horned powerhouse with territorial instincts, strength, courage, and blunt-force attitude.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiWhiteTailedBuck": "A cautious forest survivor with fast legs, alert ears, and outdoor instincts.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_YumiWhiteTailedDoe": "A graceful prey survivor with sharp senses, quiet movement, and strong foraging skill.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiAnimalInstincts": "Animal Instincts",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiAnimalInstinctsDesc": "Better awareness, survival instincts, and panic recovery.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiBorntoRun": "Born to Run",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiBorntoRunDesc": "Massive sprinting talent with faster hunger, thirst, and endurance drain.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiCarnivore": "Carnivore",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiCarnivoreDesc": "You crave meat, fish, and eggs. Eating fruits, vegetables, or mushrooms makes you unhappy, bored, and can hurt your health.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiClawedHands": "Clawed Hands",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiClawedHandsDesc": "Better melee and short-blade-style combat.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiColdBlooded": "Cold-Blooded",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiColdBloodedDesc": "You struggle in cold weather but handle heat better.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiDigitigradeLegs": "Digitigrade Legs",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiDigitigradeLegsDesc": "Better sprinting and nimble movement, but higher endurance drain.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiEnhancedHearing": "Enhanced Hearing",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiEnhancedHearingDesc": "Better hearing and alertness-style awareness.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiFireResistantScales": "Fire-Resistant Scales",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiFireResistantScalesDesc": "Reduced fire and burn danger, but you are not immune to fire.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiForagersNose": "Forager's Nose",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiForagersNoseDesc": "Better foraging and finding food.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiHerbivore": "Herbivore",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiHerbivoreDesc": "You crave fruits, vegetables, and mushrooms. Eating meat, fish, or eggs makes you unhappy, bored, and can hurt your health.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiHornedPower": "Horned Power",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiHornedPowerDesc": "Heavy horns and raw force improve shove power, blunt fighting, and combat confidence.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiLoneBeast": "Lone Beast",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiLoneBeastDesc": "Better alone, worse around groups of survivors.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiNightEyes": "Night Eyes",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiNightEyesDesc": "Your eyes are naturally adapted to darkness, making it easier to see and move at night.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPackBonded": "Pack Bonded",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPackBondedDesc": "Less stress and panic near allies, but worse when alone.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPaddedFeet": "Padded Feet",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPaddedFeetDesc": "Quieter footsteps and better sneaking.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPowerfulBite": "Powerful Bite",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPowerfulBiteDesc": "A strong reptile or predator bite instinct improves close-combat survival.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPowerfulJaws": "Powerful Jaws",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPowerfulJawsDesc": "Predator-style survival trait with stronger close-combat instincts.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPredatorReflexes": "Predator Reflexes",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPredatorReflexesDesc": "Better combat reaction and confidence.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPredatorsAppetite": "Predator's Appetite",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPredatorsAppetiteDesc": "Your body burns through food and water much faster, but your constant eating has made you naturally stronger.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPreyReflexes": "Prey Reflexes",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPreyReflexesDesc": "Faster movement and reaction, but panic rises easier.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPrimalFearResponse": "Primal Fear Response",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiPrimalFearResponseDesc": "Panic rises faster, but it fits prey-animal survival instincts.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiReptileStomach": "Reptile Stomach",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiReptileStomachDesc": "Less likely to get sick from questionable animal protein, but this does not protect you from the Knox Infection.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiScaledSkin": "Scaled Skin",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiScaledSkinDesc": "Tougher scaled skin gives a little extra survival toughness, but it is not armor.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiSensitiveTail": "Sensitive Tail",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiSensitiveTailDesc": "More pain and stress when injured.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiSharpSenses": "Sharp Senses",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiSharpSensesDesc": "Better foraging, tracking, and general awareness.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiSmallGameEater": "Small Game Eater",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiSmallGameEaterDesc": "You are built for eating small game, fish, eggs, and lean animal protein.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiSunBasking": "Sun Basking",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiSunBaskingDesc": "Warm daylight calms you and helps you recover fatigue slightly while outdoors.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiTailBalance": "Tail Balance",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiTailBalanceDesc": "Better balance, nimble movement, and lightfoot movement.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiTerritorial": "Territorial",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiTerritorialDesc": "Less stress and panic around your base or familiar safehouse areas.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiThickFur": "Thick Fur",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiThickFurDesc": "Better cold resistance, but worse heat tolerance.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiThinFur": "Thin Fur",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiThinFurDesc": "Better heat tolerance, but worse cold resistance.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiWildAppetite": "Wild Appetite",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiWildAppetiteDesc": "Hunger drains faster and you need more food.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiWildResilience": "Wild Resilience",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_YumiWildResilienceDesc": "Your anthro biology is naturally tougher against normal sickness, but this does not protect you from the Knox Infection."
}
