  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiDomesticLonghair": "A graceful night-eyed feline with soft paws, quiet movement, and elegant survival instincts.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiDomesticShorthair": "A quick, balanced housecat survivor with nimble movement, padded feet, and fast reactions.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiDragon": "A fire-scaled apex survivor with bite power, combat instincts, strength, and heat-resistant scales.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiEastAfricanCheetah": "A fast-moving sprinter built for speed, reflexes, nimble movement, and hit-and-run survival.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiGoldenRetriever": "A loyal companion type with brave instincts, helpful survival skills, and pack-bonded warmth.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiGreenIguana": "A sun-loving reptile survivor with scales, balance, outdoor skill, and cold-blooded drawbacks.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiKomodoDragon": "A dangerous scavenger-predator with reptile stomach, bite force, and ruthless hunting instincts.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiLabradorRetriever": "A loyal tracker with a strong nose, outdoor skill, courage, and natural foraging ability.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiMixedBreed": "A charming mix of instincts, loyalty, balance, senses, and adaptable survival talent.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiNileCrocodile": "A heavy reptile predator with scaled skin, bite power, strength, and survival patience.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiRedFox": "A clever fox built for quiet steps, scavenging, trapping, and slipping away before trouble catches up.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiSaintBernard": "A sturdy rescue-hearted survivor with thick fur, resilience, strength, and first-aid talent.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiSiberianTiger": "A powerful predator with claws, jaws, courage, and brutal close-combat instincts.",
