  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiWhiteTailedBuck": "A cautious forest survivor with fast legs, alert ears, and outdoor instincts.",
  "translate_en|mods/FurryTraitsForFurryLovers/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_YumiWhiteTailedDoe": "A graceful prey survivor with sharp senses, quiet movement, and strong foraging skill.",
