  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recipes.json|BYOK_MakeKayakLight": "Make Kayak Light",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recipes.json|BYOK_SkinKayakLeather": "Skin Kayak with Leather",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recipes.json|BYOK_SkinKayakTarp": "Skin Kayak with Tarps",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recipes.json|BYOK_SteamRibs": "Steam and Bend Kayak Ribs",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Item": "VHS: Paddle Craft",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line01": "Welcome back to Paddle Craft. Today we build a skin on frame kayak, start to finish.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line02": "Start with saplings. Split each one with a sharp knife into thin rib blanks.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line03": "Get a pot of water boiling hot. Steam the blanks and bend them while they're soft.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line04": "Steam a plank the same way and bend it into a hoop for the cockpit rim.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line05": "Saw planks into deck beams. They hold the gunwales apart.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line06": "Stringers run the whole length of the hull. Saw them out and trim them with a knife.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line07": "Lash every rib to the stringers with twine or sinew. No nails. The frame has to flex.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line08": "Now the skin. Four good tarps will do, or two tanned hides if you have them.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line09": "Sew it tight along the deck. Every stitch keeps the lake out.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line10": "Paint it yellow, a few coats, black on the trim, and tie on your deck lines.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line11": "And every kayak needs a paddle. Carve one from a single plank.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line12": "Out after dark? Tape a flashlight to a pipe or a long stick and stand it on the back deck, so the boats can see you.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line13": "That's all for this week. See you on the water.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Subtitle": "Build Your Own Kayak",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Title": "Paddle Craft"
}
