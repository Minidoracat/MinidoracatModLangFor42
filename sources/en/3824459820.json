  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recipes.json|BYOK_SteamRibs": "Steam and Bend Kayak Ribs",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Item": "VHS: Paddle Craft",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line01": "Welcome back to Paddle Craft. Today we build a skin on frame kayak, start to finish.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line02": "Start with saplings. Split each one with a sharp knife into thin rib blanks.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line03": "Get a pot of water boiling hot. Steam the blanks and bend them while they're soft.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line04": "Steam a plank the same way and bend it into a hoop for the cockpit rim.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line05": "Two long planks make the gunwales, the backbone of the boat. Saw more planks into deck beams to hold them apart.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line06": "Stringers run the whole length of the hull. Saw them out and trim them with a knife.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line07": "Set each rib into the gunwales, then lash the keel and stringers on with twine or sinew. No nails. The frame has to flex.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line08": "Now the skin. Four good tarps will do, or two large tanned hides, or four smaller ones.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line09": "Sew it tight along the deck. Every stitch keeps the lake out.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line10": "Paint it, a few coats in any colour you have, black on the trim, and tie on your deck lines. A leather skin can take lard or candle wax instead, with a little charcoal for the trim.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line11": "And every kayak needs a paddle. Carve one from a single plank.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line12": "Out after dark? Tape a flashlight to a pipe or a long stick and stand it on the back deck, so the boats can see you.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Line13": "That's all for this week. See you on the water.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Subtitle": "Build Your Own Kayak",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Recorded_Media.json|RM_BYOK_PaddleCraft_Title": "Paddle Craft",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BuildYourOwnKayak": "Build Your Own Kayak",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BuildYourOwnKayak_PaddleSpeedPercent": "Paddling speed (percent)",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BuildYourOwnKayak_PaddleSpeedPercent_tooltip": "How fast kayaks travel. 100 is the normal speed, about a brisk walk.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BuildYourOwnKayak_PaddleTiringPercent": "Paddling effort (percent)",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BuildYourOwnKayak_PaddleTiringPercent_tooltip": "How quickly paddling tires players. 100 is normal, and 0 means paddling never tires them.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BuildYourOwnKayak_ServerLog": "Log kayak use on the server",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BuildYourOwnKayak_ServerLog_tooltip": "Writes a line to the server log each time a player launches, gets in, or gets out, so admins can see what happened.",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BuildYourOwnKayak_StorageUnitKayaks": "Ready made kayaks in storage units",
  "translate_en|mods/BuildYourOwnKayak/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BuildYourOwnKayak_StorageUnitKayaks_tooltip": "How many finished kayaks can turn up in storage units across the whole world. 0 means every kayak has to be built."
}
