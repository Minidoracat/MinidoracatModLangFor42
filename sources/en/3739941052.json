  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JZ_AutoEngagePvP": "Auto-enter PvP in PvP zones",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JZ_AutoEngagePvP_tooltip": "When ON, entering a PvP zone automatically drops the player's safety (no need to click the PvP toggle); leaving restores it. The server's built-in safety delay still applies. Requires the server PVP and SafetySystem options ON. Default OFF.",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JZ_AutoRestoreOnWipe": "Auto-restore zones on map wipe",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JZ_AutoRestoreOnWipe_tooltip": "On a fresh boot with no saved zones, automatically import a saved config: JeevesZones_autoload.lua if you placed one, otherwise the JeevesZones_config.txt that the Export Config button writes.",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JZ_CorpseRecovery": "Let players recover their own body in a zone",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JZ_CorpseRecovery_tooltip": "ON (default): a player who dies inside a protected zone can loot their own corpse and pick their dropped weapon off the ground, even where container access is blocked. Zombie corpses stay locked, so luring a horde in for the trader guards to kill and looting the pile still does not work. OFF: the old behaviour -- nothing inside a no-container-access zone can be looted, including your own death loot.",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JZ_DefaultPvP": "Default map to PvP (carve out safe zones)",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JZ_DefaultPvP_tooltip": "OFF (recommended): the whole map is non-PvP by default and PvP-enabled zones are the exceptions; the mod auto-maintains the safe coverage so you never draw a map-wide zone. ON: the map is hot by default and only safe zones are carved out. Requires the server PVP option to be ON either way.",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JZ_Enabled": "Enable Jeeve's Zones",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JZ_Enabled_tooltip": "Master toggle for the zone system. When disabled, all zone effects are inactive.",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JZ_SafeBlanketBounds": "Safe-blanket bounds (advanced)",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JZ_SafeBlanketBounds_tooltip": "Only used when Default-PvP is OFF. 'auto' sizes the non-PvP blanket from the map automatically (recommended). On an unusual modded map you can pin exact world-tile bounds as x1,y1,x2,y2.",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JZ_ShowZoneMessages": "Show Zone Enter/Leave Messages",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JZ_ShowZoneMessages_tooltip": "Players see a notice when entering a zone. Per-zone banners can also be toggled individually.",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_JeevesZones": "Jeeve's Zones",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_JZ_AutoEngagePvP": "Auto-enter PvP in PvP zones",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_JZ_AutoEngagePvP_tooltip": "When ON, entering a PvP zone automatically drops the player's safety (no need to click the PvP toggle); leaving restores it. The server's built-in safety delay still applies. Requires the server PVP and SafetySystem options ON. Default OFF.",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_JZ_AutoRestoreOnWipe": "Auto-restore zones on map wipe",
  "translate_en|mods/JeevesZones/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_JZ_AutoRestoreOnWipe_tooltip": "On a fresh boot with no saved zones, automatically import a saved config: JeevesZones_autoload.lua if you placed one, otherwise the JeevesZones_config.txt that the Export Config button writes.",
