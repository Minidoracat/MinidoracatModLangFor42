  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_ManualTitle": "How to Play Pool",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S1_Body": "Equip a Pool Cue (Base.Poolcue) in either hand, then right-click a pool table and choose Play Pool. Pick a mode: Solo Practice for a free table with no rules, or a ruleset match against the AI or another player.",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S1_Title": "Getting Started",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S2_Body": "Move the mouse near the cue ball to aim - the stick follows your cursor. Click and drag away from the cue ball to pull the stick back, then release to shoot: the farther you pull, the harder the shot. For fine adjustments, use the mouse wheel or the [ and ] keys - the pockets forgive less than a degree of error, so small corrections matter.",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S2_Title": "Aiming & Shooting",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S3_Body": "A shot is a foul if the cue ball is pocketed, if it hits nothing, or if nothing reaches a cushion after contact. After any foul, the other player gets ball in hand: click anywhere on the table to place the cue ball before shooting (behind the line on the break).",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S3_Title": "Fouls & Ball in Hand",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S4_Body": "Standard rules. The table stays open after the break. The first ball legally potted afterwards assigns Solids or Stripes to each player. Once your group is cleared, pot the 8 to win - but potting the 8 early, on a foul, or before clearing your group loses the game instantly.",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S4_Title": "8-Ball (Classic Ruleset)",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S5_Body": "A simpler, faster match: any ball counts, there are no groups and no early-8 penalty. Potting a ball scores a point and keeps your turn; missing passes it. When the table is cleared, whoever scored more wins. Pick this when you want a quick free-for-all rather than the teams that 8-Ball uses.",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S5_Title": "Most Balls (Knockout Ruleset)",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S6_Body": "Playing lowers Boredom while the table is open, and finishing a match also eases Unhappiness and Stress, at the cost of a little Fatigue. The longer and more actively you play, the more it pays out.",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S6_Title": "Rewards",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S7_Body": "On a server, pick Multiplayer to open a lobby. Only you need a pool cue - the table is set up with it and everyone is assumed to pass it around, so your friends can join empty-handed. Others right-click the same table and choose Play Pool to take a seat, or you can invite anyone nearby with the Invite Players button. When everyone is in, press Start Match: the game counts who is at the table and sizes the match to fit, up to 8 players. In 8-Ball the extra players form two teams, odd seats against even. Anyone can also choose Watch Pool Game to spectate without playing.",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S7_Title": "Playing With Friends",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S8_Body": "Finished matches are recorded. Open Stats from the menu to see the rankings: on a server you can compare the leaderboard for that specific table against the whole server, and in singleplayer you get your own career record. Wins, win rate, pot rate and fouls are all tracked. None of this is stored in your save file, so removing the mod remains safe.",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Manual_S8_Title": "Stats and Rankings",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_Multiplayer": "Multiplayer",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_MultiplayerDesc": "8-ball against another player at this table.",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_NewGame": "New Game",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_OpenLink": "Open",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_OpenTable": "Open table",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_OpponentLeft": "Your opponent left the table.",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_OpponentTurn": "%s is shooting",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_OptShowAim": "Show opponent aiming (multiplayer)",
  "translate_en|mods/UsablePoolTables/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PoolTables_OptShowAimTooltip": "While it is your opponent's turn, show their cue following their aim in real time. Purely visual - never affects the shot.",
