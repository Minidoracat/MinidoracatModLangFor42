  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers": "Automatic Lights",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_CatchUpOnChunkLoad": "Catch up on chunk load",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_CatchUpOnChunkLoad_tooltip": "When a chunk loads, immediately reconcile any timer-configured lights so they match their schedule. Disable if this causes performance issues.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_DefaultOffHour": "Default OFF hour",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_DefaultOffHour_tooltip": "Hour (0-23) prefilled in the timer dialog for newly-configured lights.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_DefaultOffMin": "Default OFF minute",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_DefaultOffMin_tooltip": "Minute (0-59) prefilled in the timer dialog for newly-configured lights.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_DefaultOnHour": "Default ON hour",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_DefaultOnHour_tooltip": "Hour (0-23) prefilled in the timer dialog for newly-configured lights.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_DefaultOnMin": "Default ON minute",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_DefaultOnMin_tooltip": "Minute (0-59) prefilled in the timer dialog for newly-configured lights.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_Enabled": "Enabled",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_Enabled_tooltip": "Master toggle for the mod. Disable to revert to vanilla behavior.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_MotionSensorDefaultIdleMinutes": "Default idle-off minutes",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_MotionSensorDefaultIdleMinutes_tooltip": "Minutes (1-60) prefilled in the motion-sensor dialog. Controls how long the light stays on after the last detected motion.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_MotionSensorDetectZombies": "Sensors detect zombies",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_MotionSensorDetectZombies_tooltip": "When enabled, motion sensors trigger on zombies in addition to players — useful for spotting an intruder from a distance, but adds per-square scanning cost. Disable to reduce CPU load on busy servers or if you find it gives away too much.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_MotionSensorEnabled": "Motion sensors enabled",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_MotionSensorEnabled_tooltip": "Master toggle for the motion-sensor switch feature. When off, installed sensors stop reacting to players (and craft recipes still work but installs are blocked).",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_MotionSensorPollFrames": "Motion poll interval (frames)",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_MotionSensorPollFrames_tooltip": "How often motion sensors check for nearby players, in game-tick frames. Lower = snappier response, higher = lower CPU cost. Default 10 ≈ 6 polls per second at 60 FPS.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_MotionSensorSkillLevel": "Motion Sensor Electrical skill",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_MotionSensorSkillLevel_tooltip": "Minimum Electrical skill to install or configure a motion sensor when the item requirement above is off. Set to 0 for no gate.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_OutdoorMotionSensorRadius": "Outdoor sensor radius (tiles)",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_OutdoorMotionSensorRadius_tooltip": "Tile radius (1-20) within which an Outdoor Motion Sensor will detect players. Indoor sensors ignore this and use room boundaries instead.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_RequireMotionSensorItem": "Require Motion Sensor item",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_RequireMotionSensorItem_tooltip": "When enabled, players must craft and install an Indoor or Outdoor Motion Sensor item to motion-enable a light. When disabled, the skill gate below applies instead.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_RequireTimerItem": "Require Timer item",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_RequireTimerItem_tooltip": "When enabled, players must craft a Light Timer item and install it on a light before they can set a schedule. When disabled, any light can be configured directly, gated only by the Required Electrical skill below.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_RequiredElectricalSkill": "Required Electrical skill",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AutoLightTimers_RequiredElectricalSkill_tooltip": "Minimum Electrical skill to configure a light timer. Only applies when \"Require Timer item\" is off — otherwise the skill cost is in crafting the Timer. Set to 0 for no gate.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_AutoLightTimers_IndoorMotionSensor": "A wall-mount motion sensor. Install it on a light fixture; the light will turn on when someone enters the same room and switch off after a configurable idle period. Detection follows room boundaries — walls block it.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_AutoLightTimers_LightTimer": "An analog timer that switches a connected light on and off on a daily schedule. Install it on a light fixture, then right-click the light to set its schedule.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_AutoLightTimers_NightOutdoorMotionSensor": "A weatherproof outdoor motion sensor with a built-in day/night cutoff. Active only between dusk and dawn — saves bulbs and electricity by ignoring motion during daylight.",
  "translate_en|mods/AutoLightTimers/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_AutoLightTimers_OutdoorMotionSensor": "A weatherproof motion sensor for exterior lights. Install it on a light fixture; the light will turn on for any player within a configurable tile radius and switch off after an idle period."
}
