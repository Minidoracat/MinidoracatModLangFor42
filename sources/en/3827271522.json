  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GarageWorks": "GarageWorks",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GarageWorks_BatteryChargeHours": "Battery cabinet: hours for a full charge",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GarageWorks_BatteryChargeHours_tooltip": "In-game hours to charge an empty car battery in a powered battery cabinet (all batteries charge at once). The vanilla charger takes 6 hours.",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GarageWorks_ChargerFuelPerHour": "Battery cabinet: generator fuel per hour",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GarageWorks_ChargerFuelPerHour_tooltip": "Generator fuel used per in-game hour while the cabinet charges on generator power, multiplied by the world's generator fuel consumption. 0 = free (original behaviour). The vanilla battery charger uses 0.05 whenever it is on. Grid power and power relayed by other mods stay free.",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GarageWorks_ItemSlotWeight": "Weight of an item on GarageWorks furniture",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GarageWorks_ItemSlotWeight_tooltip": "Weight of each tire or battery while it is on GarageWorks furniture. The game caps containers on the ground at 100; the maximum (2.6) still lets the 27th tire in, even the heaviest modded ones (30). Never more than the item's own weight. The brake shelf and the suspension rack always use 1.",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_GW_Magazine1": "Plans for welded garage racks: tires (12, or 27 on two squares), mufflers (12), fuel cans (12), a propane cage (36), brakes (40) and suspensions (24).",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_GW_Magazine2": "Plans for a wooden cabinet with a built-in charger for six car batteries.",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_GW_craft_batteryCabinet": "Wooden cabinet for 6 car batteries, with a charger on top. Batteries weigh less inside.<br>Charges the batteries when the square has power.",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_GW_craft_brakeShelf": "Metal shelves with 10 parts bins for 40 brakes (4 per bin, 5 shelves). Brakes weigh 1 while on the shelves. Items can be put on top.",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_GW_craft_fuelCanRack": "Metal rack for fuel cans, one container per shelf: 4 cans of 20 L or more at the bottom, 4 smaller cans on each of the two shelves above. The cans weigh less, the fuel keeps its weight. Items can be put on top.",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_GW_craft_longTireRack": "Welded rack for 27 tires (3 levels of 9), two squares long. Tires weigh much less while on the rack.",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_GW_craft_mufflerRack": "Metal rack for 12 mufflers: 8 hanging on two bars, 4 on the bottom shelf. Mufflers weigh much less while on the rack. Items can be put on top.",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_GW_craft_propaneCage": "Wire mesh cage for propane tanks, two squares long, with two doors: 18 tanks on each square (3 shelves of 2 rows of 3). Tanks weigh much less inside. Items can be put on top.",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_GW_craft_suspensionRack": "Low rack with two sloped decks, two squares long: 12 suspensions on each square. Suspensions weigh 1 while on the rack.",
  "translate_en|mods/GarageWorks/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_GW_craft_tireRack": "Welded rack for 12 tires (3 levels of 4). Tires weigh much less while on the rack.",
  "translate_en|mods/GarageWorksSafeRemoval/42/media/lua/shared/Translate/EN/Moveables.json|Garage_Battery_Cabinet": "Battery Cabinet",
