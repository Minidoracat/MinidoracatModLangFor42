  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BFFloorLights_debug": "Floor Light Debug Log",
  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BFFloorLights_debug_tooltip": "Writes what the floor-light system is doing into the console log: when a carried flashlight is marked as wanted-on, how many of this mod's items are found on the floor nearby, and when a light is created or removed. Only for reporting a problem; leave it off for normal play.",
  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BFFloorLights_directional": "Directional Floor Beam",
  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BFFloorLights_directional_tooltip": "A flashlight on the ground throws its light forward, the way the model points, instead of glowing evenly in all directions. The beam stops at walls and at the edge of the room. Turn this off for a plain round pool of light around the item.",
  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BFFloorLights_drainFuel": "Drain Battery on the Ground",
  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BFFloorLights_drainFuel_tooltip": "A flashlight left switched on the ground spends its battery at the same rate as in your hands and goes dark when empty. Turn this off to let floor lights burn forever.",
  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BFFloorLights_enabled": "Flashlights Light the Ground",
  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BFFloorLights_enabled_tooltip": "When on, a switched-on flashlight from this mod really illuminates the tile it lies on. The base game only renders an item's light while it is carried, so a dropped flashlight is normally dark. Turn this off to restore vanilla behaviour.",
  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BFFloorLights_radiusMult": "Floor Light Radius",
  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BFFloorLights_radiusMult_tooltip": "Scales the flashlight's own light distance when it lies on the ground. An item's value is tuned for a forward cone in your hands, so used as a round floor spot it would light a whole room. Default 0.25, and the result is clamped to 3-7 tiles. Raise it if you want a brighter pool of light around a dropped flashlight.",
  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BFFloorLights_weaponLights": "Weapon Flashlights on the Ground",
  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BFFloorLights_weaponLights_tooltip": "Also light the ground under the three weapon flashlights (Emergency and Military Flashlight). They have no light values in their item script, so they use a fixed 8-tile radius.",
  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BFLightState_heartbeatSeconds": "MP Light Heartbeat (seconds)",
  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BFLightState_heartbeatSeconds_tooltip": "How often each client sends a background BFLightState update so the server can re-broadcast it to other players. State changes are always sent immediately. Default 30 s. Lower values make remote lights react faster after a packet drop, higher values reduce MP traffic on large servers. 0 disables the background heartbeat.",
  "translate_en|mods/[B42] BetterFlashlights/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BetterFlashlights": "Better Flashlights",
