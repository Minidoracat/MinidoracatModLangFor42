  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_AllowBlowTorch_tooltip": "If enabled, welding torches can be filled directly at gas pumps.<br>Disable to keep welding fuel loot-only, so metalworking still depends on finding propane tanks.",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_AllowIndustrialTanks": "Allow Industrial Propane Tanks",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_AllowIndustrialTanks_tooltip": "If enabled, the large static propane tanks already on the map become working propane stores you can draw from and pour into.<br>Disable to leave them as scenery.",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_AllowPropaneBottle": "Allow Lantern Bottle Refills",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_AllowPropaneBottle_tooltip": "If enabled, propane lantern bottles can be filled at gas pumps, making propane lanterns a renewable light source.<br>Disable to keep lantern fuel loot-only.",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_AllowPropaneTruck": "Allow Propane Tankers",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_AllowPropaneTruck_tooltip": "If enabled, propane tanker trucks added by other vehicle mods carry their own propane reserve you can fill from.<br>Has no effect unless such a mod is installed.",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_AllowTankerRefill": "Allow Refilling Tankers at Pumps",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_AllowTankerRefill_tooltip": "If enabled, a tanker parked at a working pump can be filled from it, making it a mobile propane store you can drive away and refill later.<br>Disable to make each tanker a one-time find that never refills.",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_BlowTorchCost": "Welding Torch Refill Cost",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_BlowTorchCost_tooltip": "How much fuel a gas pump uses to fill an empty welding torch.<br>Welding torches gate most metalworking, so this decides how much building a single pump is worth.",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_IndustrialTankCapacity": "Industrial Tank: Capacity",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_IndustrialTankCapacity_tooltip": "How much propane an industrial tank can hold in total, including what you pour into it.<br>At the default 1000 a full tank is worth fifty propane tanks.",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_IndustrialTankSpawnMax": "Industrial Tank: Maximum Found",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_IndustrialTankSpawnMax_tooltip": "Most propane an industrial tank can be discovered holding. Each tank gets its own amount between the two, so they are not all the same.<br>Capped by the tank's capacity.",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_IndustrialTankSpawnMin": "Industrial Tank: Minimum Found",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_IndustrialTankSpawnMin_tooltip": "Least propane an industrial tank can be discovered holding.<br>At 0 some tanks are found empty.",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_PropaneBottleCost": "Lantern Bottle Refill Cost",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_PropaneBottleCost_tooltip": "How much fuel a gas pump uses to fill an empty propane lantern bottle.<br>A full pump holds 100.",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_PropaneTankCost": "Propane Tank Refill Cost",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_PropaneTankCost_tooltip": "How much fuel a gas pump uses to fill an empty propane tank.<br>A full pump holds 100, so at the default of 20 each pump is worth five tanks. Raise it to make propane scarcer.",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_PropaneTruckReserveMax": "Tanker Reserve: Maximum",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_PropaneTruckReserveMax_tooltip": "How much propane a tanker can hold, and the most it can be found carrying. Each truck is found with a random amount up to this.<br>At the default 200 a full tanker is worth ten propane tanks.",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_PropaneTruckReserveMin": "Tanker Reserve: Minimum",
  "translate_en|mods/PropaneRefuel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PropaneRefuel_PropaneTruckReserveMin_tooltip": "Least propane a tanker can be found carrying.<br>At 0 some tankers are found already empty."
}
