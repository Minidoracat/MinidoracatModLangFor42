{
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks": "Refillable Propane Tanks",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_Capacity": "Industrial tank capacity (propane units)",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_Capacity_tooltip": "Maximum propane stored by each functional industrial tank sprite. A full base-game propane tank costs 100 units. Existing stored amounts are preserved unless they exceed the new capacity. Default: 2000.",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_EnableCompatiblePropaneItems": "Refill compatible modded propane items",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_EnableCompatiblePropaneItems_tooltip": "Allows registered modded drainable propane tools and containers, plus conservatively recognized propane-named drainables. Default: On.",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_EnableFossoilDepots": "Enable Fossoil bulk propane tanks",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_EnableFossoilDepots_tooltip": "Allows supported Fossoil bulk-tank sprites to dispense propane. Existing stored data is preserved while disabled. Default: On.",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_EnableGas2GoDepots": "Enable Gas2Go bulk propane tanks",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_EnableGas2GoDepots_tooltip": "Allows supported Gas2Go bulk-tank sprites to dispense propane. Existing stored data is preserved while disabled. Default: On.",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_EnableLanternBottles": "Refill propane-lantern bottles",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_EnableLanternBottles_tooltip": "Allows empty or partially used Base.Propane_Refill bottles and propane lanterns to be refilled at a depot. Default: On.",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_EnableWorkshopContainers": "Refill The Workshop propane containers",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_EnableWorkshopContainers_tooltip": "Allows compatible Large and Huge propane tanks from The Workshop B42 to be refilled. The Workshop remains optional. Default: On.",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_InfinitePropane": "Infinite industrial propane",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_InfinitePropane_tooltip": "Industrial tanks never lose propane when refilling containers. This takes effect immediately and displays Infinite in the context menu. Default: Off.",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_InitialEmptyChance": "Initial empty chance (percent)",
