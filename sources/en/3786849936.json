  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_InitialFillMax": "Maximum initial fill (0.0 to 1.0)",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_InitialFillMax_tooltip": "Maximum fill fraction rolled when a previously uninitialized industrial tank is first loaded. If minimum is higher than maximum, the mod safely swaps them. Default: 1.0.",
  "translate_en|mods/ArcadiaRefillablePropaneTanks_B42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ArcadiaRefillablePropaneTanks_InitialFillMin": "Minimum initial fill (0.0 to 1.0)",
