  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_ACL_Debug_Title": "Ambient City Lights",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights": "Ambient City Lights",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights.ActiveLightsPercent": "Active Lights (%%)",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights.ActiveLightsPercent_tooltip": "Controls how many supported city lights stay lit after the power grid shuts down. The selection is not rerolled when loading the game and is the same for every player in multiplayer. At 100%%, the full city lighting remains.",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights.Enabled": "Enable Ambient City Lights",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights.Enabled_tooltip": "Allows streetlights, illuminated signs, and supported outdoor lights to keep lighting urban areas at night after the power grid shuts down. Homes, appliances, and fuel pumps remain unpowered.",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights.FlickeringLights": "Flickering Lights",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights.FlickeringLights_tooltip": "Allows every supported light to develop a rare fault. Most only flicker briefly, while some may go dark for several in-game hours. The pattern is the same for every player in multiplayer.",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights.LightDecay": "Gradual Light Failures",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights.LightDecay_option1": "Off",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights.LightDecay_option2": "Very Slow (365 days)",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights.LightDecay_option3": "Slow (180 days)",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights.LightDecay_option4": "Normal (90 days)",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights.LightDecay_tooltip": "Allows more lights to fail over time after the power grid shuts down. The selected period determines when the amount set under “Lights Remaining” is reached. Existing worlds never count earlier days retroactively. Switching this option off temporarily restores the amount set under “Active Lights”. Switching it back on continues the previous failures.",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights.MinimumActiveLightsPercent": "Lights Remaining (%%)",
  "translate_en|mods/AmbientCityLights/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AmbientCityLights.MinimumActiveLightsPercent_tooltip": "Controls the minimum number of lights that remain working as more lights fail. If this value is higher than Active Lights, the lower value is used."
