  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PhunSprinters_Volume": "Percentage Sprinters Volume",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PhunSprinters_Volume_tooltip": "Volume of sprinter screech. 0 to disable",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PhunSprinters_option": "UI Layout",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PhunSprinters_option_option1": "Vertical",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PhunSprinters_option_option2": "Horizontal",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters": "PhunSprinters",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_AddToLoot": "Lootable Sensor",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_AddToLoot_tooltip": "If Always Show UI is disabled, tick this so that Military Issued sensor will appear in loot. Wearing these will show the UI. Requires restart. If you do not want any UI, disable this and the Always Show UI option",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_AlwaysShowElements": "Always Show UI",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_AlwaysShowElements_tooltip": "Always display the UI component in the upper right screen. Requires restart",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_DarknessLevel": "Darkness level",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_DarknessLevel_tooltip": "Adjusted light level where all sprinters will run",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Debug": "Debug",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Debug_tooltip": "Print verbosely (useful when diagnosing issues). Requires restart",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Decorate": "Decorate Sprinters",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Decorate_tooltip": "Dress the sprinters up around the holidays (only works with certain additional mods active and installed)",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_DefaultRisk": "Default Risk %%",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_DefaultRisk_tooltip": "Percentage chance of a zed being a sprinter. If you use PhunZones, this is the fallback risk level when no other value is specified by a zone (or its parent). Examples: 0 = no chance. 50 = 50%% chance and 100 = always",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_FrequencyOfEnvUpdate": "Env Checks",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_FrequencyOfEnvUpdate_tooltip": "Number of seconds before recalculating enviromental changes like light and fog. Increase for improved performance",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_HoursDiscount": "Hours Discount",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_HoursDiscount_tooltip": "The number of hours (across all characters) until risk level is fully applied. For example, if this value is 240 (10 game days) then on the fifth day of play (regardless of how many times they have died), the effective risk that a player is reduced by 50%%. Leave blank or 0 to ignore",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MaxDistance": "Max Distance",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MaxDistance_tooltip": "The maximum distance of player to zed must be to process the chance of being a sprinter (this is to improve performance trying to process zeds that are too far away)",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MaxQueue": "Queue Size",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MaxQueue_tooltip": "The max number of zeds to update per tick",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MinDistance": "Min Distance",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MinDistance_tooltip": "The minimum distance of player to zed must be to process the chance of being a sprinter (this is to prevent sudden popins)",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Mode": "Mode",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Mode_option1": "Dusk till dawn",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Mode_option2": "Always",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Mode_option3": "When its too dark outside **",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Mode_option4": "When its too dark around them ***",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Mode_tooltip": "This option governs when sprinters will run. ** = low performance impact, *** = med-high performance impact depending on population",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseCrescent": "Moon Phase (Crescent Moon)",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseCrescent_tooltip": "Adjust risk on nights with a crescent moon by this value. eg 50 would cut the risk by 50%% while 200 would be 200%% (double the risk). Leave blank or 0 for no adjustment.",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseFull": "Moon Phase (Full Moon)",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseFull_tooltip": "Adjust risk on nights with a full moon by this value. eg 50 would cut the risk by 50%% while 200 would be 200%% (double the risk). Leave blank or 0 for no adjustment.",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseGibbous": "Moon Phase (Gibbous)",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseGibbous_tooltip": "Adjust risk on nights with a gibbous moon by this value. eg 50 would cut the risk by 50%% while 200 would be 200%% (double the risk). Leave blank or 0 for no adjustment.",
