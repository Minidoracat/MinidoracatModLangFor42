  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseQuarter": "Moon Phase (First Quarter)",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseQuarter_tooltip": "Adjust risk on nights with a first quarter moon by this value. eg 50 would cut the risk by 50%% while 200 would be 200%% (double the risk). Leave blank or 0 for no adjustment.",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Skeletons": "Sprinter Skeletons (see tooltip)",
  "translate_en|mods/PhunSprinters2/common/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Skeletons_tooltip": "All sprinters appear as Skeletons. CURRENTLY DISABLED AS BUG IN VANILLA CAN CAUSE A CLIENT CRASH WHEN AIMING AT A SKELETON",
