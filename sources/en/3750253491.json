  "translate_en|mods/CommonSense/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CommonSense_ReplaceBandage_tooltip": "Enables/disables the menu to directly replace dirty bandages.",
  "translate_en|mods/CommonSense/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CommonSense_ShatterVehicleWindows": "Shatter Vehicle Windows",
  "translate_en|mods/CommonSense/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CommonSense_ShatterVehicleWindows_tooltip": "Determines whether Players can accidentally smash Vehicle door windows when failing to pry them open.<br>If enabled, this can happen at random (Based on the Window Shatter Chance setting).",
  "translate_en|mods/CommonSense/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CommonSense_WashOnly": "Wash Menu",
  "translate_en|mods/CommonSense/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CommonSense_WashOnly_tooltip": "Enables/disables the menu for washing only equipped or unequipped items.",
