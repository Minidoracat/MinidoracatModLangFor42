  "translate_en|mods/CommonSense/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CommonSense_ReinforcedDoorLevel": "Min. Reinforced Door Level",
  "translate_en|mods/CommonSense/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CommonSense_ReinforcedDoorLevel_tooltip": "Determines the Minimum level of Strength at which Players can pry open reinforced doors (Prison doors, metal grid doors, etc.)",
