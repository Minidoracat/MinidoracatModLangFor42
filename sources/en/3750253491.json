  "translate_en|mods/CommonSense/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CommonSense_PryAllDoors": "Pry All Doors",
  "translate_en|mods/CommonSense/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CommonSense_PryAllDoors_tooltip": "Toggles whether all doors can be pried open or not.<br>By default, reinforced doors (Prison doors, metal grid doors, etc.) cannot be pried open unless the Player has a Strength level equal to or higher than the Min. Reinforced Door Level.",
  "translate_en|mods/CommonSense/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CommonSense_PryBuildingDoors": "Pry Building Doors",
