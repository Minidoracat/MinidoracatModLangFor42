  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_CurrencyItem_tooltip": "Item type used as bus fare currency (e.g. Base.Money). Only used when Pay with Items is enabled.",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_EnableRandomTrip": "Enable Random Trip",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_EnableRandomTrip_tooltip": "When enabled, a Random Trip button appears in the travel panel. The destination is chosen randomly by the server from all available stops.",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_EnableTicketItem": "Enable Bus Ticket Item",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_EnableTicketItem_tooltip": "When enabled, holding a Bus Ticket Item pays for a trip for free (consuming one) at any stop that accepts it. When disabled, the item has no effect even if a player holds one.",
