  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_PricePerTile_tooltip": "Extra cost per tile of distance for dynamic pricing. Value is multiplied by 0.001 — default 1 means 0.001 per tile.",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_RandomTripPrice": "Random Trip Price",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_RandomTripPrice_tooltip": "Flat fare charged when a player uses the Random Trip button. Set to 0 for free random trips.",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_ReturnTripHours": "Return Trip Duration (hours)",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_ReturnTripHours_tooltip": "How many in-game hours a return ticket remains valid after traveling to a destination. These are in-game hours, not real time — they advance based on the server's time speed multiplier. Default is 24 in-game hours.",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_SpawnTicketInBuildings": "Spawn Ticket in Buildings",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_SpawnTicketInBuildings_tooltip": "When enabled, the Ticket Item is added to building loot distributions (schools, offices, houses) so it can be found while exploring.",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_SpawnTicketOnZombies": "Spawn Ticket on Zombies",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_SpawnTicketOnZombies_tooltip": "When enabled, the Ticket Item is added to zombie corpse loot (any zombie, plus a few commuter-type outfits) so it can be found by looting zombies.",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_TicketBuildingSpawnRate": "Ticket Building Spawn Rate",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_TicketBuildingSpawnRate_tooltip": "Relative chance weight used when adding the Ticket Item to building loot containers. Higher = more common. Only used when Spawn Ticket in Buildings is on.",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_TicketItem": "Ticket Item",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_TicketItem_tooltip": "Item type that acts as a free bus fare (e.g. BusStop.BusTicket). Only used when Enable Bus Ticket Item is on.",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_TicketZombieSpawnRate": "Ticket Zombie Spawn Rate",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_TicketZombieSpawnRate_tooltip": "Relative chance weight used when adding the Ticket Item to zombie corpse loot. Higher = more common. Only used when Spawn Ticket on Zombies is on.",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_UseBankPayment": "Pay with Bank",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_UseBankPayment_tooltip": "When enabled, fares are deducted from a bank mod's balance via its API (requires Bank Mod Global). If both sources are active, the bank covers any amount that items could not cover.",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_UseItemPayment": "Pay with Items",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_UseItemPayment_tooltip": "When enabled, fares are deducted from the player's inventory (Currency Item). If both Pay with Items and Pay with Bank are active, items are deducted first."
