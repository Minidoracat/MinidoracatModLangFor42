  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_BankModGlobal_tooltip": "Name of the Lua global the bank mod exposes its API under (e.g. MyBankMod). Must have a .API table with canAfford, deduct, formatLabel. Only used when Pay with Bank is enabled.",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_BasePrice": "Base Price",
  "translate_en|mods/BusStopFastTravel/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BusStop_BasePrice_tooltip": "Base cost in currency items for any trip, regardless of distance.",
