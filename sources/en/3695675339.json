  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_ScratchTicket_BulkStart_4": "Let's burn through the stack.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_ScratchTicket_BulkStart_5": "Time to see if the house slips.",
