  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_12": "Does anyone even use cash anymore? I do.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_13": "Lined up and ready to check.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_14": "Checking the harvest.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_15": "Let's see who was prepared.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_16": "This is going to take a minute.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_17": "Systematic approach. Open, check, drop.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_18": "Hope at least one of these is a winner.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_19": "Sorting the dead's pockets. My life now.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_2": "Let's see what the dead left behind.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_20": "Let's see the total haul.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_3": "Okay, let's see if anyone was carrying cash.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_4": "Sorting time. Hope it's worth the guilt.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_5": "Someone had to empty these eventually.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_6": "Let's count the inheritance.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_7": "A whole life in a pocket... let's look.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_8": "Okay, systemizing the loot.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_BulkStart_9": "Let's get this over with.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_1": "Just a picture of their kids... damn.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_10": "A folded gum wrapper. Great.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_11": "Bone dry.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_12": "Just an appointment card for the dentist.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_13": "A shopping list: Milk, Eggs, Bread.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_14": "Unpaid parking ticket. Lucky you.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_15": "Just a gym membership card.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_16": "Condom in the wrapper. Optimist.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_17": "Social Security card. Identity theft is over.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_18": "Just a frequent diner punch card.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_19": "Checkbook. Can't cash these anymore.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_2": "Video rental card. Useless now.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_20": "Absolutely nothing. Why carry it?",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_3": "Maxed out credit cards.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_4": "Grocery receipt from July.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_5": "Just a driver's license from Muldraugh.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_6": "Nothing but dust and lint.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_7": "Totally cleaned out.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_8": "Just a library card.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Empty_9": "Business cards... 'Insurance Agent'.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_1": "Holy... was this guy a banker?",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_10": "We are eating good tonight.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_11": "Saving up for something big, huh?",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_12": "Motherlode!",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_13": "Did he just rob a bank?",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_14": "That is a LOT of cash.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_15": "My hands are shaking... look at this.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_16": "Who carries this much cash?!",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_17": "Top tier loot right here.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_18": "Winner winner.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_19": "I could buy a car with this... if they ran.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_2": "Stashed away for a rainy day!",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_20": "This is what I'm talking about!",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_3": "Thick wad of hundreds!",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_4": "Jackpot. Sorry pal, I need this more.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_5": "This guy was loaded!",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_6": "Look at that stack...",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_7": "Retirement fund secured.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_8": "Must have been heading to the casino.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_High_9": "Unbelievable find.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_1": "Couple of singles.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_10": "Gas money, maybe.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_11": "Thin pickings.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_12": "Enough for a gumball.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_13": "Just some pennies and a dime.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_14": "Was this guy broke too?",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_15": "A wrinkled dollar bill.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_16": "Spare change.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_17": "Not exactly a fortune.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_18": "Guess he spent it all.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_19": "Just a few coins rattling around.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_2": "Just loose change.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_20": "Minimum wage wallet.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_3": "Barely enough for a coffee.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_4": "Lint and a quarter.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_5": "He kept the big bills elsewhere.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_6": "Pocket change.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_7": "Better than nothing, I suppose.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_8": "Couple of ones crumpled up.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Low_9": "Just a fiver.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_1": "Okay, twenties. Not bad.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_10": "Fair enough.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_11": "Good find.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_12": "This will buy some rounds.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_13": "A decent handful of cash.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_14": "Okay, we're getting somewhere.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_15": "Not rich, but not poor.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_16": "Useful paper.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_17": "I'll take it.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_18": "Lunch money secured.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_19": "Someone was responsible.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_2": "This helps.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_20": "A few decent bills tucked away.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_3": "Solid stash.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_4": "Kept a little emergency fund.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_5": "That's a week's worth of groceries.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_6": "Nice and crisp.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_7": "Respectable amount.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_8": "Someone just got paid.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Ambient_EN.txt|CECommon_Ambient_Wallet_Medium_9": "Adding to the pile.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Claim_NoWinners": "You don't have a winning ticket for me right now.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Claim_OptionMessage": "I need to cash in {total} worth of winning tickets.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Claim_OptionText": "Claim Win Payout ({total})",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Claim_ResultMulti": "Nice stack. That's {total} across {count} winning tickets.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Claim_ResultNone": "No winners to cash today. Bring me a real hit.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Claim_ResultSingle": "House pays. That's {total} for your winner.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_Back": "< Back",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_BackMessage": "Let's get back to business.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_ChatHouseBanter": "House Banter",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_ChatHouseBanterMessage": "How's the table feeling today?",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_ChatJackpot": "Current Jackpot",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_ChatJackpotMessage": "What's the current jackpot sitting at?",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_ChatPayouts": "How The Board Pays",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_ChatPayoutsMessage": "Break down the payouts for me.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_ChatWinners": "Winners This Week",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_ChatWinnersMessage": "Who has been winning this week?",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_HouseBanterReply_1": "Luck's moody, but business is awake. That's usually enough.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_HouseBanterReply_2": "Table's been mean, which means it's due to flinch eventually.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_HouseBanterReply_3": "I've seen worse boards. I've also seen better liars.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_HouseBanterReply_4": "People keep chasing the top line. House keeps eating the nerves.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_JackpotReply_1": "Current live jackpot is {jackpot}. Common wins top out around {commonHighMax}, so anything above that is the real board.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_JackpotReply_2": "Board's sitting at {jackpot} right now. Regular winners stay under about {commonHighMax}; the rest is jackpot country.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_JackpotReply_3": "Live pot's up to {jackpot}. Standard tickets can still hit, but the true jackpot starts above roughly {commonHighMax}.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_PayoutReply": "Low hits run up to {lowMax}, medium hits climb to about {mediumMax}, and the high common board stops near {highMax}. After that, you're chasing the live jackpot at {jackpot}.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_RootChatIntro_1": "You want table talk or board talk?",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_RootChatIntro_2": "Fine. Ask your lottery questions.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_RootChatIntro_3": "All right. What part of the board are you chasing?",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_RootChatMessage": "Let's talk lottery for a second.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_WinnerGreetingMulti_1": "Damn, you've got {count} winners on you already. That's {total} waiting at my counter.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_WinnerGreetingMulti_2": "Now that's a surprise. {count} winning tickets for a total of {total}.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_WinnerGreetingMulti_3": "You're walking in hot. I count {count} winning scratches, worth {total} altogether.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_WinnerGreetingSingle_1": "Hold on, you've got a live winner on you. That's {total}. Didn't expect you to walk in already beating the board.",
  "translate_en|mods/CurrencyExpanded/common/media/lua/shared/Translate/EN/CECommon_Dialogue_EN.txt|CECommon_Dialogue_Gambler_WinnerGreetingSingle_2": "Well now, that's a winning ticket in your pocket. {total} on the table already.",
