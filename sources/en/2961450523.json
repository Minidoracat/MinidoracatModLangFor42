  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EBW_VariableSpawnRateGunStoreCommon": "Increase or Decrease The Spawns for more Common Eastern Block Equipment (Mosins, AKMs, Makarovs)",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EBW_VariableSpawnRateGunStores": "Increase or Decrease The Spawns for Eastern Block Equipment Generally",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EBW_VariableSpawnRateGunStoresRare": "Increase or Decrease The Spawns for Rarer Eastern Block Equipment (RPKs, VSSs, 5.45 Guns)",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EBW_VariableSpawnRatePlankStash": "Increase or Decrease The Spawns for Eastern Block Equipment In Hiiden Gun Stashes",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_AKKS": "The Avtomaticheskiy karabin Kalashnikova with a folding stock.<br>An AKMS Produced by Bulgarians under License.<br>Production ran from Mid 60s till the fall of the USSR.",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_AKM": "A improved version of the AK-47.<br>It saw nearly universal use across the Pro-Soviet World.<br>Produced between 1959 and 1977.",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_AKS74U": "The AKS-74U is a shortened AKS-74 developed by the USSR.<br>It saw use by Vehicle crews, Law Enforcement and Special Forces .<br>It Produced between 1979 and the 1993.",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_AMD65": "A Hungarian licensed variant of the selective fire AKM rifle.<br>Developed for Armoured and Paratrooper Troops.<br>Produced between 1965 and 1980",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_APS": "A select-fire machine pistol from the USSR.<br>First issued to vehicle crews, before being issued to Special Forces.<br>Produced between 1951 and 1958.",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_M56SKS": "A SKS produced between under License by Romania (RSR).<br>Produced between 1956 and 1960.",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_MOSIN": "The most common version of the Mosin�Nagant rifle.<br>Produced between 1930 and 1945.",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_MPI72": "An improved AKM produced by East Germany (GDR).",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_MPI74": "AK-74 produced under License by East Germany (GDR).<br>Produced between 1983 and the reunification in 1990.",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_PM63": "A Polish SMG used by Polish Special Ops units and Airborne units.<br>Produced between 1965 and 1977.",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_PSL": "A Romanian DMR similar in appearance to the SVD.<br>Mechanically Unrelated to the SVD, the PSL is a scaled up RPK.<br> Produced from 1974",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_RPK": "A LMG developed from The AKM to standardize small arms.<br>Produced between 1961 and 1978.",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_RPK74": "The LMG member of the AK-74 Family, with a heavier, longer barrel.<br>Produced Since 1974 seeing service across the Warsaw Pact",
  "translate_en|mods/Totally's Eastern Bloc Firearms Pack/42.0/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_Scorpion": "A Czechoslovak machine pistol issued to vehicle crew and special forces.<br>Produced between 1961 and 1979.",
