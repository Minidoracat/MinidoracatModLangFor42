  "translate_en|mods/PhunSprinters/42.0.0/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_DefaultRisk_tooltip": "Percentage chance of a zed being a sprinter. This value is used when there is no valid PhunZones value to use. e.g. 0 = no chance. 50 = 50% chance and 100 = always",
