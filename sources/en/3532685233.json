  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/IG_UI_EN.txt|IGUI_PhunSprinters_minRisk": "Sprinter Risk",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/IG_UI_EN.txt|IGUI_PhunSprinters_minRisk_Tooltip": "The risk of sprinters appearing in this zone before being adjusted for character playtime or moon phase",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters": "PhunSprinters",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_DarknessLevel": "Darkness level",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_DarknessLevel_tooltip": "Adjusted light level where all sprinters will run",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Debug": "Debug",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Debug_tooltip": "Print verbosely (useful when diagnosing issues). Requires restart",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Decorate": "Decorate",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Decorate_tooltip": "Dress the sprinters up around the holidays (only works with certain additional mods active and installed)",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_DefaultRisk": "Default Risk",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_DefaultRisk_tooltip": "Percentage chance of a zed being a sprinter. This value is used when there is no valid PhunZones value to use. e.g. 0 = no chance. 50 = 50% chance and 100 = always",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_FrequencyOfEnvUpdate": "Env Checks",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_FrequencyOfEnvUpdate_tooltip": "Number of seconds before recalculating enviromental changes like light and fog. Increase for improved performance",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_HoursDiscount": "Hours Discount",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_HoursDiscount_tooltip": "The number of hours (across all characters) until risk level is fully applied. For example, if this value is 240 (10 game days) then on the fifth day of play (regardless of how many times they have died), the effective risk that a player is reduced by 50%. Leave blank or 0 to ignore",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MaxDistance": "Max Distance",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MaxDistance_tooltip": "The maximum distance of player to zed must be to process the chance of being a sprinter (this is to improve performance trying to process zeds that are too far away)",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MaxQueue": "Queue Size",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MaxQueue_tooltip": "The max number of zeds to update per tick",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MinDistance": "Min Distance",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MinDistance_tooltip": "The minimum distance of player to zed must be to process the chance of being a sprinter (this is to prevent sudden popins)",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Mode": "Sprinters run:",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Mode_option1": "Between Dusk and Dawn",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Mode_option2": "Always",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Mode_option3": "When its too dark outside **",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Mode_option4": "When its too dark around them ***",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_Mode_tooltip": "This option determins when a sprinter will actually run. ** = low performance impact, *** = med-high performance impact depending on population",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseCrescent": "Moon Phase (Crescent Moon)",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseCrescent_tooltip": "Adjust risk on nights with a crescent moon by this value. eg 50 would cut the risk by 50% while 200 would be 200% (double the risk). Leave blank or 0 for no adjustment.",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseFull": "Moon Phase (Full Moon)",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseFull_tooltip": "Adjust risk on nights with a full moon by this value. eg 50 would cut the risk by 50% while 200 would be 200% (double the risk). Leave blank or 0 for no adjustment.",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseGibbous": "Moon Phase (Gibbous)",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseGibbous_tooltip": "Adjust risk on nights with a gibbous moon by this value. eg 50 would cut the risk by 50% while 200 would be 200% (double the risk). Leave blank or 0 for no adjustment.",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseNew": "Moon Phase (New Moon)",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseNew_tooltip": "Adjust risk on nights with a new moon by this value. eg 50 would cut the risk by 50% while 200 would be 200% (double the risk). Leave blank or 0 for no adjustment.",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseQuarter": "Moon Phase (First Quarter)",
  "translate_en|mods/PhunSprinters/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MoonPhaseQuarter_tooltip": "Adjust risk on nights with a first quarter moon by this value. eg 50 would cut the risk by 50% while 200 would be 200% (double the risk). Leave blank or 0 for no adjustment.",
