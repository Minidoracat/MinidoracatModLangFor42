  "translate_en|mods/PhunSprinters/42.0.0/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_HoursDiscount": "Hours Discount",
  "translate_en|mods/PhunSprinters/42.0.0/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_HoursDiscount_tooltip": "The number of hours (across all characters) until risk level is fully applied. For example, if this value is 240 (10 game days) then on the fifth day of play (regardless of how many times they have died), the effective risk that a player is reduced by 50%. Leave blank or 0 to ignore",
  "translate_en|mods/PhunSprinters/42.0.0/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MaxDistance": "Max Distance",
  "translate_en|mods/PhunSprinters/42.0.0/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_PhunSprinters_MaxDistance_tooltip": "The maximum distance of player to zed must be to process the chance of being a sprinter (this is to improve performance trying to process zeds that are too far away)",
