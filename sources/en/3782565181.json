  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_AdapterCraftLevel_tooltip": "Metalworking level needed to craft any caliber adapter. Default: 3. The manual is still required.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Debug": "Detailed logging",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Debug_tooltip": "Writes extra diagnostic information to the game log. Useful when reporting a problem; leave off during normal play.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_DevStartingKit": "Give new characters a test kit",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_DevStartingKit_tooltip": "Starts new characters with guns, ammunition, suppressors, and crafting tools. For testing; leave off for a normal playthrough.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable12GaugeSuppressors": "12 Gauge suppressors",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable12GaugeSuppressors_tooltip": "Allows 12 Gauge suppressors to attach and work on supported guns, and includes matching suppressors and adapters in loot. Double-barrel shotguns and the sawn-off JS-2000 are excluded.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable3030Suppressors": ".30-30 suppressors",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable3030Suppressors_tooltip": "Allows .30-30 suppressors to attach and work on supported guns, and includes matching suppressors and adapters in loot.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable308Suppressors": ".308 suppressors",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable308Suppressors_tooltip": "Allows .308 suppressors to attach and work on supported guns, and includes matching suppressors and adapters in loot.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable357Suppressors": ".357 suppressors",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable357Suppressors_tooltip": "Allows .357 suppressors to attach and work on supported guns, and includes matching suppressors and adapters in loot.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable44Suppressors": ".44 suppressors",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable44Suppressors_tooltip": "Allows .44 suppressors to attach and work on supported guns, and includes matching suppressors and adapters in loot. The Desert Eagle is supported; the Magnum revolver is excluded.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable45ACPSuppressors": ".45 ACP suppressors",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable45ACPSuppressors_tooltip": "Allows .45 ACP suppressors to attach and work on supported guns, and includes matching suppressors and adapters in loot.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable556Suppressors": "5.56 suppressors",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable556Suppressors_tooltip": "Allows 5.56 suppressors to attach and work on supported guns, and includes matching suppressors and adapters in loot.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable9mmSuppressors": "9mm suppressors",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Enable9mmSuppressors_tooltip": "Allows 9mm suppressors to attach and work on supported guns, and includes matching suppressors and adapters in loot.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_EnableSuppressorHeat": "Heat glow and smoke",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_EnableSuppressorHeat_tooltip": "Sustained fire heats the suppressor until its surface glows. Smoke rises while aiming; both fade as it cools. Visual only: heat does not affect accuracy, damage, sound reduction, or wear.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_EnableSuppressorRepairs": "Allow machined suppressor repairs",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_EnableSuppressorRepairs_tooltip": "Adds welding recipes to restore worn machined suppressors to full condition. Requires tools and materials. Oil-filter suppressors cannot be repaired.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_EnableVehicleOil": "Engine oil and spills",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_EnableVehicleOil_tooltip": "Tracks oil level and condition. A missing filter drips even with the engine off; running the engine drains oil faster. Parked leaks grow into a puddle, while moving leaks leave a trail. Installing a filter stops the leak but does not refill the engine. Low or worn-out oil causes wear while running. Turn off for the original filter-only mechanic.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_FindSuppressorsNaturally": "Find finished suppressors",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_FindSuppressorsNaturally_tooltip": "Adds finished suppressors to loot. Turn off for craft-only suppressors: manuals, adapters, baffles, and oil filters can still be found. Vehicle filter salvage remains available. Does not remove items already spawned.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_LootRarity": "Loot abundance (%%)",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_LootRarity_tooltip": "How common this mod's loot is. 100 uses the standard loot weights; lower is rarer, higher is more common. Applies to crafting supplies and manuals even in craft-only mode. 0 removes all mod loot, including manuals. Does not change containers already filled.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined12GaugeCraftLevel": "12 Gauge machined: Metalworking",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined12GaugeCraftLevel_tooltip": "Metalworking level needed to craft the 12 Gauge machined suppressor. Default: 8. The manual and recipe materials are still required.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined3030CraftLevel": ".30-30 machined: Metalworking",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined3030CraftLevel_tooltip": "Metalworking level needed to craft the .30-30 machined suppressor. Default: 5. The manual and recipe materials are still required.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined308CraftLevel": ".308 machined: Metalworking",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined308CraftLevel_tooltip": "Metalworking level needed to craft the .308 machined suppressor. Default: 7. The manual and recipe materials are still required.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined357CraftLevel": ".357 machined: Metalworking",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined357CraftLevel_tooltip": "Metalworking level needed to craft the .357 machined suppressor. Default: 5. The manual and recipe materials are still required.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined44CraftLevel": ".44 machined: Metalworking",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined44CraftLevel_tooltip": "Metalworking level needed to craft the .44 machined suppressor. Default: 5. The manual and recipe materials are still required.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined45ACPCraftLevel": ".45 ACP machined: Metalworking",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined45ACPCraftLevel_tooltip": "Metalworking level needed to craft the .45 ACP machined suppressor. Default: 4. The manual and recipe materials are still required.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined556CraftLevel": "5.56 machined: Metalworking",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined556CraftLevel_tooltip": "Metalworking level needed to craft the 5.56 machined suppressor. Default: 7. The manual and recipe materials are still required.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined9mmCraftLevel": "9mm machined: Metalworking",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_Machined9mmCraftLevel_tooltip": "Metalworking level needed to craft the 9mm machined suppressor. Default: 4. The manual and recipe materials are still required.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_OilChangeHours": "Oil change interval (engine hours)",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_OilChangeHours_tooltip": "In-game hours of engine running time before fresh oil wears out. Default: 100. Drain old oil, then refill with engine oil. Topping up mixes fresh oil with what remains. Requires Engine oil and spills.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_OilFilterCraftLevel": "Oil-filter suppressors: Metalworking",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_OilFilterCraftLevel_tooltip": "Metalworking level needed to craft any oil-filter suppressor. Default: 3. Adapter requirements are set separately; the manual is still required.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_OilFilterEngineDamage": "Engine condition lost per interval",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_OilFilterEngineDamage_tooltip": "Condition lost each time the wear interval passes without a filter. Default: 1. Used with Engine wear interval.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_OilFilterRemovalSeconds": "Filter removal time (seconds)",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_OilFilterRemovalSeconds_tooltip": "Time spent removing a vehicle oil filter at the engine. Default: 10 seconds. The removed filter can be used for crafting or installed in a vehicle.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_OilFilterWearMinutes": "Engine wear interval (game minutes)",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_OilFilterWearMinutes_tooltip": "How often an engine loses condition when running without a filter. With Engine oil and spills enabled, this also applies below 25%% oil or at 0%% oil condition. Default: every 10 in-game minutes.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_SoundRadiusReduction": "Zombie hearing range (%%)",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_SoundRadiusReduction_tooltip": "How far a suppressed shot carries compared with a normal shot. Lower is quieter. Default: 20%% of normal range. At 100, range is unchanged. Oil-filter suppressors carry farther than machined ones.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_SoundVolumeReduction": "Shot volume (%%)",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_SoundVolumeReduction_tooltip": "Scales the suppressed shot's volume setting. Lower values reduce it; 100 leaves the weapon's original value unchanged. Default: 55. The recording also affects loudness, so 50 does not mean half as loud.",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_SuppressorDurability": "Suppressor lifespan",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_SuppressorDurability_option1": "Short (5,000 shots)",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_SuppressorDurability_option2": "Standard (10,000 shots)",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_SuppressorDurability_option3": "Long (15,000 shots)",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_SuppressorDurability_option4": "No wear",
  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_SuppressorDurability_tooltip": "Shots from full condition to worn out. Applies to both suppressor types. At 0 condition, suppression stops. Machined suppressors can be repaired; oil-filter suppressors must be replaced."
}
