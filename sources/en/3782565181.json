  "translate_en|mods/simple-suppressors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SimpleSuppressors_FindSuppressorsNaturally_tooltip": "When off, suppressors and parts never spawn in containers and must be crafted.",
