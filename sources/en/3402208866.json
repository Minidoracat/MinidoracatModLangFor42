{
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies": "Barricades Hurt Zombies",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_BaseDamage": "Structure Damage (Default: 5)",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_BaseDamage_tooltip": "Fixed HP per confirmed structure hit = this value / 100, before material multipliers. 5 removes 0.05 HP: roughly 30-36 wood hits for a normal B42.20.2 zombie. Set 0 to disable structure damage, including windows. Existing worlds keep their saved values.",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_BloodEffects": "Blood Effects",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_BloodEffects_tooltip": "If enabled, zombies will create blood splatters when taking damage. More blood appears with stronger materials and armor types.",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_DamageMode": "Damage Source",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_DamageMode_option1": "Structures + Vehicles",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_DamageMode_option2": "All Objects + Vehicles",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_DamageMode_option3": "Disabled",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_DamageMode_option4": "Player-Built / Moved Only",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_DamageMode_option5": "Barricades Only (Default)",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_DamageMode_option6": "Modded Defenses Only",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_DamageMode_tooltip": "Barricades Only damages zombies hitting actual plank, sheet-metal or bar barricades; bare doors, windows, furniture and vehicles do nothing. Player-Built / Moved includes barricades and marked construction/furniture. Modded Defenses Only requires a custom BarricadeDamageMultiplier. Disabled turns off all BHZ damage. Saved choices are preserved.",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_DebugMode": "Debug Mode",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_DebugMode_tooltip": "Enables debug logging for general mod operations. Use only when troubleshooting issues.",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_HeavySpikeMultiplier": "Heavy Spike Multiplier",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_HeavySpikeMultiplier_tooltip": "How much extra damage heavy spiked vehicle armor deals. 1.75 means 75%% more damage than wood. Applies to heavy spiked protection and spiked plows.",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_LightSpikeMultiplier": "Light Spike Multiplier",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_LightSpikeMultiplier_tooltip": "How much extra damage light spiked vehicle armor deals. 1.5 means 50%% more damage than wood. Applies to light spiked protection and basic bullbars.",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_LogLevel": "Log Level",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_LogLevel_option1": "None (Production)",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_LogLevel_option2": "Errors Only",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_LogLevel_option3": "Warnings",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_LogLevel_option4": "Info",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_LogLevel_option5": "Debug",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_LogLevel_option6": "Trace (Verbose)",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_LogLevel_tooltip": "Controls how much information is logged. Higher levels produce more output and may impact performance.",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_MetalHeavyMultiplier": "Heavy Metal Armor Multiplier",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_MetalHeavyMultiplier_tooltip": "How much extra damage heavy vehicle armor deals. 1.4 means 40%% more damage than wood. Applies to non-spiked heavy protection.",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_MetalMultiplier": "Metal Damage Multiplier",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_MetalMultiplier_tooltip": "How much extra damage metal barriers and basic vehicles deal compared to wooden structures. 1.25 means 25%% more damage than wood.",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_ReinforcedMultiplier": "Reinforced Armor Multiplier",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_ReinforcedMultiplier_tooltip": "How much extra damage reinforced vehicle armor deals. 2.0 means double damage compared to wood. This is the strongest armor type.",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_ScaleByToughness": "Scale Damage to Zombie Toughness",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_ScaleByToughness_tooltip": "Off by default: preserve fixed HP damage and Zombie Lore toughness differences. When enabled, scale by the average Fragile or Tough spawn health relative to Normal. Hit counts remain approximate. Normal and Random use no scaling; Random retains individual health variation.",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_ThumpDamageCooldown": "Deprecated: Thump Cooldown (Ignored)",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_ThumpDamageCooldown_tooltip": "Deprecated compatibility option. This setting is not used; structure damage is tied to actual vanilla thump world-sound events.",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_VehicleBaseDamage": "Vehicle Damage (Default: 5)",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_VehicleBaseDamage_tooltip": "Fixed HP per confirmed occupied-vehicle hit = this value / 100, before material multipliers. At 5, basic metal removes 0.0625 HP (roughly 24-29 normal-zombie hits). Only Structures + Vehicles and All Objects + Vehicles enable this. Set 0 to disable vehicle damage.",
  "translate_en|mods/BarricadesHurtZombies/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BarricadesHurtZombies_VehicleDamageCooldown": "Deprecated: Vehicle Cooldown (Ignored)",
