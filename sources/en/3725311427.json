  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Recipes.json|Reverse_Solar_Roof_Tile": "Reverse Solar Roof Tile",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Recipes.json|UnWireCarBattery": "Unwire Car Battery",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Recipes.json|WireCarBattery": "Wire Car Battery",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR": "Plysken Solar Revolution",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_AllowVanillaConnect": "Allow connecting map buildings",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_AllowVanillaConnect_tooltip": "Lets you connect a building that is part of the map - not one you built - to a Battery Bank, with Connect this area to the Power Bank.<br>Off by default everywhere, singleplayer and co-op included - turn it on to use it.<br>The reason it defaults to off: on a server, anyone could otherwise connect a neighbour's house and switch their appliances off from the Solar Computer.",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_BackupConnectFloors": "Backup Generator Vertical Reach (floors)",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_BackupConnectFloors_tooltip": "How many floors up or down a battery bank can reach to find its backup generator.<br>1 is the default and the original behaviour. Raise it if your generator sits on a roof, or several floors away from the bank.<br>This also widens the distance budget, so a rooftop generator is no longer penalised for being high up.",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_BackupConnectRange": "Backup Generator Range (tiles)",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_BackupConnectRange_tooltip": "Max distance to link a backup generator to a battery bank.<br>0 = use Electrician skill (default, ~10 tiles max)<br>1-50 = fixed range in tiles, any skill.",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_BatteryBankSpawn": "Battery Bank Spawn",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_BatteryBankSpawn_option1": "None",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_BatteryBankSpawn_option2": "Very Rare",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_BatteryBankSpawn_option3": "Rare",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_BatteryBankSpawn_option4": "Uncommon",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_BatteryBankSpawn_tooltip": "Rarity of Battery Bank spawning on the map.",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_ChargeFreq": "Charge Frequency",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_ChargeFreq_option1": "Every Ten Minutes",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_ChargeFreq_option2": "Every Hour",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_ChargeFreq_tooltip": "How often Battery Bank will charge",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_ConnectPanelMin": "Connect Panel Time",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_ConnectPanelMin_tooltip": "Base number of in-game minutes it takes to connect one panel.",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_DIYBatteryMultiplier": "DIY Battery Capacity (from source battery)",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_DIYBatteryMultiplier_tooltip": "Multiplies the capacity of the source battery. Default is 100%%: the DIY holds exactly what its source held, and the real gain is wear - it degrades about sixty times slower. Higher values add capacity: at 800%%, a wired CarBattery1 (50Ah) gives 400Ah, an Improvised Battery (100Ah) gives 800Ah.",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_HardenedPanelRecipe": "Realistic Solar Panel Recipe",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_HardenedPanelRecipe_tooltip": "When ON, crafting solar panels needs a harder, more realistic recipe (tempered glass + aluminium frame, more components, higher Electricity skill).<br>OFF = the standard recipe (default).<br>This sets what the magazine teaches, so choose it before creating a save.",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_LRMBatteries": "Loot Rarity Multiplier - Batteries",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_LRMBatteries_tooltip": "Batteries spawns in random containers and pre-placed crates multiplier",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_LRMMisc": "Loot Rarity Multiplier - Misc",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_LRMMisc_tooltip": "Spawn rate multiplier for the magazine, the Inverter and the Solar Failsafe, in random containers and pre-placed crates",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_LRMSolarPanels": "Loot Rarity Multiplier - Solar panels",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_LRMSolarPanels_tooltip": "Solar panel spawns in random containers and pre-placed crates multiplier",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_PanelConnectFloors": "Solar Panel Vertical Reach (floors)",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_PanelConnectFloors_tooltip": "How many floors up or down a solar panel can reach to find its battery bank.<br>3 is the default and the original behaviour. Raise it if your bank sits deep in a basement or bunker, or high up a tower.<br>Each extra floor widens the scan above and below, which costs performance on very big buildings.",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_PanelConnectRange": "Solar Panel Connection Range (tiles)",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_PanelConnectRange_tooltip": "Max horizontal distance between a solar panel and the battery bank it connects to.<br>20 is the default and the original behaviour. Raise it for large bases and bunkers.<br>Vertical reach is set separately, see Solar Panel Vertical Reach.<br>Larger values make the mod scan a wider area, which costs performance on very big buildings.",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_SolarCrateSpawn": "Solar Crate Spawn",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_SolarCrateSpawn_option1": "None",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_SolarCrateSpawn_option2": "Very Rare",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_SolarCrateSpawn_option3": "Rare",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_SolarCrateSpawn_option4": "Uncommon",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_SolarCrateSpawn_tooltip": "Rarity of pre-placed solar crates spawning on the map, in sheds, garages, storage units, electronics storage and farm storage.<br>Crates are the best find in the mod - a whole batch of parts at once - so they stay rarer than battery banks.<br>Set to None to remove them entirely.",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_batteryDegradeChance": "Battery Degradation",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_batteryDegradeChance_tooltip": "Batteries lose 1 point of condition per day while the bank is running.<br>Set to 0 to switch degradation off entirely. Any other value simply turns it on - the number itself has no effect.",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_consumptionMultiplier": "Power Consumption (%%)",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_consumptionMultiplier_tooltip": "Multiplier for device power consumption, in percent.<br>100 = normal consumption (default)<br>50 = half consumption<br>Lower this if powering your base requires too many solar panels.",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_solarPanelEfficiency": "Solar Panel Efficiency",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_solarPanelEfficiency_tooltip": "Solar panel power efficiency<br>12%% is realistic for 1993<br>25%% is modern solar<br>default is unrealistic",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_solarPanelWorldSpawns": "Solar Panel / Crate World Spawns",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PSR_solarPanelWorldSpawns_tooltip": "How likely pre-placed solar panels and crates are to spawn at a given spawn location.<br>Requires external API to work.",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PSR_NoPanels": "No Panel",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PSR_PanelFar": "This panel is too far",
  "translate_en|mods/Plysken Solar Revolution/42.1/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PSR_PowerBank": "Stores the power your solar panels collect and feeds it to the building.<br>Must be placed in an enclosed room, then connected to your panels.<br>Requires some Electrical knowledge. No fuel needed."
}
