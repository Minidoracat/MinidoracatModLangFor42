{
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS": "Traits As Skills",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_AutoRemoveNegativesAtLevel": "Initial level to remove traits",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_AutoRemoveNegativesAtLevel_tooltip": "This is the INITIAL level required in a trait skill for negative traits to be removed automatically. If the starting level is lower than this number, the player must level up to remove the spectrum's already-surpassed negative traits.",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_Grid": "Spectrum customization",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_Grid_tooltip": "Customize the evolutive trait spectrums for this server. Drag traits from the pool into the level ranges of each spectrum. Changes are shared by all players on the server.",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_PermanentDeafness": "Permanent deafness",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_PermanentDeafness_tooltip": "Characters born deaf keep the trait forever. Turn it off to let them raise the Hearing spectrum and lose the trait.",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_PermanentShortsightedness": "Permanent shortsightedness",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_PermanentShortsightedness_tooltip": "Characters born shortsighted keep the trait forever. Turn it off to let them raise the Vision spectrum and lose the trait.",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_ShootingHearingLossMultiplier": "Shooting hearing loss multiplier",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_ShootingHearingLossMultiplier_tooltip": "Multiplies the Hearing XP lost every shot fired. 1.0 normal. 2.0 double. 0.5 half. 0.0 disables hearing loss from gunfire.",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_TooltipLossesIfOwned": "Show trait losses only if owned",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_TooltipLossesIfOwned_tooltip": "When ON, the 'Level down' line of the spectrum tooltip only shows the loss of positive traits that the character actually has. Turn it off to always show which positive traits a level would take away.",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_XPGainActiveMultiplier": "Active XP gain multiplier",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_XPGainActiveMultiplier_tooltip": "Multiplies the XP earned by playing (eating well reading healing killing zombies driving). 1.0 normal. 2.0 double. 0.5 half. 0.0 off.",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_XPGainPassiveMultiplier": "Passive XP gain multiplier",
  "translate_en|mods/traitsAsSkills/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TAS_XPGainPassiveMultiplier_tooltip": "Multiplies the XP that spectrums earn passively over time (resting staying healthy well fed and hydrated). 1.0 normal. 2.0 double. 0.5 half. 0.0 off.",
