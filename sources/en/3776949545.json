  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Recipes_EN.txt|Recipe_Make_Fletchings_Ten": "Make Fletchings",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Recipes_EN.txt|Recipe_Make_Fletchings_Two": "Make Fletchings",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Recipes_EN.txt|Recipe_Make_FluFlu_Fletchings_Four": "Make Huge Fletchings",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows": "[SVRP] Classic Bows",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_AimingXPMultiplier": "Aiming XP Multiplier",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_AimingXPMultiplier_tooltip": "Multiplies the Aiming XP earned from hitting or killing targets with bows and crossbows. 1.0 = vanilla rate. Increase for faster skill progression; set to 0 to disable XP gain from bows entirely. (Default: 1.0)",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_DamageScale": "Bow & Crossbow Damage Scale",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_DamageScale_tooltip": "A global damage multiplier applied to all bows and crossbows. 1.0 = standard damage. Values above 1.0 make bows more lethal; below 1.0 makes them weaker. Does not affect vanilla firearms. (Default: 1.0)",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_EnableDebugMode": "Enable Debug Mode",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_EnableDebugMode_tooltip": "When enabled, activates all [SVRP_CB_DEBUG] log output and runs internal diagnostic tests on game boot (e.g. quiver container checks). Leave OFF during normal play. Enable only when diagnosing issues. (Default: Off)",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_FixedAimingLevel": "Minimum Aiming Skill for Hit Calculations",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_FixedAimingLevel_tooltip": "Sets a minimum Aiming skill level (0–10) used when calculating bow and crossbow accuracy. If your character's Aiming level is lower than this value, this value is used instead. Useful for server admins who want consistent accuracy regardless of skill. Set to 0 to disable (uses the character's actual level). (Default: 0)",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_OnlyRecoverFromCorpses": "Recover Arrows from Corpses Only",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_OnlyRecoverFromCorpses_tooltip": "When enabled, arrows and bolts can only be recovered from zombie and animal corpses — they will not be dropped on the ground after missing or hitting the environment. Overrides the recovery chance for environmental hits. (Default: Off)",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_RecoverMissedArrowsChance": "Arrow Recovery Chance (%)",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_RecoverMissedArrowsChance_tooltip": "Percentage chance (0–100) that a fired arrow or bolt survives hitting the environment (walls, ground, objects) and can be picked back up. Set to 0 to disable environmental recovery entirely. Set to 100 for maximum recovery. (Default: 100)",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_RetroactiveSpawnBows": "Retroactive Loot Spawning (Existing Saves)",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_RetroactiveSpawnBows_tooltip": "When enabled, the server will inject Classic Bows loot into hunting stores, sporting goods areas, and gun containers that have already been generated but not yet looted. Turn this ON if you added this mod to an existing save game — it gives the world a chance to populate bows in areas you have not visited yet. Has no effect on areas you have already looted. (Default: Off)",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_SpawnRateMultiplier": "Loot Spawn Rate Multiplier",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_SVRPClassicBows_SpawnRateMultiplier_tooltip": "Multiplies how often bows, crossbows, arrows, and bolts appear in the world as loot. 1.0 = default distribution. Values above 1.0 increase frequency; set to 0 to disable all Classic Bows loot spawning. (Default: 1.0)",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_MBA_Bow_Stave": "This stave is not yet a bow.<br>It must be carved some more.<br>It's in the right click menu.",
  "translate_en|mods/[SVRP] ClassicBows/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_MBA_FluFlu": "Reduces range.<br>Increases accuracy by the same amount normal fletchings do.",
