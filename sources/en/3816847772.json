  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_ShowTestMenu": "Show storm test menu",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_ShowTestMenu_tooltip": "Adds an 'Extreme Weather' entry to the right-click menu to start or stop storms. Always shown to admins and in single-player debug mode. In multiplayer only admins (and the co-op host) see it.",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_StormChance": "Daily storm chance (percent)",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_StormChance_tooltip": "Chance per in-game day that an extreme weather event begins (rolled hourly).",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoBreaksWindows": "Tornadoes smash windows",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoDestroysBuildings": "Tornadoes destroy buildings",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoDestroysBuildings_tooltip": "Tornadoes tear apart what they pass over, scaled by strength: EF1 knocks down fences, EF2 starts on roofs and loose objects, EF3 rips off roofs and upper floors, EF4 brings down many walls, EF5 levels buildings to the foundations. Includes player-built bases. The damage is permanent.",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoMaxEF": "Strongest tornado (EF rating)",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoMaxEF_tooltip": "Tornadoes roll EF1 35 percent, EF2 28, EF3 20, EF4 12, EF5 5 within this range. EF3+ rip off doors and wreck cars, EF4+ uproot trees, EF5 flattens player-built walls and fences.",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoMaxHours": "Tornado: longest (hours)",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoMaxHours_tooltip": "Longest a tornado lasts, in game hours (72 = 3 days). 0 = use the general maximum storm length. With both left at 0 a tornado never lasts more than 3 hours.",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoMinEF": "Weakest tornado (EF rating)",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoMinHours": "Tornado: shortest (hours)",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoMinHours_tooltip": "Shortest a tornado lasts, in game hours. 0 = use the general minimum storm length.",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoPickup": "Tornadoes can pick up players",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoPickup_tooltip": "EF2+ tornadoes can lift players on foot who get into the funnel, spin them around and throw them clear. Landing damage and fracture chance scale with the EF rating.",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoPlayerDeath": "Tornado landings can kill players",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoPlayerDeath_tooltip": "A player thrown by a tornado can die on landing: EF3 10 percent, EF4 40 percent, EF5 85 percent. Off = landings only injure.",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoVehicles": "Tornadoes can throw vehicles",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoVehicles_tooltip": "Vehicles in the funnel get pushed around by its winds, more the bigger the tornado: EF1 slides them, EF2 shoves and spins them, EF3 lifts light cars and rolls them, EF4 throws most cars and EF5 throws anything, trucks too. Heavier vehicles move less.",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoZombiePickup": "Tornadoes can pick up zombies",
  "translate_en|mods/ExtremeWeather/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ExtremeWeather_TornadoZombiePickup_tooltip": "EF2+ tornadoes sweep up zombies outdoors in the funnel, spin them around and throw them out. Stronger tornadoes kill more of them on landing; survivors may be left crawling.",
