  "translate_en|mods/Railroader/42/media/lua/shared/Translate/EN/Recipes.json|RR_TrainHandling": "Train Handling and the Automatic Brake",
  "translate_en|mods/Railroader/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Recipe_RR_Operate_GP7": "You can start and drive a GP7 light engine.",
  "translate_en|mods/Railroader/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_Recipe_RR_TrainHandling": "You can couple cars and handle a train on the automatic brake.",
  "translate_en|mods/Railroader/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_RR_ModelManual_GP7": "The builder's operating manual for one class of locomotive:<br>controls, starting, running, what to do when she will not.<br>Read it and you can run a GP7 light engine.",
  "translate_en|mods/Railroader/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_RR_RailFrog": "A steel ramp clamped over the railhead that a derailed wheel is driven back up into gauge.",
  "translate_en|mods/Railroader/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_RR_RailSkate": "A steel wedge over the railhead that holds the locomotive where she stands.",
  "translate_en|mods/Railroader/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_RR_SpikeMaul": "A long-handled hammer with a narrow double face, for driving track spikes. A sledgehammer will do the job, but this is what it is for.",
  "translate_en|mods/Railroader/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_RR_TrackJack": "A thirty-ton ratchet jack for lifting a derailed truck and walking it back over the rails.",
  "translate_en|mods/Railroader/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_RR_TrainHandlingBook": "The company book: the automatic brake, slack, grades, signals.<br>The brake handle you already know stops the locomotive and<br>nothing else. A train is stopped down the brake pipe, and<br>getting that wrong is what runs a grade away from you.<br>Long enough to take several sittings.<br>Teaches working a train: couplers, and the brake that<br>reaches the cars.",
  "translate_en|mods/Railroader/42/media/lua/shared/Translate/EN/UI.json|UI_prof_Railroader": "Railroader",
  "translate_en|mods/Railroader/42/media/lua/shared/Translate/EN/UI.json|UI_prof_RailroaderDesc": "Can start and drive any locomotive without reading its manual. Better at cold starts.",
  "translate_en|mods/Railroader/42/media/lua/shared/Translate/EN/UI.json|UI_trait_RRRailroader": "Locomotive Engineer",
  "translate_en|mods/Railroader/42/media/lua/shared/Translate/EN/UI.json|UI_trait_RRRailroader_Desc": "Qualified on any locomotive without reading its manual.<br>A cold diesel catches more often, and a start that misses costs half the battery."
