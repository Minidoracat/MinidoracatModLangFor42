  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_AHF1M": "Sustained beta blocker - panic zeroed for 25 in-game min. Crash: stress spikes hard, fades over ~15 min.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_Adrenaline": "Zero fatigue for 20 in-game min. Crash: fatigue rebounds hard, thirst rises. Vanilla equivalent: Caffeine Pills (weaker, no crash).",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_ETGc": "Heavy wound regen (~4 HP/min) for 30 in-game min. Pain is NOT relieved - you feel every wound while it heals. Crash: heavy hunger, thirst, and fatigue.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_EmptyInjector": "An empty injector. Combine with the right ingredients and a Mortar & Pestle to craft a stim.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_MULE": "+30 kg carry weight for 30 in-game min. Snaps off instantly on wear-off - if you're still overweight, over-encumbrance hits immediately.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_Meldonin": "Wipes unhappy and locks you in a good mood for 30 in-game min. Cost: hunger drains 3x faster while active.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_Morphine": "Pain drops to zero for 45 in-game min. Crash: fatigue spike, drowsy for 15 min after.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_Obdolbos": "Experimental cocktail. Rolls on inject: 60%% chance of a random stim's full effect, 30%% chance of a nasty side effect, 10%% chance of the jackpot (all six original stims briefly). Duration and crash vary by roll.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_Propital": "Wound regen and full pain relief for 30 in-game min. Crash: hunger and thirst surge.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_SJ12": "Slow hunger and thirst drain for 30 in-game min. The safe one - no crash.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_SJ6": "Sprint god-mode for 20 in-game min. Crash: endurance collapses, fatigue spikes. Vanilla equivalent: Caffeine Pills (weaker, no crash).",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_StimManual": "A dog-eared field manual with hand-inked notes in the margins. Covers all fourteen injector recipes step by step - vessel first, then every stim. Read it to unlock the recipes. (First Aid Level 3 also unlocks them.)",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_Trimadol": "Zeroes panic and stress for 30 in-game min. Crash: +30%% fatigue - the calm turns to drowsiness as it wears off.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_XTG12": "Clears queasy, food sickness, poisoning, and colds for 30 in-game min. Crash: mild stress bump as the sickness suppressor wears off.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_CombatStims_Zagustin": "Instantly seals every open wound. Side effect: max panic one in-game minute after injection.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CombatStims_Adrenaline": "Zero fatigue for 20 in-game min. Push through the last stretch of a long night. <LINE> <RGB:1,0.4,0.4> Crash: fatigue rebounds hard, thirst rises.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CombatStims_MULE": "+30 kg carry weight for 30 in-game min. When it wears off the boost is gone INSTANTLY - if you're still overweight you drop straight into over-encumbrance. <LINE> <RGB:1,0.4,0.4> Crash: fatigue and thirst spike.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CombatStims_Propital": "Wound regen and pain relief for 30 in-game min. Roughly 2 HP per in-game minute on any wounded body part. <LINE> <RGB:1,0.4,0.4> Crash: hunger and thirst surge.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CombatStims_SJ12": "Slow hunger and thirst drain for 30 in-game min - up to -60% recovery over the full window. <LINE> <RGB:0.5,1,0.5> The safe one: no crash when it wears off.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CombatStims_SJ6": "Sprint god-mode for 20 in-game min. Full endurance, no fatigue while active. <LINE> <RGB:1,0.4,0.4> Crash: endurance collapses to 5%, fatigue spikes.",
  "translate_en|mods/TarkovCombatStims/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CombatStims_Zagustin": "Instantly seals every open wound: bleeds, scratches, cuts, deep wounds, bites, wound infection. Skips parts holding embedded glass or bullets. Does NOT cure zombie infection. <LINE> <RGB:1,0.4,0.4> Side effect: max panic one in-game minute after injection."
}
