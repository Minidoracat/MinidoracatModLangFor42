  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_CanWoundChance_tooltip": "Determines the percentage chance of getting a minor cut when opening cans without a can opener. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_CanWoundIntensity": "Can Wound Intensity",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_CanWoundIntensity_tooltip": "Determines the severity of the wound when a Player cuts themselves opening a can without a can opener.<br>0 = No wound.<br>0.5 = Default.<br>1.0 = Maximum severity.",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_ColorFilter": "Color Filter",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_ColorFilter_tooltip": "Toggles friendly User Interface colors for those affected by color blindness. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_GunStats": "Gun Stats",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_GunStats_tooltip": "Toggles a custom User Interface that displays a gun's ammunition type, current ammo, state, etc. when one is equipped. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_OC_DisableLoot": "Disable Loot (Obvious Collecting)",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_OC_DisableLoot_tooltip": "Toggles whether removing obvious stuff off the ground such as twigs, rocks, weeds, bushes, etc. will grant the Player the item they just removed. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_OC_LootMultiplier": "Loot Multiplier (Obvious Collecting)",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_OC_LootMultiplier_tooltip": "Multiplies the amount of loot the Player receives when picking obvious stuff off the ground.",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_ObviousCollecting": "Obvious Collecting",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_ObviousCollecting_tooltip": "Toggles the ability to pick up obvious stuff off the ground, such as twigs, rocks, weeds, bushes, etc. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PryAllDoors": "Pry All Doors",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PryAllDoors_tooltip": "Toggles whether all doors can be pried open or not.<br>By default, reinforced doors (Prison doors, metal grid doors, etc.) cannot be pried open up unless the Player has a Strength level equal to or higher than the Min. Reinforced Door Level. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PryBuildingDoors": "Pry Building Doors",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PryBuildingDoors_tooltip": "Toggles whether Players can pry open building doors, such as doors on houses, apartments, etc. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PryGarageDoors": "Pry Garage Doors",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PryGarageDoors_tooltip": "Toggles whether Players can pry open garage doors. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PrySafeDoors": "Pry Safe Doors",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PrySafeDoors_tooltip": "Toggles whether Players can pry open reinforced doors (Prison doors, metal grid doors, etc.)<br>These doors cannot be pried open unless the Player has a Strength level equal to or higher than the Min. Reinforced Door Level. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PryVehicleDoors": "Pry Vehicle Doors",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PryVehicleDoors_tooltip": "Toggles whether Players can pry open vehicle doors. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PryWindows": "Pry Windows",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PryWindows_tooltip": "Toggles whether Players can pry open building windows, such as windows on houses, apartments, etc. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PryingChanceMultiplier": "Prying Chance Multiplier",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PryingChanceMultiplier_tooltip": "Determines the difficulty of prying open objects with a crowbar.<br>A higher multiplier makes it more difficult to pry open objects successfully, while a lower multiplier makes it easier.<br>0 = Always Succeed.<br>1 = Default Difficulty.<br>5 = Highest Difficulty.",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PryingMechanic": "Crowbar Mechanic",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_PryingMechanic_tooltip": "Toggles whether Players can pry open doors, windows, etc. using a Crowbar. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_ReinforcedDoorLevel": "Min. Reinforced Door Level",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_ReinforcedDoorLevel_tooltip": "Determines the Minimum level of Strength at which Players can pry open reinforced doors (Prison doors, metal grid doors, etc.)",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_ShatterVehicleWindows": "Shatter Vehicle Windows",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_ShatterVehicleWindows_tooltip": "Determines whether Players can accidentally smash Vehicle door windows when failing to pry them open.<br>If enabled, this can happen at random (Based on the Window Shatter Chance setting). ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_WindowShatterChance": "Window Shatter Chance",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_CommonSense_WindowShatterChance_tooltip": "Determines the chance of breaking the glass of a window when a Player fails an attempt to pry it open. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CS_CantPryOpenRDoor": "This door is too tough for you to pry open. You require level %s Strength. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CS_CantPryOpenWindow": "This window must be barricaded or blocked. It'd be useless to try to force it open. ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CS_PryOpenDoor": "Attempt to force this Door open. Burglars are great at this! ",
  "translate_en|mods/CS_MP_B42/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CS_PryOpenWindow": "Attempt to force this Window open. Keep in mind, there is a chance you will break the glass! "
}
