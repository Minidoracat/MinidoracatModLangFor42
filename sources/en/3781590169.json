  "translate_en|mods/Plysken Weather Station/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PWS": "Plysken Weather Station",
  "translate_en|mods/Plysken Weather Station/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PWS_ComputerRange": "Computer Range (tiles)",
  "translate_en|mods/Plysken Weather Station/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PWS_ComputerRange_tooltip": "How far the desktop computer can sit from the weather station and still read it.<br>1 means right next to it, which is the default and the way the mod is balanced.<br>The station has to stand outside, so raise this if you would rather keep the computer indoors.",
  "translate_en|mods/Plysken Weather Station/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PWS_ComputerVerticalRange": "Computer Vertical Range (floors)",
  "translate_en|mods/Plysken Weather Station/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PWS_ComputerVerticalRange_tooltip": "How many floors up or down the computer can sit from the weather station and still read it.<br>0 means the same floor only, which is the default and changes nothing.<br>Raise it if you want the station on the roof while the computer stays indoors.",
  "translate_en|mods/Plysken Weather Station/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PWS_HistoryDays": "Recorded History (days)",
  "translate_en|mods/Plysken Weather Station/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PWS_HistoryDays_tooltip": "How many past days the computer shows, up to 10.<br>Days when the station had no power leave gaps in the record.",
  "translate_en|mods/Plysken Weather Station/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PWS_MagazineLootMultiplier": "Loot Rarity Multiplier - Magazine",
  "translate_en|mods/Plysken Weather Station/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PWS_MagazineLootMultiplier_tooltip": "How often the meteorology magazine spawns in containers.<br>The magazine is the only way to learn the recipes, so setting this to 0 disables the mod's crafting.",
  "translate_en|mods/Plysken Weather Station/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PWS_PreciseForecastDays": "Precise Forecast Range (days)",
  "translate_en|mods/Plysken Weather Station/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PWS_PreciseForecastDays_tooltip": "How many days ahead the computer shows exact highs and lows.<br>3 days is what a real station can honestly predict. 7 is the most this mod will give you.<br>Set to 0 to remove precise forecasting entirely.",
  "translate_en|mods/Plysken Weather Station/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PWS_TrendForecastDays": "Trend Forecast Range (days)",
  "translate_en|mods/Plysken Weather Station/42.1/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PWS_TrendForecastDays_tooltip": "How many days ahead the computer shows a rough trend - warm or cold front only, no numbers - past the precise range.<br>Beyond about a week, real forecasting is guesswork, so 7 is the limit here.",
  "translate_en|mods/Plysken Weather Station/42.1/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PWS_WeatherStation": "Must be set up outdoors, under open sky - a roof overhead would make every reading wrong.<br>Setting it up or taking it down needs a screwdriver and some electrical know-how."
}
