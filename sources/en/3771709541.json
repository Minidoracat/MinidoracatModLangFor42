  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Duration": "Runtime",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_EnergyProj": "Energy Projection",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_FedCount": "Connected",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_FedTitle": "Powered Generators",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Fuel_Note": "The internal tank refills from the cans in the bay.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GenHelp_L1": "1. Runs anywhere, day or night: no",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GenHelp_L1b": "   solar panel, no fuel, no noise.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GenHelp_L2": "2. Powers appliances in the same",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GenHelp_L2b": "   radius as a regular generator.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GenHelp_L3": "3. It only CONSUMES power: refill it",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GenHelp_L3b": "   with car batteries or KR Solar",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GenHelp_L3c": "   Batteries (M/L) placed inside.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GenHelp_L4": "4. A KR Solar Charger in range also",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GenHelp_L4b": "   feeds it while receiving sunlight.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GenModeLabel": "Generator Mode",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GenMode_Off": "Generator Mode: OFF",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GenMode_On": "Generator Mode: ON",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GenTitle": "Portable Generator",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GridExt": "Grid Power Extension",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_GridPower": "GRID POWER",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_HelpL1": "Place chargers outdoors to harvest sunlight; generators work anywhere.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_HelpL2": "The Home shows internal battery, consumption, runtime, weather and recharge projection.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_HelpL3": "The + button opens the breakdown of appliances drawing power within the emitter radius.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_HelpL4": "The right-side list shows other emitters in range (link / unlink).",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_HelpL5": "Generator Mode ON/OFF starts or stops the electricity output.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_HelpTitle": "HOW TO USE",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_ApplB": "Power draw within the radius, grouped into Lights, Fridges and Others. The + button opens the full appliance breakdown.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_ApplT": "Connected Appliances",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_BatB": "The unit's internal energy. Drains with the total grid draw. Runtime = autonomy at the current charge. Reserve = extra hours from the bay.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_BatT": "Internal Battery",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_DayB": "Real weather: sky, sun strength and temperature. More sun means chargers harvest faster.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_DayT": "Day Condition",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_GenMode": "Top button: turns Generator Mode on or off. When ON the unit powers its radius; when OFF it stops emitting.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_GridB": "Coverage radius. Use - / + to change it in steps of 5 tiles (each level +0.1 u/h). The bottom button draws the range on the ground.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_GridT": "Grid Power Extension",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_L1": "1. Place the Solar Charger outdoors",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_L1b": "   (no roof overhead) to charge",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_L1c": "   batteries using sunlight.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_L2": "2. Charging follows the real daylight",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_L2b": "   cycle: season and weather shift the",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_L2c": "   hours and the charging speed.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_L3": "3. If a generator or powered grid is",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_L3b": "   nearby, the charger uses it as",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_L3c": "   power source - works indoors or",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_L3d": "   underground at full rate.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_L4": "4. Put batteries inside the charger",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_L4b": "   inventory to start charging.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_LinkB": "Other KR emitters in range. Each card shows its battery, what it receives (input) and, for solar chargers, what it contributes to the generator. The button links or unlinks that unit. Multiple chargers stack their contribution with diminishing returns.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_LinkT": "Linked Devices",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_ProjB": "Recharge estimates: how long the internal battery takes to fill at full sun and at the current sun, and the charge time of each compatible battery.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_ProjT": "Energy Projection",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Help_Title": "HOW TO USE",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_InRange": "In range: %1",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Info_Charging": "Solar input: %1  -  charging batteries.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Info_Depleted": "Insert charged batteries or place a KR Solar Charger nearby.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Info_Emitting": "Powering appliances within generator range.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Info_GridPower": "Charging from grid power at full rate.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Info_Indoors": "Move charger outdoors to use solar power.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Info_LowLight": "Insufficient sunlight to charge.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Info_Night": "Charger offline during night hours.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Info_SolarLink": "Receiving power from a nearby solar charger.",
  "translate_en|mods/KR SolarOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KRSolar_Info_Standby": "Generator mode is off: not powering the area.",
