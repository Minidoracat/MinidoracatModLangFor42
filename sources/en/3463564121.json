  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_ChHelp_L1": "1. Place the FriOS Charger on a tile",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_ChHelp_L1b": "   with power grid - a vanilla",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_ChHelp_L1c": "   generator or a SolarOS emitter.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_ChHelp_L2": "2. Put FriOS Batteries in its bay",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_ChHelp_L2b": "   (up to 2). They charge while the",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_ChHelp_L2c": "   tile has power.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_ChHelp_L3": "3. Each bar shows a battery's charge.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_ChHelp_L3b": "   Full batteries stop charging",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_ChHelp_L3c": "   automatically.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_ChHelp_L4": "4. Only FriOS Batteries fit here. Car",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_ChHelp_L4b": "   batteries are charged by KR",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_ChHelp_L4c": "   SolarOS instead.",
