  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpBeefFresh": "E.g. a fresh Beef keeps fresh %1 (normal) or %2 (Overdrive).",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpBeefFrozen": "E.g. a Beef stays frozen (does not age).",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpCDropHint": "Hover an item + [X]: takes it to the floor (handy for cooked food).",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpCItemsDesc": "Each item shows its cooking phase:",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpCItemsTitle": "Items - Cooking",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpCP1": "This %1 runs on an internal battery. Recharge it from the power grid, a nearby generator, or batteries placed inside.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpCP2": "It turns on by itself when you add food and heats it to cooking temperature.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpCP3": "If the food is frozen, the heat THAWS it first, then cooks it.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpCP4": "Once cooked, the burn countdown starts: take the food out in time.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpDropHint": "Hover an item + [X]: drops it on the floor (not deleted).",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpEff": "Current cooling efficiency: %1%%.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpEffOver": "Current cooling efficiency: %1%% (Overdrive).",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpGroupHint": "Identical ones stack (e.g. 45x Strawberry); click to expand.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpHdr": "FriOS Redux",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpHdrCook": "FriOS Redux - Cooking",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpItemsDesc": "Each item shows its state and approximate shelf life:",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpItemsTitle": "Items - Food",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpP1": "This %1 runs on an internal battery. Recharge it from the power grid, a nearby generator, or batteries placed inside.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpP2": "It turns on by itself when you add food. A deep suspend mode (while you are off the chunk) extends the battery.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_HelpP3": "With the ICE Add-on it also uses ice packs (cooler and fridge only; the freezer refreezes them).",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L1": "1. Walk up to any FriOS appliance and",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L1b": "   left-click it, or right-click and",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L1c": "   choose Manage Battery.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L2": "2. The appliance runs on an internal",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L2b": "   battery. Recharge it by inserting a",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L2c": "   FriOS or car battery (it is used up).",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L3": "3. It cools, freezes or heats its",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L3b": "   contents while the internal battery",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L3c": "   has charge.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L4": "4. Drains 10x slower when no player",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L4b": "   is nearby (suspend mode).",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L5": "5. Place it on a powered tile to run",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L5b": "   it and recharge from the grid.",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L6": "6. Charge FriOS Batteries in the FriOS",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_L6b": "   Charger (needs a power grid).",
  "translate_en|mods/KR FriOS/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_FriOS_Help_Title": "HOW TO USE",
