  "translate_en|mods/BathtowelsOverhaul/42.12/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_BathTowelsOverhaul_WetnessDecrease_tooltip": "Decreases the multiplier for how quickly the player's wetness dries naturally. <LINE> True = 0.005, False = 0.01 (vanilla)",
  "translate_en|mods/BathtowelsOverhaul/42.12/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_BathTowelsOverhaul_WetnessIncrease": "Increaseed Wetness Increase",
  "translate_en|mods/BathtowelsOverhaul/42.12/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_BathTowelsOverhaul_WetnessIncrease_tooltip": "Increases the multiplier of how quickly the player gets wet from rain or sweat. <LINE> True = 0.025, False = 0.015 (vanilla)",
