  "translate_en|mods/CarltonsBetterBanks/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CBB_LootResetHours": "Safe & Deposit Box Loot Respawn Time",
  "translate_en|mods/CarltonsBetterBanks/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CBB_LootResetHours_tooltip": "Number of in-game hours before looted bank safes and safe deposit boxes can contain loot again. Set to 0 to disable loot respawning. Default: 0.",
  "translate_en|mods/CarltonsBetterBanks/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CBB_UniqueKeys": "Keys Only Work at Their Own Bank",
  "translate_en|mods/CarltonsBetterBanks/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CBB_UniqueKeys_tooltip": "When enabled, a Bank Safe Key only opens safes and deposit boxes at the bank where that key was found. When disabled, any Bank Safe Key can be used at any bank.",
