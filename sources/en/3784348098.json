  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_ArrowFadeFloor": "Faintest opacity (%%)",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_ArrowFadeFloor_tt": "How solid the arrow still is once it is as faint as it gets. 0 makes a distant target invisible. Never rises above the opacity above, whatever it is set to.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_ArrowSize": "Arrow size",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_ArrowSize_tt": "How long the arrow is, in tiles. It always stands off far enough not to crowd your character, and further still when you are in a vehicle.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_AutoOff": "Switch the pointer off once the key is used",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_AutoOff_tt": "Getting into the car it starts, walking into the building it opens or reaching the gate it unlocks clears that key's pointer automatically.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_FocusZoom": "Zoom in when jumping to a key",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_FocusZoom_1": "Wide - show the neighbourhood",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_FocusZoom_2": "Medium - show the street",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_FocusZoom_3": "Close - show the building",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_FocusZoom_4": "Very close",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_FocusZoom_tt": "Clicking a key in the map list flies the map to that spot. This sets how far in it zooms on arrival. The map never zooms back out below where you already had it.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_GroundRadius": "Ground search range (m)",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_GroundRadius_tt": "Only keys within this distance are named. Nearer ones are drawn more strongly, and at most ten are shown at a time.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_HighlightSeconds": "Highlight duration (seconds)",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_HighlightSeconds_tt": "How long the marker stays on the world map after you click a key.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_MarkerThickness": "Map marker outline thickness",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_MarkerThickness_tt": "Width of the highlight outline and ping drawn on the world map and the minimap. Does not affect the in-world pointer line.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_MiniMapPin": "Keep off-screen markers on the minimap edge",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_MiniMapPin_tt": "On: a target outside the minimap sticks to the nearest edge, so you still have a heading. Off: the marker simply disappears until the target comes back into view.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_MiniMapSize": "Minimap marker size",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_MiniMapSize_tt": "Markers keep a fixed pixel size, so zooming the minimap out makes them cover more ground. Turn this down if they crowd the map.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_Notify": "Notify when a key location is learned",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_NotifyArrival": "Notify when a pointer switches itself off",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_NotifyArrival_tt": "The short message above your character when a key you were following gets used.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_NotifyRingStop": "Say when following stops by itself",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_NotifyRingStop_tt": "On by default. A line over your head when a ring stops being followed without you asking - you got it back, another survivor took it, the body was moved. Off, and it stops quietly.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_NotifyRingSwap": "Say when the followed ring changes",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_NotifyRingSwap_tt": "On by default. Only one ring in your inventory is followed at a time, so switching one on takes the star off the other. This says which one lost it.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_Notify_tt": "Shows a short floating message above your character.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_PointerFade": "Fade the arrow with distance",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_PointerFadeStart": "Faintest at (metres)",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_PointerFadeStart_tt": "The arrow is at its clearest right on top of the target and fades steadily out to this distance, where it sits at its faintest.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_PointerFade_tt": "A distant target draws a barely visible arrow that grows steadily clearer as you close in. Off means one flat opacity at any range.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_PointerOpacity": "Arrow opacity (%%)",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_PointerOpacity_tt": "How solid the arrow is at its brightest, which is when you are standing on top of the target.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_Sec_Ground": "Keys on the ground",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_Sec_Map": "Map markers",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_Sec_Notify": "Notifications",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_Sec_Pointer": "In-world arrow",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_Sec_Rings": "Key rings",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_ShowGroundKeys": "Name keys lying on the ground",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_ShowGroundKeys_tt": "Puts the name over any key on the floor around you. A key that has been in your inventory even once is never named again, so one you dropped on purpose stays quiet. Keys behind walls are not shown.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_ShowOnMiniMap": "Show markers on the minimap",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_ShowOnMiniMap_tt": "Keys you switched the pointer on for also get a marker on the minimap, pinned to the edge when the target is out of view.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_ShowOnWorldMap": "Keep markers on the world map",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_ShowOnWorldMap_tt": "A key with the pointer switched on keeps a marker on the world map. Unlike the highlight that flashes when you click a key, this one stays until you switch the pointer off.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_ShowPointer": "Show the direction arrow",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_ShowPointer_tt": "A short arrow on the ground beside you, pointing toward a key's target. It is opt-in per key either way; turning this off removes the option entirely.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_Title": "Whose Key Is This?",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_TrackRings": "Follow a key ring after you die  -  adds a key ring tab to the map",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_Opt_TrackRings_tt": "Mark a key ring to be followed and, when you die, the body carrying it is marked on the map. Getting the ring back clears the mark. Switching this on adds a key ring tab to the map's key list, which is where you choose which rings to follow; switching it off removes the tab and clears every ring being followed.",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_PickUpFirst": "picks it up first",
  "translate_en|mods/WhoseKeyIsThis/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_WKT_PointerOff": "Hide Pointer",
