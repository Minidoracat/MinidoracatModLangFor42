  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_prof_scientist": "Scientist",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_prof_settlementbuilder": "Settlement Builder",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_prof_shadowblade": "Shadow Blade",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_prof_sharpshooter": "Sharpshooter",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_prof_signalrunner": "Signal Runner",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_prof_wastelandcook": "Wasteland Cook",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_prof_wastelandcourier": "Wasteland Courier",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_prof_wateroperator": "Water Treatment Operator",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_prof_writer": "Writer",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_agent": "Trained in stealth, infiltration, and survival tactics.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_agronomist": "A crop and soil specialist focused on sustainable food production after supply chains collapse.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_amnesia": "You woke up with no clear memories, but the next three months may bring back powerful forgotten skills.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_biomedicaltech": "A hospital equipment technician with practical knowledge of medicine, electronics, and sterile procedure.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_biozard": "Trained to deal with biological risks, contaminated areas, and dangerous outbreaks.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_brawler": "A tough fighter who relies on strength and endurance.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_candlemaker": "A practical survivor who knows light, wax, cloth, fat, and the small comforts that keep people sane.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_caravanguard": "An armed escort used to protecting people and supplies between unstable settlements.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_explorer": "Experienced in traveling, scavenging, and surviving the unknown.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_fieldquartermaster": "A supply organizer who can stretch food, clothing, medicine, and tools farther than expected.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_gravekeeper": "A quiet worker used to digging, hauling, building rough markers, and keeping calm around the dead. The smell of corpses does not bother them.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_gridtechnician": "An electrical utility worker who can diagnose wiring, generators, and damaged power systems.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_industrialmechanic": "A factory-floor technician used to repairing machines, tools, and metal assemblies under pressure.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_junkdoctor": "A field healer who turns scraps, cloth, and old equipment into ugly but useful treatment.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_lockbreaker": "A quiet intruder with a Master Key that can unlock doors and prepare vehicles for use.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_mercenary": "A hired gun from the lawless years after the fall, trained to survive contracts no one should accept.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_militialeader": "A hard survivor who organized armed neighbors after the fall and learned to hold a line.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_outbreakcleaner": "A grim specialist who clears infected spaces, handles injuries, and keeps moving through contaminated work.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_psychopath": "A masked killer shaped by the end of the world. Dangerous in close combat, but unstable when the blood stops.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_radiotechnician": "A communications specialist skilled with radios, field repairs, and quiet technical work.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_ratcatcher": "A pest hunter who knows alleys, traps, crawlspaces, and the edible things people ignore.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_reliccollector": "A scavenger of the old world who knows where forgotten tools, books, and parts are likely to hide.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_scavengerforeman": "A crew lead who breaks down ruins, sorts salvage, and keeps dangerous work moving.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_scientist": "A researcher with knowledge of biology, chemistry, and survival through experimentation.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_settlementbuilder": "A practical builder focused on walls, workshops, power, and the repairs a safehouse needs.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_shadowblade": "A silent post-collapse infiltrator who survives by avoiding noise, striking cleanly, and carrying a rare blade.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_sharpshooter": "Highly trained in firearms with exceptional precision.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_signalrunner": "A mobile communications survivor who repairs radios and carries messages when signals fail.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_wastelandcook": "A survival cook who turns farms, cans, scraps, and risky ingredients into morale and calories.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_wastelandcourier": "A runner trusted to cross dead streets, bypass checkpoints, and deliver messages that matter.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_wateroperator": "A municipal systems worker trained around pumps, pipes, sanitation, and clean water procedures.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_writer": "A creative mind skilled in observation and storytelling.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_adrenalrecovery": "Adrenal Recovery",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_adrenalrecoverydesc": "The longer you stay in combat, the faster your body recovers endurance and fights off fatigue.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_badback": "Bad Back",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_badbackdesc": "Heavy loads punish your back quickly, draining endurance and causing pain.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_badknees": "Bad Knees",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_badkneesdesc": "Running, crouching, and hauling weight all remind you that your joints have history.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_battlefrenzy": "Battle Frenzy",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_battlefrenzydesc": "While actively fighting, your melee strikes and firearm hits bite harder.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_bloodmomentum": "Blood Momentum",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_bloodmomentumdesc": "Each confirmed zombie kill hardens your rhythm. The more you have killed, the more damage you deal, up to a limit.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_bloodshy": "Blood Shy",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_bloodshydesc": "Killing and blood unsettle you, turning violence into stress instead of relief.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_bloodthirst": "Blood Thirst",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_bloodthirstdesc": "Killing zombies calms you and feeds a short burst of violence. Going too long without a kill makes you restless.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_brokenleg": "Broken Leg",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_brokenlegdesc": "You start with a fractured leg. Surviving the first days will require patience, shelter, and a splint.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_claustrophobicsurvivor": "Claustrophobic Survivor",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_claustrophobicsurvivordesc": "Long stretches indoors make your breathing tighten and your panic rise.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_cleanwater": "Clean Water Protocol",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_cleanwaterdesc": "You know how to think about sanitation, contamination, and safe water handling.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_clinicalmethod": "Clinical Method",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_clinicalmethoddesc": "You approach injuries, equipment, and contamination with careful technical discipline.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_coldnerves": "Cold Nerves",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_coldnervesdesc": "Combat pressure has less hold over you, keeping panic and stress lower when things turn violent.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_combatconditioning": "Combat Conditioning",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_combatconditioningdesc": "When combat starts, your body settles into the work and preserves endurance under pressure.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_contaminationdrill": "Contamination Drill",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_contaminationdrilldesc": "You know the routine: mask, gloves, clean hands, steady breathing. Contamination scares you less.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_coverttraining": "Covert Training",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_coverttrainingdesc": "You settle into quiet movement quickly and recover your nerve while sneaking.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_crisiscook": "Crisis Cook",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_crisiscookdesc": "You can turn short supplies, questionable ingredients, and rough harvests into meals.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_cropscience": "Crop Science",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_cropsciencedesc": "You understand soil, crops, pests, and how to turn land into long-term food security.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_deaddroprunner": "Dead Drop Runner",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_deaddroprunnerdesc": "You are used to moving fast between hidden caches without drawing attention.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_deadeyefocus": "Dead-Eye Focus",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_deadeyefocusdesc": "When you aim, the world narrows and panic bleeds away.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_fasthands": "Fast Hands",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_fasthandsdesc": "Your fingers move quickly under pressure, helping with tools, packs, and close survival work.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_fieldrepair": "Field Repair",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_fieldrepairdesc": "You are used to keeping broken machinery alive with limited tools and improvised parts.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_fuelsick": "Fuel Sick",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_fuelsickdesc": "Gas fumes, engines, and chemical smells turn your stomach quickly.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_gearhoarder": "Gear Hoarder",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_gearhoarderdesc": "You hate leaving supplies behind, even when carrying them is a terrible idea.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_gridsense": "Grid Sense",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_gridsensedesc": "You understand power flow, improvised wiring, and the risks of damaged electrical systems.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_happyreader": "Happy Reader",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_happyreaderdesc": "Reading organizes your thoughts and lifts your mood. Making progress in books and magazines reduces unhappiness, boredom, and stress.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_hardbargainer": "Hard Bargainer",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_hardbargainerdesc": "You survived enough desperate trades to read people and keep your nerve.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_improvisedsplints": "Improvised Splints",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_improvisedsplintsdesc": "You are better at stabilizing injuries and keeping pain under control with crude medical supplies.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_journalkeeper": "Journal Keeper",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_journalkeeperdesc": "Writing keeps your mind organized, lowering boredom and stress over time.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_juryrigging": "Jury Rigging",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_juryriggingdesc": "You can make ugly repairs work long enough to matter.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_labdiscipline": "Lab Discipline",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_labdisciplinedesc": "You keep notes, isolate variables, and stay calm around sickness and equipment.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_lightpacker": "Light Packer",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_lightpackerdesc": "You pack cleanly and distribute weight well, carrying more before the load starts to punish you.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_medicationdependent": "Medication Dependent",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_medicationdependentdesc": "Without regular medicine, withdrawal brings stress, fatigue, and sickness back fast.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_nightadapted": "Night Adapted",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_nightadapteddesc": "Darkness feels familiar. You stay calmer and move with more confidence after sunset.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_nightblind": "Night Blind",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_nightblinddesc": "The dark swallows detail for you faster than it does for most survivors.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_noisysleeper": "Noisy Sleeper",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_noisysleeperdesc": "You cough, shift, and mutter in your sleep more than is safe.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_oldaddiction": "Old Addiction",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_oldaddictiondesc": "The old cravings never fully left. Some days they come back as stress, fatigue, and sickness.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_oldinjury": "Old Injury",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_oldinjurydesc": "A badly healed wound still punishes you when the day gets hard.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_openairspirit": "Open-Air Spirit",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_openairspiritdesc": "Open sky and moving air settle your mind. Being outdoors reduces unhappiness, boredom, and stress.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_packmule": "Pack Mule",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_packmuledesc": "You can carry twice as much as your normal body would allow before becoming encumbered.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_paintrained": "Pain Trained",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_paintraineddesc": "Pain still hurts, but it takes more of it to break your focus.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_pitfighter": "Pit Fighter",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_pitfighterdesc": "Pain and panic are familiar opponents. Close combat pushes you forward instead of back.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_salvageappraiser": "Salvage Appraiser",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_salvageappraiserdesc": "You know which scrap is trash and which scrap keeps a settlement alive.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_scrounger": "Scrounger",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_scroungerdesc": "You can read junk piles like maps and spot useful parts others would leave behind.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_shakyhands": "Shaky Hands",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_shakyhandsdesc": "Stress makes careful work and steady aim harder than they should be.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_shelterheart": "Shelter Heart",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_shelterheartdesc": "Walls, a roof, and quiet make you feel safe. Indoor spaces reduce unhappiness, boredom, and stress.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_signaldiscipline": "Signal Discipline",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_signaldisciplinedesc": "You work calmly with radios, wiring, and low-profile field communication.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_silenthands": "Silent Hands",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_silenthandsdesc": "You work with tools, doors, packs, and weapons without making much noise.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_softstomach": "Soft Stomach",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_softstomachdesc": "Spoiled food, dirty water, and rough meals hit you harder than most.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_streetmedic": "Street Medic",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_streetmedicdesc": "You learned fast medicine in bad places, where clean rooms and calm patients are rare.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_toolclumsy": "Tool Clumsy",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_toolclumsydesc": "Tools never sit right in your hands. Repairs and salvage work wear you down.",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_trailmemory": "Trail Memory",
  "translate_en|mods/ProfessionsTheArk/common/media/lua/shared/Translate/EN/UI.json|UI_trait_trailmemorydesc": "You remember routes, landmarks, and quiet paths, staying calmer outdoors and at night.",
  "translate_en|mods/ProfessionsTheArk/media/lua/shared/Translate/EN/UI_EN.txt|UI_prof_amnesia": "Amnesiac",
  "translate_en|mods/ProfessionsTheArk/media/lua/shared/Translate/EN/UI_EN.txt|UI_prof_biozard": "Biohazard Specialist",
  "translate_en|mods/ProfessionsTheArk/media/lua/shared/Translate/EN/UI_EN.txt|UI_prof_scientist": "Scientist",
  "translate_en|mods/ProfessionsTheArk/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_amnesia": "You woke up with no clear memories, only instincts and fragments of who you used to be.",
  "translate_en|mods/ProfessionsTheArk/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_biozard": "Trained to deal with biological risks, contaminated areas, and dangerous outbreaks.",
  "translate_en|mods/ProfessionsTheArk/media/lua/shared/Translate/EN/UI_EN.txt|UI_profdesc_scientist": "A researcher with knowledge of biology, chemistry, and survival through experimentation.",
  "translate_en|mods/ProfessionsTheArk/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_amnesia": "Amnesia",
  "translate_en|mods/ProfessionsTheArk/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_amnesiadesc": "Your past is missing, making survival harder to understand at first.",
  "translate_en|mods/ProfessionsTheArk/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_biozard": "Biohazard",
  "translate_en|mods/ProfessionsTheArk/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_biozarddesc": "You are more prepared to handle infection risks and contaminated environments.",
  "translate_en|mods/ProfessionsTheArk/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_scientist": "Scientific Mind",
  "translate_en|mods/ProfessionsTheArk/media/lua/shared/Translate/EN/UI_EN.txt|UI_trait_scientistdesc": "You learn from observation, testing, and a lot of questionable lab decisions."
}
