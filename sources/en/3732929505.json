  "translate_en|mods/SaborVenezolano/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_SV_CajaClap": "Contains: Harina PAN, Mayonesa Mavesa, Pampero and 5 kg of Frijol Chino. Right-click to open.",
  "translate_en|mods/SaborVenezolano/42/media/lua/shared/Translate/EN/UI.json|UI_quick_tip201": "¡Coño e' madre! ¿Conseguiste Harina PAN? Eso en el apocalipsis vale más que el CLAP, pana.",
  "translate_en|mods/SaborVenezolano/42/media/lua/shared/Translate/EN/UI.json|UI_quick_tip202": "Una Arepa Viuda es mejor que nada. Y nada, en el apocalipsis, es quedarte sin comer.",
  "translate_en|mods/SaborVenezolano/42/media/lua/shared/Translate/EN/UI.json|UI_quick_tip203": "El que domina el Pabellón Criollo domina el apocalipsis. ¡Échale bola, mi pana!",
  "translate_en|mods/SaborVenezolano/42/media/lua/shared/Translate/EN/UI.json|UI_quick_tip204": "Tajadas fritas rodeado de zombies... es que tú eres demasiado sifrino, chamo.",
  "translate_en|mods/SaborVenezolano/42/media/lua/shared/Translate/EN/UI.json|UI_quick_tip205": "¿Plátano maduro en el fin del mundo? Mijo, no lo desperdicies. Hazle las Tajadas.",
  "translate_en|mods/SaborVenezolano/42/media/lua/shared/Translate/EN/UI.json|UI_quick_tip206": "La Carne Mechada bien condimentada es el antídoto contra la depresión postapocalíptica.",
  "translate_en|mods/SaborVenezolano/42/media/lua/shared/Translate/EN/UI.json|UI_quick_tip207": "Pabellón a Caballo: porque incluso en el fin del mundo, uno tiene sus estándares.",
  "translate_en|mods/SaborVenezolano/42/media/lua/shared/Translate/EN/UI.json|UI_quick_tip208": "Los zombies no le tienen miedo a las balas. Le tienen miedo al que aparece oliendo a Arepa recién hecha.",
  "translate_en|mods/SaborVenezolano/42/media/lua/shared/Translate/EN/UI.json|UI_quick_tip209": "Tip de supervivencia venezolana: primero asegura la Harina PAN, después piensa en las armas.",
  "translate_en|mods/SaborVenezolano/42/media/lua/shared/Translate/EN/UI.json|UI_quick_tip210": "Si lograste hacer un Pabellón Criollo completo en el apocalipsis, felicitaciones. Eres leyenda."
}
