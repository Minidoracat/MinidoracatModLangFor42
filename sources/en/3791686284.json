  "translate_en|mods/VFluidLib/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_VFluidLib_ServiceOverride_tooltip": "Player can create mixtures that are not compliant with vanilla mixing rules and make a tank compromised and unusable unless drained and cleaned.",
  "translate_en|mods/VFluidLib/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_VFluidLib_SpawnFlavor": "Tank spawns: flavor combo weight",
  "translate_en|mods/VFluidLib/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_VFluidLib_SpawnFlavor_tooltip": "How often a found tank holds one of the curated loads - a milk tanker, a whisky trailer, watered-down milk, a cocktail mix, someone's cleaning stash. Relative weight; see the original-cargo option.",
  "translate_en|mods/VFluidLib/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_VFluidLib_SpawnMixLarge": "Tank spawns: 6-8 fluid roll weight",
  "translate_en|mods/VFluidLib/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_VFluidLib_SpawnMixLarge_tooltip": "How often a found tank rolls a six-to-eight fluid soup. Keep this low or the extraordinary becomes furniture. Relative weight; see the original-cargo option.",
  "translate_en|mods/VFluidLib/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_VFluidLib_SpawnMixMedium": "Tank spawns: 3-5 fluid roll weight",
  "translate_en|mods/VFluidLib/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_VFluidLib_SpawnMixMedium_tooltip": "How often a found tank rolls three to five random fluids. Mixes that no service could carry spawn COMPROMISED - sealed until drained and cleaned. Relative weight; see the original-cargo option.",
  "translate_en|mods/VFluidLib/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_VFluidLib_SpawnMixSmall": "Tank spawns: 1-2 fluid roll weight",
  "translate_en|mods/VFluidLib/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_VFluidLib_SpawnMixSmall_tooltip": "How often a found tank rolls one or two random fluids, weighted by how common each fluid is. Relative weight; see the original-cargo option.",
  "translate_en|mods/VFluidLib/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_VFluidLib_SpawnOrigin": "Tank spawns: original cargo weight",
  "translate_en|mods/VFluidLib/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_VFluidLib_SpawnOrigin_tooltip": "How often a found tank simply holds its own cargo - water in a water tank, fuel in a fuel tank. The five spawn weights are RELATIVE, not percentages: they are normalised against each other, so any values work. Set all five to 0 for tanks that always spawn empty.",
