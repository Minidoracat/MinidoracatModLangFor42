  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment": "Zombie Dismemberment",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_AxeChance": "Axe dismemberment chance (percent)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_BleedAmount": "Maximum marks per zombie blood patch (1–16)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_BleedAmount_tooltip": "Remaining allowance is paced over the bleeding window so the initial pool leaves blood for later crawling. This is a maximum per pulse.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_BleedInterval": "Interval between bleeding patches, milliseconds (250–3000)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_BleedMarks": "Shared maximum blood marks per zombie (0–2048; 0: disabled)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_BleedTime": "Bleeding duration after amputation, real seconds (0: disable)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_BloodBudget": "Shared extra blood emissions per second (0–256; 0: disabled)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_BloodBudget_tooltip": "Limits ordinary extra emissions and floor blood. Core burst particles consume available budget, but remain visible when it is exhausted: a transient-only exception within the64-particle cap. Zero disables the core too. Does not replenish pools or persistent bleeding.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_BloodMaxZombies": "Shared maximum blood emitters: zombies and pieces (0: disabled)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_CrawlBlood": "Blood trails from amputated crawling zombies (SP only)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_CrawlBlood_tooltip": "Ground-moving amputees bleed during their configured window. Leg wounds use an approximate knee position based on facing and severed side. Duration and allowance persist across saving/loading and are not renewed by further cuts.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_CrawlSpacing": "Minimum ground-drag trail spacing, tiles (0.1–1)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_CriticalAlwaysCuts": "Cutting melee criticals always dismember limbs",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_CutBlood": "Brief arm/leg amputation splash (SP only)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_CutBloodMarks": "Extra blood marks on each cut (0: disabled)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_CutBlood_tooltip": "Adds stains and up to three visible drops at the cut. Shares the global blood limit; trails and pools may be disabled. Does not alter the original impact blood.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DamageThreshold": "Minimum hit damage for dismemberment",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DecapitationChance": "Decapitation chance per critical hit (percent)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DecapitationStrength": "Strength modifies cutting-weapon decapitation",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropBlood": "Blood drips during limb flight (SP only)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropCloth": "Drop decorative cloth when long sleeves are destroyed (SP only)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropDistance": "Removal distance in tiles (0: disable)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropFlight": "Vanilla temporary drawing for arm and leg flight (SP only)",
