  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropMax": "Shared maximum of loaded limbs and cloth (0: disable)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropParts": "Drop arms and legs (SP only)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropPerZombie": "Limb pieces per zombie (SP only)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropPerZombie_option1": "None",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropPerZombie_option2": "At most one",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropPerZombie_option3": "Every severed limb",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropPerZombie_tooltip": "Does not limit amputations. One-piece allowance survives saving and loading. Cloth has its own switch.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropPoolMarks": "Maximum blood marks per piece (0: disabled)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropPoolTime": "Piece bleeding, real seconds from landing (0: disabled)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropPools": "Small blood pools under landed limbs (SP only)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_DropPools_tooltip": "Does not affect cloth scraps. Has its own duration and allowance, sharing the global blood budget. Saving/loading does not renew it.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_EnableDecapitation": "Enable critical-hit decapitation (experimental)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_EnableLegs": "Enable leg dismemberment (experimental)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_EnableShotguns": "Enable shotgun dismemberment",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_Enabled": "Enable zombie dismemberment",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_HeadBurst": "Shotgun head explosion (SP only)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_HeadBurstCount": "Visible fragments per head burst (SP only; 0–64; 0: disabled)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_HeadBurstCount_tooltip": "Requested particle count per shotgun decapitation; zero disables particles. The first six, or all particles if fewer, receive priority. Remaining particles require space and budget.3D chunks have their own option.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_HeadBurstDuration": "Head-burst duration, milliseconds (SP only; 250–1500)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_HeadBurstScale": "Shotgun explosion: blood particle size (SP only)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_HeadBurstScale_tooltip": "Scales only shotgun explosion blood sprites, from1 to5. Neck spray and ordinary blood retain their original size.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_HeadBurst_tooltip": "Each shotgun decapitation prioritizes up to six burst particles, respecting a lower configured count. Older extra particles are recycled first; maximum64 active. Extreme saturation replaces the oldest core particles. The visual core may exceed an exhausted extra budget without adding floor blood. Disabled burst, zero count or zero budget disables the core.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_HeadDrops": "Whole heads with katana or sword (SP only)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_HeadDrops_tooltip": "Requires detached pieces enabled. Whole heads only on confirmed sword or katana decapitations; shotgun uses explosion. Shares saved per-zombie allowance, total pieces, lifetime and distance. Cannot be picked up. Combat chances stay unchanged.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_HeadGoreCount": "Shotgun explosion: temporary 3D fragments (SP only)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_HeadGoreCount_tooltip": "0 disables solid chunks. Requires shotgun head explosion and detached-piece flight enabled; does not require whole-piece drops. Up to eight shared active flights and the global piece limit. Chunks vanish on landing and cannot become loot.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_HeadHair": "Copy vanilla hairstyle to detached heads (SP only)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_HeadHair_tooltip": "Copies the vanilla hairstyle and its original colour as part of the same static head. No beard or hat. Unknown mod hairstyles use a bald head. Enabled when a new head is created; existing heads keep their saved appearance.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_ImpactBlood": "Initial impact blood (floor and body)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_ImpactBlood_tooltip": "Controls the initial native floor splash and body stains on amputation or decapitation. Independent of extra cut blood, pools, trails, flight blood and explosions. Disable those effects too to stop all added emissions. Wound textures retain their appearance. Works in SP and MP.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_LegTargetChance": "Chance to target a leg (percent)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_LongBladeChance": "Long Blade dismemberment chance (percent)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_NeckBlood": "Brief neck blood splash on decapitation (SP only)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_NeckBlood_tooltip": "Up to six vanilla droplets for 650 ms from an approximate neck position. Independent of radial burst; shares global budget and 32-particle limit.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_PoolBlood": "Brief pools under living amputees on the ground (SP only)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_PoolBlood_tooltip": "Dense-core pool under a living stationary amputee on the floor, including armless zombies. Grows with elapsed time and emitted blood onto neighboring loaded floors.",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_PoolRadius": "Maximum amputation-pool radius, tiles (0.15–1)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_ShotgunChance": "Shotgun dismemberment chance (percent)",
  "translate_en|mods/ZombieDismembermentB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ZombieDismemberment_UpperArmDamage": "Damage for upper-arm severing"
