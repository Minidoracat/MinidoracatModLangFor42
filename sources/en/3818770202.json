  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxedrineHours_tooltip": "How long Zomboxedrine keeps you going.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxidineChance": "Zomboxidine: best chance %",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxidineChance_tooltip": "Chance to stop the infection when used right after the wound.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxidineWindowMinutes": "Zomboxidine: minutes after the wound",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxidineWindowMinutes_tooltip": "How long after a bite or scratch Zomboxidine can still help. The chance drops to nothing over this time.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboximabMaxProgress": "Zomboximab: works up to infection %",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboximabMaxProgress_tooltip": "Zomboximab only cures while the infection is at or below this.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxiprofenHours": "Zomboxiprofen: hours",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxiprofenHours_tooltip": "How long Zomboxiprofen keeps the fever away.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxoloneChainHours": "Zomboxolone: hours that count as in a row",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxoloneChainHours_tooltip": "A dose taken within this many hours of the last one counts as in a row.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxoloneFalloff": "Zomboxolone: less per dose %",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxoloneFalloff_tooltip": "In pausing mode, each dose in a row lasts this much less.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxoloneMaxResets": "Zomboxolone: resets in a row",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxoloneMaxResets_tooltip": "In resetting mode, doses in a row stop working after this many.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxoloneWoundChance": "Zomboxolone: wound infection % per hour",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxoloneWoundChance_tooltip": "While Zomboxolone is active, chance each hour that an open, untreated wound gets infected.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxycyclineTreatsWounds": "Zomboxycycline treats wound infection",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxycyclineTreatsWounds_tooltip": "Zomboxycycline also treats ordinary wound infections. With Hardship wound infection enabled, each dose grants a normal antibiotic course for the configured duration; sepsis still needs proper care.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_BloodCollectionKit": "Draws blood from you or someone next to you. Only blood with antibodies is any use.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_CarrierLocator": "Picks up the signal of a carrier with the cure. Use it to get a direction and how strong the signal is. The carrier won't be alone. Runs on batteries.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_ConvalescentSerum": "Protection: Antibodies from a survivor. Protects you for a while, or holds an infection back if you already have one. Keep it cold.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_Full_ConvalescentSerum": "Protection: Antibodies from a cured or immune survivor. Clean, it keeps the virus out for a couple of days. Infected, it holds the infection back for a day. Spoils outside a fridge.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_Full_Zomboxidine": "Antiseptic: Disinfect a bite or scratch from the health panel within minutes. The sooner, the better the chance the virus never takes hold in that wound. You won't know if it worked. Also a normal disinfectant.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_Full_Zomboximab": "Early cure: Lab-made antibodies. Cures the zombie virus with no side effects, but only in the first stage. Later it does nothing. Spoils outside a fridge.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_Full_Zomboxivir": "Cure: Inhaled vapor from a glass ampule. Clears the zombie virus at any stage. Recovery is rough, and rougher if you needed one recently. Leaves antibodies in your blood for about a week.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_Full_Zomboxolone": "Delay: Steroid. Holds the infection back but never cures it. Each dose in a row does less. Weakens your immune system, so wounds get infected more easily.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_Full_Zomboxycycline": "Prevention: Take before a bite. Stops the zombie virus for a day. Also clears ordinary wound infections. Useless once you are infected.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_Full_Zomboxyvax": "Vaccine: Takes about two days to build up, then keeps the zombie virus out for a long time. Does not cure an infection you already have.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_ImmuneBloodSample": "Blood full of antibodies against the zombie virus. Two make a dose of serum. Keep it cold.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_InfectionScanner": "Scans you or someone next to you for the zombie virus. Shows roughly how long ago it started and how long is left. Runs on batteries.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_LabKeycard": "Opens a locked specimen case.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_NeedFirstAid": "You need First Aid %1 to inject yourself. Someone else can do it for you.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_Reinforce": "Needs %1 x %2, a sewing needle, thread and Tailoring %3.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_ScannerFlat": "The battery is flat.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_SpecimenCase": "Sealed with a card reader. A lab keycard opens it. A crowbar might too, but the glass inside may not survive.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_SpecimenCooler": "A small medical cooler for vials and blood samples. Keeps Zomboximab, samples and serum fresh much longer.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_TrialIDTag": "Taken from a test subject. A number, a barcode and nothing else.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_TrialReport": "Results from the Knox drug trials. Most of it is blacked out.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_UnlabeledVial": "Something from the trials. The label is gone. It could be anything, or nothing.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_Zomboxamine": "Smells like them. Ordinary zombies lose track of you more easily for a while. Running, sprinting or aiming gives you away.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_Zomboxedrine": "Stimulant: Wipes out tiredness and puts the Zomboxivir recovery on hold for a few hours. You crash hard afterwards.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_Zomboxidine": "Antiseptic: Disinfect a fresh bite or scratch with it from the health panel. Used quickly, it may stop the zombie virus from taking hold in that wound. Also works as a normal disinfectant.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_Zomboximab": "Early cure: Antibody injection. Cures the zombie virus only if it is caught early. Keep it cold.",
  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TKTM_Zomboxiprofen": "Symptom relief: Takes the fever and pain away for a few hours. Does nothing against the infection itself.",
