  "translate_en|mods/TheyKnewTooMuch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TheyKnewTooMuch_ZomboxedrineCrash_tooltip": "Tiredness (in %) added when Zomboxedrine wears off.",
