  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Mod.json|description": "Rebalances 150 vanilla craftable melee weapons around their materials, crafting cost, handling, and intended role. Every weapon is adjusted individually while preserving vanilla balance. Adds no new weapons or recipes, leaves loot-only weapons unchanged, and includes in-game Vanilla vs. CMR comparisons.",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Mod.json|name": "[B42] Cye's Crafted Melee Rebalance",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR": "CMR",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR_ExemptPlayers": "Exempt players",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR_ExemptPlayers_tooltip": "Account usernames or SteamID64 values separated by commas. Exempt players keep their local CMR settings and ignore both forced panel restrictions. Co-op hosts and admins are always exempt. Use none for no additional players.",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR_ForceDisableCraftingPanel": "Force-disable the crafting information panel",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR_ForceDisableCraftingPanel_tooltip": "Removes the CMR Changes right-click option from supported crafting recipes for non-exempt multiplayer users.",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR_ForceDisableWeaponPanel": "Force-disable the weapon information panel",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR_ForceDisableWeaponPanel_tooltip": "Removes More... > CMR Changes from supported weapons for non-exempt multiplayer users.",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR_HideLocalOptions": "Lock local CMR settings for players",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR_HideLocalOptions_tooltip": "Hides Options > Mods > Cye's Crafted Melee Rebalance from non-exempt multiplayer users. Enabled by default.",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR_IntensityPercentage": "Precise CMR intensity (%%)",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR_IntensityPercentage_tooltip": "Used only while quick rebalance mode is disabled. 0 restores vanilla values, 100 keeps original CMR, and 200 doubles the difference between vanilla and CMR. Range: 0.00 to 200.00.",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR_ProgressionMultiplier": "CMR progression multiplier",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR_ProgressionMultiplier_tooltip": "Used only while quick rebalance mode is enabled. Enter the server's progression rate: x1 keeps original CMR, x2 applies 50%%, x3 applies 33.33%%, and x0.5 applies 200%% of CMR. Range: 0.50 to 10.00.",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR_UseQuickAdjustment": "Use quick rebalance mode",
  "translate_en|mods/CraftedMeleeRebalance/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CMR_UseQuickAdjustment_tooltip": "Enabled: CMR uses only the progression multiplier below. Disabled: CMR ignores that multiplier and uses only the precise percentage setting."
