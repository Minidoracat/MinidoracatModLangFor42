{
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/ContextMenu.json|ContextMenu_BLChars_RunShine": "Run a batch of shine",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BL_CigHabitSmokes": "Chain Smoker Trait: Cigarettes Required",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BL_CigHabitSmokes_tooltip": "Cigarettes smoked before a clean character earns the Chain Smoker trait. 0 disables. Default 40.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BL_HabitThresholdHours": "Alcoholic Trait: Drunk-Hours Required",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BL_HabitThresholdHours_tooltip": "Cumulative hours spent drunk (net of sober decay) before a clean character earns the Alcoholic trait. 0 disables acquisition. Default 10.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BL_MethAddictLevel": "Meth Addict Trait: Addiction Level Trigger",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BL_MethAddictLevel_tooltip": "When the KNXDrugs addiction meter reaches this level through use, the Meth Addict trait is granted. Requires KNXDrugs. 0 disables. Default 55.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BL_PillHabitDoses": "Pill Popper Trait: Doses Required",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BL_PillHabitDoses_tooltip": "Painkiller and sleeping-pill doses before a clean character earns the Pill Popper trait. Beta blockers and vitamins never count. 0 disables. Default 25.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BL_VanillaIntegration": "Vanilla Integration Layer",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BL_VanillaIntegration_tooltip": "Master switch: vanilla drinking can grow into the Alcoholic trait, idle skill traits gain live effects, and trait crafts (moonshine) appear. Off kills the whole layer without a mod update.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BadlandsChars": "BADLANDS Traits and Professions",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_bl_say_hypochondriac": "Is that a fever? That's a fever.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_bl_say_paranoid": "Someone's out there. I know it.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_bl_say_ptsd": "Not again. Not again.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_bl_say_schizophrenic": "Shut up. SHUT UP.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_bl_say_split_personality": "...who said that?",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_bl_say_squeamish": "Don't look at it. Don't look.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_bl_say_survivor_guilt": "Should have been me.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_bl_say_tremors": "Steady. Steady, damn it.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_bl_say_war_never_ends": "Incoming... no. No, it's quiet.",
