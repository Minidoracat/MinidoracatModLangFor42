  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_prof_bl_radiohost": "Radio Host",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_prof_bl_roofer": "Roofer",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_prof_bl_scientist": "Lab Scientist",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_prof_bl_scrapper": "Scrapper",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_prof_bl_smuggler": "Smuggler",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_prof_bl_streetpreacher": "Street Preacher",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_prof_bl_surgeon": "Surgeon",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_prof_bl_swat": "SWAT Officer",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_prof_bl_tattooartist": "Tattoo Artist",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_prof_bl_taxidriver": "Taxi Driver",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_prof_bl_trapper": "Trapper",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_prof_bl_truckdriver": "Truck Driver",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_prof_bl_veterinarian": "Veterinarian",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_prof_bl_welder": "Welder",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_accountant": "Spreadsheets, audits, tax season. None of it transfers. Cheap start, clean slate.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_actor": "Community theater and one regional commercial. You can be anybody.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_architect": "You designed buildings. Now you fortify them.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_barber": "Thirty years of straight razors and small talk.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_bartender": "Every regular's story, every bottle's pour. You've broken up worse fights than this.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_beekeeper": "Patience, smoke, and a healthy respect for things that swarm.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_bodyguard": "Paid to stand between someone important and everything else.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_bountyhunter": "Skip tracing and door kicking. Everybody runs. You were paid to know where.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_butcher": "Meat is meat. You've never been squeamish about where it comes from.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_carthief": "Slim jim, screwdriver, forty seconds. Nothing in this county stays locked to you.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_cashier": "Double shifts and exact change. The register's not opening again.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_conartist": "You sold people their own wallets and they thanked you for it.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_corrections": "Years walking the tiers. You know how people act when the walls close in.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_cultmember": "You left the compound, or it left you. The gardens were real, at least.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_dealer": "You moved product and never got caught holding. Quick, quiet, always watching the corners.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_dentist": "Precision work in small dark places. Patients feared you before the world ended.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_deputy": "County roads, domestic calls, and a cruiser you'll never fuel again.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_drifter": "No fixed address before it was mandatory. You've been rehearsing this your whole life.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_enforcer": "You collected what was owed. People paid because of what happened when they didn't.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_exconvict": "You did your time. The skills you left with weren't on the rehabilitation brochure.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_farmhand": "Up before the sun, done after it. Work that never once ended.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_fence": "Everything that fell off a truck went through your back room first.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_glazier": "Glass work: storefronts, windshields, the occasional aquarium. Steady hands or stitches.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_gravedigger": "You buried this county for years. Business has never been worse.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_infantry": "You carried a rifle for a living. Some of it never got put down.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_janitor": "Keys to every door in the building and nobody ever looked at you twice.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_journalist": "You chased the story. The story caught everyone.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_lawyer": "Objection: the apocalypse. Overruled.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_librarian": "Quiet, organized, and you know where every book in town lives.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_loanshark": "Five points a week, and you were your own collections department.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_locksmith": "Every lock is a conversation. You always got the last word.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_machinist": "Tolerances in thousandths. The shop floor taught you patience and precision.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_methcook": "Chemistry degree from a trailer outside town. Your product was the cleanest in three counties.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_musician": "Bar gigs and gas money. Quick fingers, thick calluses.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_panhandler": "Invisible to everyone, surviving on nothing. Deep experience with both.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_paramedic": "Lights, sirens, and the worst night of everyone else's life, every night.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_pharmacist": "You know every pill in the county and exactly what it does. So do the people who robbed you.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_photographer": "You made a living going unnoticed and framing the shot.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_pi": "Cheating spouses and insurance fraud. You watch, you wait, you write it down.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_plumber": "Pipes, pressure, and other people's messes. Honest work, filthy hands.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_poacher": "Out of season, off the books, one shot. Wardens never caught you. Nothing will now.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_professor": "Tenure meant nothing to the dead. At least you're used to hostile audiences.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_psychiatrist": "You spent a career in other people's heads. Now everyone's diagnosis is terminal.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_radiohost": "Late-night AM, callers and static. You know your way around a transmitter.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_roofer": "Two stories up in July heat. Heights don't scare you. Falling does, a little.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_scientist": "Method, measurement, repeatability. The world stopped being repeatable.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_scrapper": "Copper, steel, aluminum. One man's wreck was your paycheck.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_smuggler": "River routes, hollow panels, cash on delivery. No questions either direction.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_streetpreacher": "You said the end was coming. Nobody's laughing at the sign now.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_surgeon": "You've had hands inside a human chest. This is not the retirement you planned.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_swat": "Breach, clear, repeat. Trained for the worst day. It came.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_tattooartist": "Steady needle, clean lines, and more anatomy than most nurses.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_taxidriver": "You know the streets and you've heard everybody's worst opinions.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_trapper": "Lines checked at dawn. The woods feed the ones who pay attention.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_truckdriver": "Long hauls, short sleep, and every backroad in Kentucky memorized.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_veterinarian": "Large animal practice. If it bleeds, you can probably stitch it.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_bl_welder": "Sparks, steel, and a steady bead. You built things meant to outlast you.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_abandonment_issues": "Abandonment Issues",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_abandonment_issuesdesc": "Everyone leaves. Being alone with that thought costs you, at random.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_alcoholic": "Alcoholic",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_alcoholicdesc": "Dry is not an option. Withdrawal builds misery, stress, and shakes until you drink.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_anxiety_disorder": "Anxiety Disorder",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_anxiety_disorderdesc": "The dread doesn't need a reason. Panic and stress rise steadily on their own.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_arthritis": "Arthritis",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_arthritisdesc": "Your joints are twenty years older than the rest of you. Weaker grip, and working outdoors wears you out and wears on you.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_backyard_mechanic": "Backyard Mechanic",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_backyard_mechanicdesc": "Three project cars, one that ran. You learned on rust and swearing.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_bad_back": "Bad Back",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_bad_backdesc": "Lifting wrong once was all it took. Constant extra fatigue.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_bipolar": "Bipolar",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_bipolardesc": "Long lows broken by manic surges of energy and mood - and every surge crashes harder a few hours later.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_bum_knee": "Bum Knee",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_bum_kneedesc": "It gave out in '89 and never forgave you. Extra fatigue on your feet outdoors.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_canner": "Canner",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_cannerdesc": "Rows of jars in the cellar. Grandma's method, zero botulism to date.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_catatonic_episodes": "Catatonic Episodes",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_catatonic_episodesdesc": "Sometimes you just stop. Rare, sudden, crushing waves of exhaustion.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_chain_smoker": "Chain Smoker",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_chain_smokerdesc": "Two packs a day, minimum. You smoke like anyone else who smokes - but the craving comes back twice as fast, and only a cigarette answers it. Starts with smokes.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_chronic_pain": "Chronic Pain",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_chronic_paindesc": "It never fully stops hurting. Steady fatigue and a permanent drag on your mood.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_clinical_depression": "Clinical Depression",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_clinical_depressiondesc": "The heaviest kind of tired. Unhappiness climbs relentlessly without something to hold it down.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_dead_shot": "Dead Shot",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_dead_shotdesc": "You hit what you look at. Always have.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_death_wish": "Death Wish",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_death_wishdesc": "Nothing left to lose burns clean: far less stress, far more darkness.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_deer_hunter": "Deer Hunter",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_deer_hunterdesc": "Tree stand at 4 AM, one shot at first light.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_dirt_poor_raised": "Raised Dirt Poor",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_dirt_poor_raiseddesc": "You grew up fixing what couldn't be replaced. Scarcity is your native language.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_dissociative": "Dissociative",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_dissociativedesc": "You float away when it gets bad. Less stress, more melancholy. You're not all the way here.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_epileptic": "Epileptic",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_epilepticdesc": "Rare, sudden seizures: crushing fatigue and stress, wherever you happen to be standing.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_even_keel": "Even Keel",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_even_keeldesc": "Slow to anger, slow to rattle. Stress drains steadily.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_faithful": "Faithful",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_faithfuldesc": "Whatever you believe, it's load-bearing. Stress drains slowly.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_field_medic_course": "Field Medic Course",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_field_medic_coursedesc": "Combat lifesaver certified. Tourniquets, pressure, don't die.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_forager": "Forager",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_foragerdesc": "You see food where others see weeds.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_functional_addict": "Functional Addict",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_functional_addictdesc": "Years of practice holding it together. Alcohol, pill and opioid withdrawal hits you at half strength. Does not blunt a meth crash - nothing does.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_gambling_addict": "Gambling Addict",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_gambling_addictdesc": "The itch never left. Stress builds, and the losses replay at random.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_glass_case_of_emotion": "Glass Case of Emotion",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_glass_case_of_emotiondesc": "Everything hits you at full volume. Frequent spikes of panic, misery, and stress.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_green_thumb": "Green Thumb",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_green_thumbdesc": "Things grow for you. Always have.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_grill_master": "Grill Master",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_grill_masterdesc": "Smoke rings and secret rubs. Meat obeys you.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_gun_nut": "Gun Nut",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_gun_nutdesc": "Safe full of iron, opinions to match. You know weapons.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_handloader": "Handloader",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_handloaderdesc": "You rolled your own ammunition at the kitchen table. Powder, primer, patience.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_hardy_stock": "Hardy Stock",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_hardy_stockdesc": "Your people don't get sick and don't stay down. Good genes, mean grandmother.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_herb_lore": "Herb Lore",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_herb_loredesc": "Which leaf soothes and which one kills. Passed down, not taught.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_hothead": "Hothead",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_hotheaddesc": "Zero to swinging in four words. Random stress flares.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_hypochondriac": "Hypochondriac",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_hypochondriacdesc": "Every itch is the infection. Random stress spikes, especially inconvenient in this economy.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_iron_lungs": "Iron Lungs",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_iron_lungsdesc": "Deep tank, slow burn. You can run and keep running.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_junkie": "Junkie",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_junkiedesc": "Chronic opioid habit. Four hours past your last painkiller the misery, stress and exhaustion set in, and stay until you find another. The habit itself never fades. Starts with one bottle.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_keen_nose": "Keen Nose",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_keen_nosedesc": "You smell rain, rot, and trouble before anyone else.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_knife_fighter": "Knife Fighter",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_knife_fighterdesc": "Close, fast, and personal. You learned where it counts.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_marathon_runner": "Marathon Runner",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_marathon_runnerdesc": "26.2 stickers earned the hard way.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_medicated_stable": "Medicated and Stable",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_medicated_stabledesc": "The prescription works. Steady stress and mood recovery. Pray the pharmacies hold out. Starts with a bottle.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_meth_addict": "Meth Addict",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_meth_addictdesc": "You start hooked, hard. Withdrawal hits fast and mean without a fix. Comes with your works.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_migraines": "Migraines",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_migrainesdesc": "White light and a vice behind the eyes, at random. Stress and fatigue spikes.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_missing_fingers": "Missing Fingers",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_missing_fingersdesc": "The saw, the door, the fight. What's left of the hand never grips like it used to.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_moonshiner": "Moonshiner",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_moonshinerdesc": "Copper coil, creek water, family recipe. Distillation is chemistry with better outcomes.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_narcoleptic": "Narcoleptic",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_narcolepticdesc": "Sleep takes you without asking. Sudden waves of exhaustion at random.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_night_terrors": "Night Terrors",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_night_terrorsdesc": "You wake screaming most nights. Heavy fatigue and violent panic spikes after dark.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_ocd": "Obsessive-Compulsive",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_ocddesc": "Check the door. Check it again. Constant background stress from a brain that won't sign off.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_old_scars": "Old Scars",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_old_scarsdesc": "Some history is written on you. A quiet, permanent weight on your mood.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_pain_tolerance": "Pain Tolerance",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_pain_tolerancedesc": "Pain is information, not an argument. Slight stress recovery; nothing rattles you easily.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_panic_attacks": "Panic Attacks",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_panic_attacksdesc": "Out of nowhere: chest tight, vision narrow, heart slamming. Severe random panic spikes.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_paranoid": "Paranoid",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_paranoiddesc": "They are watching. Constant stress, and sudden certainty that something's out there.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_pill_popper": "Pill Popper",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_pill_popperdesc": "A bottle-a-week habit. Eight hours without a dose and the misery and stress start climbing. Stay dry for a week and it loosens its grip. Starts with a stash.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_psychopath": "Psychopath",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_psychopathdesc": "Nothing touches you. Panic, stress, and grief bleed away on their own. People notice the eyes.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_ptsd": "PTSD",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_ptsddesc": "Constant background stress. Flashbacks strike at random: panic, cold sweat, gone again.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_quick_hands": "Quick Hands",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_quick_handsdesc": "Cards, locks, knots. Your hands finish before your brain does.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_schizophrenic": "Schizophrenic",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_schizophrenicdesc": "The voices didn't end with the world. Constant stress and violent random episodes.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_seamstress": "Seamstress",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_seamstressdesc": "A machine in the spare room and a thousand hems behind you.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_second_wind": "Second Wind",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_second_winddesc": "When everyone else is done, you find another gear. Fatigue recovers faster.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_shade_tree_welder": "Shade-Tree Welder",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_shade_tree_welderdesc": "Ugly beads that hold forever.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_short_fuse": "Short Fuse",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_short_fusedesc": "Everything is a provocation. Stress builds fast.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_slow_twitch": "Slow Twitch",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_slow_twitchdesc": "Built for the long haul, useless in a sprint. You start out of condition and stay that way.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_sociopath": "Sociopath",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_sociopathdesc": "Other people are furniture. Stress and unhappiness slide off you.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_split_personality": "Split Personality",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_split_personalitydesc": "There's someone else in here, and you don't always get a vote. RP trait with random stress.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_squeamish": "Squeamish",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_squeamishdesc": "Blood, guts, and gristle turn you gray. It catches up with you at the worst moments.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_stone_cold": "Stone Cold",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_stone_colddesc": "Flat, calm, unbothered. Panic and stress both bleed down over time.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_stray_magnet": "Stray Magnet",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_stray_magnetdesc": "Animals find you and stay. Always have.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_street_smart": "Street Smart",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_street_smartdesc": "You read rooms, corners, and people fast, because you had to.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_survivor_guilt": "Survivor's Guilt",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_survivor_guiltdesc": "Everyone else is gone and you're not. Persistent sadness that ambushes you.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_thick_neck": "Thick Neck",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_thick_neckdesc": "Built like a fireplug. Collars fear you.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_tourettes": "Tourette's",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_tourettesdesc": "Tics and outbursts you don't choose. Frequent, minor, exhausting.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_tremors": "Tremors",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_tremorsdesc": "Your hands shake. Coffee, nerves, genetics, does it matter? Fighting them wears you down, and the bad ones come out of nowhere.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_trivia_champion": "Trivia Champion",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_trivia_championdesc": "Tuesday nights at the bar, undefeated. Full of facts, some useful. RP trait.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_varsity_athlete": "Varsity Athlete",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_varsity_athletedesc": "Letter jacket, two sports, knees still mostly fine.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_war_never_ends": "The War Never Ends",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_war_never_endsdesc": "Nights are the worst. Stress climbs after dark and the incoming fire follows you into the quiet.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_will_to_live": "Will to Live",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_will_to_livedesc": "Something in you refuses to quit. Unhappiness recovers on its own.",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_woods_wise": "Woods Wise",
  "translate_en|mods/BadlandsCharacters/42/media/lua/shared/Translate/EN/UI.json|UI_trait_bl_woods_wisedesc": "The forest is a pantry, a pharmacy, and a hiding place, if you know it. You know it."
}
