{
  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis": "Keep Them Out",
  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_BarsOutside": "Allow door bars built from outside",
  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_BarsOutside_tooltip": "Off: on a door between a building and the street, bars and latches can only be built and operated from indoors. On: players can bar a door from the street and lock others in.",
