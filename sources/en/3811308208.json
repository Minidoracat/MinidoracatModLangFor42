  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_SpikeCarpentry_tooltip": "Carpentry level to build a single spiked board. The metal-reinforced version needs one level more, plus Welding.",
  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_SpikeDamage": "Spike damage per hit (x0.01 zombie health)",
