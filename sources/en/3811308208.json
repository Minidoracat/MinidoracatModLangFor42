  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_BuildSeconds_tooltip": "Reference time, in seconds, for building and fixing. Each item takes a share of it: door bars 10 percent to 33 percent, spiked boards 50 percent to 150 percent (more boards and metal take longer), stair hatches 100 percent to 150 percent. Re-nailing and repairs are shorter.",
  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_CarpentryLevel": "Carpentry level",
  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_CarpentryLevel_tooltip": "Minimum Carpentry level to build the nailed, screwed and metal door bars. The simple latch needs no skill. Spiked boards and stair hatches have their own levels.",
  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_MetalEnabled": "Enable metal reinforcement",
  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_MetalEnabled_tooltip": "Allows the metal reinforcement on door bars: the strongest bar (8000 HP), which needs Welding. Off: new metal bars cannot be built or upgraded. It does not affect spiked boards or hatches.",
  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_MetalHealth": "Metal reinforcement health (HP)",
  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_OperateSeconds": "Base operating time (seconds)",
  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_OperateSeconds_tooltip": "Reference time, in seconds, to lock or unlock a bar. Each type takes a share of it: latch 15 percent, nailed or screwed bar 40 percent, metal bar 60 percent. Raise it to make locking slower and riskier during an attack.",
  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_ScrewBonus": "Screw strength multiplier",
  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_ScrewBonus_tooltip": "Wood health multiplied by this value, capped at 4000 HP by the native engine.",
  "translate_en|mods/KeepThemOut/42.21/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_TrancasRemoviveis_SpikeCarpentry": "Spiked board: Carpentry level",
