  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_01": "Nature is all around me, so you know exactly who's welcoming you back.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_02": "I'm your host, Dean, on another episode of Exposure Survival!",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_03": "Everyone knows that a REAL hunter...",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_04": "... is nothing wihout his trusty bow.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_05": "Start with a branch.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_06": "Strip it clean. No bark, no problems.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_07": "Cut notches at each tip for the string.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_08": "Make sure the bow is loose when you string it.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_09": "Don't want it snapping back on you, ey?",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_10": "Firing a bow without an arrow can break it bad.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_11": "And break you even worse!",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_12": "Speaking of arrows...",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_13": "... when carving em, split em straight.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_14": "A crooked shaft wastes your effort.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_15": "Shape a stone point, then fasten it tight.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_16": "Fletchings stabilize the arrow.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_17": "You can use feathers, or even wood or duct tape in a pinch.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_18": "Nock each arrow securely. If it slips off the string, it cannot fly straight.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_19": "Nock securely, draw smoothly, and anchor consistently.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_20": "And only draw right when you're about to fire.",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_21": "Until next time guys!",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_Item": "VHS: Exposure Survival E9",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_Subtitle": "Episode 9: Bows and Arrows",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Recorded_Media.json|RM_ACExposureSurvivalE9_Title": "Exposure Survival",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_UltimateMarksman": "Archery and Crossbows",
  "translate_en|mods/UltimateMarksman/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_UltimateMarksman_ArrowRecoveryChance": "Arrow Recovery Chance",
