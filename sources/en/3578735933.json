  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_CullLightsToView": "Cull lights to player view",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_CullLightsToView_tooltip": "When enabled, streetlights far from every player stay dark to save GPU/CPU in dense cities. Only needed on weaker machines.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_DecorativeLightBoost": "Sign light reach",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_DecorativeLightBoost_tooltip": "Scales how far sign and billboard light reaches (not its brightness). Signs keep their own colour. The game caps any light at 20 tiles.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_Enabled": "Enable Generator Streetlights Restored",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_Enabled_tooltip": "Master switch for this mod’s lighting. Turn it off to switch every generator-powered streetlight off without removing the mod.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_ExcludeSprites": "Exclude sprite names/prefixes",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_ExcludeSprites_tooltip": "Advanced: comma-separated sprite names or prefixes the mod should never light (e.g. lighting_outdoor_01_0, signs_one-off_). A name ending in _ or * is treated as a prefix. Leave blank to include all supported sprites.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_IncludeDecorative": "Light outdoor signs and billboards",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_IncludeDecorative_tooltip": "Also lights outdoor shop signs, neon and billboards that the game normally powers only from the grid. Indoor lamps and anything inside a building are never touched: the game already powers those from generators, and their switches work as normal.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_InstantWarmup": "Instant light switching",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_InstantWarmup_tooltip": "Advanced: when on, light changes are applied as soon as they're ready so lights pop on together. When off, changes are applied in calmer batches a few frames apart. Lights are batched either way, so moving through powered areas doesn't stutter.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorB": "Streetlight color B (0..255)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorB_tooltip": "Blue channel for custom streetlight color. Used when 'Override streetlight color' is enabled.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorG": "Streetlight color G (0..255)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorG_tooltip": "Green channel for custom streetlight color. Used when 'Override streetlight color' is enabled.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorOrder": "Streetlight color order",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorOrder_tooltip": "Advanced: for tilesets that store color in a non-RGB order. Keep at RGB unless you know what you're doing.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorPreset": "Streetlight color preset",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorPreset_tooltip": "Choose a predefined color for streetlights. To use custom RGB, enable 'Override streetlight color' above and set the RGB sliders.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorR": "Streetlight color R (0..255)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorR_tooltip": "Red channel for custom streetlight color. Used when 'Override streetlight color' is enabled.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightIntensityPct": "Streetlight intensity (%%)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightIntensityPct_tooltip": "Color strength of streetlight lamps. With the Amber preset, 100%% matches vanilla grid-powered streetlights; 120%% is a little stronger, 50%% is dimmer.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightLampRadius": "Streetlight lamp radius (tiles)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightLampRadius_tooltip": "Glow radius of each streetlight lamp (not the generator range). The game caps any light at 20 tiles, so values above 20 look the same as 20. Vanilla grid streetlights use 13.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightRadius": "Generator lighting tile range",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightRadius_tooltip": "How far, in tiles, a running generator powers streetlights, outdoor signs and billboards at night. This is the mod’s own range: the vanilla generator tile range does NOT affect it. 20–35 is a good default.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_UseCustomStreetlightColor": "Override streetlight color",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_UseCustomStreetlightColor_tooltip": "When enabled, streetlights use the custom RGB color set below instead of the preset. Signs and billboards keep their own colors.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_ViewCullPadding": "View cull padding (tiles)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_ViewCullPadding_tooltip": "Advanced: a light that is already on stays on until you are this much farther than the cull radius, so lights don't flicker at the edge. 8–16 is recommended.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_ViewCullRadius": "View cull radius (tiles)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_ViewCullRadius_tooltip": "How far from each player lights are kept when culling is enabled. Increase to keep distant lights visible; reduce for more performance."
}
