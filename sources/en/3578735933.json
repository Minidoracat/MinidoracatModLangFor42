  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_CullLightsToView": "Cull lights to player view",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_CullLightsToView_tooltip": "When enabled, disables lights far outside the player’s current view to reduce GPU/CPU usage in dense areas. Use if you’re running into performance problems.",
