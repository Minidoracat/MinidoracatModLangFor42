  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_Enabled": "Enable Generator Streetlights Restored",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_Enabled_tooltip": "Master switch for this mod’s lighting. Disable to turn off generator powered streetlights without removing the mod; useful for testing and avoiding Lua reloading.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_ExcludeSprites": "Exclude sprite names/prefixes",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_ExcludeSprites_tooltip": "Advanced: Comma-separated list of sprite names or prefixes to exclude from lighting on (e.g., advertising_01_36, billboard_). Leave blank to include all supported sprites.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_GenDiscoverRadius": "Generator discovery radius (tiles)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_GenDiscoverRadius_tooltip": "Advanced: distance around each player to scan for generators that power streetlights. Larger values pick up more gens sooner at a small overhead.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_IncludeDecorative": "Light world decorative/sign sprites",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_IncludeDecorative_tooltip": "Lights sprites that define their own light (signs, shop fronts, billboards) within a powered area.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_InstantWarmup": "Instant warmup burst on area entry",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_InstantWarmup_tooltip": "Advanced: briefly boosts the relight process when you enter a powered area so lights appear to turn on instantly. Recommended to leave on.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorB": "Streetlight color B (0..255)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorB_tooltip": "Blue channel for custom streetlight color. Used when 'Override streetlight color' is enabled.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorG": "Streetlight color G (0..255)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorG_tooltip": "Green channel for custom streetlight color. Used when 'Override streetlight color' is enabled.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorOrder": "Streetlight color order",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorOrder_tooltip": "Advanced: for tilesets that store color in a non-RGB order. Keep at RGB unless you know what you're doing.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorPreset": "Streetlight color preset",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorPreset_tooltip": "Choose a predefined color for streetlights. To use custom RGB, enable 'Override streetlight color' above and set the RGB sliders.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorR": "Streetlight color R (0..255)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightColorR_tooltip": "Red channel for custom streetlight color. Used when 'Override streetlight color' is enabled.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightIntensityPct": "Streetlight intensity (%)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightIntensityPct_tooltip": "Overall brightness multiplier for streetlight lights. 100% = default. 120% is slightly brighter; 50% is dimmer.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightLampRadius": "Streetlight lamp radius (tiles)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightLampRadius_tooltip": "Radius of the glow for each streetlight lamp (not the generator radius). Higher values create more overlap and brightness at the cost of performance.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightRadius": "Generator lighting tile range",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_StreetlightRadius_tooltip": "The tile range of how far a generator powers world light sources. Larger ranges light up more of the map, but values past 40 can make lights take longer to appear. 20–35 is average and recommended for performance. Note: The vanilla Sandbox generator tile range does NOT affect this value.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_TogglePollRadius": "Generator toggle poll radius (tiles)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_TogglePollRadius_tooltip": "Advanced: within this range of a player, generators are checked frequently for ON/OFF changes. Larger radius detects changes farther away with more polling.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_UseCustomStreetlightColor": "Override streetlight color",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_UseCustomStreetlightColor_tooltip": "When enabled, forces streetlights to use the custom RGB color set below (or use the color order below). Decorative/sign lights keep their own colors.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_ViewCullPadding": "View cull padding (tiles)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_ViewCullPadding_tooltip": "Advanced: extra margin beyond the cull radius to avoid pop-in while moving. A small buffer (8–16) is recommended.",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_ViewCullRadius": "View cull radius (tiles)",
  "translate_en|mods/Generator Streetlights Restored/42.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_StreetlightGen_ViewCullRadius_tooltip": "How far from each player lights are kept when culling is enabled. Increase to keep distant lights visible; reduce for more performance."
}
