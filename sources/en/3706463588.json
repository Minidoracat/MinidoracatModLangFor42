{
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/ItemName.json|ApocNemesisBoss.MrXSuit": "MrX's Suit",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/ItemName.json|ApocNemesisBoss.NemesisSuit": "Nemesis's Suit",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis": "Nemesis Boss",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_BossCooldownCycles": "Boss Cooldown Cycles",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_BossCooldownCycles_tooltip": "After the boss spawns near a player, that player is protected from being targeted again for this many spawn cycles. 0 disables the cooldown. Default: 3.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_BossMaxHits": "Boss Hits Before Damage",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_BossMaxHits_tooltip": "Number of hits the boss can absorb before taking actual damage. Higher values make the boss harder to kill. Default: 10.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_CooldownPerPlayer": "Cooldown Per Player",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_CooldownPerPlayer_tooltip": "Extra cooldown cycles added per online player when scaling is enabled. For example, with 4 players online and this set to 1, the cooldown increases by 4 cycles. Default: 1.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_CooldownScaleByPlayers": "Scale Cooldown by Online Players",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_CooldownScaleByPlayers_tooltip": "When enabled, the cooldown duration increases based on the number of online players. The extra cycles are calculated as (online players × Cooldown Per Player). Default: off.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_Debug": "Debug Logging",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_Debug_tooltip": "Enable debug messages in the server console. Useful for troubleshooting spawn behavior. Default: off.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_DetectionRange": "Detection Range",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_DetectionRange_tooltip": "Distance in tiles at which the Nemesis is detected and tracked by the client. Also controls when sounds and redirect start. Default: 80.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_GruntChance": "Grunt on Hit Chance (%%)",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_GruntChance_tooltip": "Percentage chance that the Nemesis grunts when hit by a weapon. 0 disables grunts. Default: 50.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_OutfitName": "Boss Outfit Name",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_OutfitName_tooltip": "Comma-separated list of outfit names used when spawning the boss zombie. Each must match a registered outfit (e.g. Nemesis,MrX).",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_OutfitWeights": "Outfit Spawn Weights",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_OutfitWeights_tooltip": "Comma-separated percentages controlling how likely each outfit is to be picked. Must match the outfit list order (e.g. 50,50). Missing values default to 0.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_PressurePerMinute": "Pressure Per Minute",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_PressurePerMinute_tooltip": "How much spawn pressure accumulates each game minute while no boss is active. Higher values make the boss appear sooner. Default: 3.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_PressureThreshold": "Pressure Threshold",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_PressureThreshold_tooltip": "The pressure value that must be reached before a spawn roll can occur. Higher values delay the first possible spawn. Default: 30.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_RedirectSeconds": "Pathfind Redirect Interval (seconds)",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_RedirectSeconds_tooltip": "How often in seconds the owning client re-issues a pathfind command to direct the Nemesis toward the nearest player. Lower values make the Nemesis track more aggressively. Default: 5.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_RoarChance": "Roar Chance (%%)",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_RoarChance_tooltip": "Percentage chance that the Nemesis roars each cooldown cycle. 0 disables roars. Default: 40.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_RoarCooldownSeconds": "Roar Cooldown (seconds)",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_RoarCooldownSeconds_tooltip": "Minimum time in seconds between roar sound checks. Default: 8.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_SpawnAttempts": "Spawn Location Attempts",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_SpawnAttempts_tooltip": "Number of random locations tried to find a valid spawn square. Increase if boss fails to spawn in dense areas. Default: 24.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_SpawnMaxDistance": "Maximum Spawn Distance",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_SpawnMaxDistance_tooltip": "Maximum tile distance from the target player where the boss can spawn. Default: 45.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_SpawnMinDistance": "Minimum Spawn Distance",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_SpawnMinDistance_tooltip": "Minimum tile distance from the target player where the boss can spawn. Default: 30.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_SpawnRollPercent": "Spawn Roll Chance (%%)",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_SpawnRollPercent_tooltip": "Percentage chance each minute (after threshold is met) that the boss actually spawns. Lower values make spawns less predictable. Default: 10.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_StarsRange": "STARS Announcement Range",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_StarsRange_tooltip": "Distance in tiles at which the STARS announcement plays when the Nemesis is first detected nearby. Default: 40.",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_ThemeRange": "Theme Music Range",
  "translate_en|mods/ApocalipseBrProjetoNemesis/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ApocalipseBrProjetoNemesis_ThemeRange_tooltip": "Distance in tiles at which the looping theme music begins playing on the Nemesis zombie. Default: 60."
}
