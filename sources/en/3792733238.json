  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_AcidOverlay": "Show acid footprint (debug)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_AcidOverlay_tooltip": "Highlight in green every tile an acid pool actually damages, so the damage area can be compared with what is drawn. Needs the game launched with -debug; ignored otherwise.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_AcidSimpleZone": "Accessibility: simplify acid zones",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_AcidSimpleZone_tooltip": "Draw a plain circle on top of each acid pool, marking exactly how far it reaches. The splat is still drawn underneath - this adds a clear outline rather than replacing it.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamitiesEnabled": "Enable Calamities",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamitiesEnabled_tooltip": "Master switch for tier 6. When off, no Calamity ever spawns and the options below are ignored. Not implemented yet - this switch does nothing.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamityCentaur": "The Centaur (Fast + Tank)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamityCentaur_tooltip": "Charges at extreme speed, smashing through every breakable obstacle in its path. Not implemented yet - this switch does nothing.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamityHost": "The Host (Stealth + Ranged)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamityHost_tooltip": "Immobile and extremely tough. Endlessly spawns Zed+ until it is killed. Not implemented yet - this switch does nothing.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamityLeader": "The Leader (Tank + Ranged)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamityLeader_tooltip": "Huge and slow. Grabs the zombies around it and hurls them at you. Not implemented yet - this switch does nothing.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamityMinZombies": "Zombies required in the zone",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamityMinZombies_tooltip": "How many zombies must be nearby for a T4 to become a Calamity.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamityMist": "The Mist (Fast + Stealth)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamityMist_tooltip": "Fast and fragile. Trails a dense smoke cloud that blinds the area behind it. Not implemented yet - this switch does nothing.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamityPrePlaced": "Pre-placed Calamities",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamityPrePlaced_tooltip": "Place a few Calamities near landmark buildings when the world is created.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamityRadius": "Exclusion radius (tiles)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_CalamityRadius_tooltip": "Only one Calamity may exist within this radius. Smaller radius means more Calamities on the map.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_DayTier1": "Day T1-T2 start appearing",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_DayTier1_tooltip": "Apocalypse day from which Reinforced Zombies can spawn. They look and sound completely ordinary.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_DayTier3": "Day T3-T4 start appearing",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_DayTier3_tooltip": "Apocalypse day from which specialised Zed+ can spawn. Before this day, only T1-T2 are rolled.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_DayTier5": "Day T5 can appear",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_DayTier5_tooltip": "Earliest day a T4 may evolve into a final form. It must also have survived the delay set below.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_DayTier6": "Day T6 can appear",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_DayTier6_tooltip": "Earliest day a T4 may become a Calamity. The zone conditions must be met as well.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_Debug": "Debug logging",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_Debug_tooltip": "Print Zed+ spawn decisions to the console. Noisy, for testing only.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_PathFast": "Fast path",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_PathFast_tooltip": "Faster than normal, less resistant. Disabling a path removes it from the roll along with its final forms.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_PathRanged": "Ranged path",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_PathRanged_tooltip": "Keen senses: spots you from far outside normal detection range. Disabling a path removes it from the roll along with its final forms.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_PathStealth": "Stealth path",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_PathStealth_tooltip": "Dulled senses: only notices you from a few tiles away. Disabling a path removes it from the roll along with its final forms.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_PathTank": "Tank path",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_PathTank_tooltip": "Much slower, far tougher. Disabling a path removes it from the roll along with its final forms.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_SpawnRate": "Zed+ rarity (1 in N zombies)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_SpawnRate_tooltip": "How many ordinary zombies spawn for each Zed+. Higher means rarer. Default 400.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_ThrillerEnabled": "Thriller easter egg",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_ThrillerEnabled_tooltip": "An ultra-rare group of dancing zombies found on roads.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_ThrillerRarity": "Thriller rarity (1 in N)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_ThrillerRarity_tooltip": "Higher means rarer.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_TierRampDays": "Tier ramp (days)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_TierRampDays_tooltip": "How long a tier takes to go from rare to common after the day it unlocks. Higher tiers end up more likely than lower ones, so the zombies you meet climb the ladder as you survive - but the lower tiers never disappear. Set to 0 to skip the ramp entirely.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightBoomer": "Boomer weight (Tank)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightBoomer_tooltip": "How often this form is chosen instead of the Colossus. Relative to it, not a percentage - two forms at 50 and 50 is the same as 100 and 100. Set to 0 and it never spawns.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightColossus": "Colossus weight (Tank)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightColossus_tooltip": "How often this form is chosen instead of the Boomer. Relative to it, not a percentage - two forms at 50 and 50 is the same as 100 and 100. Set to 0 and it never spawns.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightMimic": "Mimic weight (Stealth)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightMimic_tooltip": "How often this form is chosen instead of the Stalker. Relative to it, not a percentage - two forms at 50 and 50 is the same as 100 and 100. Set to 0 and it never spawns.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightScout": "Scout weight (Ranged)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightScout_tooltip": "How often this form is chosen instead of the Spitter. Relative to it, not a percentage - two forms at 50 and 50 is the same as 100 and 100. Set to 0 and it never spawns.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightSpitter": "Spitter weight (Ranged)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightSpitter_tooltip": "How often this form is chosen instead of the Scout. Relative to it, not a percentage - two forms at 50 and 50 is the same as 100 and 100. Set to 0 and it never spawns.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightStalker": "Stalker weight (Stealth)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightStalker_tooltip": "How often this form is chosen instead of the Mimic. Relative to it, not a percentage - two forms at 50 and 50 is the same as 100 and 100. Set to 0 and it never spawns.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightVolatile": "Volatile weight (Fast)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightVolatile_tooltip": "How often this form is chosen instead of the Witch. Relative to it, not a percentage - two forms at 50 and 50 is the same as 100 and 100. Set to 0 and it never spawns. The Volatile is not implemented, which is why it ships at 0.",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightWitch": "Witch weight (Fast)",
  "translate_en|mods/SZedPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SZedPlus_WeightWitch_tooltip": "How often this form is chosen instead of the Volatile. Relative to it, not a percentage - two forms at 50 and 50 is the same as 100 and 100. Set to 0 and it never spawns."
}
