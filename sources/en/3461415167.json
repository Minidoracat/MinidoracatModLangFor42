  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Recipes.json|RepairFlatOffroadWheelRear": "Repair Flat Offroad Wheel (Rear)",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Recipes.json|RepairFlatStreetWheelFront": "Repair Flat Street Wheel (Front)",
