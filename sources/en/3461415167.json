  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle": "Bicycle",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_AllowTransferToInventory": "Allow Transfer to Inventory",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_AllowTransferToInventory_tooltip": "Allow bicycles to be transferred into the player inventory instead of only the floor or vehicle trunk.",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_ImmersiveMode": "Immersive Mode",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_ImmersiveMode_tooltip": "When enabled you will be slower on rough surfaces unless the bicycle has a full offroad wheel setup.",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_LoadPenaltyEnabled": "Container Load Penalty",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_LoadPenaltyEnabled_tooltip": "When enabled, attaching containers makes the bike harder to turn and heavy cargo slows it down. Disable for vanilla bike handling regardless of load.",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_MaxSpeedPenalty": "Max Speed Penalty % (Default 35)",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_MaxSpeedPenalty_tooltip": "Maximum reduction in bike speed at 20kg of cargo inside containers. Heavy cargo slows both pedal speeds proportionally; fast pedal stays faster than slow. 0 = no speed penalty.",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_MaxTurnPenalty": "Max Turn Penalty % (Default 50)",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_MaxTurnPenalty_tooltip": "Maximum reduction in turn rate when all 6 containers are attached. 0 = no turning penalty. Capped at 75% to keep the bike usable.",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_RunSpeedMultiplier": "Bicycle Speed Fast (Default 3.1)",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_RunSpeedMultiplier_tooltip": "Set your player speed when riding the bicycle and holding SHIFT.",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_SidecarSpawnRate": "Sidecar Spawn Rate",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_SidecarSpawnRate_tooltip": "Percent-based multiplier applied to sidecar spawn chances - both for sidecars found loose in garages, storage units, and sheds, and for sidecars rarely pre-attached to a newly spawned bicycle. Set to 0 to disable sidecar spawns entirely.",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_SpawnRate": "Bicycle Spawn Rate",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_SpawnRate_tooltip": "Percent-based multiplier applied to bicycle spawn chances. Set to 0 to disable bicycle spawns entirely.",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_WalkSpeedMultiplier": "Bicycle Speed Slow (Default 2.2)",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_WalkSpeedMultiplier_tooltip": "Set your player speed when riding the bicycle and not holding SHIFT.",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_ZombieContactSensitivity": "Zombie Contact Sensitivity (Default 30)",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_ZombieContactSensitivity_tooltip": "How close a zombie must be to count as touching. Higher widens the contact range slightly so zombies count from a touch further out; 0 requires true body overlap.",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_ZombieSlowdownEnabled": "Zombie Contact Slowdown",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_ZombieSlowdownEnabled_tooltip": "When riding, zombies that physically press against you slow the bike - a single bump bleeds off a little speed, and being surrounded slows you toward a near-stop. Sustained contact from a full surround also knocks you off the bike.",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_ZombieSlowdownStrength": "Zombie Slowdown Strength % (Default 100)",
  "translate_en|mods/Bicycle/42.13/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Bicycle_ZombieSlowdownStrength_tooltip": "Scales how hard contacting zombies slow you. 100 = default curve (1 zombie ~85% speed, 4+ near stop). Lower is gentler, higher is harsher. Does not affect the knock-off.",
