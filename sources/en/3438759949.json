  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_EqualizeVehicleTypes": "Equalize vehicle type chances",
