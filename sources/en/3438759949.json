  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedBurntChance_tooltip": "Only used when Preset = Custom. 0 = never burnt, 100 = always burnt.",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedInjectTrailers": "Custom: add trailers to common zones",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedInjectTrailers_tooltip": "Only used when Preset = Custom. Adds trailer vehicle types into common zone lists (parking lots/residential/commercial), so they can actually spawn there. Use together with trailer spawn bias to see more trailers overall.",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedInjectUniqueVehicles": "Custom: add unique vehicles to common zones",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedInjectUniqueVehicles_tooltip": "Only used when Preset = Custom. Injects a small pool of branded/service vans (Spiffo/Radio/Butchers/Mail etc) into common zones so they can appear more widely.",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedKeyChance": "Custom: key chance",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedKeyChance_tooltip": "Only used when Preset = Custom. Chance the vehicle spawns with a key available.",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedPartDamageChance": "Custom: part damage chance",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedPartDamageChance_tooltip": "Only used when Preset = Custom. Adds/sets how often parts spawn damaged.",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedSpawnRateMultiplier": "Custom: spawn rate multiplier",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedSpawnRateMultiplier_tooltip": "Only used when Preset = Custom. Multiplies each zone's spawnRate (clamped to 100). 1.0 = vanilla rates.",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedSpecialVehicleChance": "Custom: emergency/special vehicle chance",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedSpecialVehicleChance_tooltip": "Only used when Preset = Custom. Sets each zone's chanceToSpawnSpecial (special vehicles like police/fire/ambulance). Higher values = more emergency vehicles everywhere.",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedTrailerBias": "Custom: trailer spawn bias",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedTrailerBias_tooltip": "Only used when Preset = Custom. Boosts how often trailer-type vehicles (names containing 'Trailer') are chosen inside a zone. 1.0 = no change, 2.0 = about twice as common, 0.0 = disable trailers (only in zones that already include them).",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedUniqueBias": "Custom: unique vehicle bias",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedUniqueBias_tooltip": "Only used when Preset = Custom. Boosts branded/service vehicles (Spiffo/Radio/Butchers and many underscore variants like StepVan_* and Van_*).",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedUniqueVehiclePercent": "Custom: unique vehicle percent",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedUniqueVehiclePercent_tooltip": "Only used when Preset = Custom. How much of each zone's vehicle-type weighting is reserved for injected unique vehicles (1-50).",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedVanBias": "Custom: van spawn bias",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedVanBias_tooltip": "Only used when Preset = Custom. Boosts how often van-type vehicles are chosen inside each zone. 1.0 = no change, 2.0 = about twice as common.",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedVehicleQuality": "Custom: vehicle quality",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_AdvancedVehicleQuality_tooltip": "Only used when Preset = Custom. Higher values mean better parts when damaged (roughly).",
  "translate_en|mods/HydeCoUnlimitedCars/42.4.0/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoUnlimitedCars_DebugLogging": "Debug logging",
