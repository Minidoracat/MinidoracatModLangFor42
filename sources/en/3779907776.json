  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_MeowNearZombies": "Meow when zombies nearby",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_MeowNearZombiesRadius": "Meow near zombies radius",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_MeowNearZombiesRadius_tooltip": "Tiles. How far companion cats scan for zombies before the warning meow. Default 24 so the cat alerts before typical player sight. Independent of Shoulder auto-dismount zombie radius. 0 disables warning meows. Rising-edge + long cooldown still apply.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_MeowNearZombies_tooltip": "When ON (default), companion cats meow once when zombies first enter the zombie-warning radius (see Meow near zombies radius; independent of shoulder dismount). Long cooldown and rising-edge only — no spam during a horde. Strays do not alert. If Meows attract zombies is also ON, the warning meow can pull zombies.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_MeowsAttractZombies": "Meows attract zombies",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_MeowsAttractZombies_tooltip": "When OFF (default), cat meows and purrs are local cosmetic sounds only and do not alert zombies. When ON, meows (including zombie-warning meows) create world sound that can attract zombies. Leave OFF if you want warning meows to stay safe.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_MoodReliefEnabled": "Mood relief from petting",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_MoodReliefEnabled_tooltip": "Petting your cat reduces unhappiness, boredom, stress, and a little panic. Stronger with Cat Lover.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_NaturalWaterDrinkEnabled": "Drink from natural water",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_NaturalWaterDrinkEnabled_tooltip": "When ON (default), thirsty cats may drink from puddles, ponds, lakes, and rivers if no filled water/milk bowl is nearby. Stay may path within the Stay roam radius for water; Follow/Free may path within a short radius. Filled bowls are preferred when available.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_NeedsRateMultiplier": "Hunger / thirst rate",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_NeedsRateMultiplier_tooltip": "Multiplier for how fast companion cats get hungry and thirsty.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_ShoulderZombieRadius": "Shoulder auto-dismount zombie radius",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_ShoulderZombieRadius_tooltip": "Tiles. When a zombie comes this close while the cat is on your shoulder, the cat jumps down and Follows. Independent of the companion zombie-warning meow radius. 0 disables threat dismount only. Fence vault, shoulder ride, and cat moodles are always on.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_ShowCatOnMap": "Show cats on map",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_ShowCatOnMap_tooltip": "When ON (default), companion cats appear on the world map and minimap with a cat-face icon so you can find them (especially useful in Free will).",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_ShowNameTags": "Show cat name tags",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_ShowNameTags_tooltip": "Draw each companion cat's name (or breed) floating above its head in the world.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_SleepBondingEnabled": "Sleep bonding",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_SleepBondingEnabled_tooltip": "Sleeping near your cat grants mood relief and a short rested buff.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_SleepPoseRandom": "Random sleep pose",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_SleepPoseRandom_tooltip": "When OFF (default), cats nap belly-up during the day and on their side at night. When ON, each nap randomly picks belly-up or side sleep (50/50).",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_SpawnRateMultiplier": "Stray spawn rate",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_SpawnRateMultiplier_tooltip": "How often strays appear. 1.0 is normal; 0 pauses world spawns; 2.0 doubles them. World stray spawning itself is always enabled.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_StayKey": "Stay key",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_StayKey_tooltip": "Keyboard key to tell your cat to Stay (default F8): outdoors it may wander near the Stay point; indoors it may roam the house. Context menu still works.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_StayRoamRadius": "Stay outdoor roam radius",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_StayRoamRadius_tooltip": "Tiles. Outdoors, Stay lets the cat wander within this radius of where Stay was issued (default 20). Indoors, Stay roams the building instead. Call still brings the cat back.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_WildCatsCanBeRunOver": "Wild cats can be run over",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_WildCatsCanBeRunOver_tooltip": "When ON (default), unowned stray cats can be killed by vehicles like other animals. Owned companion cats stay protected. When OFF, strays are also invincible.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_ZombieWakeRadius": "Wake owner zombie radius",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_ZombieWakeRadius_tooltip": "Tiles. While the owner is asleep, companion cats use this shorter radius to meow and wake you when zombies get close. Only applies when Meow when zombies nearby is ON. Default 10.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/UI.json|UI_trait_CMCatLover": "Cat Lover",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/UI.json|UI_trait_CMCatLoverDesc": "Animals trust you faster. Comfort from cats is stronger. Does not start with a cat — find strays and earn trust with food. Cats never fight zombies."
}
