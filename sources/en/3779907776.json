  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_Key_option2": "C",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_Key_option3": "V",
