  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod": "Cats Mod",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_AffectionSeekThreshold": "Attention request affection threshold",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_AffectionSeekThreshold_tooltip": "Cats ask for pets/attention only when Affection is BELOW this (0–100). High affection = content. Default 40.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_AllowDebugSpawn": "Allow debug spawn",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_AllowDebugSpawn_tooltip": "Adds a right-click world option to spawn a stray cat (admin only in multiplayer).",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_CallAllKey": "Call all cats key",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_CallAllKey_tooltip": "Keyboard key to call all owned bonded cats to Follow (default Backspace). Same as ground Cats Mod → Call all. Remappable. Chat/text focus ignores this key.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_CallKey": "Call / Follow key",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_CallKey_tooltip": "Keyboard key to call one cat to follow (default F7): nearest owned bonded cat, or your active companion. Also ends free roam. Use Call all for every bonded cat. Context menu and ground Cats Mod → Call still work.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_CatsInvincible": "Cats ignore zombie damage",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_CatsInvincible_tooltip": "Companion cats cannot be hurt by zombies (and stay roadkill-immune). They still never fight zombies.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_FreeWillKey": "Free will / free roam key",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_FreeWillKey_tooltip": "Keyboard key for free roam (default F9): the cat stops forced follow and wanders on its own. Press Call (F7), Call all (Backspace), or ground Cats Mod → Call to bring it back to follow. Toggle Free will again to return to follow.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_HuntEnabled": "Cats hunt small wildlife",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_HuntEnabled_tooltip": "Companion cats may hunt rats, mice, rabbits, raccoons and similar small animals (never zombies). They often eat the catch.",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_Key_option1": "Unbound",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_Key_option10": "N",
  "translate_en|mods/Cats Mod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CatsMod_Key_option11": "M",
