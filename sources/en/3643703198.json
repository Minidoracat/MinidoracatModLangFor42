  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CmpSyringeReusableWithCure": "Vaccine in a reusable syringe.<br>Completely cures infection.<br>Grants one day of virus immunity if uninfected.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CmpSyringeReusableWithPlainVaccine": "Vaccine in a reusable syringe.<br>Reduces infection to 5%.<br>Low reaction to albumin, ~5-7 pills.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CmpSyringeReusableWithQualityVaccine": "Vaccine in a reusable syringe.<br>Reduces infection to 5%.<br>Grants one day of virus immunity if uninfected.<br>High reaction to albumin, ~9-12 pills.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CmpSyringeReusableWithSerum": "Vaccine in a reusable syringe.<br>Completely cures infection.<br>Grants two days of virus immunity if uninfected.<br>Gives a chance (cumulative) to obtain resistant antibodies if infected.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CmpSyringeWithBlood": "Used for further analysis, research, and vaccine development.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CmpSyringeWithCure": "Vaccine in a disposable syringe.<br>Completely cures infection.<br>Grants one day of virus immunity if uninfected.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CmpSyringeWithPlainVaccine": "Vaccine in a disposable syringe.<br>Reduces infection to 5%.<br>Low reaction to albumin, ~5-7 pills.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CmpSyringeWithQualityVaccine": "Vaccine in a disposable syringe.<br>Reduces infection to 5%.<br>Grants one day of virus immunity if uninfected.<br>High reaction to albumin, ~9-12 pills.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CmpSyringeWithSerum": "Vaccine in a disposable syringe.<br>Completely cures infection.<br>Grants two days of virus immunity if uninfected.<br>Gives a chance (cumulative) to obtain resistant antibodies if infected.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CmpTestTubeWithAntibodies": "Basis for creating a cure for the zombie virus.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CmpTestTubeWithInfectedBlood": "«V+» - zombie virus infection present, «V-» - none;<br>«A+» - resistant antibodies present, «A-» - none;<br>«V+[N]», where N - infection percentage!<br>When separating into components, bonus to obtaining blood cells:<br>- Type «V-, A-»: -20 percent;<br>- Type «V-, A+\": +25 percent;<br>- Type «V+, A-»: +30 percent;<br>- Type «V+, A+»: +40 percent.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_CmpTestTubeWithTaintedBlood": "This sample is only suitable for disposal.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_LabCentrifuge": "Used for separating blood into components.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_LabChemistrySet": "Workstation for conducting various chemical reactions.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_LabChromatograph": "Device for isolating required elements from compounds.<br>Requires a computer to operate.",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Tooltip_EN.txt|Tooltip_LabCorks": "A bunch of corks.<br>You need something to stopper test tubes and flasks!",
