  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_AntibodyPower": "TRAIT - Resistant Antibodies. Stage:",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_AntibodyPower2": "TRAIT - Resistant Antibodies. Potency:",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_AntibodyPower2_tooltip": "Affects how quickly resistant antibodies eliminate the zombie virus from the body after activation in the stage.<br> <INDENT:20>-This trait is acquired by injecting the level 4 vaccine;<br> <INDENT:20>-If potency = 6, then ~5% infection is removed per hour;<br> <INDENT:20>-If potency = 12, then ~10% infection is removed per hour;<br> <INDENT:20>-If potency = 24, then ~20% infection is removed per hour.<br>",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_AntibodyPower_tooltip": "Affects at which infection stage the resistant antibodies activate.<br> <INDENT:20>-This trait is acquired by injecting the level 4 vaccine;<br> <INDENT:20>-TERMINAL - when infected over 80%, health drains, high chance of death;<br> <INDENT:20>-PRETERMINAL - when infected over 60% (nausea, fever)(RECOMMENDED!);<br> <INDENT:20>-MODERATE - when infected over 40% (mild nausea);<br> <INDENT:20>-INITIAL - when infected over 20% (no symptoms).<br>",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_AntibodyPowers_option1": "Terminal",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_AntibodyPowers_option2": "Preterminal",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_AntibodyPowers_option3": "Moderate",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_AntibodyPowers_option4": "Initial",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_BookInWorldSpawnChance": "WORLD SPAWN - Books. Multiplier:",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_BookInWorldSpawnChance_tooltip": "Affects the number of laboratory (mod) books in the world.<br> <INDENT:20>-Setting to 0 disables their world spawn;<br> <INDENT:20>-Does not affect book drops from special zombies.<br>",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_DefaultVaccineSpawnChance": "SPECIAL ZOMBIE LOOT - Vaccine. %:",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_DefaultVaccineSpawnChance_tooltip": "First-level vaccine that reduces infection to 5%.<br> <INDENT:20>-This option affects the drop chance in SPECIAL ZOMBIES.<br>",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_General_ModSandbox": "zRe VACCINE 2.0",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_ResearchMinHealthNotification": "RESEARCH - Blood Draw. Notification:",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_ResearchMinHealthNotification_tooltip": "Affects at what health level the character will notify<br>about crossing the critical health threshold specified in this parameter!<br>",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_ResearchRand": "RESEARCH - Progress bonus. Number:",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_ResearchRand_tooltip": "Only works for the vaccine improvement research type \"PROGRESSIVE CHANCE\" and \"FULL RESEARCH\"!<br> <INDENT:20>-In case of failed research, increases the result by a randomizer depending on this number (hereafter referred to as X);<br> <INDENT:26>-The formula works as:<br> Rand(X, X*2) for research up to level 2;<br> <INDENT:26>Rand(X*0.75, X*1.5) for research up to level 3;<br> <INDENT:26>Rand(X*0.5, X) for research up to level 4!<br> <INDENT:20>-Rounded up to the nearest whole number;<br> <INDENT:20>-Simply put: the randomizer decreases for researching a new vaccine by ~30% on average.<br>",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_ResearchReduceHealth": "RESEARCH - Blood Draw. Health reduction:",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_ResearchReduceHealth_tooltip": "When performing the recipe \"Take blood for further work\" your health will be reduced by this value!<br>",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_ResearchType": "RESEARCH - Vaccine Improvement. Type:",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_ResearchType_tooltip": "Choice of result type for improving (researching) new vaccine levels.<br> <INDENT:20>-PROGRESSIVE CHANCE - on failure, the next success chance increases (accumulates);<br> <INDENT:20>-STATIC CHANCE - fixed percentage chance of success (30,20,14% from second to fourth);<br> <INDENT:20>-FULL RESEARCH - there is a hidden progress bar for study (100 units, conditionally, each research fills the bar).<br>",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_ResearchTypes_option1": "Progressive chance",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_ResearchTypes_option2": "Static chance",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_ResearchTypes_option3": "Full research",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_ScalpelTweezersSpawnChance": "SPECIAL ZOMBIE LOOT - Scalpel/Tweezers. %:",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_ScalpelTweezersSpawnChance_tooltip": "This option affects the drop chance in SPECIAL ZOMBIES.<br>",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_SpecZombieSpawnChance": "SPECIAL ZOMBIE. Spawn weight:",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_SpecZombieSpawnChance_tooltip": "The main zombie from the mod, the key element needed<br>to begin your research journey!<br> <INDENT:20>-Regular zombies vary from 2000+;<br> <INDENT:20>-For example, the Golfer zombie (quite rare) has a weight of 2000, while the Park Ranger has 10000.<br>",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_TigelTongsSpawnChance": "SPECIAL ZOMBIE LOOT - Crucible/Glassblower Tongs. %:",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_TigelTongsSpawnChance_tooltip": "This option affects the drop chance in SPECIAL ZOMBIES.<br>",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_TubeOrSyringeOrFlaskSpawnChance": "SPECIAL ZOMBIE LOOT - Test Tubes/Syringes/Flasks. %:",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_TubeOrSyringeOrFlaskSpawnChance_tooltip": "This option affects the drop chance in SPECIAL ZOMBIES.<br>",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_chanceToNormal": "LOOT IN ALL ZOMBIES - Normal sample. %:",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_chanceToNormal_tooltip": "Determines the chance to obtain a normal sample after killing a zombie.<br>",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_chanceToRare": "LOOT IN ALL ZOMBIES - Rare sample. %:",
  "translate_en|mods/zReVaccin 3/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_zReV2_chanceToRare_tooltip": "Determines the chance to obtain a rare sample after killing a zombie.<br>",
