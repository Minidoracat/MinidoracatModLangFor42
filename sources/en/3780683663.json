  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors": "Push Doors!",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_AffectCrawlers": "Affect Crawlers",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_AffectCrawlers_tooltip": "Allows door impacts to damage and stun crawling zombies.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_AllowImpactsFromBothSides": "Allow Impacts from Both Sides",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_AllowImpactsFromBothSides_tooltip": "Allows doors, fences, and double doors to apply mod effects from either side.\nDisabled by default. Garages and sliding doors are unaffected.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ArmStrainGainMultiplier": "Arm Strain Gain",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ArmStrainGainMultiplier_tooltip": "Scales strain added to both arms by regular successful impacts and to the selected arm during forced opening.\nIt also applies before garage-specific strain.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ArmStrainPenaltyMultiplier": "Arm Strain Penalty",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ArmStrainPenaltyMultiplier_tooltip": "Scales how arm strain reduces damage and knockdown chance.\nDefault: 1.0.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ArmStrainRecoveryMultiplier": "Impact Recovery Duration",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ArmStrainRecoveryMultiplier_tooltip": "Scales the anti-spam recovery between CPD impacts: 1.60s at 0-4.99 arm strain, 2.00s light, and 2.50s medium/high.\nLow Endurance can add extra recovery time. Default: 1.0.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ArmStrainUsageLimitMultiplier": "Arm Strain Limit",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ArmStrainUsageLimitMultiplier_tooltip": "Scales the 20.00 limit and every penalty threshold.\nBoth arms at the limit block CPD effects. Default: 1.0.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_DamagePlayers": "Damage Players",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_DamagePlayers_tooltip": "Allows impacts to damage other valid PvP players. On normal doors, fence gates, and double entrances, a stronger target blocks the regular interaction but can be hit through forced opening. Sliding and garage doors do not use the player Strength block.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_DoorBlockCapacityMultiplier": "Crowd Opening Capacity",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_DoorBlockCapacityMultiplier_tooltip": "Scales how many eligible zombies a character can push through before an entrance blocks.\nIt also changes the pressure used to calculate regular and forced door wear. Garages are excluded. Default: 1.0.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_DoorWearMultiplier": "Door Wear Multiplier",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_DoorWearMultiplier_tooltip": "Scales every durability loss caused by Push Doors!.\n0 disables regular, forced, and garage wear, including random garage failure. Default: 1.0.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_EnduranceCostMultiplier": "Endurance Cost Multiplier",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_EnduranceCostMultiplier_tooltip": "Scales vanilla Endurance consumed by successful CPD impacts.\n0 disables CPD drain; current Endurance still affects CPD. Default: 1.0.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ForcedOpeningDoorWearMultiplier": "Forced Opening Door Wear",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ForcedOpeningDoorWearMultiplier_tooltip": "Extra wear multiplier for successful forced openings.\nStacks with Door Wear; 0 disables only forced-opening wear. Default: 1.0.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ForcedOpeningFractureRiskMultiplier": "Forced Opening Fracture Risk",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ForcedOpeningFractureRiskMultiplier_tooltip": "Scales the normal chance of fracturing one healthy part of the selected arm: hand, forearm, or upper arm.\nAt critical endurance, with both arms already at the strain limit, or when the selected arm reaches the limit after the action, fracture risk is always 100%%. Default: 1.0.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_GarageArmStrainMultiplier": "Garage Arm Strain",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_GarageArmStrainMultiplier_tooltip": "Extra strain multiplier for garage impacts.\nStacks with Arm Strain Gain. Default: 1.0.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_GarageDoorWearMultiplier": "Garage Door Wear",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_GarageDoorWearMultiplier_tooltip": "Extra wear multiplier for garage doors.\nStacks with Door Wear. Default: 1.0.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_GarageFailureChanceMultiplier": "Garage Failure Chance",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_GarageFailureChanceMultiplier_tooltip": "Scales garage failure from Strength and existing damage while Door Wear is above 0.\n0 disables random failure, not normal wear. Default: 1.0.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_GlobalImpactFeedback": "Global Impact Feedback",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_GlobalImpactFeedback_tooltip": "When personal feedback controls are locked, controls messages, custom animations, and sound effects for everyone.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_HideIndividualOptions": "Lock Personal Feedback Controls",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_HideIndividualOptions_tooltip": "In MP, locks each player's personal feedback controls and enforces Global Impact Feedback.\nThe forced-opening shortcut remains available.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_KnockDownPlayers": "Knock Down Players",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_KnockDownPlayers_tooltip": "Allows eligible door impacts to knock down other valid PvP players. Regular impacts use Player Knockdown Chance; forced opening has a 100%% knockdown chance across its two-square impact band.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_PlayerKnockdownChance": "Player Knockdown Chance (%%)",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_PlayerKnockdownChance_tooltip": "Maximum chance for regular impacts after comparing Strength and Fitness.\nWinning one stat halves it; winning neither sets it to 0. Forced opening uses 100%% while Knock Down Players is enabled. Default: 25%%.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ZombieDamageMultiplier": "Zombie Damage Multiplier",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ZombieDamageMultiplier_tooltip": "Scales damage dealt to zombies.\n0 disables damage but keeps other effects. Default: 1.0.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ZombieKnockdownChance": "Zombie Knockdown Chance (%%)",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ZombieKnockdownChance_tooltip": "Chance for a selected eligible zombie to fall during regular, closing, or forced impacts; otherwise it staggers.\nArm strain can reduce it. Sliding glass doors never knock zombies down. Default: 35%%.",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ZombiesAffectedMultiplier": "Zombies Affected Multiplier",
  "translate_en|mods/CyesPushDoors/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CyesPushDoors_ZombiesAffectedMultiplier_tooltip": "Scales targets per regular impact for all supported doors.\nForced opening always affects its entire eligible crowd; sliding glass doors remain capped at 3."
}
