  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_AmmoPercent": "Loadout ammunition (%)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_AmmoPercent_tooltip": "100% is the normal kit. 50% gives half of each ammo stack; 200% doubles it; 0% removes loadout ammo.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_Assault": "Special Ops - Rifleman & Marksman",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_BreachNoisePercent": "Breach charge zombie noise (%)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_BreachNoisePercent_tooltip": "100% is normal: 12-tile attraction radius. 50% is 6 tiles. 200% is 24 tiles. 0% creates no zombie-attraction sound.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_BreachSeconds": "Breach charge placement time (seconds)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_BreachSeconds_tooltip": "Set 0 to disable breach charges. Standard placement time is 12 seconds.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_BreacherDemo": "Special Ops - Breacher & Demo Engineer",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_CombatAbilityPercent": "Combat ability strength (%)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_CombatAbilityPercent_tooltip": "100% is normal. 50% halves numerical combat effects, such as the One Shot bonus (2.0 damage becomes 1.0). 150% makes them 1.5 times stronger. 0% disables scripted combat abilities.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_CombatRecoveryPercent": "Combat recovery strength (%)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_CombatRecoveryPercent_tooltip": "Scales SOS combat recovery effects. 100% is normal, 50% halves them, 200% doubles them, and 0% disables them.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_Command": "Special Ops - Squad Leader",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_DeadOperatorCount": "Dead operator spawns",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_DeadOperatorCount_tooltip": "Number of lootable dead operators seeded in a newly created world. Set 0 to disable.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_DropzoneEnabled": "Enable Special Ops Dropzone",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_DropzoneEnabled_tooltip": "Adds the military-approach spawn option to character creation.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_EnduranceResistancePercent": "Endurance resistance (%)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_EnduranceResistancePercent_tooltip": "Reduces new incoming Endurance loss for Operators; it does not restore Endurance. 35% is standard, 0% gives no reduction, and 75% gives the maximum reduction.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_FatigueResistancePercent": "Fatigue resistance (%)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_FatigueResistancePercent_tooltip": "Reduces new incoming Fatigue gain for Operators; it does not remove existing Fatigue. 30% is standard, 0% gives no reduction, and 65% gives the maximum reduction.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_General": "Special Ops - General",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_GhostStealthRange": "Ghost stealth range (tiles)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_GhostStealthRange_tooltip": "Range in which Ghost night cloak can break zombie targeting. Standard is 14 tiles. Set 0 to turn it off.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_Medic": "Special Ops - Combat Medic",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_MedicHealingPercent": "Medic healing strength (%)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_MedicHealingPercent_tooltip": "100% is normal. 50% halves every scripted SOS healing amount. 150% increases it by half. 0% disables scripted SOS healing.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_MedicSupplyUsePercent": "Medic supply use (%)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_MedicSupplyUsePercent_tooltip": "Scales medical supplies consumed by Combat Medic effects. 100% is normal, 50% uses half as much, and 200% uses twice as much.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_MedicTreatmentPercent": "Medic treatment strength (%)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_MedicTreatmentPercent_tooltip": "Scales Combat Medic treatment effects. 100% is normal, 50% halves them, 200% doubles them, and 0% disables them.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_MedicalSupplyPercent": "Loadout medical supplies (%)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_MedicalSupplyPercent_tooltip": "100% is the normal kit. 50% gives half of each medical stack; 200% doubles it; 0% removes medical supplies.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_PainResistancePercent": "Pain resistance (%)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_PainResistancePercent_tooltip": "Reduces new incoming Pain gain for Operators; it does not remove existing Pain or heal wounds. 35% is standard, 0% gives no reduction, and 75% gives the maximum reduction.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_ProfessionGrantsPoints": "Profession grants points",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_ProfessionGrantsPoints_tooltip": "Enabled: 14 means +14 points to spend (the original mod behavior). Disabled: 14 means -14 points to spend (a 14-point cost).",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_ProfessionPointValue": "Profession point value (0-30)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_ProfessionPointValue_tooltip": "Magnitude of the profession's point effect. The direction is set by the option below.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_ScoutGhost": "Special Ops - Scout & Ghost",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_ScoutSenseRange": "Scout Sense range (tiles)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_ScoutSenseRange_tooltip": "Range in which Scout Sense marks zombies while sneaking. Standard is 18 tiles. Set 0 to turn it off.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_SquadAuraRange": "Squad aura range (tiles)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_SquadAuraRange_tooltip": "Range of the Squad Leader's panic suppression and non-stacking incoming Endurance-loss resistance. It never restores Endurance or health. Standard is 14 tiles; set 0 to turn it off.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_StartingKitLevel": "Starting kit level (0-3)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_StartingKitLevel_tooltip": "0 = civilian character preview; a selected Loadout trait replaces it with its complete paid SOS package. 1 = basic clothing and survival items. 2 = standard SOS kit. 3 = reinforced kit with extra supplies.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_SuppressorReductionPercent": "Suppressor sound reduction (%)",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_SuppressorReductionPercent_tooltip": "75% is the default: a 100-tile gunshot becomes 25 tiles. 50% halves it. 0% gives no sound reduction. 95% is near silent.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SOS_Survival": "Special Ops - Survival",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_SOS_BreachCharge": "A focused demolition charge. Right-click an adjacent door or window to breach it without a wide-area explosion.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_SOS_FieldRepair": "Repairs a damaged weapon or tool in your inventory. Requires scrap or electronics scrap, duct tape, and a screwdriver. Can fail and may damage the item.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_SOS_FieldRepairAdvanced": "Stronger field repair for damaged weapons and tools. Needs Maintenance 3, more scrap, tape or epoxy, screwdriver, and pliers. Restores more condition than basic Field Repair.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|IGUI_SOS_FieldTriage_Dead": "Both operators must be alive.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|IGUI_SOS_FieldTriage_Disabled": "Combat abilities are disabled.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|IGUI_SOS_FieldTriage_NotAuthority": "Field Triage must be validated by the server.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|IGUI_SOS_FieldTriage_NotMedic": "Only a Combat Triage Medic can perform Field Triage.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|IGUI_SOS_FieldTriage_OutOfRange": "The target must be within 10 tiles on the same level.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|IGUI_SOS_FieldTriage_Target": "Wounded operator",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|IGUI_SOS_FieldTriage_WoundOrSupplies": "No untreated eligible wound has the required supplies.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|IGUI_SOS_ScoutSense_Off": "Scout Sense: OFF",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|IGUI_SOS_ScoutSense_On": "Scout Sense: ON",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|Tooltip_SOS_Laser": "Tactical laser module. Improves hit chance and aiming speed. Needs a screwdriver to attach/detach. Occupies the cannon slot (swap with suppressor if preferred).",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|Tooltip_SOS_Suppressor": "Operator suppressor for pistols and rifles that have a quiet sound bank. Cuts report volume and zombie-hear range. Needs a screwdriver. Occupies the cannon slot (swap with laser if preferred). Not for shotguns — their report stays loud.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_optionscreen_binding_SOS Toggle Scout Sense": "Toggle Scout Sense",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_optionscreen_binding_Special Ops Squad": "Special Ops Squad",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_prof_specialops_breacher": "Breacher",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_prof_specialops_demoengineer": "Demo Engineer",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_prof_specialops_marksman": "Marksman",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_prof_specialops_medic": "Combat Medic",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_prof_specialops_rifleman": "Rifleman",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_prof_specialops_scoutghost": "Scout / Ghost",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_prof_specialops_squadleader": "Squad Leader",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_specialops_breacher": "Shock trooper. Closes distance hard, knocks zombies down on the charge, shrugs off pain.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_specialops_demoengineer": "Explosives, field repairs, and tactical electronics. Targeted breach charges, jury-rig fixes, radios, and controlled-entry tools.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_specialops_marksman": "Precision overwatch. Aiming talent beyond skill caps — faster aim settle, first-shot lethality, and rock-steady focus.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_specialops_medic": "Battlefield doctor. Stabilizes nearby wounded allies with a fast, supply-driven Field Triage action and keeps them calm under pressure.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_specialops_rifleman": "Elite gunfighter. Stacked training starts near the vanilla firearm skill caps. Shoots while moving, moves faster, and firearms weigh much less.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_specialops_scoutghost": "Recon specialist. Silent steps, night cloak, and scout sense that marks nearby threats while you stay unseen.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_profdesc_specialops_squadleader": "Commands the detachment. High Aiming/Reloading and a non-stacking squad aura that calms nearby allies and reduces new incoming Endurance loss.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_adrenalinesurge": "Adrenaline Surge",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_adrenalinesurge_Desc": "At 40% Endurance or lower near a zombie, gain 25% extra Endurance-loss resistance for 45 seconds. 5-minute cooldown.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_ballisticgenius": "Ballistic Genius",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_ballisticgenius_Desc": "Gifted shooter. While aiming and standing still, your sights settle much faster than normal.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_bloodlust": "Bloodlust",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_bloodlust_Desc": "A qualifying nearby kill restores 15% Endurance only. 2-minute cooldown; only the nearest eligible operator benefits.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_breachercharge": "Breacher",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_breachercharge_Desc": "Shock entry. Sprinting into zombies can knock them down.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_closequarters": "Close Quarters",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_closequarters_Desc": "+2 Axe, +2 Short Blade, +2 Long Blunt.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_combathardened": "Combat Hardened",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_combathardened_Desc": "Desensitized muscle memory. Panic and fear are heavily suppressed in danger.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_combatmobility": "Combat Mobility",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_combatmobility_Desc": "Faster combat movement. While moving under an active zombie threat, new Endurance loss is reduced; it does not restore Endurance or remove Fatigue.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_combattriage": "Combat Triage",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_combattriage_Desc": "Unlocks supply-driven Field Triage for nearby wounded allies. Your presence suppresses panic, but never passively heals wounds or infection.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_commandpresence": "Command Presence",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_commandpresence_Desc": "Leadership under fire. Nearby allies gain panic suppression and bounded resistance to new incoming Endurance loss; it never restores Endurance or health.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_conditioning": "Peak Conditioning",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_conditioning_Desc": "+2 Fitness, +2 Strength, +2 Sprinting.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_controlleddemo": "Controlled Demolition",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_controlleddemo_Desc": "Knows flame bombs, timers, and targeted SOS charges that breach doors and windows without a wide-area blast.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_deadeye": "Deadeye",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_deadeye_Desc": "Precision under stress. Reduced panic while aiming and sharper long-range focus.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_demolitions": "Demolitions Training",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_demolitions_Desc": "Trained in charges, wiring, and field repairs. Strong technical foundation.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_demolitionsspec": "Demolitions Specialist",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_demolitionsspec_Desc": "+3 Electrical and stronger field engineering instincts.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_fieldbreaching": "Field Breaching",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_fieldbreaching_Desc": "Knows pipe bombs, noise makers, smoke, aerosol charges, and cheaper SOS field-expedient versions.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_fieldmedic": "Field Medic",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_fieldmedic_Desc": "Advanced First Aid training without passive wound healing or infection reduction.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_fieldsurgeon": "Field Surgeon",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_fieldsurgeon_Desc": "+3 First Aid and advanced trauma readiness.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_fortifier": "Fortifier",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_fortifier_Desc": "+3 Carpentry, +2 Maintenance.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_ghostprotocol": "Ghost Protocol",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_ghostprotocol_Desc": "Silent movement discipline. Greatly reduced chance to attract attention while sneaking.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_gunfighter": "Gunfighter",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_gunfighter_Desc": "Fire on the move with faster aim settle, less strain, better combat movement, and much lighter firearms.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_ironwill": "Iron Will",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_ironwill_Desc": "Unbreakable mindset. Unhappiness and boredom drain far slower.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_juryrig": "Jury-Rig Specialist",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_juryrig_Desc": "Knows SOS Field Repair and Advanced Field Repair — use them on damaged weapons and tools to restore condition with scrap and tape.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_lightweapons": "Light Weapons",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_lightweapons_Desc": "Firearms in your inventory weigh significantly less, so you can carry more guns and ammo.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutassault": "Loadout: Assault",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutassault_Desc": "Start with a shotgun, shells, and a sledgehammer.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutcarbine": "Loadout: Carbine",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutcarbine_Desc": "Start with an assault rifle, magazines, and basic combat kit.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutcovert": "Loadout: Covert",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutcovert_Desc": "Start with a suppressed-style pistol kit, knife, and stealth gear.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutcqc": "Loadout: CQC",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutcqc_Desc": "Start with a pistol, melee weapons, and close-quarters kit.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutheavy": "Loadout: Heavy",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutheavy_Desc": "Start with an assault rifle, lots of ammo, and heavy provisions.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutmarksman": "Loadout: Marksman",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutmarksman_Desc": "Start with a hunting rifle, ammo, and overwatch kit.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutparatrooper": "Loadout: Paratrooper",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutparatrooper_Desc": "Start with a carbine kit, rope, bag, and drop-zone survival gear.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutsupport": "Loadout: Support",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_loadoutsupport_Desc": "Start with medical supplies, food, water, and utility gear.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_nightops": "Night Ops",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_nightops_Desc": "Comfortable in the dark. Much less panic at night.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_oneshotdoctrine": "One Shot Doctrine",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_oneshotdoctrine_Desc": "After you settle your aim, the first firearm hit hits much harder and can stagger the target. Re-aim to ready the next killing shot.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_operator": "Special Operator",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_operator_Desc": "Years of black-ops deployments. Strong baseline combat fitness, weapons handling, and a base carry capacity of 20 before Strength and condition modifiers. Starts with an armorer manual for suppressors and laser modules.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_painkiller": "Pain Tolerance",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_painkiller_Desc": "Adds strong, capped pain and strain resistance. Injuries and existing pain still require treatment.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_pathfinder": "Pathfinder",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_pathfinder_Desc": "+2 Lightfooted, +2 Sneaking, +2 Nimble.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_quickdraw": "Quickdraw",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_quickdraw_Desc": "Faster weapon handling instincts. Better Aiming and Reloading foundation.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_runngun": "Run N' Gun",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_runngun_Desc": "Fire on the move. Aim settles much faster while moving, and panic/fatigue build slower. Crosshair still blooms a bit vs standing still (vanilla), but far less than a normal shooter.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_scoutsense": "Scout Sense",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_scoutsense_Desc": "While sneaking (and enabled), nearby zombies pulse as green HUD pins and edge arrows for about 1–2 seconds — including contacts behind you and through walls. Toggle with N (Options → Key Bindings) or the world context menu.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_secondwind": "Second Wind",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_secondwind_Desc": "At 20% Endurance or lower, restore 30% Endurance. 10-minute cooldown; recovery scales with sandbox settings.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_shadowcloak": "Shadow Cloak",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_shadowcloak_Desc": "At night while sneaking, your ghost effect is stronger — zombies forget you across a wider radius.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_shadowops": "Shadow Operative",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_shadowops_Desc": "+3 Sneaking, +2 Lightfooted, +1 Aiming.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_sharpshooter": "Sharpshooter",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_sharpshooter_Desc": "+3 Aiming, +2 Reloading.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_silentstep": "Silent Step",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_silentstep_Desc": "While sneaking, nearby zombies lose interest more easily and struggle to keep a lock on you.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_squadaura": "Squad Aura",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_squadaura_Desc": "Active command radius. Nearby allies gain strong panic suppression and non-stacking resistance to new incoming Endurance loss; it never restores Endurance or health.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_steadyhands": "Steady Hands",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_steadyhands_Desc": "Rock-solid aiming discipline that suppresses panic while aiming without removing fatigue.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_stimulantprotocol": "Stimulant Protocol",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_stimulantprotocol_Desc": "Additional First Aid and fitness training for sustained field operations.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_survivalexpert": "Survival Expert",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_survivalexpert_Desc": "+3 Foraging, +3 Farming, +3 Trapping.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_tacticalawareness": "Tactical Awareness",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_tacticalawareness_Desc": "Situational mastery. Panic spikes are crushed; you stay composed in chaos.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_tacticalelectronics": "Tactical Electronics",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_tacticalelectronics_Desc": "Knows generators, makeshift radios, remote triggers, timers, and improvised lights.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_traumaresponse": "Trauma Response",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_traumaresponse_Desc": "Additional First Aid training for recognizing and responding to battlefield trauma.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_unstoppable": "Unstoppable",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_unstoppable_Desc": "At 35 health or lower, restore 35% Endurance only. 12-minute cooldown; recovery scales with sandbox settings.",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_warhero": "War Hero",
  "translate_en|mods/SpecialOpsSquad/common/media/lua/shared/Translate/EN/UI.json|UI_trait_specialops_warhero_Desc": "+2 Aiming, +2 Reloading, +2 Sprinting from prior deployments."
}
