  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core": "Gore's SVU4 Core",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_ApocalypseProtectionPercent": "Apocalypse Protection %%",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_ApocalypseProtectionPercent_tooltip": "Share of each incoming hit absorbed by Apocalypse armor while armor health remains. The rest reaches the vanilla vehicle part. If the hit destroys the armor, excess damage can still pass through. 100% is full absorption only until the armor is exhausted.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_ArmorDurabilityMultiplier": "Armor Damage Taken Multiplier",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_ArmorDurabilityMultiplier_tooltip": "Controls how quickly installed armor loses health when it absorbs damage. 1.0 = normal, 0.5 = half damage to armor (lasts longer), 2.0 = double damage to armor (wears out faster). This does not change the protection percentage.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_ArmorWeightMultiplier": "Installed Armor Weight Multiplier",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_ArmorWeightMultiplier_tooltip": "Multiplies the extra vehicle mass added by installed SVU4 armor. 1.0 = normal added weight, 0.5 = half, 2.0 = double. Has no effect when Enable Armor Weight is off.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_BlockAllSVU4ArmorOnKI5Vehicles": "Block SVU4 Armor on KI5 Vehicles",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_BlockAllSVU4ArmorOnKI5Vehicles_tooltip": "When enabled, SVU4 blocks new SVU4 armor installation on detected KI5 / that DAMN Library vehicles so their native armor system can be used instead.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableAdminLogs": "Enable Admin Logs",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableAdminLogs_tooltip": "Writes SVU4 armor installs, repairs, removals, rejected actions and gas-leak events to the server/admin log. This does not enable debug console spam.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableApocalypseArmorGrade": "Enable Apocalypse Armor",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableApocalypseArmorGrade_tooltip": "Allows new Apocalypse armor installations. Existing Apocalypse armor remains removable and repairable unless another compatibility rule blocks the action.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableArmorWeight": "Enable Armor Weight",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableArmorWeight_tooltip": "When enabled, installed SVU4 armor adds vehicle mass using the Installed Armor Weight Multiplier. When disabled, SVU4 armor adds no extra vehicle mass.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableRandomSurvivorArmor": "Enable Random Survivor Armor",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableRandomSurvivorArmor_tooltip": "Allows eligible world-spawned vehicles to receive random worn SVU4 armor panels. Does not add armor to every vehicle. Server-authoritative in multiplayer.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableReinforcedArmorGrade": "Enable Reinforced Armor",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableReinforcedArmorGrade_tooltip": "Allows new Reinforced armor installations. Existing Reinforced armor remains removable and repairable unless another compatibility rule blocks the action.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableScrapArmorGrade": "Enable Scrap Armor",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableScrapArmorGrade_tooltip": "Allows new Scrap armor installations. Existing Scrap armor remains removable and repairable unless another compatibility rule blocks the action.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableSkillRequirements": "Enable Skill Requirements",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableSkillRequirements_tooltip": "When enabled, SVU4 armor installation and repair enforce their configured MetalWelding and Mechanics skill requirements. Turning this off does not remove material costs.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableStandardArmorGrade": "Enable Standard Armor",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_EnableStandardArmorGrade_tooltip": "Allows new Standard armor installations. Existing Standard armor remains removable and repairable unless another compatibility rule blocks the action.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_GasLeakRateMultiplier": "Gas Leak Rate Multiplier",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_GasLeakRateMultiplier_tooltip": "Multiplies fuel loss from a punctured gas tank after its armor is destroyed. 1.0 = normal leak rate, 0.5 = half, 2.0 = double, 0 = disable leaking.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_GasTankLeakClearCondition": "Gas Tank Leak Clear Condition",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_GasTankLeakClearCondition_tooltip": "Vanilla Gas Tank condition required before an active SVU4 fuel leak is cleared. Example: 90 means repair the tank to at least 90 condition.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_GasTankPunctureDamage": "Gas Tank Puncture Damage",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_GasTankPunctureDamage_tooltip": "Condition damage applied to the vanilla Gas Tank at the moment gas-tank armor is destroyed. 0 = no direct puncture damage; 100 = up to 100 condition points.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_MaterialCostMultiplier": "Armor Material Cost Multiplier",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_MaterialCostMultiplier_tooltip": "Multiplies materials used by SVU4 armor installation and repair. 1.0 = normal cost, 0.5 = half cost, 2.0 = double cost. Final item counts are rounded by the armor recipe system.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_MaxQueuedActions": "Max Queued Armor Actions",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_MaxQueuedActions_option1": "3 actions",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_MaxQueuedActions_option2": "5 actions",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_MaxQueuedActions_option3": "10 actions",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_MaxQueuedActions_option4": "Unlimited",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_MaxQueuedActions_tooltip": "Maximum number of armor actions queued by one batch command. Applies to batch install, repair and removal. It does not limit normal single actions.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_MultiInstallMode": "Multi-Install Mode",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_MultiInstallMode_option1": "Single install only",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_MultiInstallMode_option2": "Batch, one grade only",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_MultiInstallMode_option3": "Full multi-install",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_MultiInstallMode_tooltip": "Controls batch armor installation only. Single install disables batch install. One-grade batch allows several panels of one armor grade at a time. Full multi-install allows mixed armor grades in the same queued batch.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_RandomArmorApocalypseChance": "Random Apocalypse Armor Chance %%",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_RandomArmorApocalypseChance_tooltip": "Chance used when rolling random worn Apocalypse armor for eligible survivor vehicles. This is a per-roll grade chance, not a guaranteed percentage of all vehicles.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_RandomArmorMaxHealth": "Random Armor Maximum Health %%",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_RandomArmorMaxHealth_tooltip": "Maximum starting health percentage for a randomly spawned worn armor panel. If this is set below Minimum Health, SVU4 automatically swaps the two values.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_RandomArmorMaxPanels": "Maximum Random Armor Panels Per Vehicle",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_RandomArmorMaxPanels_tooltip": "Maximum number of random worn armor panels that an eligible survivor vehicle can receive. This is a cap, not a guaranteed number of panels.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_RandomArmorMinHealth": "Random Armor Minimum Health %%",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_RandomArmorMinHealth_tooltip": "Minimum starting health percentage for a randomly spawned worn armor panel. If this is set above Maximum Health, SVU4 automatically swaps the two values.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_RandomArmorReinforcedChance": "Random Reinforced Armor Chance %%",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_RandomArmorReinforcedChance_tooltip": "Chance used when rolling random worn Reinforced armor for eligible survivor vehicles. This is a per-roll grade chance, not a guaranteed percentage of all vehicles.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_RandomArmorScrapChance": "Random Scrap Armor Chance %%",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_RandomArmorScrapChance_tooltip": "Chance used when rolling random worn Scrap armor for eligible survivor vehicles. This is a per-roll grade chance, not a guaranteed percentage of all vehicles.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_RandomArmorStandardChance": "Random Standard Armor Chance %%",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_RandomArmorStandardChance_tooltip": "Chance used when rolling random worn Standard armor for eligible survivor vehicles. This is a per-roll grade chance, not a guaranteed percentage of all vehicles.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_ReinforcedProtectionPercent": "Reinforced Protection %%",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_ReinforcedProtectionPercent_tooltip": "Share of each incoming hit absorbed by Reinforced armor while armor health remains. The rest reaches the vanilla vehicle part. If the hit destroys the armor, excess damage can still pass through. 100% is full absorption only until the armor is exhausted.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_ScrapProtectionPercent": "Scrap Protection %%",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_ScrapProtectionPercent_tooltip": "Share of each incoming hit absorbed by Scrap armor while armor health remains. The rest reaches the vanilla vehicle part. If the hit destroys the armor, excess damage can still pass through. 100% is full absorption only until the armor is exhausted.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_SoundRadiusMultiplier": "Armor Work Noise Radius Multiplier",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_SoundRadiusMultiplier_tooltip": "Multiplies the radius of noise created by SVU4 armor work. 1.0 = normal radius, 0 = silent, 2.0 = twice the noise radius.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_StandardProtectionPercent": "Standard Protection %%",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_StandardProtectionPercent_tooltip": "Share of each incoming hit absorbed by Standard armor while armor health remains. The rest reaches the vanilla vehicle part. If the hit destroys the armor, excess damage can still pass through. 100% is full absorption only until the armor is exhausted.",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_XPRewardMultiplier": "Armor XP Reward Multiplier",
  "translate_en|mods/Gores SVU4 Core/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_GoresSVU4Core_XPRewardMultiplier_tooltip": "Multiplies MetalWelding and Mechanics XP awarded by SVU4 armor actions. 1.0 = normal XP, 0 = no SVU4 armor XP, 2.0 = double XP."
}
