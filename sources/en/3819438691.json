  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowAbrasion_tooltip": "Scrapes on bare skin from falls. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowAvulsion": "Avulsion",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowAvulsion_tooltip": "Torn flesh from a second bite in the same spot. Needs stitching. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowBruised": "Bruised",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowBruised_tooltip": "Pain and stiffness from blunt hits. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowConcussion": "Concussion",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowConcussion_tooltip": "Head injuries that cause stumbling and block reading. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowDirty": "Dirty",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowDirty_tooltip": "Wounds taken through dirty clothes, which infect more easily. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowDislocation": "Dislocation",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowDislocation_tooltip": "Joints knocked out of place by bad falls. Needs Reset Joint. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowEmbeddedDebris": "Embedded Debris",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowEmbeddedDebris_tooltip": "Glass, bullets and grit stuck in a wound. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowFrostbite": "Frostbite",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowFrostbite_tooltip": "Cold injury on wet, exposed hands, feet and face, in three stages. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowInflamed": "Inflamed",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowInflamed_tooltip": "The stage before a wound infection. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowInternalBleeding": "Internal Bleeding",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowInternalBleeding_tooltip": "Hidden bleeding from severe falls and crashes. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowJointDamage": "Joint Damage",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowJointDamage_tooltip": "Permanent damage from repeated or unsplinted fractures. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowMaggots": "Maggots",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowMaggots_tooltip": "Maggots in dead tissue left uncovered. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowNecrotic": "Necrotic",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowNecrotic_tooltip": "Dying tissue from bad infections or severe frostbite. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowNerveDamage": "Nerve Damage",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowNerveDamage_tooltip": "Permanent numbness, and a damaged hand can drop its weapon. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowNumb": "Numb",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowNumb_tooltip": "The health panel shows less pain than the part has. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowOverBandaged": "Over-Bandaged",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowOverBandaged_tooltip": "A spent dressing left on stops the wound under it healing. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowPoorlyStitched": "Poorly Stitched",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowPoorlyStitched_tooltip": "Bad stitching from low skill, no disinfectant or a sewing needle. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowPuncture": "Puncture Wound",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowPuncture_tooltip": "Deep, narrow wounds from stabbing weapons, thorns and horns. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowReopened": "Reopened",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowReopened_tooltip": "Stitches tearing open from running, fighting or climbing. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowScar": "Scars",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowScar_tooltip": "Healed deep wounds, bites and bad burns leave a scar on the body figure. Off stops new ones and clears the ones already there.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowSepticFever": "Septic Fever",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowSepticFever_tooltip": "An infected wound left without antibiotics brings on a fever. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowSprain": "Sprain",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowSprain_tooltip": "Strained joints from hard landings. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowSwollen": "Swollen",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowSwollen_tooltip": "Wounds left undressed swell and heal slower. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowTornBandage": "Torn Bandage",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.allowTornBandage_tooltip": "Dressings tearing when the part is hit or worked hard. Off stops it from happening and clears it from anyone who has it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.enabled": "Enable Wound Expansion",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.enabled_tooltip": "Turns every new wound type and condition off without disabling the mod. Existing wounds stop being processed but are not deleted.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.fallHard": "Hard Fall Threshold",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.fallHard_tooltip": "Fall damage at or above this counts as a hard fall: abrasions, sprains and concussion. Ignored when the ZombieBuddy companion is installed, which reports real fall severity instead.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.fallSevere": "Severe Fall Threshold",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.fallSevere_tooltip": "Fall damage at or above this counts as a severe fall: dislocations and internal bleeding instead of scrapes.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.infectionBase": "Wound Infection Odds",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.infectionBase_tooltip": "The one-in-N chance per in-game minute for a wound with no infection multiplier. Lower is more dangerous. Punctures, dirty wounds and embedded debris divide this further.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.internalBleedFirstAid": "First Aid to Spot Internal Bleeding",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.internalBleedFirstAid_tooltip": "Internal bleeding is hidden in the health panel below this First Aid level. Set to 0 to always show it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.minigames": "Procedure Minigames",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.minigames_tooltip": "Reset Joint, Remove Debris, Stitching and Emergency Surgery start with a minigame. Doing well adds up to 25 to the success chance, doing badly takes up to 25 off, and the procedure itself takes half as long. Turn off to use the plain actions.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.preset": "Preset",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.preset_option1": "Light",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.preset_option2": "Default",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.preset_option3": "Hardcore",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.preset_tooltip": "Fills in the infection odds, fall thresholds, internal bleeding skill and every injury switch. Light turns off the permanent and deadly injuries and makes infection rarer. Hardcore makes infection and bad falls more likely. You can still change any option afterwards.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.skinFreeze": "Frostbite Skin Temperature",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.skinFreeze_tooltip": "Frostbite risk accumulates while a body part's skin temperature is below this, in degrees Celsius. Normal skin sits around 33. Raise it if frostbite never triggers, lower it if it triggers in mild weather.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.skinMarks": "Injuries On The Character",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.skinMarks_tooltip": "Wounds, bruising, swelling, treatments and scars show on the character itself, on the skin under the clothes. Off shows only the base game marks.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.tocTourniquet": "The Only Cure Tourniquet",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansion.tocTourniquet_tooltip": "With The Only Cure installed, a belt tied on an arm works as its tourniquet when the arm is amputated, and its own tourniquet no longer spawns. Off leaves The Only Cure's tourniquet as it is.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_WoundExpansionInjuries": "Wound Expansion: Injuries",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Barehanded": "You can dig it out with your fingers, but it will hurt and you are as likely to fail as not.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Cast": "Sets the limb in plaster. A break heals several times faster than in a splint and limps less, but the cast has to be cut off and nothing comes back.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Cauterize": "Sears the bleeding shut with a heated blade. The wound closes into a burn, and it hurts badly.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_CauterizeNeeds": "Needs a lighter, matches or a lit candle, and a knife or scalpel to heat in it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Item_BloodBag": "Restores health lost to bleeding. Needs First Aid to use, from the health panel.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Item_BurnDressing": "A gel dressing for burns. Soothes the burn and helps it heal faster.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Item_ElasticBandage": "A compression wrap for sprains and swelling. Use it from the health panel.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Item_HemostaticGauze": "Packed into the wound, it stops bleeding four times faster than a plain bandage and never soaks through. It is used up when it comes off.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Item_Iodine": "Disinfects a wound with barely any sting, and keeps it from getting infected for a day.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Item_PlasterCast": "Sets a broken or sprained limb in plaster. Use it from the health panel.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Item_Sling": "Supports an injured arm. Use it from the health panel.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Item_SmellingSalts": "A sharp whiff that clears a concussed head for a while. Use it from the health panel.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Item_SurgicalKit": "Proper instruments. Counts as tweezers, scalpel and needle holder, and makes every procedure faster and safer.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Maggots": "Pick them out one at a time. Slow, foul, and it will hurt.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_NeedScalpel": "The wound is too deep for tweezers. You need a scalpel.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_NeedTweezers": "You need tweezers or forceps to pick this out.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_NoWaterToRinse": "Without water to rinse it, the wound will be left dirty and far more likely to become infected.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_OneCataplasm": "Only one cataplasm can be on a part at a time. Wait for the one already on to wear off.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_PackWithCotton": "Slows the bleeding, but it is not a dressing - it leaves fibres in the wound and will dirty it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_RemoveBandageFirst": "Take the bandage off first - you cannot work through a dressing.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_RinseNeedsSoap": "Water alone will not get it any cleaner. It needs soap.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_RinseWithSoap": "Washes the wound clean with soap and water.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_RinseWithWater": "You have water to rinse the wound out afterwards, so it will not be left dirty.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_RinseWound": "Rinses the worst of the dirt out with water. It stays dirty until it is washed with soap.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Sling": "Holds the arm still so a sprain heals as if splinted and stops aching in the cold. That hand is out of use while it is on.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_SmellingSalts": "Clears your head for about %1 minutes. You stop stumbling, but the concussion is still there.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_SplintNeedsMaterial": "You need a splint, or a plank and ripped sheets.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_SplintSprain": "Immobilising a sprain cuts recovery from about %1 hours to %2, and stops exertion adding to it.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Surgery": "Open the abdomen, stop the bleeding inside and close it again. This does not heal you: it buys you a stitched deep wound and whatever internal bleeding is left, instead of certain death. Failing it is usually fatal.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_SurgeryNeedsKit": "You need a scalpel, a suture needle (or needle and thread), and something to disinfect with.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_SurgeryNeedsSkill": "Requires First Aid %1. Nobody attempts this on instinct.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_SurgerySelf": "Operating on your own abdomen. %1 worse odds, and you will be awake for all of it. Painkillers help.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Tourniquet": "Halves the blood loss from the limb. The limb goes numb after about %1 hours and starts to die after %2. Take it off as soon as the wound is dressed.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_TourniquetAmputation": "Tied on before an amputation, the cut bleeds much less and the stump takes half the damage. The limb goes numb after about %1 hours and starts to die after %2.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Transfusion": "Puts blood back into a patient who has lost too much. Restores %1 health.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_TransfusionNeedsSkill": "Requires First Aid %1 to find a vein.",
  "translate_en|mods/WoundExpansion/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_WE_Wrap": "Compression for a sprain or swelling. The sprain heals faster and swelling goes down in half the time."
}
