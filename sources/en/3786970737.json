  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Stash.json|Stash_EPR_Riverside_3": "just the one panel here",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Stash.json|Stash_EPR_RosewoodWater_1": "TREATMENT WORKS",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Stash.json|Stash_EPR_RosewoodWater_2": "every tap in the county",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Stash.json|Stash_EPR_RosewoodWater_3": "transformers on the west wall",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Stash.json|Stash_EPR_UtilityMap": "Utility Service Map",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/UI.json|UI_EPR_Action_Maintaining": "Performing maintenance...",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/UI.json|UI_EPR_Ambience": "Facility Ambience",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/UI.json|UI_EPR_Ambience_tooltip": "Plays the sound of a running plant up close, so you can hear a repaired station working when you stand near it.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/UI.json|UI_EPR_Building_Connected": "Connected to the grid.",
