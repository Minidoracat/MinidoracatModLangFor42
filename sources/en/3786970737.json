  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Stash.json|Stash_EPR_LouisvillePlant_3": "panel, breakers, transformer",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Stash.json|Stash_EPR_LouisvilleSouth_1": "SOUTH SUBSTATION",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Stash.json|Stash_EPR_LouisvilleSouth_2": "west point + valley station",
