{
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR": "Exhaustive Power Rework",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_AssessmentTimeMinutes": "Assessment Time (minutes)",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_AssessmentTimeMinutes_tooltip": "Base time for the damage assessment stage.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_BrownoutChance": "Brownout Chance",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_BrownoutChance_tooltip": "Chance that a worn region dips for a couple of minutes and comes back on its own. The lights stutter and go out, then return: no wear on the facility and nothing to restart. Scaled by how worn the station is and how well it was repaired, so a plant in good order almost never dips. Set to 0 to only ever lose power for real.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_CalibrationTimeMinutes": "Calibration Time (minutes)",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_CalibrationTimeMinutes_tooltip": "Base time for the calibration stage.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_ColdSnapInfluence": "Cold Snap Strain",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_ColdSnapInfluence_tooltip": "How much a hard freeze raises the chance of a power failure. Starts biting below 4C and peaks at -12C.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_DebugMode": "Debug Mode",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_DebugMode_tooltip": "Writes debug information to the console.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_DegradationRate": "Degradation Rate",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_DegradationRate_tooltip": "How fast facilities lose health over time. Higher = faster degradation.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_FacilityCapacity": "Facility Capacity",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_FacilityCapacity_tooltip": "Scales how many buildings a facility can carry before it starts sagging. Each site has its own rating, from six at the Riverside relay to twenty four at the water plant. Only matters when buildings have to be wired in.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_FieldComponentCount": "Field Repair Points",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_FieldComponentCount_tooltip": "Number of additional repair points to fix after the main control panel.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_GeneratorFumes": "Fixed Generators Give Off Fumes",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_GeneratorFumes_tooltip": "Lets a hooked up industrial generator poison the building it stands in, the way a portable one does. Off by default, since these are permanent map fixtures rather than something you chose to put indoors. Generators you place yourself always give off fumes either way.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_LouisvillePlantEnabled": "Louisville Plant Available",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_LouisvillePlantEnabled_tooltip": "Makes the Louisville Power Plant repairable.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_MinElectricalSkill": "Min Electrical Skill (Substations)",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_MinElectricalSkill_tooltip": "Minimum Electrical skill to repair power substations.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_MinMetalworkSkill": "Min Welding Skill (Substations)",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_MinMetalworkSkill_tooltip": "Minimum Welding skill to repair power substations.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_OutageHealthScaling": "Outage Wear Scaling",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_OutageHealthScaling_tooltip": "How sharply failures follow wear. Odds rise with the square of how worn a station is at the default of 2, so the last few percent of health buy a lot of quiet and a neglected station fails often. Lower values make even a healthy station unreliable, higher values forgive light wear.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_OutageRecoveryChance": "Power Return Chance",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_OutageRecoveryChance_tooltip": "Chance that a region which has lost power or water gets it back on its own, checked every ten in-game minutes once the outage has outlasted its cooldown. Lower values mean longer outages and less switching between lit and dark. At 0 an outage never lifts on its own. Immersive Blackouts owns this while it is installed.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_OverloadScaling": "Overload Penalty",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_OverloadScaling_tooltip": "How hard an overloaded facility is punished. At the default, a site carrying twice its rating fails three times as often. Set to 0 to ignore load entirely.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_PartReplacementTimeMinutes": "Part Replacement Time (minutes)",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_PartReplacementTimeMinutes_tooltip": "Base time for the part replacement stage.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_PartRequirementMultiplier": "Part Requirement Multiplier",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_PartRequirementMultiplier_tooltip": "Multiplies the number of parts needed. Lower = fewer parts.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_PeakLoadBoost": "Evening Peak Load",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_PeakLoadBoost_tooltip": "Extra brownout chance between 5pm and 10pm, when everyone's lights and heaters are on at once.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_PreShutoffBlackouts": "Blackouts Before the Shutoff",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_PreShutoffBlackouts_tooltip": "Lets the grid start failing region by region in the run-up to the day the power dies for good, instead of everything working perfectly until the moment it does not. A region that drops out comes back on its own a few hours later, and outages get more frequent the closer that day gets. Immersive Blackouts already does this, so EPR stands aside while it is installed.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_PreShutoffLeadDays": "Early Blackout Days",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_PreShutoffLeadDays_tooltip": "How long before the power shutoff the grid starts dropping out. Nothing happens outside this window.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RegionalOutages": "Regional Outages",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RegionalOutages_tooltip": "After the world's own shutoff, a region you restored can still drop out temporarily on its own, independently of every other region. Where Immersive Blackouts is installed its percentages, cooldowns and weather influence are reused so the behaviour matches what you configured there.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RepairNoiseRadius": "Repair Noise Radius",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RepairNoiseRadius_tooltip": "How far repair sounds travel (in tiles).",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RepairSounds": "Repair and Sequence Sounds",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RepairSounds_tooltip": "Plays a continuous tool sound while repairing a component or performing maintenance, and loop the plant startup noise for the whole startup or shutdown sequence. Part Replacement uses a welding torch, Calibration and maintenance a wrench. Does not change how much noise attracts zombies.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RepairSpeedMultiplier": "Repair Speed Multiplier",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RepairSpeedMultiplier_tooltip": "Multiplies all repair times. Lower = faster repairs.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RequireBuildingConnection": "Buildings Must Be Connected",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RequireBuildingConnection_tooltip": "Restoring a region is not enough on its own: each building has to be wired into the grid before it gets power or water. Off by default, in which case a restored region powers everything inside it.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RequirePowerOff": "Require Utility Shutoff",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RequirePowerOff_tooltip": "Only allow repairs after the world's own power or water shutoff has happened.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RequirePrerequisite": "Require Louisville First",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RequirePrerequisite_tooltip": "The Louisville Power Plant has to be repaired before any other facility.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RequireTools": "Require Tools",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_RequireTools_tooltip": "Require specific tools to perform repairs.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_SkillRequirementMultiplier": "Skill Requirement Multiplier",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_SkillRequirementMultiplier_tooltip": "Multiplies all skill requirements. Lower = easier.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_StartupDefenseTimeMinutes": "Startup Defense Time (minutes)",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_StartupDefenseTimeMinutes_tooltip": "How long you must defend the facility during startup. Shutting a facility down again takes twice this.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_StartupNoiseRadius": "Startup Noise Radius",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_StartupNoiseRadius_tooltip": "How far startup sounds travel (in tiles). Startup is LOUD!",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_StormBlackouts": "Storm Blackouts",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_StormBlackouts_tooltip": "Lightning can knock a running substation offline during a storm, damaging components and forcing another repair trip. Water treatment is not affected.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_StormRequireThunder": "Require Thunderstorm",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_StormRequireThunder_tooltip": "On, only thunderstorms and tropical storms can cause a strike. Off, heavy rain counts as well.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_StormStrikeChance": "Storm Strike Chance",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_StormStrikeChance_tooltip": "Chance per substation, checked every ten in-game minutes while a storm is overhead. At 2%% a substation survives an hour-long storm about 88%% of the time. Set to 0 to disable strikes without turning the feature off.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_ToolsConsumed": "Tools Get Damaged",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_ToolsConsumed_tooltip": "Tools lose durability when used for repairs.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_WaterPlantElectricalSkill": "Min Electrical Skill (Water Plants)",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_WaterPlantElectricalSkill_tooltip": "Minimum Electrical skill to repair the water treatment plant. One plant supplies the whole map, so it asks more than a substation does.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_WaterPlantMetalworkSkill": "Min Welding Skill (Water Plants)",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_WaterPlantMetalworkSkill_tooltip": "Minimum Welding skill to repair the water treatment plant. One plant supplies the whole map, so it asks more than a substation does.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_WaterPlantPartMultiplier": "Water Plant Part Multiplier",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_WaterPlantPartMultiplier_tooltip": "Multiplies the spare parts the water treatment plant needs, on top of the general part multiplier. Set to 1.0 to make it cost the same as a substation.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_WaterRestoration": "Water Restoration",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_WaterRestoration_tooltip": "Lets the water treatment plant be repaired to bring water back. When off, the plant cannot be repaired and water shuts off everywhere as normal, while power restoration keeps working.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_ZombieAttractionEnabled": "Zombie Attraction",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_ZombieAttractionEnabled_tooltip": "Repairs and startup attract nearby zombies.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_ZombieAttractionMultiplier": "Zombie Attraction Multiplier",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_EPR_ZombieAttractionMultiplier_tooltip": "How many zombies are attracted. Higher = more zombies.",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Stash.json|Stash_EPR_Irvington_1": "IRVINGTON SUBSTATION",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Stash.json|Stash_EPR_Irvington_2": "the whole west end",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Stash.json|Stash_EPR_Irvington_3": "breakers up the north yard",
