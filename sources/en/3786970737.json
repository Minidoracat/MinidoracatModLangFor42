  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Stash.json|Stash_EPR_Muldraugh_3": "breakers + transformers south",
  "translate_en|mods/EPR/42/media/lua/shared/Translate/EN/Stash.json|Stash_EPR_Riverside_1": "RIVERSIDE RELAY",
