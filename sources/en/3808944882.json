  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Look_Inverted": "Inverted",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Look_Journal": "Survivor's Journal",
