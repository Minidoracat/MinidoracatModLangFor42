  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_DailyHour": "Daily briefing hour",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_DailyHour_tooltip": "The hour of the daily briefing on a 24-hour clock: 0 is midnight, 6 is 6 AM, 20 is 8 PM. The day number itself still changes at midnight.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_DayCounter": "Day counter",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_DayCounter_Both": "Both",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_DayCounter_Survival": "Your day of survival",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_DayCounter_World": "World day (server day)",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_DayCounter_tooltip": "Which day the big number counts. Your day of survival starts again at Day 1 for every new character, respawns included. The world day counts from the world's first day (the server's, in multiplayer). Both shows your day big and the world day as a line below.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_DayRule": "Your day changes",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_DayRule_Elapsed": "Every 24 hours survived",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_DayRule_Midnight": "At midnight",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_DayRule_tooltip": "At midnight: the day you arrived is Day 1 and a new day starts every midnight, so the number can be ahead of the \"Survived for\" time on the character panel. Every 24 hours survived: Day 2 starts once you have survived 24 hours, in step with the character panel.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Duration": "Time on screen (seconds)",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Duration_tooltip": "How long the briefing stays once all its lines are in.",
