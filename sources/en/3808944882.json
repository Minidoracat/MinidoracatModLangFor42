  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Look_Minimal": "Minimal",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Look_Newspaper": "Newspaper",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Look_Quarantine": "Quarantine Notice",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Look_RPG": "16-bit RPG",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Look_Terminal": "Terminal",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Look_Y2K": "Y2K",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Look_tooltip": "How the briefing looks. Every look shows the lines you switch on above, at the position and text size set below (Emergency Broadcast becomes a full-width bar in the centre positions; Cinematic always uses the whole screen). To try them all on your own character, press \"Preview the looks\" below.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Position": "Position",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Position_BottomCentre": "Bottom centre",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Position_BottomLeft": "Bottom left",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Position_BottomRight": "Bottom right",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Position_Centre": "Centre",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Position_TopCentre": "Top centre",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Position_TopLeft": "Top left",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Position_TopRight": "Top right",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Position_tooltip": "Where the briefing appears. It keeps clear of the chat box, the icon bar, the speed buttons, the moodles and the hotbar. Size is set separately, under Text size.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_PreviewLooks": "Preview the looks",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_PreviewLooks_tooltip": "Opens the looks window as soon as you are back in the game: click a look to see it on your own character, and \"Use these settings\" keeps it.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_SectionLook": "How it looks",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_SectionWhat": "What it shows (the day of survival is always shown)",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_SectionWhen": "When it appears",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_ShowKey": "Show briefing",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_ShowKey_tooltip": "Press to show the briefing now, press again to hide it. Unbound by default.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_TextSize": "Text size",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_TextSize_Large": "Large",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_TextSize_Normal": "Normal",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_TextSize_Small": "Small",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_TextSize_tooltip": "Follows the game's font size setting, one step smaller or larger.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_Title": "Survivor Briefing",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_dailySunrise": "Daily briefing at sunrise",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_dailySunrise_tooltip": "Shows the daily briefing at sunrise instead of at the hour above. Sunrise follows the game's seasons: earlier in summer, later in winter. If the world has no sunrise (Endless Day or Endless Night), the hour above is used.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_looksMenu": "Looks window in the right-click menu",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_looksMenu_tooltip": "Also puts \"Survivor Briefing: test looks\" in the menu you get by right-clicking in the world. Off by default: \"Preview the looks\" above opens the same window.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_motion": "Motion",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_motion_tooltip": "Lets the looks move: lines rise into place, letterbox bars slide in, text types out letter by letter. Off: everything fades in instead, which looks smooth at any UI frame rate. Stamps, stickers, flickers and blinking cursors happen either way.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_onArrival": "Show on a new character",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_onArrival_tooltip": "When a new survivor starts: a new game, a respawn, or a first join to a server.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_onLoadSave": "Show when loading a save",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_onLoadSave_tooltip": "When you continue an existing character: loading a save or rejoining a server.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_onMidnight": "Daily briefing",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_onMidnight_tooltip": "Once a day at the hour set below (midnight by default), while you are awake. Asleep at that hour, or woke up less than two hours before it? The briefing you get on waking counts instead.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_onResume": "Show after the pause menu",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_onResume_tooltip": "When you close the pause menu and return to the game.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_onTown": "Show when entering a town",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_onTown_tooltip": "Shows the briefing when you walk or drive into a town or a named area such as the airport. Not again for the same place within 6 in-game hours, and not when you only skirt its edge.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_onWake": "Show after sleeping",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_onWake_tooltip": "A moment after you wake up.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_realistic": "Only what your character can know",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_realistic_tooltip": "Follows the same rule as the game's own clock. Without a watch on your wrist or a clock in your hand you only get the part of the day (Morning, Evening...). The date and the temperature need a digital one. A watch in a bag does not count. Past a hundred kills you only get a rough count.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showBanditKills": "Bandits killed",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showBanditKills_tooltip": "Only with the Bandits mod: the bandit kill count that mod keeps for your character.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showDate": "Date",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showDate_tooltip": "Weekday, month, day and year.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showDeaths": "Deaths",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showDeaths_tooltip": "How many characters you have lost in this world (on this server, in multiplayer). Counted from the day this option arrived, not before.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showKills": "Zombies killed",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showKills_tooltip": "How many zombies this character has killed.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showLocation": "Location",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showLocation_tooltip": "The town you are in or how far the nearest one is, and a nearby landmark.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showName": "Name",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showName_tooltip": "Your character's first and last name.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showOccupation": "Occupation",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showOccupation_tooltip": "Your character's occupation.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showOutbreakDay": "Outbreak day",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showOutbreakDay_tooltip": "Which day of the Knox Event it is. The outbreak began on July 4, 1993 (the in-game radio says so), so July 4 is day 1 and the usual start, July 9, is day 6. Not shown before July 4. With \"Only what your character can know\" on, it needs the date, like the Date line.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showTime": "Time",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showTime_tooltip": "The clock. It keeps running while the briefing is on screen.",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showWeather": "Weather",
  "translate_en|mods/SurvivorBriefing/common/media/lua/shared/Translate/EN/UI.json|UI_SurvivorBriefing_showWeather_tooltip": "The sky and the temperature."
}
