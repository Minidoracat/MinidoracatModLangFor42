  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/IG_UI_EN.txt|IGUI_ContainerTitle_DHCS_Debug_wardrobe": "Wardrobe",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS": "Mattnetic's Hide Anywhere",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS_AllowSleeping": "Allow Sleeping While Hidden",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS_AllowSleeping_tooltip": "Allows survivors to sleep in supported hiding places that have room for a seated or lying posture. Upright lockers and wardrobes remain too cramped to sleep in. Danger, zombie pounding, cold, or discovery can wake the survivor. Default: Enabled. In multiplayer, only an Admin can change this server setting.",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS_BaseInteractionSeconds": "Base Entry and Exit Time (Seconds)",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS_BaseInteractionSeconds_tooltip": "Sets the base channel time for entering and leaving a hiding place. Survivor body weight, carried bulk, the hiding-place type, and the Stealthy, Inconspicuous, or Graceful traits can change the final time. Valid range: 1.0 to 30.0 seconds. Default: 7.0 seconds. In multiplayer, only an Admin can change this server setting.",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS_EntryNoiseRadiusTiles": "Base Entry Sound Radius (Tiles)",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS_EntryNoiseRadiusTiles_tooltip": "Sets the base distance in tiles that entry noise can travel before Sneaking, Lightfooted, traits, carried bulk, panic, and stress modify it. Default: 8 tiles. Set to 10 tiles for the previous Hide Anywhere base balance. Valid range: 1 to 20 tiles. In multiplayer, only an Admin can change this server setting.",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS_GrantLightfootedXPWhileHidden": "Gain Lightfooted XP While Hidden",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS_GrantLightfootedXPWhileHidden_tooltip": "Allows hidden survivors to gain Lightfooted XP when nearby zombies meet Hide Anywhere's stealth XP eligibility checks. Default: Disabled. In multiplayer, only an Admin can change this server setting.",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS_GrantSneakingXPWhileHidden": "Gain Sneaking XP While Hidden",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS_GrantSneakingXPWhileHidden_tooltip": "Allows hidden survivors to gain Sneaking XP when nearby zombies meet Hide Anywhere's stealth XP eligibility checks. Default: Enabled. In multiplayer, only an Admin can change this server setting.",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS_ShowStatusPanelOnEntry": "Show Hidden Status Panel on Entry",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS_ShowStatusPanelOnEntry_tooltip": "Sets the server-wide default for opening the hidden status panel when a survivor enters a hiding place. Players can close the panel with X and can use their personal Hide Anywhere mod option to suppress it on entry. Default: Enabled. In multiplayer, only an Admin can change this server setting.",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS_ZombiesCanPullPlayersFromHiding": "Zombies Can Pull Players From Hiding",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_DHCS_ZombiesCanPullPlayersFromHiding_tooltip": "Allows an eligible standing zombie to open a compromised hiding place and pull the survivor out after reaching it. This only works when Zombie Cognition is explicitly set to Navigate + Use Doors. It does not activate with Basic Navigation or Random cognition, and crawlers, prone zombies, and dead zombies cannot perform the pullout. Disabling this does not stop zombies from using ordinary doors; it only prevents them from pulling survivors from Hide Anywhere locations. Default: Enabled. In multiplayer, only an Admin can change this server setting.",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_HideAnywhere": "Mattnetic's Hide Anywhere",
