  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_DHCS_GrantSneakingXPWhileHidden": "Gain Sneaking XP While Hidden",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_DHCS_GrantSneakingXPWhileHidden_tooltip": "Allows hidden survivors to gain Sneaking XP when nearby zombies meet Hide Anywhere's stealth XP eligibility checks. Default: Enabled. In multiplayer, only an Admin can change this server setting.",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_DHCS_ShowStatusPanelOnEntry": "Show Hidden Status Panel on Entry",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_DHCS_ShowStatusPanelOnEntry_tooltip": "Sets the server-wide default for opening the hidden status panel when a survivor enters a hiding place. Players can close the panel with X and can use their personal Hide Anywhere mod option to suppress it on entry. Default: Enabled. In multiplayer, only an Admin can change this server setting.",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_DHCS_ZombiesCanPullPlayersFromHiding": "Zombies Can Pull Players From Hiding",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_DHCS_ZombiesCanPullPlayersFromHiding_tooltip": "Allows an eligible standing zombie to open a compromised hiding place and pull the survivor out after reaching it. This only works when Zombie Cognition is explicitly set to Navigate + Use Doors. It does not activate with Basic Navigation or Random cognition, and crawlers, prone zombies, and dead zombies cannot perform the pullout. Disabling this does not stop zombies from using ordinary doors; it only prevents them from pulling survivors from Hide Anywhere locations. Default: Enabled. In multiplayer, only an Admin can change this server setting.",
  "translate_en|mods/HideAnywhere/42/media/lua/shared/Translate/EN/sandbox.json|Sandbox_HideAnywhere": "Mattnetic's Hide Anywhere",
