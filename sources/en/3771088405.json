  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_BreedDesc_beagle": "A working rabbit dog: an outstanding nose backed by real hunting drive. Famously deaf to recall, weak-biting, and unable to knock a zombie down.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_BreedDesc_belgianmalinois": "The pack's fighter: the fastest combat learner, the sharpest bite, and the steadiest under pressure. Carries little, and has next to no nose or stock sense.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_BreedDesc_bernesemountaindog": "A draft dog that works stock and hauls. Second only to the Heeler at herding and to the Dane at carrying, but it is no fighter.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_BreedDesc_bloodhound": "The finest nose in the pack by a wide margin, bought with the worst obedience of any breed. It follows the trail, not you.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_BreedDesc_blueheeler": "The pack's herding specialist, and the only light-framed dog that can knock a zombie down. Steady nerves, but a poor nose and almost no hunting drive.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_BreedDesc_dachshund": "The only dog in the pack that cannot kill. A burrow specialist with the third-best nose of any breed here: it finds everything, finishes nothing, and carries almost nothing.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_BreedDesc_greatdane": "Hits harder and carries more than anything else in the pack, but it is a gentle giant with no standout skill and the shortest nerve of the big breeds.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_BreedDesc_greyhound": "Runs anything down and brings nothing back. The best hunter in the pack, and also the frailest, thinnest-skinned, and quickest to lose its nerve.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_BreedDesc_jackrussell": "The only small dog that fights. Tenacious and fearless, but the quickest in the pack to wind itself up, stubborn, weak-biting, and a minimal carrier.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_BreedDesc_newfoundland": "The nursemaid: the most obedient of the giants, the gentlest temperament in the pack, and a soft mouth that returns kills from early on.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_BreedDesc_saintbernard": "Unshakeable. The toughest constitution and the highest panic threshold in the pack, a heavy carrier, and a good nose behind the true scent hounds.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_BreedDesc_staffordshirebullterrier": "A stout, loyal bull terrier with a big heart and a harder bite than its size suggests. Brave in a fight, gentle at home and happiest right beside its person.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_BreedDesc_standardpoodle": "The most obedient breed in the pack and the only true soft mouth: it retrieves kills from the very first hunt. Weak in a fight.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_BreedDesc_welshcorgi": "Small but mighty. A born herder that is easy to train and never knows it is small: the steadiest nerve in the pack, with a short reach and a light bite.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Breed_beagle": "Beagle",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Breed_belgianmalinois": "Belgian Malinois",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Breed_bernesemountaindog": "Bernese Mountain Dog",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Breed_bloodhound": "Bloodhound",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Breed_blueheeler": "Australian Cattle Dog",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Breed_dachshund": "Dachshund",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Breed_greatdane": "Great Dane",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Breed_greyhound": "Greyhound",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Breed_jackrussell": "Jack Russell Terrier",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Breed_newfoundland": "Newfoundland",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Breed_saintbernard": "Saint Bernard",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Breed_staffordshirebullterrier": "Staffordshire Bull Terrier",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Breed_standardpoodle": "Standard Poodle",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Breed_welshcorgi": "Pembroke Welsh Corgi",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15ColdTrail": "Cold Trail",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15ColdTrail_desc": "Following a nose like this one teaches you to read a trail that has long gone cold.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15Coursing": "Coursing",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15Coursing_desc": "Keeping up with a coursing hound is a training programme in itself.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15Deterrent": "Standing Guard",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15Deterrent_desc": "Nothing comes close with a dog this size beside you, and it shoulders part of your load.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15Draft": "Draft Harness",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15Draft_desc": "A dog bred to pull carts to market carries a real share of your load, and works the plot beside you.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15LapWarmer": "Lap Warmer",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15LapWarmer_desc": "It cannot fight, hunt, or carry. It is warm, it is yours, and that turns out to be enough.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15Lifeguard": "Lifeguard",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15Lifeguard_desc": "Keeping pace with a water rescue dog builds your wind and your conditioning.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15LilysLove": "Lily's Love",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15LilysLove_desc": "Lily is here. Some good dogs never really leave. Her love lifts your spirits, calms your nerves and keeps you company in the kitchen.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15OnPoint": "On Point",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15OnPoint_desc": "A trained protection dog at your side steadies your nerves and your aim.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15RabbitRun": "Rabbit Run",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15RabbitRun_desc": "A hound bred to work rabbit shows you where the runs are and how to set for them.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15Ratter": "Ratter",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15Ratter_desc": "Going to ground after vermin teaches you to move unseen and to finish things at knife range.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15Rescue": "Rescue Cask",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15Rescue_desc": "A rescue dog keeps you moving well past where you would have stopped, and caring for it teaches you medicine.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15Stockman": "Stockman's Eye",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15Stockman_desc": "Working beside a cattle dog teaches you to handle animals and to move quietly among them.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15StoutHeart": "Stout Heart",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15StoutHeart_desc": "A staffy at your side never backs down, and neither do you. Panic eases, and hauling and heavy work build real strength.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15UnderFoot": "Under Foot",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15UnderFoot_desc": "A corgi in the kitchen is a corgi under your feet. Cooking comes easier with a helper who never leaves your side.",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15WaterDog": "Water Retriever",
  "translate_en|mods/CompanionDogsBreedPack15/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PD_Moodle_BP15WaterDog_desc": "A working water dog knows where the fish are holding, and brings back what it takes.",
