  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_AllowOilFilterRepair": "Allow Oil Filter Suppressor repair",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_AllowOilFilterRepair_tooltip": "OFF by default. When enabled, a broken Oil Filter Suppressor can be repaired a maximum of one time. After the next failure it is permanently destroyed.",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_AlwaysShowSuppressorStatusIcon": "Always show suppressor status icon",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_AlwaysShowSuppressorStatusIcon_tooltip": "Keeps the suppressor HUD icon visible whenever a supported suppressor is attached to the weapon in your primary hand. When disabled, the HUD behaves like before and appears only as a heat warning. Right-click the icon to switch between normal and compact size. Applies without restarting the session.",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_CKMAudioVolume": "LMG and machine-gun volume (0-200)",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_CKMAudioVolume_tooltip": "Changes only the suppressed gunshot volume heard by the player. 100 is the default level. It does not change zombie-hearing radius. Restart the session after changing the value.",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_EnableCrafting": "Enable suppressor crafting and repairs",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_EnableCrafting_tooltip": "Enables suppressor crafting and repair recipes. Oil Filter maintenance is controlled by a separate Sandbox option. Restart the session after changing this option.",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_EnableDurability": "Suppressor durability",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_EnableDurability_tooltip": "Enables suppressor condition loss while firing. Suppressors always heat and cool dynamically; high heat increases smoke and, when durability is enabled, accelerates wear. This option applies without a restart.",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_HotBrassCasingVolume": "Hot Brass - casing impact volume (0-200)",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_HotBrassCasingVolume_tooltip": "Controls only Hot Brass casing and shell impact sounds. 100 is the original Hot Brass level, 0 mutes casing impacts. This option works only when Hot Brass is enabled.",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_InfiniteOilFilterRepairs": "Infinite Oil Filter Suppressor repairs",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_InfiniteOilFilterRepairs_tooltip": "OFF by default. Requires Oil Filter repair to be enabled. When ON, an Oil Filter Suppressor can be repaired again after every failure instead of being limited to one repair.",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_LootAKSuppressor": "AK Suppressor loot rarity",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_LootAKSuppressor_tooltip": "Controls this suppressor in the mod loot tables. Disabled removes it from those tables. Restart the session after changing this option; already-generated containers are not rerolled.",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_LootHeavyShotgunSuppressor": "Heavy Shotgun Suppressor loot rarity",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_LootHeavyShotgunSuppressor_tooltip": "Controls this suppressor in the mod loot tables. Disabled removes it from those tables. Restart the session after changing this option; already-generated containers are not rerolled.",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_LootKnowledgeMagazines": "Suppressor knowledge magazines loot rarity",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_LootKnowledgeMagazines_tooltip": "Controls the spawn rarity of Deadly Silence and Silence Under Control. Disabled removes both learning magazines from this mod's loot tables. Already-generated containers are not rerolled.",
  "translate_en|mods/RealisticSuppressorSystemB42/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressor_LootOilFilter": "Oil Filter Suppressor loot rarity",
