  "translate_en|mods/RealisticSuppressorSystemB42_GunsOfMarz/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorGoM": "Realistic Suppressor System - Guns of Marz",
  "translate_en|mods/RealisticSuppressorSystemB42_GunsOfMarz/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorGoM_EnableMuzzleAdapters": "Enable Guns of Marz muzzle adapters",
  "translate_en|mods/RealisticSuppressorSystemB42_GunsOfMarz/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorGoM_EnableMuzzleAdapters_tooltip": "WORLD-START OPTION: Choose whether the original Guns of Marz muzzle mounting adapters remain enabled. Changing this later on an existing save is not supported and may not restore disabled items correctly. Restart required. When disabled, AR/AK/Pistol/.45 adapters cannot be mounted and are removed from GoM random spawn tables and the vanilla replacement pool.",
  "translate_en|mods/RealisticSuppressorSystemB42_GunsOfMarz/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorGoM_EnableSuppressors": "Enable Guns of Marz suppressors",
  "translate_en|mods/RealisticSuppressorSystemB42_GunsOfMarz/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorGoM_EnableSuppressors_tooltip": "WORLD-START OPTION: Choose whether the original Guns of Marz suppressors remain enabled. Changing this later on an existing save is not supported and may not restore disabled items correctly. Restart required. When disabled, GoM suppressors cannot be mounted and are removed from GoM random spawn tables.",
  "translate_en|mods/RealisticSuppressorSystemB42_GunsOfMarzOld/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorGoMOld": "Realistic Suppressor System - Guns of Marz Old Version",
  "translate_en|mods/RealisticSuppressorSystemB42_GunsOfMarzOld/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorGoMOld_EnableMuzzleAdapters": "Enable Guns of Marz Old Version muzzle adapters",
  "translate_en|mods/RealisticSuppressorSystemB42_GunsOfMarzOld/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorGoMOld_EnableMuzzleAdapters_tooltip": "WORLD-START OPTION: Choose whether the original Guns of Marz Old Version muzzle mounting adapters remain enabled. Restart required. When disabled, AR/AK/Pistol/.45 adapters cannot be mounted and are removed from GoM random spawn tables and the vanilla replacement pool.",
  "translate_en|mods/RealisticSuppressorSystemB42_GunsOfMarzOld/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorGoMOld_EnableSuppressors": "Enable Guns of Marz Old Version suppressors",
  "translate_en|mods/RealisticSuppressorSystemB42_GunsOfMarzOld/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorGoMOld_EnableSuppressors_tooltip": "WORLD-START OPTION: Choose whether the original Guns of Marz Old Version suppressors remain enabled. Restart required. When disabled, GoM suppressors cannot be mounted and are removed from GoM random spawn tables.",
  "translate_en|mods/RealisticSuppressorSystemB42_VanillaWeaponsPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorVWP": "Realistic Suppressor System - Vanilla Weapons Plus",
  "translate_en|mods/RealisticSuppressorSystemB42_VanillaWeaponsPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorVWP_EnableMuzzleDevices": "Enable Vanilla Weapons Plus muzzle devices",
  "translate_en|mods/RealisticSuppressorSystemB42_VanillaWeaponsPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorVWP_EnableMuzzleDevices_tooltip": "WORLD-START OPTION: Choose whether the original Vanilla Weapons Plus / Gunworks 5.56 and 7.62 muzzle devices remain enabled. Changing this later on an existing save is not supported and may not restore disabled items correctly. Restart required. When disabled, these muzzle devices cannot be mounted and are scrubbed from generated weapon attachments where possible.",
  "translate_en|mods/RealisticSuppressorSystemB42_VanillaWeaponsPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorVWP_EnableNativeSuppressors": "Enable Vanilla Weapons Plus suppressors",
  "translate_en|mods/RealisticSuppressorSystemB42_VanillaWeaponsPlus/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_ShotgunSuppressorVWP_EnableNativeSuppressors_tooltip": "WORLD-START OPTION: Choose whether the original Vanilla Weapons Plus / Gunworks suppressors remain enabled. Changing this later on an existing save is not supported and may not restore disabled items correctly. Restart required. When disabled, the original Pistol, Heavy Pistol and AR silencers cannot be mounted and are removed from random loot."
