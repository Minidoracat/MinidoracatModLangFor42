  "translate_en|mods/Superheroes/42.13/media/lua/shared/Translate/EN/IG_UI_EN.txt|IGUI_PlayerText_Shout_105": "FREEDOM!",
  "translate_en|mods/Superheroes/42.13/media/lua/shared/Translate/EN/IG_UI_EN.txt|IGUI_PlayerText_Shout_106": "GO AHEAD!! MAKE MY DAY!",
  "translate_en|mods/Superheroes/42.13/media/lua/shared/Translate/EN/IG_UI_EN.txt|IGUI_PlayerText_Shout_107": "BRING IT!",
  "translate_en|mods/Superheroes/42.13/media/lua/shared/Translate/EN/IG_UI_EN.txt|IGUI_PlayerText_Shout_108": "THAT ALL YOU GOT?!",
  "translate_en|mods/Superheroes/42.13/media/lua/shared/Translate/EN/IG_UI_EN.txt|IGUI_PlayerText_Shout_109": "WHO'S NEXT?!",
