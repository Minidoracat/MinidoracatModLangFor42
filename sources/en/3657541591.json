  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_Adamantium": "Adamantium",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_AdamantiumDesc": "Start with an indestructable adamantium skeleton.<br>Pop adamantium claws when attacking unarmed.",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_Bloodlust": "Bloodlust",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_BloodlustDesc": "Double the speed. Triple the damage.<br>Recover endurance with every melee kill.<br>Desensitized",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_Celerity": "Celerity",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_CelerityDesc": "Superhuman speed and reaction time.<br>Faster combat and recovery animations.<br>Faster movement and timed actions.<br>Chance to dodge zombie attacks.<br>Dextrous",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_CelerityDodge": "*dodged*",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_Deadshot": "Deadshot",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_DeadshotAmmo": "Ammo restored!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_DeadshotDesc": "One shot. One kill. Every time.<br>Firearms degrade more slowly, and may restore ammo when fired.<br>Desensitized<br>Eagle Eyed",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_Eidetic": "Eidetic",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_EideticDesc": "Perfect recall and comprehension.<br>Gain skill levels by reading skill books.<br>Automatically know all recipes.<br>Fast Learner<br>Fast Reader",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_Flight": "Flight",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_FlightDesc": "Sky roads are faster than walking.<br>Double tap the vehicle key to toggle flight mode. Page Up/Down to change elevation.<br>Constant feather fall.",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_Hammer": "Hammertime",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_HammerDesc": "Explosive hammer strikes.<br>Will blow the pants right off you.<br>Works with blunt weapons.",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_Invisibility": "Invisibility",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_InvisibilityAssassinate": "*assassinated*",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_InvisibilityDesc": "Become invisible while sneaking.<br>Assassinate enemies while invisible.<br>Graceful<br>Inconspicuous",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_LaserEyes": "Laser Eyes",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_LaserEyesDesc": "Shoot fricken' laser beams out of your eyes.<br>Wear any eyewear to activate. Equip from the hotbar, then point and shoot.<br>Eagle Eyed",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_LastStand": "Last Stand",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_LastStandDesc": "Explode in a last stand of defiance when about to be dragged down.",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_OnePunch": "One Punch",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_OnePunchDesc": "One punch. Everything dies.<br>Obliterate doors, trees, zombies, and zombie hordes with a single unarmed strike.",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_PlotArmor": "Plot Armor",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_PlotArmorDesc": "Start with nigh-impenetrable plot armor.<br>Just don't forget to equip it.",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_Psychotic": "Psychotic",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_PsychoticDesc": "Violence is a part of you now.<br>Increased boredom.<br>Boost mood with every kill.",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_Regeneration": "Regeneration",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_RegenerationDesc": "Wounds heal in minutes.<br>Never become diseased or infected.<br>Immune to zombification.<br>Fast Healer",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_Telekinesis": "Telekinesis",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_TelekinesisDesc": "Passively push zombies away with telekinetic shields.<br>Shout to project devastating telekinetic blasts.<br>Drains endurance; will fail if you get too tired.",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_TelekinesisPush": "*shielded*",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_Thunderstrike": "Thunderstrike",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_ThunderstrikeDesc": "Shout to summon the wrath of the heavens.<br>Only works outside.<br>Beware of fires!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_Unstoppable": "Unstoppable",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/UI.json|UI_trait_UnstoppableDesc": "Sprint straight through your enemies. They will regret it.<br>Just don't run out of endurance in the middle of a horde."
