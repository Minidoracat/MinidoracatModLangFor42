  "translate_en|mods/Superheroes/42.13/media/lua/shared/Translate/EN/IG_UI_EN.txt|IGUI_PlayerText_Shout_13": "EAT LIGHTNING!",
  "translate_en|mods/Superheroes/42.13/media/lua/shared/Translate/EN/IG_UI_EN.txt|IGUI_PlayerText_Shout_201": "Don't come asking to play rock, scissors, paper with a booger on your finger!",
  "translate_en|mods/Superheroes/42.13/media/lua/shared/Translate/EN/IG_UI_EN.txt|IGUI_PlayerText_Shout_204": "I want a Coca Cola so bad.",
  "translate_en|mods/Superheroes/42.13/media/lua/shared/Translate/EN/IG_UI_EN.txt|IGUI_PlayerText_Shout_206": "I'm just a guy who's a hero for fun.",
  "translate_en|mods/Superheroes/42.13/media/lua/shared/Translate/EN/IG_UI_EN.txt|IGUI_PlayerText_Shout_207": "100 push-ups, 100 sit-ups, 100 squats, and a 10km run EVERY SINGLE DAY!",
  "translate_en|mods/Superheroes/42.13/media/lua/shared/Translate/EN/IG_UI_EN.txt|IGUI_PlayerText_Shout_208": "Heroes and the police don't do their jobs because someone says \"please\". Right?",
