  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_06": "I CAME, I SAW, I SMOTE!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_07": "NONE CAN WITHSTAND MY LIGHTNING!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_08": "LOUD NOISES!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_09": "LET THERE BE THUNDER!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_10": "LET THERE BE LIGHTNING!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_101": "NOT TODAY!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_102": "NEVER SAY DIE!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_103": "NONE SHALL PASS!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_104": "YOU... SHALL... NOT... PASS!!!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_105": "FREEDOM!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_106": "GO AHEAD!! MAKE MY DAY!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_107": "BRING IT!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_108": "THAT ALL YOU GOT?!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_109": "WHO'S NEXT?!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_11": "ARE YOU NOT ENTERTAINED?!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_110": "MY SQUEEDILY SPOOCH!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_12": "I AM SPARTACUS!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_13": "EAT LIGHTNING!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_201": "Don't come asking to play rock, scissors, paper with a booger on your finger!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_204": "I want a Coca Cola so bad.",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_206": "I'm just a guy who's a hero for fun.",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_207": "100 push-ups, 100 sit-ups, 100 squats, and a 10km run EVERY SINGLE DAY!",
  "translate_en|mods/Superheroes/42.15/media/lua/shared/Translate/EN/IG_UI.json|IGUI_PlayerText_Shout_208": "Heroes and the police don't do their jobs because someone says 'please'. Right?",
