  "translate_en|mods/LootTracker/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LootTracker_Options_LabelsOn_tooltip": "Show how many containers you have searched (for example 7/10) on each building. Untick to hide the counts and keep only the colours.",
  "translate_en|mods/LootTracker/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LootTracker_Options_MyCars": "Remember my cars",
  "translate_en|mods/LootTracker/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LootTracker_Options_MyCars_tooltip": "A car you have driven for 5 minutes in total becomes one of your cars, up to 3. They show on the map and minimap in their own colour, with an arrow on the edge of the minimap when they are out of view. Turning this off hides them and stops counting. Your cars are kept.",
  "translate_en|mods/LootTracker/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LootTracker_Options_OverlayKey": "Show/hide loot on map",
  "translate_en|mods/LootTracker/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_LootTracker_Options_OverlayKey_tooltip": "Press this key to turn the Loot Tracker building colours on the map on or off. Unbound by default.",
