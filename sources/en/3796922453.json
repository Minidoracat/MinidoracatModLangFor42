  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Mod.json|description": "Functional central heating with three boiler sizes: industrial, medium and compact. Residential boilers can appear only in basements, and their spawn is decided lazily when a player first enters the basement. Untouched world boilers remain dormant until the player picks them up or attempts to connect them.",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Mod.json|name": "Central Heating Boilers",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_CompatibilityMode": "Mod compatibility",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_CompatibilityMode_tooltip": "Experimental fallback for other power-grid mods. Use the separate LG Extended Electricity option for LG support. When enabled, CHB may accept electricity reported on the boiler square by another mod when no normal grid or directly detectable vanilla generator is found. Fuel and load accounting for external sources may differ from normal CHB operation.",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_DeveloperMode": "Developer mode",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_EnableResidentialSpawn": "Spawn residential boilers",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_EnableResidentialSpawn_tooltip": "Allows Home and Compact boilers to appear only in basements, generated lazily when a player enters one.",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_EnableSystemAging": "Heating system aging",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_EnableSystemAging_tooltip": "Gradually increases boiler water consumption as the heating system ages after the electricity shutoff. There is no extra consumption during the first year; aging then increases over time and reaches its maximum permanent penalty by year ten. Disable this option to remove long-term system aging.",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_LGExtendedElectricityCompatibility": "LG Extended Electricity compatibility",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_LGExtendedElectricityCompatibility_tooltip": "Enable CHB power compatibility with LG Extended Electricity. When enabled and LG is active, CHB may use electricity delivered to the boiler square through LG's extended network. CHB does not add this external boiler load to LG generator fuel or breaker accounting.",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_Mode": "Power consumption mode",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_Mode_option1": "Hardcore Realism",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_Mode_option2": "Realistic (default)",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_Mode_option3": "Comfort",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_Mode_tooltip": "Hardcore Realism uses very high power in cold weather. Normal is the recommended balance. Comfort uses a low, nearly constant draw.",
  "translate_en|mods/CentralHeatingBoilers/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CHB_ResidentialSpawnChance": "Residential boiler spawn chance (percent)",
