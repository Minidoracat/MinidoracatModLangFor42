  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions": "Food Drying",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_DryingRackDaysBerries": "Drying Rack: Days for Berries",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_DryingRackDaysBerries_tooltip": "7 by default. How many days berries take to dry on the physical Drying Rack. Only affects the Drying Rack, not oven drying.",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_DryingRackDaysFish": "Drying Rack: Days for Salted Fish",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_DryingRackDaysFish_tooltip": "14 by default. How many days salted fish takes to dry on the physical Drying Rack. Only affects the Drying Rack, not oven drying.",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_DryingRackDaysFruit": "Drying Rack: Days for Fruit",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_DryingRackDaysFruit_tooltip": "5 by default. How many days fruit takes to dry on the physical Drying Rack. Only affects the Drying Rack, not oven drying.",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_DryingRackDaysMeat": "Drying Rack: Days for Salted Meat",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_DryingRackDaysMeat_tooltip": "21 by default. How many days salted meat takes to dry on the physical Drying Rack. Only affects the Drying Rack, not oven drying.",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_DryingRackDaysMushrooms": "Drying Rack: Days for Mushrooms",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_DryingRackDaysMushrooms_tooltip": "3 by default. How many days mushrooms take to dry on the physical Drying Rack. Only affects the Drying Rack, not oven drying.",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_DryingRackDaysVegetables": "Drying Rack: Days for Vegetables",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_DryingRackDaysVegetables_tooltip": "7 by default. How many days vegetables take to dry on the physical Drying Rack. Only affects the Drying Rack, not oven drying.",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_OvenDryingEnabled": "Enable Oven Drying",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_OvenDryingEnabled_tooltip": "On by default. When disabled, food can no longer be dried in an oven (Baking Tray/Skewer recipes) - only the Drying Rack still works.",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_SaltHarvestingEnabled": "Enable Salt Harvesting",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_SaltHarvestingEnabled_tooltip": "On by default. When disabled, salt licks can no longer be harvested for Drying Salt.",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_ShelfLifeMultiplier": "Dried Food Shelf Life Multiplier",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_FoodDryingOptions_ShelfLifeMultiplier_tooltip": "1 by default. Multiplies how long dried/preserved foods from this mod stay fresh/edible before spoiling. At the default 1x: dried meat stays good for about 3-8 months, dried fish 4-9 months, dried fruit/berries/mushrooms 6-12 months, dried vegetables 5-10 months. 2x doubles those, 0.5x halves them.",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_FD_HarvestSaltLick_NoTool": "Requires a hammer, sledgehammer, stone maul or pickaxe.",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PotOfBrine": "Salt lick shavings dissolved in water. Needs to be boiled before the brine can be filtered into usable salt.",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_PotOfBrineCooked": "Boiled salt brine. Filter it through cheesecloth or a respirator filter to extract usable salt.",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_SaltLickShavings": "Coarse, mineral-rich shavings scraped from a salt lick. Not safe to eat directly - dissolve in water and boil it down before filtering out the trace metals.",
  "translate_en|mods/FoodDrying/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_dryFoodRackDesc": "A simple wooden rack for air-drying mushrooms, berries, fruit, vegetables, salted meat and salted fish. Slower than an oven, but needs no fuel.",
