  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_ClaimDeedEnabled": "Enable safehouse deed item",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_ClaimDeedEnabled_tooltip": "Lets players use the safehouse deed item to claim a safehouse anywhere, without needing an existing building room.",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_ClaimDeedMinDistance": "Deed minimum distance from other safehouses",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_ClaimDeedMinDistance_tooltip": "Minimum distance, in tiles, the claimed area must keep from any existing safehouse. 0 = no minimum.",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_FactionCoLeadersEnabled": "Enable faction co-leaders",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_FactionCoLeadersEnabled_tooltip": "If disabled, the faction leader is the only member who can add or remove players -- the vanilla screens stay exactly as they are, just without the co-leader role layered on top.",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_FactionMaxCoLeaders": "Max co-leaders per faction",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_FactionMaxCoLeaders_tooltip": "Maximum number of co-leaders a faction leader can appoint. A co-leader may only add or remove plain members. 0 = unlimited.",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_FactionMaxMembers": "Max members per faction",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_FactionMaxMembers_tooltip": "Maximum number of players (leader included) allowed in a single faction. 0 = unlimited.",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_FactionSafehouseLimitEnabled": "Limit safehouses per faction",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_FactionSafehouseLimitEnabled_tooltip": "If enabled, a player cannot claim a new safehouse (deed or vanilla claim) while their faction already owns one, up to the max below. Only real ownership counts -- being a plain member/guest of a safehouse never counts against this. Disabled by default. This is not enforced retroactively: factions that already own more than the limit when this is turned on keep what they have, an admin should handle those manually.",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_FactionSafehouseMaxOwned": "Max safehouses owned per faction",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_FactionSafehouseMaxOwned_tooltip": "Only applies when \"Limit safehouses per faction\" is enabled. Maximum number of safehouses the combined members of a faction may own at once.",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_FactionTrackingEnabled": "Export faction data for external tools",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_FactionTrackingEnabled_tooltip": "Disabled by default. Exports faction snapshots and events. Configure the snapshot interval in real seconds. External readers cannot change game data.",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_FactionTrackingExportIntervalSeconds": "Snapshot interval in real seconds",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_FactionTrackingExportIntervalSeconds_tooltip": "Real seconds between snapshot writes, from 5 to 3600. Changes are grouped and written once per interval, failed writes are retried on the next one, and the file is also refreshed once per interval when nothing changed. Only used while the export above is enabled.",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_SafehouseCoLeadersEnabled": "Enable safehouse co-leaders",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_SafehouseCoLeadersEnabled_tooltip": "If disabled, the safehouse owner is the only one who can add or remove players -- the vanilla screens stay exactly as they are, just without the co-leader role layered on top.",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_SafehouseMaxCoOwners": "Max co-leaders per safehouse",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_SafehouseMaxCoOwners_tooltip": "Maximum number of co-leaders a safehouse owner can appoint. A co-leader may only add or remove plain members. 0 = unlimited.",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_SafehouseMaxMembers": "Max members per safehouse",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_SafehouseMaxMembers_tooltip": "Maximum number of players (owner included) allowed in a single safehouse. 0 = unlimited.",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_SafehouseViewerEnabled": "Enable safehouse area viewer",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SafehouseFactionControl_SafehouseViewerEnabled_tooltip": "Lets players toggle a ground highlight showing the tiles of their own safehouse, from the user panel (Escape menu).",
  "translate_en|mods/SafehouseFactionControl/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_SFC_SafehouseDeed100": "Right-click to claim a 100x100 safehouse on the spot you're standing on, no building required. Consumed on use.",
