  "translate_en|mods/Blackout Predators/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BlackoutPredators_AmbientSpawnChancePercent_tooltip": "Chance for each normal zombie encountered at night to become a roaming Volatile. 0 disables ambient Volatile spawns. Default: 9%%.",
  "translate_en|mods/Blackout Predators/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BlackoutPredators_DayStartHour": "Volatile Spawn End Hour",
