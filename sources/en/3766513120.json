  "translate_en|mods/Blackout Predators/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BlackoutPredators_NestCountMax_tooltip": "Maximum number of Volatiles assigned to each nest. Default: 7.",
  "translate_en|mods/Blackout Predators/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BlackoutPredators_NestCountMin": "Nest Population - Minimum",
  "translate_en|mods/Blackout Predators/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BlackoutPredators_NestCountMin_tooltip": "Minimum number of Volatiles assigned to each nest. Default: 4.",
  "translate_en|mods/Blackout Predators/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BlackoutPredators_NightStartHour": "Volatile Spawn Start Hour",
  "translate_en|mods/Blackout Predators/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BlackoutPredators_NightStartHour_tooltip": "Hour when Volatiles begin spawning and hunting outdoors. The fixed 2× XP bonus also begins at this hour. Default: 00:00.",
  "translate_en|mods/Blackout Predators/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BlackoutPredators_UVMechanicsEnabled": "Enable UV Mechanics",
