  "translate_en|mods/Blackout Predators/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BlackoutPredators_VolatileHealth_tooltip": "Total health assigned to each Volatile. Default: 12.",
  "translate_en|mods/Blackout Predators/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BlackoutPredators_VolatileHearing": "Volatile Hearing",
  "translate_en|mods/Blackout Predators/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BlackoutPredators_VolatileHearing_tooltip": "Distance at which each Volatile can hear players and sounds. Does not change ordinary zombies. Default: Pinpoint.",
  "translate_en|mods/Blackout Predators/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BlackoutPredators_VolatileMemory": "Volatile Memory",
