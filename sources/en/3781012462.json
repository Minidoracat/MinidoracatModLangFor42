  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC": "QoL Compendium",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AdrenalineBoostSpeed": "Adrenaline Boost Speed",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AdrenalineBoostSpeed_tooltip": "How quickly panic wakes the character up. Higher sheds the Tired debuff sooner.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AdrenalineCrashPenalty": "Adrenaline Crash Penalty",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AdrenalineCrashPenalty_tooltip": "How much extra fatigue is paid back on top of what adrenaline borrowed.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AdrenalineCrashSpeed": "Adrenaline Crash Speed",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AdrenalineCrashSpeed_tooltip": "How quickly drowsiness returns once the character calms down.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AdrenalineEnabled": "Adrenaline",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AdrenalineEnabled_tooltip": "Panic temporarily takes fatigue off the character, hiding the Tired debuff until they calm down.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AlarmHouseRule": "Alarms On Open Houses",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AlarmHouseRule_option1": "Alarms Always Sound",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AlarmHouseRule_option2": "Open Doors And Broken Windows",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AlarmHouseRule_option3": "Also Unlocked Doors",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AlarmHouseRule_tooltip": "Stops a house alarm sounding for a house anyone could already have walked into. Unlocked doors covers many more houses than open ones, since vanilla leaves most exterior doors unlocked.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AlarmVehiclesEnabled": "Alarms On Open Vehicles",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_AlarmVehiclesEnabled_tooltip": "Stops a car alarm sounding when a door or the trunk was left unlocked, a door or window stands open, or a window has been smashed out.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_BlowtorchEnabled": "Bigger Welding Torch",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_BlowtorchEnabled_tooltip": "A torch holds more uses and a propane tank refills it more times, by the two numbers below. Off restores vanilla's 10 uses and roughly 7 refills a tank.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_BlowtorchRefills": "Torch Refills Per Propane Tank",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_BlowtorchRefills_tooltip": "Times a full propane tank refills an empty torch, whatever size the torch is. Vanilla is roughly 7. Ignored while the bigger torch is off.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_BlowtorchUses": "Welding Torch Uses",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_BlowtorchUses_tooltip": "Uses a full welding torch holds. Vanilla is 10. Takes effect when the world next loads, and is ignored while the bigger torch is off.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_ClothRecyclingEnabled": "Cloth Recycling",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_ClothRecyclingEnabled_tooltip": "Lets you tear a bath towel or a dish cloth into rags, and sew twelve rags back into a bedsheet. The base game can do neither: only the bedsheet carries the tag that makes cloth rippable, and nothing turns rags back into anything. A towel gives three rags and a dish cloth one, against the bedsheet's ten.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_CorpseDisposalEnabled": "Corpse Disposal",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_CorpseDisposalEnabled_tooltip": "Butcher a body for flesh that can be composted, and, at Cooking 7, prepared and then cured in salt over three days into meat a pot will accept. The base game can burn, bury or dump a corpse but never get anything back from one. Off by default, because this is cannibalism and not a fix for anything.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_CutClothingEnabled": "Cut Up Any Clothing",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_CutClothingEnabled_tooltip": "Lets you cut up the clothing the base game forgot: underwear, socks, bandanas, scarves, gloves, hide trousers, shoes and empty wallets. The garment yields whatever it is made of, so leather boots give leather strips. Off leaves every one of them uncuttable, exactly as the base game has it.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_LockpickingEnabled": "Lockpicking",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_LockpickingEnabled_tooltip": "Adds lockpicks, hairpins to make them from, and a manual to learn from. Pick a locked door, car door or boot with a screwdriver and a pick. The base game has no lockpicking at all. Prying a lock with a crowbar is the option below.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_MetalworkingEnabled": "Metalworking Gaps",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_MetalworkingEnabled_tooltip": "Adds forge recipes for four things the base game has items for and no way to make: wire, metal pipe, welding rods and electrical wire. Wire is the worst of them, being craftable only from barbed wire which is craftable only from wire. Off leaves all four found rather than made.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_NutritionistMagEnabled": "The Nutritionist Magazine",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_NutritionistMagEnabled_tooltip": "Adds a magazine that teaches the Nutritionist trait, putting nutrition on the food the base game keeps quiet about: fresh produce, meat, foraged food and anything you cook. Tinned and boxed food already shows its label to anyone. It spawns wherever cooking magazines do, at half their odds.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_PropanePumpCost": "Propane Cost At A Pump",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_PropanePumpCost_tooltip": "Fuel drawn from a pump to fill one propane tank. A jerry can holds 10, a pump holds 22000.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_PropanePumpEnabled": "Propane From Fuel Pumps",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_PropanePumpEnabled_tooltip": "Refill a propane tank at a working fuel pump. The base game has no other way to refill one, so turning this off restores a hard ceiling on welding.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_PryingEnabled": "Prying Locks",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_PryingEnabled_tooltip": "Lever a locked door, window, car door or boot open with a crowbar, once you have read the manual it adds or started as a Burglar. Louder and cruder than picking, and it needs no tools beyond the crowbar. A car lock that gives way is wrecked, so the door will never lock again.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_ReadingCalmEnabled": "Reading Settles The Mind",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_ReadingCalmEnabled_tooltip": "Reading a skill book slowly eases boredom, unhappiness and stress. The base game gives skill books no morale value at all, only comics and newspapers.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_ReadingCalmRate": "Reading Calm Rate",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_ReadingCalmRate_tooltip": "Percentage of the effect a page of a skill book is worth. Illness weakens it, and a fast reader gets less per page because they turn more of them.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_SleepRecoveryEnabled": "Sleep Wears Off Boredom",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_SleepRecoveryEnabled_tooltip": "Boredom and unhappiness fall while a character sleeps. The base game freezes both instead, so a night changes neither.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_SleepRecoveryRate": "Sleep Recovery Rate",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_SleepRecoveryRate_tooltip": "Percentage of what a night's sleep is worth. At the default an eight hour night clears boredom and takes a quarter off unhappiness.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_SlingEnabled": "Rifle Slings",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_SlingEnabled_tooltip": "Wear a rifle or other long weapon on a sling. Off stops them spawning in loot and on dead soldiers. The recipe stays available, and slings already owned keep working.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_TailoringCutXp": "Tailoring Cutting Rate",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_TailoringCutXpEnabled": "Tailoring From Cutting Clothes",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_TailoringCutXpEnabled_tooltip": "Cutting a garment into strips teaches tailoring, and cutting gets quicker as the skill rises. Vanilla pays nothing for either.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_TailoringCutXp_tooltip": "Percentage of the experience a cut garment is worth. Denim and leather pay per strip, cotton pays nothing, uniforms pay a bonus on top.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_WorkbooksEnabled": "DIY Workbooks",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_QoLC_WorkbooksEnabled_tooltip": "Adds four practice manuals for carpentry, electrical, welding and tailoring. Holding one lets you work an exercise from it, spending materials for experience in that trade. Every one is a net loss of materials, so this is somewhere to put a surplus rather than a way to make anything. Off stops them spawning and makes the exercises uncraftable.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_QoLC_ButcherCorpseNoKnife": "Needs a sharp knife or a meat cleaver.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_QoLC_CorpseFlesh": "Is there anything you would not do to survive? Eating this will make you very ill. It composts.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_QoLC_CuredCorpseFlesh": "Cured through. Raw, so cook it, and then it is meat like any other.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_QoLC_CuringCorpseFlesh": "Packed in salt. Leave it somewhere that is not cold for three days.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_QoLC_Lockpick": "Thin enough to work a pin tumbler, with a screwdriver for tension.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_QoLC_LockpickBook1": "Teaches how to make a pick, and how to use one.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_QoLC_LockpickBook2": "Teaches how to lever a lock open with a crowbar.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_QoLC_PreparedCorpseFlesh": "Trimmed and boned properly. Still a mistake to eat, and still a long way from food.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_QoLC_ReadOnePage": "Still too advanced to learn from, but reading a page is enough to recognize another copy later.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_QoLC_WorkbookCarpentry": "Exercises to work through with a saw and a hammer. Costs planks, teaches carpentry.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_QoLC_WorkbookElectrical": "Exercises to work through with a screwdriver. Costs scrap electronics and wire, teaches electrical.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_QoLC_WorkbookTailoring": "Exercises to work through with scissors and a needle. Costs rags and thread, teaches tailoring.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_QoLC_WorkbookWelding": "Exercises to work through with a torch and a mask. Costs scrap metal, teaches welding.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC": "QoL Compendium",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_BiggerAvatar": "Bigger Character Avatar",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_BiggerAvatar_Desc": "Enlarges the 3D character model on the in game info panel.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_BiggerAvatar_Enabled": "Bigger Avatar",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_BiggerAvatar_Enabled_tooltip": "Turn off to restore the vanilla avatar size. Takes effect immediately.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_BiggerAvatar_Scale": "Avatar Scale (%%)",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Condition": "Weapon Condition",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Condition_Accessible": "Use Accessibility Colors",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Condition_Accessible_tooltip": "Takes the healthy and danger colors from the 'Good' and 'Bad' highlight colors on the game's Accessibility page, with the warning color halfway between. Off uses green, amber and red.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Condition_Desc": "Shows how worn a weapon or tool is, without hovering it. Turns itself off if a mod that draws its own condition, such as Clean HotBar, is installed.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Condition_Enabled": "Show Condition Bars",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Condition_Enabled_tooltip": "Draws a bar under each equipped weapon and each item on the hotbar, changing color under half and again under a quarter.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features": "Features",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_AmmoIcons": "Ammo And Magazine Icons",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_AmmoIcons_tooltip": "Gives each ammo box and magazine its own icon. Takes effect after a restart.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_BookIcons": "Skill Book Icons",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_BookIcons_tooltip": "Gives all twenty four skill book families their own icon. Takes effect after a restart.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_Capacity": "Fix Container Titles",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_Capacity_tooltip": "Stops a container's name running into the weight printed beside it.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_Desc": "Turn individual features on or off. Features with settings of their own have their switch in their own section below.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_FlagBook": "Flag A Book As Seen",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_FlagBook_tooltip": "Reads the first page of a book that is still too advanced, so a second copy is recognisable later.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_Flashlight": "Flashlight On The Belt",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_Flashlight_tooltip": "Hang a torch off either belt slot, the way a screwdriver or a walkie talkie already can. Attaching one does not switch it on. Takes effect on the next start.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_FoodCategories": "Split Food Categories",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_FoodCategories_tooltip": "Separates food that spoils from food that keeps in the inventory. Takes effect after a restart.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_Generator": "Generator Fuel And Range",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_Generator_tooltip": "Adds how long the fuel lasts to the generator window, and highlights the squares it powers.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_Hotbar": "Reorder The Hotbar",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_Hotbar_tooltip": "Drag hotbar slots into the order you want, and click a slot to use it. Off restores the vanilla hotbar.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_Material": "Clothing Material",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_Material_tooltip": "Adds what a garment is made of to its tooltip, colored by fabric.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_MoodleQuarters": "Moodle Quarters",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_MoodleQuarters_tooltip": "Squares off one more quarter of a moodle's plate for each level it climbs, so the stack reads at a glance. Stands down on its own if Moodle Quarters or Moodles in Lua is installed, since both replace the same panel.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_TakeAmount": "Take Any Amount",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_TakeAmount_tooltip": "Adds a typed amount to the grab menu, alongside vanilla's one, half and all.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_XpView": "Fix XP Boost Multipliers",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Features_XpView_tooltip": "The skills panel says what a boost is really worth. Off restores the vanilla percentages, which understate it.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Overlays": "Immersive Overlays",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Overlays_DamageStrength": "Damage Strength (%%)",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Overlays_Desc": "Full-screen tints that react to your moodles.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Overlays_Enabled": "Enable Overlays",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Overlays_Enabled_tooltip": "Turn off every moodle overlay. Each overlay still has its own strength slider below.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Overlays_HyperthermiaStrength": "Hyperthermia Strength (%%)",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Overlays_HypothermiaStrength": "Hypothermia Strength (%%)",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Overlays_PainStrength": "Pain Strength (%%)",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Overlays_TiredStrength": "Tired Strength (%%)",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Reorder": "Reorder Duplicates",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Reorder_Desc": "Sort a container's duplicates by condition, how full they are, or what they are worth eating.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Reorder_Enabled": "Sort Duplicates",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Reorder_Enabled_tooltip": "Adds the sort options to a container's right click menu. Off removes them and leaves the two settings below with nothing to do.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Reorder_Extras": "Offer Bloodiness And Dirtiness",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Reorder_Extras_tooltip": "Adds two more ways to sort clothing and weapons, at the cost of a longer menu.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Reorder_Speak": "Say When Already Sorted",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_options_QoLC_Reorder_Speak_tooltip": "The character mentions it rather than walking over to do nothing.",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_optionscreen_binding_Hotbar 10": "Hotbar 10",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_optionscreen_binding_Hotbar 11": "Hotbar 11",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_optionscreen_binding_Hotbar 12": "Hotbar 12",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_optionscreen_binding_Hotbar 13": "Hotbar 13",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_optionscreen_binding_Hotbar 14": "Hotbar 14",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_optionscreen_binding_Hotbar 15": "Hotbar 15",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_optionscreen_binding_Hotbar 16": "Hotbar 16",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_optionscreen_binding_Hotbar 9": "Hotbar 9",
  "translate_en|mods/QoLCompendium/42/media/lua/shared/Translate/EN/UI.json|UI_optionscreen_binding_[QoLC Extra Hotbar]": "QoL Compendium - Extra Hotbar"
}
