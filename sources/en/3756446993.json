  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB": "Mr. Brollow's Skyblock",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_CobbleRewardMaxSeconds": "Cobblestone Generator: Max Seconds Per Reward",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_CobbleRewardMaxSeconds_tooltip": "Maximum seconds of mining between cobblestone generator rewards.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_CobbleRewardMinSeconds": "Cobblestone Generator: Min Seconds Per Reward",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_CobbleRewardMinSeconds_tooltip": "Minimum seconds of mining between cobblestone generator rewards.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_CropGrowthSpeed": "Crop Growth Speed",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_CropGrowthSpeed_tooltip": "Multiplier on farm crop growth (Skyblock uses its own crop timing of 11-18 hours per stage; the vanilla Farming speed setting does not apply). 2.0 = crops grow twice as fast, 0.5 = half speed.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_DespawnDistance": "Zombie Despawn Distance (tiles)",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_DespawnDistance_tooltip": "Zombies farther than this from every player slowly despawn (Minecraft's 128-block rule). On the Skyblock map 128 covers nearly everything, so this only matters if players cluster far away for a long time. 0 = never despawn.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_GrassRegrowDays": "Grass Regrow Time (days)",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_GrassRegrowDays_tooltip": "In-game days before cut grass regrows.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_HostileCapPerPlayer": "Zombie Spawn: Cap Per Player",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_HostileCapPerPlayer_tooltip": "Minecraft-style population scaling: the total zombie cap is this number times the online player count (never exceeding Max Zombies). 0 = no per-player scaling, use Max Zombies only.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_MaxZombieCount": "Zombie Spawn: World Cap",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_MaxZombieCount_tooltip": "No new zombies spawn while this many are already in the world. 0 disables night spawning entirely.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnAttemptsPerPlayer": "Zombie Spawn: Attempts Per Cycle",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnAttemptsPerPlayer_tooltip": "How many spawn attempts each player generates per spawn cycle. Each attempt rolls the spawn chance independently and targets its own random zone, so higher values mean faster AND more spread-out spawning.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnChance": "Zombie Spawn: Chance Per Attempt (%%)",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnChance_tooltip": "Each spawn attempt only proceeds this percent of the time. Lower values mean fewer, less predictable spawn waves (and fewer performance hitches at nightfall). 100 = every attempt spawns, 0 = never.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnCycleSeconds": "Zombie Spawn: Cycle Length (REAL seconds)",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnCycleSeconds_tooltip": "How often the spawner runs, in REAL-WORLD seconds (not in-game time). 30 = a spawn wave every 30 real seconds. Lower = more frequent waves. Minimum 5.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnDriver": "Zombie Spawn: Driver",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnDriverValues_option1": "Time of Day",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnDriverValues_option2": "Darkness (Minecraft)",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnDriver_tooltip": "What triggers zombie spawning. Time of Day: spawns only during the configured night hours (dark tiles only). Darkness (Minecraft): no clock at all — anywhere dark enough can spawn at any hour, including unlit interiors at noon. Light your base!",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnLightThreshold": "Zombie Spawn: Darkness Threshold",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnLightThreshold_tooltip": "Zombies only spawn on tiles at or below this light level (0.0 = pitch black required, 1.0 = spawns even in full light). Checked per-tile and as a 4-tile-radius area average.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnNightEndHour": "Zombie Spawn: Night Ends (hour)",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnNightEndHour_tooltip": "Time of Day driver only: the hour spawning stops (24h clock, default 6 = 6 AM).",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnNightStartHour": "Zombie Spawn: Night Starts (hour)",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpawnNightStartHour_tooltip": "Time of Day driver only: the hour spawning begins (24h clock, default 20 = 8 PM).",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpecialZombieOneIn": "Zombie Spawn: Special Zombie Rarity (1 in N)",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_SpecialZombieOneIn_tooltip": "Chance for a spawned zombie to be a rare military, survivor, looter or ghillie zombie instead of a civilian. 150 = roughly 1 in 150. Higher = rarer. Set 0 to disable them entirely.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_TreeGrowthSpeed": "Tree Growth Speed",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_TreeGrowthSpeed_tooltip": "Multiplier for tree growth. 2.0 = trees grow twice as fast, 0.5 = half speed.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_VoidGraceSeconds": "Void: Grace Period (seconds)",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_VoidGraceSeconds_tooltip": "How long a living player can stand at void level before the void kills them. Fall-damage deaths resolve naturally first; this only applies to survivors. Staff (any access level above None) are always exempt. 0 = instant.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_ZombieMaxSpawnDistance": "Zombie Spawn: Max Distance (tiles)",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_ZombieMaxSpawnDistance_tooltip": "Zombies never spawn farther than this many tiles from a player.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_ZombieMinSpawnDistance": "Zombie Spawn: Min Distance (tiles)",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_ZombieMinSpawnDistance_tooltip": "Zombies never spawn closer than this many tiles from a player on the same floor level. Spawns one level above use half this distance.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_ZombiesPerSpawnMax": "Zombies Per Spawn: Max",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_ZombiesPerSpawnMax_tooltip": "Maximum zombies per spawn wave.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_ZombiesPerSpawnMin": "Zombies Per Spawn: Min",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_ZombiesPerSpawnMin_tooltip": "Minimum zombies per spawn wave.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_ZoneZombieCap": "Zombie Spawn: Max Per Zone",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_MBSB_ZoneZombieCap_tooltip": "The world is divided into 16x16-tile zones; each zone holds at most this many zombies. Spawning skips full zones, so zombies spread out and torch-lit zones stay clear.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud": "Minecraft HUD",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_AllowClientOverrides": "Allow client Mod Options",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_AllowClientOverrides_tooltip": "ON: each player can change HUD visibility toggles in Esc > Options > Mods. OFF: everyone uses the sandbox values below (server-wide).",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_Enabled": "Enable Minecraft HUD",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_Enabled_tooltip": "Master switch. OFF replaces the Minecraft-style HUD with the vanilla Project Zomboid hotbar for everyone.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_HudSize": "HUD size (%%)",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_HudSize_tooltip": "On-screen size of the Minecraft HUD as a percentage. 100 = the original fixed size, 70 = default. Only used when client Mod Options are disabled.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_ShowArmor": "Show armor",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_ShowArmor_tooltip": "Server default / forced value for armor icons.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_ShowDurability": "Show durability bars",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_ShowDurability_tooltip": "Server default / forced value for item durability bars.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_ShowHealth": "Show health",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_ShowHealth_tooltip": "Server default / forced value for the heart row.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_ShowHunger": "Show hunger",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_ShowHunger_tooltip": "Server default / forced value for hunger icons.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_ShowStamina": "Show stamina bar",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_ShowStamina_tooltip": "Server default / forced value for the stamina bar.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_ShowThirst": "Show thirst",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_ShowThirst_tooltip": "Server default / forced value for thirst air-bubble icons.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_ShowXpOrbs": "XP orbs on kill",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_ShowXpOrbs_tooltip": "Server default / forced value for experience orb VFX when you kill zombies/players/animals.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_XpOrbSounds": "XP orb sounds",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkyblockMCHud_XpOrbSounds_tooltip": "Server default / forced value for absorb sounds when orbs are collected.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_CobblestoneGenerator": "Mine it for stone, ore and other materials",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_DirtGenerator": "Turns waste, water and worms into dirt",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_FishingPond": "Cast a line here to catch fish",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_FoodCellar": "Cool storage. Add salt to slow spoilage",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_Furnace": "Smelts iron, copper and steel ingots",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_GrassFloor": "A grass floor for a natural look",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_SkyblockArmory": "Craft protective gear and weapons",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_SkyblockForge": "For heating, shaping and forging metal",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_SkyblockGroundTorch": "A torch fixed to the ground",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_SkyblockLogStorage": "Stores logs, sticks and other tree loot",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_SkyblockLoom": "Process flax and weave cloth",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_SkyblockWorkbench": "A sturdy bench that unlocks more recipes",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_WallMountedTorch": "A torch mounted to the wall",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_WaterCollector": "Collects water when it rains",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_craft_Well": "A reliable source of clean water",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_BasementKey": "A key for a basement",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_BrollowsDigest": "A well-thumbed engineering digest. Reading it teaches you how to upgrade a Cobblestone Generator to Tier 2 - better ore yields, and the only way to get Copper Ore.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_CrudePickaxe": "A roughly-made pickaxe with a primitive head. Effective for breaking rocks and hard ground, though less durable than professionally made tools",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_FireTorch": "A burning torch that provides light in the darkness. Handle with care.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_Mulch": "Organic matter broken down into a soil-like material",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_PineNuts": "Raw pine nuts harvested from pine cones. Must be cooked before eating to avoid stomach upset. Rich in fats and proteins, these nutritious seeds become tastier when roasted",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_PlantFiber": "Fibrous strands extracted from plant materials",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_Resin": "Sticky tree resin that hardens over time. Can be used as a natural adhesive for crafting and repairs",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_RoastedPineNuts": "Roasted pine nuts with a pleasant, nutty flavor. Safe to eat and quite satisfying",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_StoneHacksawBlade": "A crude blade knapped from stone, suitable for use in a hacksaw frame. Less durable than metal blades",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_item_WormGrunter": "A wooden rod with a notched stick, used to create vibrations in the ground that lure worms to the surface. Great for gathering fishing bait without digging",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_Enabled": "Enable Minecraft HUD",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_Enabled_Tooltip": "Turn the Minecraft-style HUD on or off. When off you get the normal Project Zomboid hotbar.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_HudSize": "HUD size (%%)",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_HudSize_Tooltip": "Scale the Minecraft HUD up or down. 100 = original size, lower = smaller. Applies as soon as you accept the options.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_Name": "Minecraft HUD",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_ShowArmor": "Show armor",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_ShowArmor_Tooltip": "Show blocky survival-style armor icons above the health row.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_ShowDurability": "Show durability bars",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_ShowDurability_Tooltip": "Show durability below items that have a condition value.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_ShowHealth": "Show health",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_ShowHealth_Tooltip": "Show the heart row on the left side of the HUD.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_ShowHunger": "Show hunger",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_ShowHunger_Tooltip": "Show the hunger icons on the right side of the HUD.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_ShowStamina": "Show stamina bar",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_ShowStamina_Tooltip": "Show endurance in the experience bar position.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_ShowThirst": "Show thirst",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_ShowThirst_Tooltip": "Show blue air-bubble thirst icons above the hunger row.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_ShowXpOrbs": "XP orbs on kill",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_ShowXpOrbs_Tooltip": "When you kill a zombie, player, or animal, experience orbs scatter on the ground. Walk close to vacuum them in.",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_XpOrbSounds": "XP orb sounds",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_SkyblockMCHud_XpOrbSounds_Tooltip": "Play a pickup sound when an experience orb is absorbed (uses the game level-up sound unless a custom ogg is installed).",
  "translate_en|mods/Mr. Brollow's Skyblock/42.16/media/lua/shared/Translate/EN/UI.json|UI_prof_skyblock": "Skyblock Survivor - RECOMMENDED"
}
