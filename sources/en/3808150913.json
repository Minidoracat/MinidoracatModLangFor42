  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Recipes.json|HydeCoButcherFoxSquirrel": "Butcher Small Animal",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels": "HydeCo. Squirrels!",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels_DenTreeOdds": "Den trees: one in",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels_DenTreeOdds_tooltip": "About one grown tree in this many is a den. Oaks are dens twice as often, small ornamental trees half as often. Lower means more squirrels.",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels_PrepareToRemove": "Prepare to Remove Mod",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels_PrepareToRemove_tooltip": "Removing this mod from a game where a squirrel was out at the last save loses the other animals saved around it, your own included. In single player, save once with this version (sleep, or quit), after letting go of any you carry and it should be safe to remove. On a server, turn this on first: no squirrels or zombie squirrels come out and any that are out go home; let the server save, then remove the mod.",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels_SquirrelDens": "Squirrel den trees",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels_SquirrelDens_tooltip": "Squirrels live in some of the grown trees. In daylight they come down to forage, run back up when spooked, and go home at dusk. Felling a den tree turns out whoever is inside.",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels_SquirrelsNearPlayer": "Most squirrels out at once",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels_SquirrelsNearPlayer_tooltip": "How many den squirrels can be out foraging around each player at the same time (4 by default). Lower it to see fewer, raise it for more. 0 keeps them all in their dens.",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels_StunChance": "Stunned when their tree falls (%%)",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels_StunChance_tooltip": "The chance a squirrel inside a felled den tree lands stunned for a few seconds, long enough to grab it. The rest bolt for another den.",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels_ZombieScratchInfects": "Zombie squirrel scratches can infect",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels_ZombieScratchInfects_tooltip": "When on, a zombie squirrel's scratch can carry the zombie infection, like any scratch from a zombie. Off by default: in the game's own lore, animals do not carry it.",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels_ZombieSquirrels": "Zombie squirrels",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HydeCoSquirrels_ZombieSquirrels_tooltip": "Some den trees are rotten. At night a few zombie squirrels come out of them and chase anyone who comes close, scratching at the feet and shins; boots and trousers help. A dead squirrel left lying can get back up. Chop a rotten den down and the whole nest comes out after you.",
  "translate_en|mods/HydeCoSquirrels/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_HydeCoSquirrels_SquirrelSkull": "Light as a dry leaf."
}
