  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Feo": "Ugly",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_FibrosisPulmonar": "Pulmonary Fibrosis",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Flojo": "Lazy",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Gafe": "Jinxed",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Gato": "Catlike",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Hemorratico": "Hemorrhagic",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Herido": "Wounded",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_HuesosDeAcero": "Steel Bones",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Iluminado": "Enlightened",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Inmunodeficiencia": "Immunodeficiency",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Maleante": "Hoodlum",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_MandibulaDeAcero": "Jaw of Steel",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_ManoDeSanto": "Healing Hands",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_ManosSucias": "Dirty Hands",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_MenteSana": "Healthy Mind",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_MotorRoto": "Broken Engine",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Narcolepsia": "Narcolepsy",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_NeuralgiaCronica": "Chronic Neuralgia",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Obsesivo": "Obsessive",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Olfateador": "Sniffer",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_OsteogenesisFragil": "Brittle Bones",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Parasitos": "Parasites",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_PerdidoFeliz": "Happy Lost",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_PielDeOso": "Bear Skin",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Pocho": "Sickly",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_ProfetaCiego": "Blind Prophet",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_PulmonDeHierro": "Iron Lungs",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_RataCallejera": "Street Rat",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Recio": "Tough",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Refugiado": "Refugee",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Reparador": "Fixer",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_RugidoInterior": "Inner Roar",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_SangreVieja": "Old Blood",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_SinAlma": "Soulless",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Terminal": "Terminal",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Tranquilo": "Calm",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Viejo": "Old Timer",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Abuelita": "Your recipes and energy keep others alive, even on worst days.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Agrofitness": "Your active life made you strong and resilient. Physical effort doesn't scare you.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_ArritmiaCardiaca": "Risk of heart attack under high panic",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_CarneDura": "You endure pain and regain some stamina while suffering",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Chamanismo": "You master ancient knowledge: you hunt, gather, and use nature to your advantage.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Chatarrero": "Your life among scrap taught you to give new life to old metals.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_CicatrizNegra": "Pain lowers your panic: cold-blooded",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_CorazonMuerto": "Nearly immune to panic; stress greatly reduced",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Cuidador": "You have patience and a gentle hand to care for others and keep things tidy.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Desgraciado": "Your body's been beaten by life. Tired, weak, and unlucky.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Despojo": "Your health is fragile and your food rarely tastes good.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Desterrado": "Exile made you clumsy and distrustful. Moving unseen is hard for you.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Devoto": "You trust faith more than science. You walk with purpose—but clumsily.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Envidioso": "Envy clouds your judgment. You move awkwardly, consumed by comparison.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Epilepsia": "Random seizures may knock you unconscious",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Esmirriao": "Your weak body barely handles effort. Tools feel heavy in your hands.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Feo": "You're not pretty or subtle, but survival isn't about looks.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_FibrosisPulmonar": "Physical effort reduces health while running",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Flojo": "Gets tired sooner and recovers stamina more slowly",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Gafe": "If something can go wrong, it will—and usually with you.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Gato": "Recovers stamina faster and builds less fatigue while moving",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Hemorratico": "Bleeding is dangerous and drains health faster",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Herido": "You start wounded and bleeding (2 bandages in inventory)",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_HuesosDeAcero": "General toughness; recover from hits more easily",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Iluminado": "You are one with silence. No one notices you until it's too late.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Inmunodeficiencia": "Accelerated general decay; illnesses last longer",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Maleante": "The streets were your school. You can hotwire and break locks with ease.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_MandibulaDeAcero": "You've got a jaw like an anvil. Blows don't knock you down easily.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_ManoDeSanto": "Your hands are blessed: you heal wounds and find natural remedies with ease.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_ManosSucias": "Better performance in combat/repairs; less fatigue when attacking",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_MenteSana": "Your mind and body are in balance. You adapt quickly to chaos.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_MotorRoto": "Adrenaline in combat; more fatigue afterwards",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_Narcolepsia": "Sudden sleep at random moments",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_traitdesc_NeuralgiaCronica": "Sudden bursts of severe pain affect your performance",
