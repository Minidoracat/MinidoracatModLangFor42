  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_prof_Veterinario": "Veterinarian",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_prof_Vigilante": "Vigilante",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_prof_Yonki": "Junkie",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Antisistema": "Always against every rule.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Artista": "Had an audience once. Now has a knife.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Astronauta": "Sunburned, scorched, hardened. Unbreakable.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Barrendero": "Keeps the shelter clean and reuses everything.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Bioquimico": "Researches, cooks, documents, and fights if needed.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Brujo": "Doesn’t heal, but many believe he does.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Burocrata": "Delays everything—except his own benefit.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Buzo": "Enduring and driven.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Caballero": "Moral armor or real scrap—fights the same.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Callejero": "Knows shortcuts, hideouts, and useful scraps.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Camarografo": "Sees everything. Keeps evidence.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Camello": "Moves things quietly. Gets paid well.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Campesino": "Feet on the ground. Hands worn and ready.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Canibal": "Never wastes protein.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Carnicera": "Cuts with precision and no remorse.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Carnicero": "Cuts flesh, cleans bone. Knows a body’s worth.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Casero": "Cooks well, fixes the basics, and keeps the shelter running.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Cazador": "Follows tracks. Or invents his own.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Cazarecompensas": "Hunts for money. Kills for sport.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Chaman": "Mysterious and skilled, mixes intuition and precision to survive.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Chapucero": "Improvises fixes that sometimes work too well.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Chatarrero": "Turns trash into scrap—and profit.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Chorizo": "Always brings stuff.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Cirujano": "Cuts with precision. Or improvises.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Clinico": "Knows real medicine. And what hurts too.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Colgao": "Disconnected from everything—except instinct.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Contrabandista": "Smuggles things where no one else can.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Contratista": "Builds shelters on request… or for the mob.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Cultista": "Ancient healer. Or modern fraud.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Curandera": "Knows plants and heals with what she finds.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Desgraciado": "Life hit him hard. He hits back.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Desollador": "Knows how to remove skin—human or not.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Dictador": "He commands even though no one chose him. And he knows how to do it.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Donante": "Already gave all he could. Still useful.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Enterrador": "Knows how to dig, close cycles, and bury fears.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Esclavo": "Used to hard work—and never complaining.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Espia": "Watches and acts with caution.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Esquizofrenico": "Sees more than he should. Sometimes he’s right.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Estudiante": "Learns fast, full of energy and enthusiasm.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Experimento": "Result of tests. Survives despite everything.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Feriante": "Sells what he has—or what’s needed.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Filosofo": "Thinks too much. Sees what others miss.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Fontanero": "Born fixer. Finds leaks and patches them.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Forense": "Speaks with the dead. Learns from them.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Gallego": "Says he’s not Galician. Survives like one.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Garrapata": "Survives selling company. Knows things.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Gaucho": "Knife, mate, and silence. Deadly if disturbed.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Gitano": "Moves, trades, survives. Trusts no one.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Herrero": "Forges, repairs, hardens. Like steel.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Licenciado": "Lots of study. Little street. Learns fast anyway.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Lisiado": "Physically limited. Makes up for it with wit or rage.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Loco": "His mind is useful chaos.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Luchador": "One-on-one. Always head-on.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Machaca": "Used to run errands. Now cracks skulls.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Maestro": "Fixes almost anything with whatever’s at hand.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Mafioso": "Moves through shady deals and gets the impossible.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Malhecho": "Never was right. Now he uses it to his advantage.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Mandao": "Goes, returns, delivers. Never asks.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Maquinista": "Moves gears. And worse things.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Matero": "Always has mate tea. And patience to survive.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Militante": "Obeys orders, even when there aren’t any.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Ministro": "Finds resources even when there are none.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Mochilero": "Travels light. Lives with what fits on his back.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Motero": "Knows old routes. Some still work.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Motivado": "Wants to do everything and is always ready.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Narco": "Controls routes, resources, and wills.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Nomada": "Carries his home on his back. Never roots down.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Okupa": "Takes shelter where others see ruins.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Otaku": "Obsessive, reclusive, and surprisingly lethal.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Paramedico": "Runs, heals, and flees if necessary.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Paria": "Cast out everywhere. But never falls completely.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Payaso": "Laughs at chaos. Madness disarms or confuses.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Picapedrero": "Breaks rock, breaks fear, breaks path.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Pistolero": "Fast on the trigger. Accurate when it counts.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Politico": "The worst and the best of society.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Predicador": "Offers comfort… or judgment.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Princesa": "Delicate—or so everyone thought.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Principe": "Raised to lead. Not to fight.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Recolector": "Searches for fruit, roots, or human remains.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Reina": "Elegance among ruins. Sharp mind.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Repartidor": "Knows every route and delivers without questions.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Rey": "Thinks he has the right to rule. Sometimes it works.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Saboteador": "Breaks more than he fixes.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Sastrecillo": "Mends clothes—and sometimes people.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Savandija": "Fast, slippery, and shameless.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Senador": "Talks a lot. But survives with privileges.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Sindicalista": "Organizes, shouts, and eats first.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Solitario": "Prefers silence, but calm keeps him alive.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Tarado": "Not right in the head. But no one dares touch him.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Tartamudo": "Struggles to speak. Acts fast.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Taxidermista": "Meticulous handyman who gives new life to discarded things.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Taxista": "Drives anything that still works. Knows all shortcuts.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Tecnochaman": "Understands old machines and brings them back to life.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Torero": "Masters beasts. Sometimes zombies too.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Trafica": "Gets what’s unavailable. At a price.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Traidor": "Helps you. Then sells you out.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Trapero": "Collects what no one wants. Lives off it.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Trilero": "Always has something to offer. Or to trade.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Troglodita": "Doesn’t talk. Hits.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Vago": "Avoids effort whenever possible—but still survives.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Veterinario": "Heals raccoons or humans alike.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Vigilante": "Delivers justice without permission.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_profdesc_Yonki": "Seeks his dose. Finds useful stuff instead.",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Abuelita": "Grandma",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Agrofitness": "Rural Fitness",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_ArritmiaCardiaca": "Cardiac Arrhythmia",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_CarneDura": "Tough Flesh",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Chamanismo": "Shamanism",
