  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Envidioso": "Jealous",
  "translate_en|mods/NEWProfessionsandTraitsB42/42/media/lua/shared/Translate/EN/UI.json|UI_trait_Epilepsia": "Epilepsy",
