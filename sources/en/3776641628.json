  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_SkillJournal_WrittenAfter": "%1 hours survived at the time",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/ItemName.json|Base.SkillJournalBook": "Empty Journal",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Recipes.json|BindSkillJournal": "Bind Skill Journal",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournal": "Skill Journal",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalMatchReaderLearningRate": "Pay out XP at the reader's own learning rate",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalMatchReaderLearningRate_tooltip": "A skill boost from a profession or trait makes that skill level several times faster, and with no boost at all a skill levels at quarter rate. With this on, XP written down under one character's boosts is converted to what the reader would have had to earn themselves, so a boosted character cannot farm a skill, die, and hand the full total to a character who never paid for the boost. It works both ways: a reader with a bigger boost than the writer gets more XP out of the same page than was written down, and keeps their own profession's free levels on top. Off pays exactly what was written.",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalOneReadPerEntry": "Each entry can be recovered once per character",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalOneReadPerEntry_tooltip": "A journal entry pays out once for any given character. Turn this off to let the same entry be read again -- it still only ever hands back the gap between what you have and what was written.",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalRecoverExerciseRegularity": "Recover exercise regularity",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalRecoverExerciseRegularity_tooltip": "The journal restores how regularly each exercise was being kept up, so a new character does not start their fitness routine from cold. Never lowers what the reader already keeps up. Ignored while physical skills are left out of the journal.",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalRecoverFishRecords": "Recover fishing records",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalRecoverFishRecords_tooltip": "The fish log you open by right-clicking water only lists species you have caught yourself, and death empties it. The journal writes down which species were logged and fills them back in. It hands back the record, never the fish: what the log shows about each species still depends on your Fishing level.",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalRecoverKills": "Recover zombie kill count",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalRecoverKills_tooltip": "The journal restores the kill count it recorded. Never lowers your current count.",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalRecoverRecipes": "Recover learned recipes",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalRecoverRecipes_tooltip": "The journal restores recipes you had learned when you wrote in it.",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalRecoverSkillBookProgress": "Recover skill book progress",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalRecoverSkillBookProgress_tooltip": "Skill books do two things. They give a temporary XP boost while you are inside the level band the book teaches, and they stay marked as read once you finish them. On, the journal gives both back, so you do not have to find and read those books again, and a boost that was still running returns at the value it had. Off, the journal leaves skill books alone, so a book covering a band you are still inside has to be read again to get its boost back. This setting never affects the XP you recover. Your skills come back at the levels written on the page either way, however fast they were earned.",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalRecoverWeight": "Recover body weight",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalRecoverWeight_tooltip": "The journal records what the author weighed and sets the reader to that figure. Unlike everything else in the journal this is not a floor -- weight is a state rather than progress, so a reader heavier than the page says comes down to it just as a lighter one goes up. Held inside the range the game itself allows, 30 to 130.",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalRecoveryPercentage": "Skill recovery percentage",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalRecoveryPercentage_tooltip": "How much of the gap between your current XP and the XP written in the journal is recovered. 100 restores you fully to what was written. 0 disables skill recovery.",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalSkipPhysical": "Never record physical skills",
  "translate_en|mods/SkillJournal/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_SkillJournalSkipPhysical_tooltip": "Fitness, Strength and the agility skills (Sprinting, Lightfooted, Nimble, Sneaking) are left out of the journal entirely. Your next character builds their body back themselves; only what they learned carries over."
}
