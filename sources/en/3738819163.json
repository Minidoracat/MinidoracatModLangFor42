  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AirdropMod_AirdropDynamicWeaponsMelee": "Dynamic pool: melee weapons",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AirdropMod_AirdropDynamicWeaponsMelee_tooltip": "Enables axes, blunt weapons, blades and spears in the dynamic pool.",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AirdropMod_AirdropDynamicWeaponsPistols": "Dynamic pool: pistols and revolvers",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AirdropMod_AirdropDynamicWeaponsPistols_tooltip": "Enables the pistol class of the dynamic pool.",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_AirdropMod_AirdropDynamicWeaponsRifles": "Dynamic pool: rifles and long guns",
