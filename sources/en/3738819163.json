  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDeadBodyMax": "Maximum decorative bodies",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDeadBodyMax_tooltip": "Maximum number of dead bodies created near the airdrop when decorations are enabled.",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDeadBodyMin": "Minimum decorative bodies",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDeadBodyMin_tooltip": "Minimum number of dead bodies created near the airdrop when decorations are enabled.",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponAmmo": "Dynamic pool: add ammo with firearms",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponAmmo_tooltip": "Each dynamic firearm comes with a box of its rounds, or a magazine/loose rounds when no box exists (mod ammo).",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponMinDamage": "Dynamic pool: minimum melee damage",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponMinDamage_tooltip": "Melee weapons with MaxDamage below this value are left out (pens, forks and similar junk). Firearms ignore it.",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponWeight": "Dynamic pool weight",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponWeight_tooltip": "Total weight of the dynamic pool compared to the fixed loot tables (the Military table sums about 24). Each enabled class shares this weight equally, and inside a class every weapon has the same chance, so a mod with many rifles does not drown the rest. Multiplied by the loot level (0.15 / 0.8 / 1.6 / 3.2).",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeapons": "Dynamic weapon pool (all weapons, incl. mods)",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponsIncludeMods": "Dynamic pool: include mod weapons",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponsIncludeMods_tooltip": "When disabled only vanilla (Base) weapons enter the dynamic pool.",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponsIncludeTools": "Dynamic pool: include strong tools and crafted weapons",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponsIncludeTools_tooltip": "Includes items the game files as ToolWeapon, GardeningWeapon, SportsWeapon or WeaponCrafted when their MaxDamage is at least 1.5: axes, sledgehammer, machete, barbell, spiked bats... Hammers, screwdrivers and other light tools never enter the pool.",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponsMelee": "Dynamic pool: melee weapons",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponsMelee_tooltip": "Enables axes, blunt weapons, blades and spears in the dynamic pool.",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponsPistols": "Dynamic pool: pistols and revolvers",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponsPistols_tooltip": "Enables the pistol class of the dynamic pool.",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponsRifles": "Dynamic pool: rifles and long guns",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponsRifles_tooltip": "Enables the rifle class (long range or heavy firearms, including SMGs from mods).",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponsShotguns": "Dynamic pool: shotguns",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeaponsShotguns_tooltip": "Enables the shotgun class (any firearm using shells).",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropDynamicWeapons_tooltip": "Adds every weapon registered in the game, from vanilla or any loaded mod, to the airdrop roll, grouped by category (pistols, rifles, shotguns, axes, blunt, blades, spears). Firearms come with matching ammo when enabled below.",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropFixedPointSearchRadius": "Mode 2 search radius",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropFixedPointSearchRadius_tooltip": "Radius, in tiles, used around each fixed point to find a loaded valid square if the exact point is not valid.",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropIntervalHours": "Event interval",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropIntervalHours_tooltip": "Real server hours between automatic attempts to create an airdrop.",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropLifetimeMinutes": "Airdrop duration",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropLifetimeMinutes_tooltip": "Real minutes before the server removes the container, timer and marker.",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropLocationMaxAttempts": "Location search attempts",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropLocationMaxAttempts_tooltip": "Maximum number of candidate points tested around the player before canceling the spawn attempt.",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropLootDifficultyMultiplier": "Loot multiplier",
  "translate_en|mods/AirdropMod/42/media/lua/shared/Translate/EN/Sandbox_EN.txt|Sandbox_AirdropMod_AirdropLootDifficultyMultiplier_tooltip": "Multiplies the world-difficulty adjustment applied to airdrop loot.",
