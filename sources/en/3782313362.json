  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsMultiContainerInv": "Show all backpacks (Player)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsMultiContainerInv_Tooltip": "When enabled (default), all open backpacks are rendered in the player inventory grid. Disable to render only the selected container (better performance).",
