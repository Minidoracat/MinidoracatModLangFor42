  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsAutoSearch": "Auto-Search Target Container",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsAutoSearch_Tooltip": "Automatically initiates search when you view a container with unsearched items.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsCloseOnEsc": "Close inventory panels with ESC",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsCloseOnEsc_Tooltip": "When enabled (default), pressing ESC closes the inventory, loot and PaperDoll panels instead of opening the main menu. Disable to restore the vanilla behavior (ESC always opens the main menu).",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsFullscreenPanel": "Fullscreen Panel",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsFullscreenPanel_Tooltip": "When enabled (default), the inventory panel fills half of the screen and cannot be moved or resized. Disable to restore the native movable and resizable panel. NOTE: if you disable it with a save already loaded, you must restart the game (reload the save) for the windows to become resizable again.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsGradientFast": "Fast gradient (lower quality)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsGradientFast_Tooltip": "Draws the item footprint gradient with fewer color bands (6 instead of 12), halving the gradient draw calls per item per frame. The gradient looks chunkier but the render is faster.\n\nOff (default): smooth 12-band gradient.\n\nThis is a per-machine visual setting; each player chooses their own.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsJoypadAnalogSpeed": "Gamepad analog stick speed",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsJoypadAnalogSpeed_Tooltip": "Speed at which the virtual cursor moves when using the analog stick (0 to 100, 50 is the default). The harder you push the stick, the faster the cursor moves. Does not affect the D-pad.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsJoypadCursorMode": "Gamepad cursor movement",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsJoypadCursorMode_Cell": "Cell by cell",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsJoypadCursorMode_Snap": "Snap to items (default)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsJoypadCursorMode_Tooltip": "How the virtual cursor moves with the gamepad D-pad/analog stick in the grids. 'Snap to items' (default) jumps directly from item to item (Tarkov style). 'Cell by cell' moves one grid cell at a time, including empty cells.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierAlt": "Alt + Click Action",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierAlt_Tooltip": "What happens when you hold Alt and click an item.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierCtrl": "Ctrl + Click Action",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierCtrl_Tooltip": "What happens when you hold Ctrl and click an item.",
