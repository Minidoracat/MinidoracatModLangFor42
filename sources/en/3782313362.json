  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_ModAction_QuickTransfer": "Quick Transfer",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_ModAction_StackPicker": "Open Stack Picker",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_ModAction_TakeOne": "Take One (Split 1x)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsAutoSearch": "Auto-Search Target Container",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsAutoSearch_Tooltip": "Automatically initiates search when you view a container with unsearched items.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsCloseOnEsc": "Close inventory panels with ESC",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsCloseOnEsc_Tooltip": "When enabled (default), pressing ESC closes the inventory, loot and PaperDoll panels instead of opening the main menu. Disable to restore the vanilla behavior (ESC always opens the main menu).",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsContainerButtonSize": "Container Button Size (Loot Icons)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsContainerButtonSize_Tooltip": "Sets the size of container and backpack buttons on the sidebar of the inventory and loot window. Supports enlarged sizes (XL and 2XL) tailored for 1440p and 4K displays.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsFloatingAutoClose": "Auto-close bag windows when far",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsFloatingAutoClose_Tooltip": "Closes a floating bag window when you walk away from where the bag is: on the floor, inside a crate or on a corpse.\n\nBags you carry never close. Pinned windows close too.\n\nOff: windows stay open until you close them.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsFullscreenPanel": "Fullscreen Panel",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsFullscreenPanel_Tooltip": "When enabled (default), the inventory panel fills half of the screen and cannot be moved or resized. Disable to restore the native movable and resizable panel. NOTE: if you disable it with a save already loaded, you must restart the game (reload the save) for the windows to become resizable again.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsGradientFast": "Fast gradient (lower quality)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsGradientFast_Tooltip": "Draws the item footprint gradient with fewer color bands (6 instead of 12), halving the gradient draw calls per item per frame. The gradient looks chunkier but the render is faster.\n\nOff (default): smooth 12-band gradient.\n\nThis is a per-machine visual setting; each player chooses their own.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsHoldToPeek": "Hold to Peek (Tap to Toggle)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsHoldToPeek_Tooltip": "Hold inventory key to peek quickly and release to close. Tap once to keep open.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsIconRotation": "Rotate/Scale Item Sprites",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsIconRotation_Tooltip": "Draws item sprites with the rotation, scale and anchor tuned for the mod, so tools, clothes and bottles sit nicely in their cells.\n\nOn (default): tuned sprites.\n\nOff: plain sprites, only the footprint size applies. Slightly faster to render.\n\nThis is a per-machine visual setting; each player chooses their own.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsItemInfo": "Item info",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsItemInfo_Tooltip": "Shows extra info inside each item: the ammo count of magazines.\n\nOff: items show only their icon, as before.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsItemWeight": "Item weight",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsItemWeight_Tooltip": "Shows each item's weight in its top-right corner; for a pile, the total of the pile.\n\nNeeds Item info on. Turn off for slightly faster rendering.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsJoypadAnalogSpeed": "Gamepad analog stick speed",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsJoypadAnalogSpeed_Tooltip": "Speed at which the virtual cursor moves when using the analog stick (0 to 100, 50 is the default). The harder you push the stick, the faster the cursor moves. Does not affect the D-pad.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsMaxMultiLoot": "Max World Containers (Multi-Loot)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsMaxMultiLoot_Tooltip": "Limits how many nearby containers/corpses are loaded simultaneously in the loot window to prevent lag when standing over hordes. The selected container is always guaranteed to be shown.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierAlt": "Alt + Click Action",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierAlt_Tooltip": "What happens when you hold Alt and click an item.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierCtrl": "Ctrl + Click Action",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierCtrl_Tooltip": "What happens when you hold Ctrl and click an item.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierRightAlt": "Alt + Right Click",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierRightAlt_Tooltip": "Action performed when right clicking an item while holding Alt.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierRightCtrl": "Ctrl + Right Click",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierRightCtrl_Tooltip": "Action performed when right clicking an item while holding Ctrl.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierRightShift": "Shift + Right Click",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierRightShift_Tooltip": "Action performed when right clicking an item while holding Shift.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierShift": "Shift + Click Action",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsModifierShift_Tooltip": "What happens when you hold Shift and click an item.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsMultiContainerInv": "Show all backpacks (Player)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsMultiContainerInv_Tooltip": "When enabled (default), all open backpacks are rendered in the player inventory grid. Disable to render only the selected container (better performance).",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsMultiContainerLoot": "Show all loot containers",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsMultiContainerLoot_Tooltip": "When enabled (default), all loot containers on screen are rendered. Disable to render only the active container (better performance).",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsMultiLootCorpsesOnly": "Multi-container only for corpses",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsMultiLootCorpsesOnly_Tooltip": "Shows several containers at once only for corpses. Crates, shelves, fridges and the floor show just the one you selected.\n\nThe 'Max World Containers' limit still applies to the corpses. Better performance in bases full of containers.\n\nNeeds 'Show all loot containers' on.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsPanelOpacity": "Background Opacity",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsPanelOpacity_Tooltip": "Adjust the opacity of the inventory backgrounds.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsPaperDollLeft": "Show PaperDoll on Left",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsPaperDollLeft_Tooltip": "When enabled, the PaperDoll (equipment) panel is shown on the left side of the player inventory instead of the right. The inventory grid shifts to the right to make room.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsRotateKey": "Rotate Dragged Item (Default: R)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsRotateKey_Tooltip": "Shortcut key to rotate items while dragging. Right click also rotates.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsScrollBehavior": "Scroll Outside Grids",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsScrollBehavior_Tooltip": "Choose what happens when scrolling the mouse wheel outside item grids. 'Standard Scroll' scrolls the inventory window up and down. 'Switch Container' cycles through open containers.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsSection": "Grid Inventory",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsSolidFootprint": "Solid Footprints (Performance)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsSolidFootprint_Tooltip": "Renders a solid color instead of a gradient, massively improving FPS.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsTextShadow": "Text shadow",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsTextShadow_Tooltip": "Draws a dark shadow under the small texts inside items (weight, ammo, stack count) so they read better over bright sprites.\n\nOff (default): plain text. On: each text is drawn twice, which costs some FPS.\n\nThis is a per-machine visual setting.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsToggleInvKey": "Toggle Inventory (Recommended: TAB)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsToggleInvKey_Tooltip": "Shortcut to open, close, and peek into your inventory. We recommend setting this to TAB for quick peeking with WASD without searching through the game's keybindings.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsTopBar": "Search / filter bar",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsTopBar_Tooltip": "Reserves a bar above the inventory and loot grids for search, category filter and auto-sort.\n\nOff: the grids use the full height, as before.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsUiScale": "UI Scale",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsUiScale_Tooltip": "Scales the size of the inventory grids (cells, items, headers). 100 is the default (full size). Increase it on high-resolution (e.g. 4K) displays to make the interface bigger and easier to read. Applies to open panels immediately after clicking OK.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OverflowPenalty": "Overflow full: you cannot sprint",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OverflowTitle": "Overflow",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_ScrollBehavior_Cycle": "Switch Container",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_ScrollBehavior_Native": "Standard Scroll (Default)",
