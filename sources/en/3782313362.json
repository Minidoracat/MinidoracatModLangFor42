  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsPanelOpacity": "Background Opacity",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsPanelOpacity_Tooltip": "Adjust the opacity of the inventory backgrounds.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsPaperDollLeft": "Show PaperDoll on Left",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsPaperDollLeft_Tooltip": "When enabled, the PaperDoll (equipment) panel is shown on the left side of the player inventory instead of the right. The inventory grid shifts to the right to make room.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsSection": "Grid Inventory",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsSolidFootprint": "Solid Footprints (Performance)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsSolidFootprint_Tooltip": "Renders a solid color instead of a gradient, massively improving FPS.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsUiScale": "UI Scale",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_GridInv_OptionsUiScale_Tooltip": "Scales the size of the inventory grids (cells, items, headers). 100 is the default (full size). Increase it on high-resolution (e.g. 4K) displays to make the interface bigger and easier to read. Applies to open panels immediately after clicking OK.",
