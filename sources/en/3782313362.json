  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/IG_UI.json|IGUI_Unequip": "Unequip",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory": "GridInventory",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_ContainerBonusRows": "Extra Container Rows",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_ContainerBonusRows_tooltip": "Adds extra rows vertically to all world containers and subgrids (drawers, shelves, compartments). Width (columns) remains intact to preserve proper layout proportions.\n\n0 (default) keeps the mod's calibrated layouts.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_EnableDevTools": "Enable DevTools",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_EnableDevTools_tooltip": "Adds the \"[DevTool] Edit Grid Size\" option to the item context menu, so you can resize item footprints and container grids without launching the game with -debug.\n\nOn: DevTools available in this save. In multiplayer, non-admin players can see the option but the server rejects applying changes.\n\nOff: only available when the game is started with -debug.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_IgnoreCarryWeight": "Ignore Carry Weight (single player)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_IgnoreCarryWeight_tooltip": "Single player only. Containers stop checking weight capacity: only grid space limits what fits, like in Inventory Tetris. A bag with free slots accepts an item of any weight. Off by default. Has no effect in multiplayer (the server validates weight).",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_InventoryPlayerHeight": "Player inventory height",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_InventoryPlayerHeight_tooltip": "Height (rows) of the player's main inventory grid. Fixed value (default 4). The DevTool grid override for the player inventory can override this.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_InventoryPlayerWidth": "Player inventory width",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_InventoryPlayerWidth_tooltip": "Width (columns) of the player's main inventory grid. Fixed value (default 3). The DevTool grid override for the player inventory can override this.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_MaxContainerGridSize": "Max container grid size",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_MaxContainerGridSize_tooltip": "Maximum number of rows for world container grids. Grids are sized by capacity up to this cap. The DevTool grid override can exceed this cap for specific containers.\n\nDefault 15 keeps the classic behavior.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_OverflowGraceMs": "Overflow Grace Time (ms)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_OverflowGraceMs_tooltip": "Classic mode only. How long (in milliseconds, with no action running) an item can stay in the overflow before the auto-drop moves it. Gives time for chained actions such as crafting. 0 = move immediately.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_OverflowMode": "Overflow Behavior",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_OverflowMode_option1": "Classic (grace time, then auto-drop)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_OverflowMode_option2": "Strict (refuse items that do not fit)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_OverflowMode_option3": "Keep (overflow stays, no sprint)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_OverflowMode_tooltip": "What happens to items that do not fit in your inventory grid.\n\nClassic: they wait in a red overflow list, then are moved to another bag or dropped on the floor after a short grace time. The context menu works on overflow items.\n\nStrict (hardcore): there is no overflow. Items that do not fit are refused before the transfer starts; anything that still gets in (crafting results, unequipped gear) is dropped on the floor at once. No context menu on overflow items.\n\nKeep (medium): the overflow list is never cleared automatically. No context menu, and you cannot sprint while there are items in the overflow.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_ReorderMoveWhileWalking": "Move while organizing",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_ReorderMoveWhileWalking_tooltip": "Allows the character to walk while the item reorder action is running (running still cancels it).\n\nOn: you can walk while items reorganize, like many other timed actions.\n\nOff: the action only runs while standing still.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_ReorderTimeAction": "Item Reorder Animation",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_ReorderTimeAction_option1": "Animated",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_ReorderTimeAction_option2": "Instant",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_ReorderTimeAction_tooltip": "Moves items within the same container with a short transfer animation.\n\nAnimated: the character does the transfer animation and the move is applied ~0.5s later. In multiplayer this gives the server time to process before the next move.\n\nInstant: items move immediately on drop, like before.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_ScatterMode": "Scatter Mode",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_ScatterMode_option1": "Automatic (natural loot)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_ScatterMode_option2": "Always scatter (messy)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_ScatterMode_option3": "Never scatter (neat)",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_ScatterMode_tooltip": "How items without a saved position are placed in containers.\n\nAutomatic (natural loot): only containers that were never looted get a natural random layout; the player inventory and explored containers fill organized.\n\nAlways scatter (messy): items land scattered everywhere, including your own inventory. Quick transfers get messy; precise drag & drop with x,y keeps things organized.\n\nNever scatter (neat): everything auto-fills from the top-left, never random.",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_SearchTimePerItem": "Search time per item",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_SearchTimePerItem_tooltip": "Time in milliseconds to reveal each stack while searching a container. Scales with the number of stacks: more items, longer search.\n\n0 = instant (reveals everything on click).",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_SearchWorldContainers": "Search world containers",
  "translate_en|mods/GridInventory/42.20/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_GridInventory_SearchWorldContainers_tooltip": "Makes world containers (crates, shelves, corpses...) need to be searched before you can interact with the items inside, like Tarkov.\n\nWhen on, opening a container hides unidentified items behind a dark mask. Click the grid to start searching: items are revealed one stack at a time. You can stop anytime and keep what you already found; click again to resume. Items you put in yourself are revealed immediately.\n\nOff: containers always show their contents."
}
