  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_BaguaMirror": "Special: collect moonlight at night and spend it to attack. Requires nighttime collection first.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_BaijiangAppearance": "Zombie-exclusive resource. Players must not use it.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_Coffin": "Something powerful seems to be sleeping inside.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_CoinSword": "Special: focus with the Bagua Mirror to release the sword effect. Requires Taoist Sword Arts and a Bagua Mirror.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_FeijiangAppearance": "Zombie-exclusive resource. Players must not use it.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_FuluTalisman": "Function: seals zombies struck by it. Requires worn use against a zombie; Taoist feature.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_FuluTalismanHeld": "Function: cast the sealing talisman while held. Requires seal mode and a zombie hit.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_GhostBrideAppearance": "Zombie-exclusive resource. Players must not use it.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_GhostJar": "Stores one downed ordinary zombie while you are standing over it.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_HeijiangAppearance": "Zombie-exclusive resource. Players must not use it.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_IncenseAltar": "An altar for inviting a deity. After comprehending the art, use a placed altar to invoke this Celestial Master rite.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_MaoshanAmulet": "When worn, releases a protective blast if a zombie gets too close. 20-second cooldown.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_MaoshanSecretBook": "Left by a master named Lin; it can break your cultivation through one rank.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_MilletJar": "Function: cure infection or scatter rice as a floor trap. Requires Taoist use; cure once every 3 hours.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_Modou": "Function: place an ink line that heavily damages zombies on contact. Requires left-hand use; each line has durability.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_PeachWoodSword": "Special: paint with blood to empower attacks and release sword qi. Requires Taoist Sword Arts and full health.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_ProtectiveTalisman": "While carried, restores injuries and health below 20 without clearing infection.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_QixingSword": "Special: enable magic to release crossed sword qi on swings. Requires Taoist Sword Arts.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_RitualGourd": "Absorbs ten zombie corpses, then transforms them into a healing elixir.",
  "translate_en|mods/末日镇尸录/42/media/lua/shared/Translate/EN/Tooltip.json|Tooltip_TalesOfTaoistExorcism_RitualGourdFilled": "Drink once to heal all wounds and purge the zombie infection.",
