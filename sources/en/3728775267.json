  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_DriftMinSpeed_tooltip": "Below this speed the drift key is ignored, so parking doesn't slide.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_DriftRotation": "Drift rotation force",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_DriftRotation_tooltip": "Strength of the rotation pushed into the car while drifting + steering. Raise if it slides wide, lower if it spins out.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_DriftSteer": "Drift steering gain",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_DriftSteer_tooltip": "How much sharper the front wheels respond while a drift is held.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_Drift_tooltip": "Hold the drift key while cornering at speed to break the rear loose for an arcade-style slide. Bind the key in Mod Options.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_DriverHUD": "Vehicle info panel",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_DriverHUD_tooltip": "Adds a Better Vehicle Dynamics panel docked beside the vehicle mechanics window, showing the active tuning profile and grip settings (the values vanilla does not display).",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_EnginePower": "Engine output",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_EnginePower_tooltip": "Scales how much pulling force every engine makes. Below 1 feels gutless; above 1 makes hills and ramming trivial.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_GripLevel": "Tire grip",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_GripLevel_tooltip": "Overall traction budget. Lower means the car steps out and spins up more readily.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_KeylessTow": "Tow without keys",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_KeylessTow_tooltip": "When off, easy-tow needs keys in the ignition or the parking brake released.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_LoadAffectsFuel": "Load affects fuel use",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_LoadAffectsFuel_tooltip": "Carrying a heavy load burns extra fuel while driving.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_LoadAffectsHandling": "Load affects handling",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_LoadAffectsHandling_tooltip": "A heavily loaded vehicle is slow to pull away from a stop, as if the engine is straining against the weight.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_LoadMaxPenalty": "Max launch penalty when fully loaded",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_LoadMaxPenalty_tooltip": "Biggest drop in launch force for a fully loaded vehicle (0.50 = up to 50 percent less force from a stop). Fades out as the vehicle speeds up. Requires 'Load affects handling'.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_LowSpeedGrunt": "Crawl-speed shove",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_LowSpeedGrunt_tooltip": "Extra pulling force available at very low wheel speed — the force used to push wrecks and shove through crowds. Lower it for a weaker, more cautious low-end.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_Mode": "Tuning preset",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_Mode_option1": "Custom",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_Mode_option2": "Relaxed",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_Mode_option3": "Grounded",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_Mode_option4": "Punishing",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_Mode_tooltip": "Custom keeps every slider below as you set it. The other presets snap drivetrain, grip and shove values to a curated profile when the world loads.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_OffroadFloor": "Off-road grip floor",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_OffroadFloor_tooltip": "Minimum off-road grip multiplier any tire family can fall to. Without this, sports-tire profiles can drop off-road grip so low a high-HP car barely moves on grass. Default 0.55 keeps brute-force motion possible (the car will slip and chew tires, but it moves).",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_OffroadGrip": "Grip off-road",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_OffroadGrip_tooltip": "Off-road grip strength. HIGHER = more grip (less tire slip) on dirt, grass and gravel. Default 0.85 = moderate slip; 1.5 = near-paved feel. Does not change rolling drag - tune that via Rolling drag off-road.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_RealismHPWeight": "Reference power & weight",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_RealismHPWeight_tooltip": "Replaces engine force and mass for the covered vanilla vehicles with Better Vehicle Dynamics' own researched reference figures (see BVD_VehicleData.lua; modded vehicles can register their own via the public API).",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_ReverseTopSpeed": "Reverse speed cap (km/h)",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_ReverseTopSpeed_tooltip": "Hard ceiling on reverse speed.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_RollResistance": "Rolling drag (road)",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_RollResistanceOffroad": "Rolling drag (off-road)",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_RollResistanceOffroad_tooltip": "Extra rolling resistance when off sealed road.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_RollResistance_tooltip": "Resistance from tires on sealed surfaces. Affects coasting and steady-state speed.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_ShoveCorpses": "Corpse shove",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_ShoveCorpses_tooltip": "Force imparted to bodies and gibs on the ground.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_ShoveFoliage": "Foliage shove",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_ShoveFoliage_tooltip": "Force the body transfers into bushes and small plants on contact.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_ShoveZombies": "Zombie shove",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_ShoveZombies_tooltip": "Force imparted to living zombies struck by the vehicle.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SkidMarks": "Tire marks",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SkidMarks_tooltip": "Leaves a ground decal when a tire breaks loose under power or hard braking.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SkidSound": "Tire skid sound",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SkidSound_tooltip": "Plays a tire-screech sound when a vehicle is sliding. Independent of the tire-marks visual. Disable if the sound is bothering you or if a sound mod conflicts.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SnowGrip": "Grip on snow",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SnowGrip_tooltip": "Fraction of normal grip on snow-covered ground.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_StabilityGuard": "Vehicle ground-clip guard",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_StabilityGuardSinkTiles": "Ground-clip trigger depth (levels)",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_StabilityGuardSinkTiles_tooltip": "How far below its own level's floor a vehicle must sink before the guard re-seats it, measured in floor levels (0.75 = three-quarters of one level). Lower reacts sooner; raise it if a custom map ever triggers it wrongly. Requires 'Vehicle ground-clip guard'.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_StabilityGuard_tooltip": "Safety net for multiplayer: if a vehicle sinks far below the floor of the level it is on (the 'sucked into the ground' desync), it is snapped back onto that floor. Only acts on a state that is never reached by normal driving, so ramps, basements and multi-level parking are unaffected.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SteeringCenteringHighSpeed": "Steering self-centering (high speed)",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SteeringCenteringHighSpeed_tooltip": "Multiplier on how quickly the wheels return to center at high speed.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SteeringCenteringLowSpeed": "Steering self-centering (low speed)",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SteeringCenteringLowSpeed_tooltip": "Multiplier on how quickly the wheels return to center at low speed.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SteeringFactorHighSpeed": "Steering response (high speed)",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SteeringFactorHighSpeed_tooltip": "Multiplier on how quickly the wheels turn at high speed.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SteeringFactorLowSpeed": "Steering response (low speed)",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SteeringFactorLowSpeed_tooltip": "Multiplier on how quickly the wheels turn at low speed.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SteeringHighSpeed": "High-speed threshold (km/h)",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SteeringHighSpeed_tooltip": "Speed (km/h) at which steering uses the high-speed response and centering values instead of the low-speed ones.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SteeringSnapback": "Steering response while drifting",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_SteeringSnapback_tooltip": "Multiplier on how quickly the wheels turn while a drift is held.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_ThrottleStart": "Start on throttle",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_ThrottleStart_tooltip": "When off, the engine must be started deliberately (start key or the engine icon) rather than by pressing accelerate.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TireGripModel": "Tire grip model",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TireGripModel_tooltip": "Different tire types (worn / standard / modern) get distinct grip on road, rain, snow and off-road instead of one flat value.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TireSlipWear": "Tires wear from wheel slip",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TireSlipWearRate": "Tire wear rate from slip",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TireSlipWearRate_tooltip": "Multiplier on how fast tires degrade while slipping. 1.0 is the default (a few minutes of hard slipping noticeably degrades them). Set to 0 to disable wear without disabling the model.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TireSlipWear_tooltip": "When the engine is forcing the wheels faster than the surface can grip (e.g. flooring it on grass) tires lose condition over time. Lets you brute-force through low-grip surfaces - at the cost of bald tires later.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TrunkCar": "Cargo factor: cars",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TrunkCar_tooltip": "Multiplier on this body type's reference storage. 1.0 keeps the reference value.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TrunkScaling": "Cargo capacity rescale",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TrunkScaling_tooltip": "Scales each vehicle's storage by a per-body-type factor instead of overwriting it. Auto-disabled when 'isoContainers' is present.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TrunkTrailer": "Cargo factor: trailers",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TrunkTrailer_tooltip": "Multiplier on this body type's reference storage. 1.0 keeps the reference value.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TrunkTruck": "Cargo factor: pickups",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TrunkTruck_tooltip": "Multiplier on this body type's reference storage. 1.0 keeps the reference value.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TrunkVan": "Cargo factor: vans",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_TrunkVan_tooltip": "Multiplier on this body type's reference storage. 1.0 keeps the reference value.",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_WetGrip": "Grip in rain",
  "translate_en|mods/BetterVehicleDynamics/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_BVD_WetGrip_tooltip": "Fraction of normal grip while it is raining.",
