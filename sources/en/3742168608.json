  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Marker_Pincer": "Pincer attack!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Marker_Sprinter": "Sprinters!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Marker_Surround": "Surrounded!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Marker_Wandering": "Wandering horde",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Shop_Buy": "Buy",
