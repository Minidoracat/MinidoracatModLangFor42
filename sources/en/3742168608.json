  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Shop_Name": "Merchant",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Shop_Teeth": "Zombie teeth: %1",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Shop_TeethUnit": "teeth",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Shop_Title": "Merchant",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_crescendo_large_1": "From the {dir}... and it's getting bigger and bigger. Can't hold on.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_crescendo_large_2": "Wave {wave} from the {dir}. I don't know how much longer I can hold.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_crescendo_large_3": "They're coming from the {dir} again... and even more of them.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_crescendo_medium_1": "Wave from the {dir}! It's not gonna stop... gotta hold on.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_crescendo_medium_2": "They're coming from the {dir}. Wave after wave. Can't let up.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_crescendo_medium_3": "From the {dir}... and more will follow. Deal with them fast.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_crescendo_medium_4": "Another wave from the {dir}. How many are left?",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_crescendo_neighbor_warning_1": "[{name}] is under fire from successive waves to the {dir}!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_crescendo_neighbor_warning_2": "Waves are stacking up near [{name}] to the {dir}.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_crescendo_small_1": "A first wave from the {dir}... more are coming.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_crescendo_small_2": "They're coming from the {dir}. And I hear more behind... it's not over.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_marchand_1": "Hey... someone, near the road to the {dir}. A merchant maybe?",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_marchand_2": "I spot someone to the {dir}, near a parked vehicle. Not a zombie.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_marchand_3": "There's a survivor to the {dir}, near the road. Looks calm.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_marchand_4": "Someone's set up to the {dir}, with a car. Interesting.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_neighbor_normal_1": "[{name}] attracted a horde to the {dir}!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_neighbor_normal_2": "A horde is closing in on [{name}] from the {dir}!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_neighbor_normal_3": "Watch out, [{name}] has a horde to the {dir}!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_neighbor_wandering_1": "A wandering horde is passing near [{name}] to the {dir}.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_neighbor_wandering_2": "Big horde on the move to the {dir}, near [{name}].",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_normal_large_1": "My god... there's dozens of them to the {dir}!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_normal_large_2": "It's a whole damn horde coming from the {dir}!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_normal_large_3": "They're everywhere to the {dir}... way too many. Gotta get out of here!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_normal_large_4": "A big horde from the {dir}. This won't be easy.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_normal_medium_1": "I hear a horde... it's coming from the {dir}!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_normal_medium_2": "Damn it, they're coming from the {dir}. Gotta move!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_normal_medium_3": "I can hear them coming from the {dir}... way too many.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_normal_medium_4": "From the {dir}... a horde. Gotta run!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_normal_small_1": "I hear 2-3 things over there... to the {dir}.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_normal_small_2": "There's some shuffling to the {dir}. Just a few.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_normal_small_3": "Something's moving to the {dir}. Not much.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_pincer_large_1": "My god... they're coming from everywhere, {dir} and ahead. I'm trapped.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_pincer_large_2": "Dozens from {dir} AND from the opposite direction. This is it.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_pincer_large_3": "A pincer... {dir} and behind. There's no way out of this.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_pincer_medium_1": "They're coming from the {dir} AND the opposite direction! I'm trapped!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_pincer_medium_2": "Damn it... {dir} and behind too. Gotta break through one side, fast.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_pincer_medium_3": "Caught in a pincer from {dir}. Gotta pick a side now.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_pincer_medium_4": "Two hordes converging... {dir} and the opposite. No time.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_pincer_small_1": "They're coming from the {dir}... and the opposite side too. Quick!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_pincer_small_2": "Two groups... {dir} and straight ahead. I'm caught in a pincer.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_sprinter_large_1": "Too many and too fast... from the {dir}. This is it.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_sprinter_large_2": "Dozens of them running from the {dir}. There's no way out.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_sprinter_medium_1": "They're running from the {dir}! Can't stay here!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_sprinter_medium_2": "Sprinters... from the {dir}. Can't fight that.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_sprinter_medium_3": "Damn it, they're sprinting! From the {dir}. Run!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_sprinter_small_1": "They're running... damn it, they're running!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_sprinter_small_2": "Those things... they're fast. Really fast.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_surround_large_1": "My god... I'm completely surrounded. This is it.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_surround_large_2": "There's dozens of them all around me. I'm trapped.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_surround_large_3": "I'm completely encircled. Gotta find a gap in the ring.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_surround_medium_1": "They're surrounding me... coming from all sides!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_surround_medium_2": "Damn it, they're all around. Which way do I go?",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_surround_medium_3": "They're everywhere! North, south, east... everywhere!",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_surround_small_1": "They're coming from everywhere... I hear them on all sides.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_surround_small_2": "Wait... is that coming from every direction at once?",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_wandering_large_1": "Damn... they're huge. It's crossing from the {dir}. Play dead.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_wandering_large_2": "A massive horde from the {dir}. Absolutely no noise.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_wandering_large_3": "There's hundreds of them passing to the {dir}... don't even breathe.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_wandering_medium_1": "Wait... a horde passing by to the {dir}. Stay still.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_wandering_medium_2": "They're moving... coming from the {dir}. Maybe they'll pass.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_wandering_medium_3": "A horde on the move to the {dir}. Don't make a sound.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_wandering_small_1": "A few of them passing by to the {dir}. Stay still.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_HS_Speech_wandering_small_2": "I hear 2-3 of them moving to the {dir}. No noise.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/ItemName.json|ItemName_HordeSpawner.ZombieTooth": "Zombie Tooth",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner": "HordeSpawner",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_AttractionRadius": "Attraction sound radius (tiles)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_AttractionRadius_tooltip": "Radius of the sound that pulls zombies toward the player. Must be larger than max spawn distance. Default: 1500.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_AttractionVolume": "Attraction sound volume",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_AttractionVolume_tooltip": "Intensity of the attraction sound. Higher = more zombies attracted. Default: 1500.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_AvoidIndoorSpawn": "Avoid indoor spawning",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_AvoidIndoorSpawn_tooltip": "Zombies only spawn outdoors. Recommended.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CooldownSeconds": "Individual cooldown (seconds)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CooldownSeconds_tooltip": "Minimum time in seconds between two hordes for the SAME player. Independent from other players unless Global cooldown is enabled. 900 = 15 minutes.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoBaseSize": "Crescendo - First wave size",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoBaseSize_tooltip": "Number of zombies in wave 1. Each following wave is multiplied by the Multiplier. Example: base=5 x2 = 5, 10, 20, 40. Default: 5.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoChance": "% Crescendo horde (out of 100)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoChance_tooltip": "STEP 2: Chance the horde is a crescendo. Default: 10%.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoDistMax": "Crescendo - Max distance (tiles)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoDistMax_tooltip": "Maximum distance. Default: 35.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoDistMin": "Crescendo - Min distance (tiles)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoDistMin_tooltip": "Minimum spawn distance for each wave. Each wave arrives from a different random direction. Default: 15.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoEnabled": "Enable crescendo horde",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoEnabled_tooltip": "The crescendo horde sends multiple waves of zombies at regular intervals, each larger than the last. The player cannot rest between waves — unkilled zombies stack up with each new wave.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoMultiplier": "Crescendo - Multiplier (%)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoMultiplier_tooltip": "Size multiplier between waves as a percentage. 200 = x2 (double), 150 = x1.5, 300 = x3. Example with base=5 and x2: wave 1=5, wave 2=10, wave 3=20, wave 4=40. Default: 200.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoWaveDelaySec": "Crescendo - Delay between waves (seconds)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoWaveDelaySec_tooltip": "Real-world seconds between each new wave. 30 = 30 seconds to kill the current wave before the next arrives. Minimum: 5 seconds. Default: 30.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoWaves": "Crescendo - Number of waves",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_CrescendoWaves_tooltip": "Total number of waves. Wave 1 spawns immediately, subsequent waves arrive after the configured delay. Default: 4 waves.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_Debug": "Debug mode",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_Debug_tooltip": "Outputs technical logs to console.txt. Disable in normal play.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_EnableDebugContextMenu": "Admin right-click menu",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_EnableDebugContextMenu_tooltip": "Enables admin options in the right-click menu: force a horde, view status, reset cooldown.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_Enabled": "Enable HordeSpawner",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_Enabled_tooltip": "Enables or completely disables the mod.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_GlobalPlayerCooldownSeconds": "Global cooldown after a horde (seconds)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_GlobalPlayerCooldownSeconds_tooltip": "If > 0, when a horde spawns on any player, ALL players are protected for this many seconds. Prevents two simultaneous hordes on the server. 0 = disabled. Example: 300 = nobody can get a horde for 5 minutes after any horde spawns.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_GroupSizeMax": "Normal horde - Maximum size",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_GroupSizeMax_tooltip": "Maximum zombies in a normal horde (before scaling). Hard limit: 500.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_GroupSizeMin": "Normal horde - Minimum size",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_GroupSizeMin_tooltip": "Minimum zombies in a normal horde (before scaling).",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_MPAttractionDelaySeconds": "MP attraction delay (seconds)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_MPAttractionDelaySeconds_tooltip": "Seconds before sending the zombie attraction signal in MP. Too short = zombies miss the signal. Default: 10.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_MPSpawnClamp": "MP spawn distance limit (tiles)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_MPSpawnClamp_tooltip": "MULTIPLAYER ONLY. Limits spawn radius to stay in the loaded zone. Reduce if zombies vanish on spawn. Default: 75.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_MerchantChance": "% Spawn chance (per check)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_MerchantChance_tooltip": "Every 15 in-game minutes, chance that a merchant spawns near a player if a valid spot is found. Default: 25%.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_MerchantDespawnMinutes": "Merchant despawn (minutes)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_MerchantDespawnMinutes_tooltip": "Time before an inactive merchant (no nearby player, no ongoing trade) disappears along with his vehicle. Default: 20 minutes.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_MerchantEnabled": "Enable wandering merchant",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_MerchantEnabled_tooltip": "A merchant NPC can appear near a road with his vehicle parked on the roadside.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_MerchantMaxDistance": "Merchant max distance (tiles)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_MerchantMaxDistance_tooltip": "Maximum distance from the player when searching for a merchant spawn spot.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_MerchantMinDistance": "Merchant min distance (tiles)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_MerchantMinDistance_tooltip": "Minimum distance from the player when searching for a merchant spawn spot.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_NeighborNotifyRadius": "Neighbor alert radius (tiles)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_NeighborNotifyRadius_tooltip": "Players within this radius are warned when a horde is triggered nearby. 0 = disabled. Default: 100.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_NewPlayerGraceSeconds": "New player protection (seconds)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_NewPlayerGraceSeconds_tooltip": "How long after connecting a player cannot be targeted. 0 = disabled. Default: 600 = 10 minutes.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_NightEndHour": "Night end hour (in-game)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_NightEndHour_tooltip": "In-game hour at which night ends. Default: 5. Midnight crossing handled automatically.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_NightOnly": "Hordes at night only",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_NightOnly_tooltip": "If enabled, hordes can only spawn during nighttime in-game.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_NightStartHour": "Night start hour (in-game)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_NightStartHour_tooltip": "In-game hour at which night starts. Default: 21.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_NormalChance": "% Normal horde (out of 100)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_NormalChance_tooltip": "STEP 2: If a horde must spawn, this % is the chance it is a normal horde. The 6 types should ideally add up to 100. Example: Normal=35 Wandering=22 Surround=16 Pincer=12 Crescendo=10 Sprinter=5 = exactly 100%. If the total is not 100, the game recalculates automatically.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_PincerChance": "% Pincer horde (out of 100)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_PincerChance_tooltip": "STEP 2: Chance the horde is a pincer. Ignored if pincer is disabled. The 4 types should ideally add up to 100.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_PincerDistMax": "Pincer horde - Max distance (tiles)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_PincerDistMax_tooltip": "Maximum distance. Capped by MP Clamp in multiplayer. Default: 40.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_PincerDistMin": "Pincer horde - Min distance (tiles)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_PincerDistMin_tooltip": "Minimum distance from the player where each group spawns. Both groups spawn at this distance in opposite directions.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_PincerEnabled": "Enable pincer horde",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_PincerEnabled_tooltip": "The pincer horde spawns two groups of zombies in opposite directions simultaneously (e.g. North AND South). The player is caught between them and must break through one line or flee sideways.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_PincerGroupMax": "Pincer horde - Maximum size (total)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_PincerGroupMax_tooltip": "Maximum total zombies. Default: 30.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_PincerGroupMin": "Pincer horde - Minimum size (total)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_PincerGroupMin_tooltip": "Minimum total zombies across both groups. Each group gets roughly half. Default: 10.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_RewardCrateChance": "% Crate chance (per horde)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_RewardCrateChance_tooltip": "For each horde that spawns, chance that a reward crate appears at its spawn point. Default: 35%.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_RewardCrateEnabled": "Enable reward crate",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_RewardCrateEnabled_tooltip": "A wooden crate is placed at the horde's spawn point, with a few useful items (ammo, medical, food, sometimes a weapon) dropped on the ground next to it - as if it had been air-dropped when the horde arrived.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_ScalingInterval": "Difficulty step (days or months)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_ScalingInterval_tooltip": "Days between each difficulty increase. Default: 14.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_ScalingMaxPercent": "Difficulty cap (%)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_ScalingMaxPercent_tooltip": "Maximum horde size with scaling. 250 = x2.5 max.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_ScalingMode": "Progressive difficulty",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_ScalingMode_option1": "Disabled",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_ScalingMode_option2": "By days survived",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_ScalingMode_option3": "By months survived",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_ScalingMode_tooltip": "Increases horde size over survival time.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_ScalingPercent": "Increase per step (%)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_ScalingPercent_tooltip": "Extra zombies per step. Example: 20 = +20% every 14 days.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_SpawnChance": "Chance a horde appears (%)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_SpawnChance_tooltip": "STEP 1: Every 15 minutes, the game rolls a die. This is the probability a horde appears at all. Example: 50 = 50% chance. If the roll fails, nothing happens and we wait another 15 minutes. If it succeeds, we move to Step 2.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_SpawnDistMax": "Normal horde - Max distance (tiles)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_SpawnDistMax_tooltip": "Maximum spawn distance. Capped by MP Clamp in multiplayer.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_SpawnDistMin": "Normal horde - Min distance (tiles)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_SpawnDistMin_tooltip": "Minimum spawn distance. Too small = zombies in the player's field of view.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_SpawnSearchAttempts": "Spawn location search attempts",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_SpawnSearchAttempts_tooltip": "Attempts to find a valid spawn tile. Higher = more reliable. Default: 64.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_SpecialZombieChance": "% Special zombie chance (per zombie)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_SpecialZombieChance_tooltip": "For EACH spawned zombie, chance it wears a special outfit instead of a normal random one. With a 50-zombie horde and 6%, roughly 3 zombies will be special. The player gets notified if any were spotted. Default: 6%.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_SpecialZombieEnabled": "Enable special zombies",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_SpecialZombieEnabled_tooltip": "A small percentage of zombies in each horde will spawn wearing a special outfit (military, police, doctor, fire officer, ranger, hazmat...). These zombies carry interesting lootable equipment to reward the player for searching bodies after the fight.",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_SprinterChance": "% Sprinter horde (out of 100)",
  "translate_en|mods/HordeSpawner/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_HordeSpawner_SprinterChance_tooltip": "STEP 2: Chance the horde is a sprinter horde. Keep low as it is very dangerous. Default: 5%.",
