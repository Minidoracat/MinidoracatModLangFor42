  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_ErrBadRequest": "Invalid request.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_ErrBusy": "Hold on a second.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_ErrFailed": "The transaction failed.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_ErrNoMarket": "The market is not trading.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_ErrNoMoney": "You can't afford that.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_ErrNoStock": "That item just sold out.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_ErrTooFar": "Get closer to the merchant.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_GuardAvenge1": "If the merchant dies, nobody here wins!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_GuardAvenge2": "You killed the business, you idiot!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_GuardAvenge3": "He was the last honest trader and you wrecked him!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_GuardBetray1": "You asked for this!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_GuardBetray2": "The deal is off!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_GuardBetray3": "Nobody shoots at this stand and walks away!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_GuardCombat1": "Deadheads on the perimeter!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_GuardCombat2": "I've got this, nobody leaves the stand!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_GuardCombat3": "We've got ammo to spare!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_GuardWarn1": "You attack, we attack. Simple as that.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_GuardWarn2": "You're not taking us, stranger.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_GuardWarn3": "Hands where I can see them and we're all friends.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_GuardWarn4": "Buy something or move along, don't just stand there.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_MerchantBetray1": "You're shooting at ME?! Guards!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_MerchantBetray2": "Guards, this lunatic is shooting at me!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_MerchantGreet1": "Welcome to MaurinBombin Market! Cash, always cash.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_MerchantGreet2": "Come on in. If I've got it, I'll sell it.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_MerchantGreet3": "No haggling here, but no swindling either.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_MerchantIdle1": "The price is the price, don't look at me like that.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_MerchantIdle2": "The guards eat separately, that's why nothing is free.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_MerchantIdle3": "Everything you see here, somebody died bringing it in.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_MoneyLine": "Money: %1 / %2",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RadioAt": "right in %1",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RadioHeader": "*crrrsh* This is MaurinBombin Market, 88.5 FM, the last honest business still standing.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RadioNear": "%1 of %2",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RadioNoOffers": "Shelves are bare today, but drop by anyway.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RadioOffAir": "No stand today, we're still hauling the goods. Keep this dial handy.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RadioOffAirDead": "The stand is closed. They killed our man. We'll be back when we can.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RadioOfferItem": "%1 for %2",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RadioOffers": "Today's deals: %1.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RadioRoad": "%1, right by the highway",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RadioSignOff": "Bring cash, no credit here. *crrrsh*",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RadioWhere": "You'll find us %1.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RestockDays": "We're back in %1 days.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RestockNow": "Restocking right now.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RestockSoldOut": "Sold out! We restock tomorrow.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_RestockToday": "We restock later today.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_Title": "MaurinBombin Market",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_TownCoords": "around %1, %2",
