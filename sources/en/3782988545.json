  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_ChispaBoom": "You really went for it, you idiot, here comes the fireworks!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_ChispaWarn10": "10 seconds!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_ChispaWarn30": "30 seconds left, get out!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_ChispaWarn5": "5... 4... 3...!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_ChispaWarn60": "You've got 1 minute to get out or I burn it all down!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_DebugDiagnose": "Diagnose (check console)",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_DebugMenu": "[DEBUG] Team PVC",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_DebugReinject": "Re-inject clan definition",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_DebugSpawnChispa": "Spawn Team PVC (+ Forced Pyro)",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_DebugSpawnElite": "Spawn Team PVC (Elite)",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_DebugSpawnHere": "Spawn Team PVC here (tile)",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_IntroChispa": "I'm El Chispa and I brought you a little present!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_IntroEvaristo": "Evaristo Brea, with all due respect, this is about to get ugly!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_IntroGaston": "Gaston Cath reporting in, you're done for!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_IntroKhris": "Khris Heartz, the law just showed up in the neighborhood!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_IntroMauricio": "I'm Captain Mauricio Murillo and this is your last warning!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_IntroNealcito": "Nealcito Murillo, axe in hand, here to help you out!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_IntroNep": "Nep Tune in command, don't you dare run!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_Phrase1": "This is Team PVC!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_Phrase2": "Long live PVC and long live the clan!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_PVC_Phrase3": "*Incomprehensible Chilean slang*",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TA2_EvaristoLastWords": "THE SUIT'S RUINED. SEE YOU IN HELL, YOU WORTHLESS SACK OF GARBAGE",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TA2_HordeBaitTaunt": "Let's see you deal with these!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TA2_SurrenderBetray": "Never trust a bandit!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TA2_SurrenderFake": "I surrender, take it all!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TA_CaptainDown": "THEY KILLED THE CAPTAIN, DON'T LEAVE A SINGLE ONE ALIVE!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TB_NoteBody": "The PVC arsenal is buried at [%1, %2].\n\nIf I don't come back, it's yours.\n\n- Captain Mauricio Murillo",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TB_NoteTitle": "Arsenal coordinates",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TD_AllyDied1": "%1 is down!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TD_AllyDied2": "%1 went down! They're slaughtering us!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TD_AllyDied3": "They killed %1, son of a bitch!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TD_AllyDied4": "%1! NO! Finish him off!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TD_Dmg1": "I'm hit!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TD_Dmg2": "Damn it, I'm hit!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TD_Dmg3": "Cover me, I'm hurt!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TD_Dmg4": "Aaagh! Got me!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TD_Dmg5": "I'm bleeding!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TD_Reload1": "Cover the hallway, I'm reloading!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TD_Reload2": "Out of ammo, give me a second!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TD_Reload3": "Changing mags! Cover me!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TD_Reload4": "Reloading! Don't let him through!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TD_Unknown": "one of ours",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Meds1": "Hang in there... I'll patch up and keep going.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Meds2": "Just a moment!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Meds3": "Damn it, this hurts.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Negotiate1": "You've got nothing to shoot me with! Drop %1 and live.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Negotiate2": "You're out, aren't you? Hand over %1 and I let you go.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Negotiate3": "Not one more step. %1 on the ground. Now.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Negotiate4": "I can kill you, or you can pay me with %1. Your choice.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_NegotiateFail": "You handed over nothing. This talk is over.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_NegotiateSuccess": "Good deal. You don't shoot, I don't shoot.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Note1Body": "WANTED - DEAD OR ALIVE\n\n%1\n\nWanted for looting the Rosewood depot and for killing two of our own.\n\nREWARD: 4 crates of ammunition and a tank of gasoline.\nDeliver proof at the mile 12 outpost.\n\n- The Accountant",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Note1Title": "Poster: WANTED",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Note2Body": "Mom:\n\nIf you're reading this, someone found me before you did.\nWe're not the monsters they talk about on the radio. At first we just wanted food.\nAfter what happened at the farm... I don't know what we are anymore.\n\nDon't come looking for me.\n\n%1",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Note2Title": "Unsent letter",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Note3Body": "STANDING ORDER - READ AND BURN\n\n1. No one enters the perimeter without the password.\n2. The wounded stay behind. No exceptions.\n3. If one of us falls, call it in on the radio and regroup. Do NOT give chase.\n4. Whoever abandons their post answers to me.\n\nSigned: %1",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Note3Title": "Clan order",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Note4Body": "WHAT THEY OWE ME:\n\n- Vic: 200 rounds of .308. Dead. Collected.\n- Marta: the shotgun. Took off up north.\n- The new guy: nothing yet. Good aim, though.\n- %1 (me): a shot to the knee I took covering all of them.\n\nNobody ever pays up.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Note4Title": "List of debts",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Pyro1": "Burn it all!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Pyro2": "Fire! FIRE!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Pyro3": "Let's see if you like the heat!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Radio1": "Base, this is team one, we've got casualties!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Radio2": "Send reinforcements, NOW!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Radio3": "They're killing us, we need backup!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Scavenge1": "This one doesn't need it anymore.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Scavenge2": "Nice haul...",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Scavenge3": "Come on, grab whatever's useful.",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Sidearm1": "Screw it, sidearm!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Sidearm2": "Too close, too close!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_Sidearm3": "No time to reload!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TQW_UnknownBandit": "an unknown man",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TR_DebugForce": "Force nearby roadblock and teleport me",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TR_DebugMenu": "[DEBUG] Toll",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TR_DebugTeleport": "Teleport me to nearest roadblock",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TR_NoteBody": "TOLL NOTICE\n\nThose who don't pay, burn.\nSay hi to hell for me.\n\n- Evaristo Brea",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_BEP_TR_NoteTitle": "Toll Notice",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_Buy": "Buy",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_BuyOk": "Deal!",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_Close": "Close",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_ContextTrade": "Trade with MaurinBombin",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_DebugMenu": "[DEBUG] MaurinBombin Market",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_DebugSpawnHere": "Spawn the market here",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_DirE": "east",
  "translate_en|mods/BanditsExpansionPVC/42/media/lua/shared/Translate/EN/UI.json|UI_MBM_DirN": "north",
