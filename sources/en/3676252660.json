  "translate_en|mods/PhunZones2/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PhunZones_UpdateInterval_tooltip": "The number of seconds between scanning for zone changes. 1 should be more than fine",
  "translate_en|mods/PhunZones2/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PhunZones_Widget": "Show Widget",
