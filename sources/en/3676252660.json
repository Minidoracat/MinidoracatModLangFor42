  "translate_en|mods/PhunZones2/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PhunZones_ExemptModGM_tooltip": "Extends 'Staff ignore zone restrictions' to the Moderator, GM and Overseer roles as well as Admin. Has no effect unless that option is on.",
  "translate_en|mods/PhunZones2/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_PhunZones_ManageNoPvpZones": "Manage no-pvp zones",
