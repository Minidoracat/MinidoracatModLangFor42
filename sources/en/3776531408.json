  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/IG_UI.json|IGUI_KnoxClaim_ZoneShow": "Show my zone",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim": "Knox Claim",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_ApprovalForNonResidential": "Commercial needs approval",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_ApprovalForNonResidential_tooltip": "Houses are free to claim. Anything else requires a request with a reason and headcount that an admin approves. Turn off to let any building be claimed without asking.",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_ClaimsPerPlayer": "Claims per player",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_ClaimsPerPlayer_tooltip": "How many properties a player may hold at once. A faction owned property counts against the faction, not the individual member.",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_ClearZombies": "Keep claimed ground clear of zombies",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_ClearZombies_tooltip": "Removes zombies standing on claimed ground, checked every ten minutes. Mind the reach: on a painted zone this covers the whole area, not just the house. Off leaves everything standing and each owner clears their own ground.",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_DecayDays": "Release after days away",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_DecayDays_tooltip": "If the owner has not visited the property for this many in-game days it becomes free again. Set to 0 to disable decay, then a property stays until it is released or an admin clears it.",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_DecayWarnDays": "Warning ahead in days",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_DecayWarnDays_tooltip": "The owner gets a warning on login this many days before the property expires. 0 lets it expire without notice.",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_Enabled": "Allow claiming property",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_Enabled_tooltip": "Master switch. Turning it off keeps existing claims stored but nobody can claim, enter or manage anything.",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_FactionOwnsClaims": "Factions own property",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_FactionOwnsClaims_tooltip": "Players in a faction claim on behalf of that faction. Every member has access and the leadership manages the household. Players without a faction own personally. Turn off to make everyone own personally.",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_FactionOwnsVehicles": "Factions own vehicles",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_FactionOwnsVehicles_tooltip": "On registers a car directly to the faction when a member claims it. Off keeps every car personal at first, and handing it over to the faction stays available from the vehicle menu at any time.",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_LimitTiles": "Use the tile budget",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_LimitTiles_tooltip": "Off removes the tile ceiling. The window then only shows how many tiles someone holds, with no bar and no limit, and the number of claims is the only cap left. The per claim cap is unaffected.",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_MembersPerClaim": "Household size",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_MembersPerClaim_tooltip": "How many players besides the owner may be listed, guests included.",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_TilesPerClaim": "Tile cap per claim",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_TilesPerClaim_tooltip": "Upper limit for a single property. It matters because the game treats terraced buildings as one building. The largest measured is 157 by 164 tiles, which without a cap would be a single click.",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_TilesPerPlayer": "Tile budget per player",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_TilesPerPlayer_tooltip": "Total claimed tiles across all of a player's properties. An ordinary house in Knox County runs about 100 to 200 tiles.",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_VehiclesPerFaction": "Vehicles per faction",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_VehiclesPerFaction_tooltip": "How many vehicles a faction may hold. This is a separate pool from the personal one: a member who hands a car over to the faction frees a personal slot and uses a faction slot instead. Every member may drive and loot a faction vehicle without being listed individually.",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_VehiclesPerPlayer": "Vehicles per player",
  "translate_en|mods/KnoxClaim/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_KnoxClaim_VehiclesPerPlayer_tooltip": "How many vehicles a player may register personally. Registered vehicles cannot be started, looted, towed or stripped by strangers. Set to 0 to disable vehicle claims entirely."
}
