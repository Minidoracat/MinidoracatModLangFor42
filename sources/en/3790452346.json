  "translate_en|mods/NicksRideableElevators/common/media/lua/shared/Translate/EN/IG_UI.json|IGUI_NRE_Options_ShaftLight": "Light the elevator car",
  "translate_en|mods/NicksRideableElevators/common/media/lua/shared/Translate/EN/IG_UI.json|IGUI_NRE_Options_ShaftLight_Tip": "An elevator shaft is a sealed room with no lights, so the car is pitch black inside. This lights the car whenever you are in it or standing at its doors.",
