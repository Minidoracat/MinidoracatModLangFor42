  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch": "A-Life - Companion Dogs Compatibility Patch",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogAlertHumans": "Dog alerts for people",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogAlertHumans_tooltip": "Dogs can smell A-Life NPCs (friendly ones too) as well as zombies. The owner's own people (residents, faction members, followers, party members) never trigger an alert. OFF: dogs only ever alert for zombies.",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogCanDieByNPC": "Dog can die by NPC",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogCanDieByNPC_tooltip": "ON: A-Life NPCs can kill your dog. OFF: NPC attacks cannot take the dog below its health threshold, and NPCs and the dog stop attacking each other once the dog is at that threshold or is panicking or terrified.",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogHealthThreshold": "Dog health threshold",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogHealthThreshold_tooltip": "Fraction of the dog's maximum health that counts as low (0.1 = 10%). When an NPC hit leaves the dog at or below it, the dog gets the status chosen below. With Dog can die by NPC off, NPC damage also stops here.",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogNPCDamageMultiplier": "Dog NPC damage multiplier",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogNPCDamageMultiplier_tooltip": "Scales the damage your dog deals to A-Life NPCs (1.0 = normal, 2.0 = double, 0.1 = a tenth). It stacks with the Companion Dogs damage option and does not affect zombies. The NPC's armor and damage reduction are applied after this.",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogNPCDefenseMultiplier": "Dog NPC defense multiplier",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogNPCDefenseMultiplier_tooltip": "Scales how well your dog withstands A-Life NPC attacks, relative to its health (1.0 = normal, 2.0 = takes half the damage, 0.1 = takes ten times as much). It does not affect zombies.",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogPeopleSenseLevel": "Scent level to smell people",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogPeopleSenseLevel_tooltip": "Below this Scent skill level the dog only alerts for zombies. From this level it smells people as well, but cannot tell them from zombies and warns about 'something' nearby.",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogPeopleStanceLevel": "Scent level to read people's attitude",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogPeopleStanceLevel_tooltip": "From this Scent skill level the dog also tells how people feel towards you: friendly, neutral (careful included) or hostile, each with its own alert. When several are near, the most dangerous one is shown. Never lower than the level above.",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogPeopleTellLevel": "Scent level to tell people from zombies",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogPeopleTellLevel_tooltip": "From this Scent skill level the dog tells people and zombies apart: zombies keep their normal alert and people get their own 'Someone nearby' alert. Never lower than the level above.",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogTarget": "Dog Attacks A-Life NPC",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogTarget_option1": "Hostile only",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogTarget_option2": "Hostile and Careful",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogTarget_option3": "Hostile, Careful and Neutral",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogTarget_option4": "Everyone (including Friendly)",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogTarget_option5": "Disabled",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogTarget_tooltip": "Which A-Life NPCs your dog will attack, judged by their relation to the dog's owner. Each level also includes every more hostile one. Disabled: the dog never attacks A-Life NPCs. An NPC that has surrendered (hands up) or is lying injured is never attacked, whatever its relation. Neither are the owner's own people: residents, faction members, followers and party members.",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogThresholdStatus": "Dog status at health threshold",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogThresholdStatus_option1": "Panicking",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogThresholdStatus_option2": "Terrified",
  "translate_en|mods/CDALifePatch/42/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_CDALifePatch_DogThresholdStatus_tooltip": "The status the dog gets when an A-Life NPC attacks it and it is at the health threshold. It is only ever applied after an NPC attack. A dog that cannot panic always becomes terrified."
}
