  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_BirdStrikes_tooltip": "With in-flight events on: birds hit aircraft flying low (below about 900 m, mostly below 150 m) - more the longer it stays low.",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_Ceiling": "Altitude limit",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_Ceiling_option1": "10 m",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_Ceiling_option2": "30 m",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_Ceiling_option3": "60 m",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_Ceiling_option4": "100 m",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_Ceiling_tooltip": "Highest height above the ground for aircraft in the game view. At this height hold arrow up to climb through the clouds to the map screen.",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_CrashExplode": "Crash explosion",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_CrashExplode_tooltip": "An aircraft whose fuselage hits something in the air, that hits something fast on the ground, or that comes down too hard blows up: fire round it, everyone aboard dies.",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_EngineNoise": "Engine noise draws zombies",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_EngineNoise_option1": "Off",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_EngineNoise_option2": "Low",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_EngineNoise_option3": "Normal",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_EngineNoise_option4": "High",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_EngineNoise_tooltip": "How far the jets' noise carries to the zombies: further with more throttle, and the ground under a low flight hears it too. Normal: about 100 tiles at full throttle.",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_FlightEvents": "In-flight events",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_FlightEvents_tooltip": "Events while flying: bird strikes on aircraft flying low. Off: no bird strikes (the low-altitude warning still shows after take-off).",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_FuelUse": "Fuel use",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_FuelUse_option1": "Off",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_FuelUse_option2": "Low",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_FuelUse_option3": "Normal",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_FuelUse_option4": "High",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_FuelUse_tooltip": "How much fuel the aircraft's engines burn (the tank is a car's: filled and siphoned the same way). Normal: a 50 L tank lasts about an hour of flight.",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_HandOverTimeout": "Coming down from the map: stop waiting after 10 s",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_HandOverTimeout_tooltip": "Coming down from the high-altitude map, the aircraft waits at the bottom until the land ahead has loaded (the panel says SCANNING THE TERRAIN BELOW). On a slow PC or server this can take very long, or never end, so the aircraft cannot land. On: after 10 seconds it comes down anyway once the land round the aircraft itself is there; it then flies on slowly while the rest loads and may stop in the air for a moment now and then. Off (default): it waits for the land as before. Turn it on only if you cannot land.",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_MapEaseStrong": "High-altitude flight: slow down for frame rate",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_MapEaseStrong_tooltip": "At high altitude, when the frame rate drops because the game is loading a lot of new land (chunks) - over a big town, for example - the cruise slows down automatically, so less new land comes in each second and the game stutters less. When the frame rate recovers it speeds back up slowly. On: slows as soon as the frame rate dips (the speed rises and falls). Off: slows only when the game nearly stops (a steady speed, more stutter).",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_RunwayLength": "Take-off and landing length",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_RunwayLength_option1": "Normal",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_RunwayLength_option2": "Short",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_RunwayLength_option3": "Shorter",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_RunwayLength_tooltip": "How long a run aircraft need to take off and land (the take-off and landing speeds go down with it). Normal: closest to real, long runs - for realism. Short (about two thirds): freer landings on most roads and fields. Shorter (about half): land almost anywhere. Multiplayer: choose by your screen resolution and the server - a small screen or a slow server loads less land around you, so pick Short or Shorter.",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_Wear": "Airframe wear",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_Wear_option1": "Off",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_Wear_option2": "Half",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_Wear_option3": "Normal",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_Wear_option4": "Double",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_Wear_tooltip": "How fast the aircraft's parts (skin, wings, tailplanes, control surfaces, hydraulics, landing gear, fuel tank, engines) wear in flight. Repair them in the mechanics window.",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_WorldSpawns": "Aircraft at the airfields",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/Sandbox.json|Sandbox_Wingsmith_WorldSpawns_tooltip": "One aircraft in very good shape on the runway of the airstrip west of Brandenburg and one in front of the hangars of Louisville airport - once in every world (the game's own map).",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/UI.json|UI_Wingsmith_OptDesc": "Settings of this computer: every save and every aircraft.",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/UI.json|UI_Wingsmith_OptEngineVolume": "Engine sound volume",
  "translate_en|mods/Wingsmith/common/media/lua/shared/Translate/EN/UI.json|UI_Wingsmith_OptEngineVolume_tooltip": "The aircraft engines' sound: 0 to 400 (200 = default). On top of the game's vehicle engine volume.",
